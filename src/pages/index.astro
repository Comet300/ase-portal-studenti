---
import StudentLayout from '../layouts/StudentLayout.astro'
import { formatDate, stages, currentStage, studentMilestones, studentRequests } from '../lib/repo'
import { currentYearLabel } from '../lib/years'

const u = Astro.locals.user
const [stageList, currentStageRow, sesiune] = await Promise.all([
  stages(),
  currentStage(),
  currentYearLabel(),
])

// Un student autentificat vede propria situație în locul textului general.
const requests = u?.role === 'student' ? await studentRequests(u.id) : []
const activeRequest = requests.find((c) => c.status === 'approved' || c.status === 'pending')
const milestones = u?.role === 'student' ? await studentMilestones(u.id) : []
/* „Următorul termen” trebuie să fie în viitor.
 *
 * Se lua primul nefinalizat, în ordine, deci pe 29 iulie pagina anunța drept
 * următor un termen din 1 martie. Dacă tot ce a rămas este restant, se spune
 * asta — nu se prezintă trecutul ca viitor. */
const neterminate = milestones.filter((j) => j.status !== 'done')
const azi = new Date()
azi.setHours(0, 0, 0, 0)

const nextMilestone =
  neterminate.find((j) => j.due_on && new Date(j.due_on) >= azi) ?? neterminate[0]
const nextMilestoneOverdue = Boolean(
  nextMilestone?.due_on && new Date(nextMilestone.due_on) < azi,
)

/**
 * Prima propoziție de pe ecran.
 *
 * Era una singură pentru toată lumea — o prezentare a portalului, arătată la
 * fel unui vizitator care nu îl cunoaște și unui student care intră a
 * cincisprezecea oară ca să vadă dacă i s-a răspuns. Iar un cadru didactic
 * primea drept acțiune principală „Cererile mele”, adică o pagină de student,
 * goală pentru el.
 */
const intro = (() => {
  if (!u) {
    return {
      titlu: 'Tot ce ține de lucrarea ta, într-un singur loc',
      text: 'Alegi coordonatorul, depui cererea, urmărești termenele și discuți cu profesorul — fără drumuri la secretariat și fără fire de email pierdute.',
      actiune: { href: '/autentificare', text: 'Intră în cont' },
      secundar: { href: '/coordonatori', text: 'Vezi coordonatorii' },
    }
  }

  if (u.role !== 'student') {
    return {
      titlu: `Bine ai revenit, ${u.name.split(' ').slice(-1)[0]}`,
      text: 'Ești autentificat ca și cadru didactic. Triajul cererilor, temele propuse și consultațiile sunt în zona dedicată.',
      actiune: { href: '/profesor', text: 'Deschide zona cadrelor didactice' },
      secundar: { href: '/coordonatori', text: 'Vezi catalogul public' },
    }
  }

  if (activeRequest?.status === 'approved') {
    return {
      titlu: activeRequest.title_ro,
      text: `Coordonezi lucrarea cu ${activeRequest.teacher_name}.${
        nextMilestone
          ? nextMilestoneOverdue
            ? ` Termenul „${nextMilestone.title}” a trecut pe ${formatDate(nextMilestone.due_on)}.`
            : ` Următorul termen: ${nextMilestone.title}, ${formatDate(nextMilestone.due_on)}.`
          : ''
      }`,
      actiune: { href: '/cererile-mele', text: 'Vezi termenele lucrării' },
      secundar: { href: '/mesaje', text: 'Scrie coordonatorului' },
    }
  }

  if (activeRequest) {
    return {
      titlu: `Cererea ta este la ${activeRequest.teacher_name}`,
      text: activeRequest.expires_at
        ? `Ai un răspuns până la ${formatDate(activeRequest.expires_at)}. Dacă nu vine până atunci, cererea se închide singură și poți depune alta.`
        : 'Aștepți răspunsul coordonatorului. Primești un email imediat ce decide.',
      actiune: { href: '/cererile-mele', text: 'Vezi cererea' },
      secundar: { href: '/coordonatori', text: 'Vezi coordonatorii' },
    }
  }

  return {
    titlu: 'Primul pas: alege-ți coordonatorul',
    text: 'Poți porni de la persoană sau de la temă. Cererea se depune din catalog, iar coordonatorul are o săptămână să răspundă.',
    actiune: { href: '/coordonatori', text: 'Alege coordonator' },
    secundar: { href: '/ghid', text: 'Citește ghidul' },
  }
})()

const RESOURCES = [
  { title: 'Ghid de redactare', text: 'Structura lucrării, citare, formatare.', href: '/ghid#redactare' },
  { title: 'Regulament privind IA', text: 'Ce este permis și ce trebuie declarat.', href: '/ghid#ia' },
  { title: 'Antiplagiat', text: 'Procedura de verificare și pragurile admise.', href: '/ghid#antiplagiat' },
  { title: 'Formulare', text: 'Cereri, declarații și anexe descărcabile.', href: '/ghid#documente' },
]
---

<StudentLayout
  title="Acasă"
  description={`Sesiunea de Finalizare a Studiilor ${sesiune} — Facultatea de Marketing, ASE București`}
  active="acasa"
>
  <div class="container stack stack--loose">
    <section class="hero">
      <div class="hero__text">
        <p class="hero__sesiune">Sesiunea de Finalizare a Studiilor {sesiune}</p>
        <h1 class="hero__titlu">{intro.titlu}</h1>
        <p class="page-lede">{intro.text}</p>
        <div class="row row--wrap" style="gap:var(--s-3)">
          <a href={intro.actiune.href} class="btn btn--primary">{intro.actiune.text}</a>
          <a href={intro.secundar.href} class="btn btn--secondary">{intro.secundar.text}</a>
        </div>
      </div>

      {
        u?.role === 'student' && (
          <aside class="situatie">
            <h2 class="situatie__titlu">Situația ta</h2>
            {activeRequest ? (
              <>
                <p class="situatie__linie">
                  <span class="muted">Coordonator</span>
                  <strong>{activeRequest.teacher_name}</strong>
                </p>
                <p class="situatie__linie">
                  <span class="muted">Cerere</span>
                  <strong>{activeRequest.status === 'approved' ? 'Aprobată' : 'În așteptare'}</strong>
                </p>
                {nextMilestone && (
                  <p class="situatie__linie">
                    <span class="muted">
                      {nextMilestoneOverdue ? 'Termen depășit' : 'Următorul termen'}
                    </span>
                    <strong class:list={{ 'is-restant': nextMilestoneOverdue }}>
                      {nextMilestone.title} · {formatDate(nextMilestone.due_on)}
                    </strong>
                  </p>
                )}
              </>
            ) : (
              <>
                <p class="muted text-sm">
                  Nu ai încă o cerere activă. Primul pas este să alegi un coordonator și să depui
                  cererea de coordonare.
                </p>
                <a href="/coordonatori" class="btn btn--primary btn--sm">Alege coordonator</a>
              </>
            )}
          </aside>
        )
      }
    </section>

    <section class="stack">
      <h2 class="section-title">Calendarul sesiunii</h2>
      <ol class="calendar">
        {
          stageList.map((e, i) => {
            const active = currentStageRow?.id === e.id
            const past = e.ends_on ? new Date(e.ends_on) < new Date() : false
            return (
              <li class:list={['etapa', { 'is-activa': active, 'is-trecuta': past }]}>
                <span class="etapa__index numeric" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="etapa__corp">
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <h3 class="etapa__titlu">{e.title}</h3>
                    {active && <span class="badge badge--asteptare">În curs</span>}
                    {past && <span class="badge badge--aprobata">Încheiată</span>}
                  </div>
                  <p class="etapa__interval numeric">{e.interval_label}</p>
                  {e.description && <p class="etapa__descriere">{e.description}</p>}
                </div>
              </li>
            )
          })
        }
      </ol>
    </section>

    <section class="stack">
      <h2 class="section-title">Resurse academice</h2>
      <div class="grid-auto">
        {
          RESOURCES.map((r) => (
            <a href={r.href} class="resursa">
              <strong>{r.title}</strong>
              <span class="muted">{r.text}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</StudentLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .hero__sesiune {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--red);
  }

  .hero__titlu {
    font-family: var(--serif);
    font-size: var(--t-3xl);
    letter-spacing: -0.015em;
    max-width: 22ch;
  }

  .situatie {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .situatie__titlu {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .situatie__linie {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--t-sm);
  }
  .is-restant {
    color: var(--danger);
  }

  .situatie__linie .muted {
    font-size: var(--t-xs);
  }

  .calendar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .etapa {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .etapa:last-child {
    border-bottom: 0;
  }

  /* Numerotarea este reală aici: etapele sunt o secvență cu ordine obligatorie. */
  .etapa__index {
    font-family: var(--serif);
    font-size: var(--t-xl);
    color: var(--border-strong);
    line-height: 1.2;
    flex: none;
    width: 2.2rem;
  }
  .etapa.is-activa .etapa__index {
    color: var(--red);
  }
  .etapa.is-trecuta .etapa__index {
    color: var(--ok);
  }

  .etapa__corp {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .etapa__titlu {
    font-size: var(--t-md);
    font-weight: 600;
  }

  .etapa__interval {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .etapa__descriere {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 70ch;
    text-wrap: pretty;
  }

  .resursa {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--fast) var(--ease);
  }
  .resursa:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }
  .resursa strong {
    font-size: var(--t-sm);
  }
  .resursa .muted {
    font-size: var(--t-xs);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
