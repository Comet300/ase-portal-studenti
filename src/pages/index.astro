---
import StudentLayout from '../layouts/StudentLayout.astro'
import { formatDate, stages, currentStage, studentMilestones, studentRequests } from '../lib/repo'
/* `astro check` does not look inside a frontmatter `return`, so it reports
 * `homeFor` as an unused import. It is not: deleting it leaves the redirect
 * below calling a name that no longer exists, and nothing says so until a
 * teacher opens the page. */
import { homeFor } from '../lib/http'
import { currentYearLabel } from '../lib/years'

/* The student home.
 *
 * Nothing in the portal is readable without a session any more, so this page
 * has one audience. It used to open with a paragraph introducing the portal to
 * a visitor who no longer exists, and a member of the teaching staff was given
 * a student shell with „Cererile mele” in it — a screen that is empty for them.
 * They are sent to their own home instead. */
const u = Astro.locals.user!

if (u.role !== 'student') {
  return Astro.redirect(homeFor(u), 302)
}

const [stageList, currentStageRow, yearLabel, requests, milestones] = await Promise.all([
  stages(),
  currentStage(),
  currentYearLabel(),
  studentRequests(u.id),
  studentMilestones(u.id),
])

const activeRequest = requests.find((c) => c.status === 'approved' || c.status === 'pending')
/* „Următorul termen” has to be in the future.
 *
 * It used to take the first unfinished one, in order, so on 29 July the page
 * announced a milestone from 1 March as the next one. If everything that is
 * left is overdue, that is what is said — the past is not shown as future. */
const unfinished = milestones.filter((j) => j.status !== 'done')
const today = new Date()
today.setHours(0, 0, 0, 0)

const nextMilestone =
  unfinished.find((j) => j.due_on && new Date(j.due_on) >= today) ?? unfinished[0]
const nextMilestoneOverdue = Boolean(
  nextMilestone?.due_on && new Date(nextMilestone.due_on) < today,
)

/**
 * The first sentence on the screen.
 *
 * There used to be a single one for everybody — an introduction to the portal,
 * shown the same way to somebody who does not know it and to a student who
 * comes in for the fifteenth time to see whether they have been answered.
 */
const intro = (() => {
  if (activeRequest?.status === 'approved') {
    return {
      title: activeRequest.title_ro,
      text: `Coordonezi lucrarea cu ${activeRequest.teacher_name}.${
        nextMilestone
          ? nextMilestoneOverdue
            ? ` Termenul „${nextMilestone.title}” a trecut pe ${formatDate(nextMilestone.due_on)}.`
            : ` Următorul termen: ${nextMilestone.title}, ${formatDate(nextMilestone.due_on)}.`
          : ''
      }`,
      action: { href: '/lucrarea-mea', text: 'Vezi termenele lucrării' },
      secondary: { href: '/mesaje', text: 'Scrie coordonatorului' },
    }
  }

  if (activeRequest) {
    return {
      title: `Cererea ta este la ${activeRequest.teacher_name}`,
      text: activeRequest.expires_at
        ? `Ai un răspuns până la ${formatDate(activeRequest.expires_at)}. Dacă nu vine până atunci, cererea se închide singură și poți depune alta.`
        : 'Aștepți răspunsul coordonatorului. Primești un email imediat ce decide.',
      action: { href: '/lucrarea-mea', text: 'Vezi cererea' },
      secondary: { href: '/coordonatori', text: 'Vezi coordonatorii' },
    }
  }

  return {
    title: 'Primul pas: alege-ți coordonatorul',
    text: 'Poți porni de la persoană sau de la temă. Cererea se depune din catalog, iar coordonatorul are o săptămână să răspundă.',
    action: { href: '/coordonatori', text: 'Alege coordonator' },
    secondary: { href: '/ghid', text: 'Citește ghidul' },
  }
})()

const RESOURCES = [
  { title: 'Ghid de redactare', text: 'Structura lucrării, citare, formatare.', href: '/ghid#redactare' },
  { title: 'Regulament privind IA', text: 'Ce este permis și ce trebuie declarat.', href: '/ghid#ia' },
  { title: 'Antiplagiat', text: 'Procedura de verificare și pragurile admise.', href: '/ghid#antiplagiat' },
  { title: 'Formulare', text: 'Cereri, declarații și anexe descărcabile.', href: '/ghid#documente' },
]
---

<StudentLayout
  title={intro.title}
  docTitle="Acasă"
  description={`Sesiunea de Finalizare a Studiilor ${yearLabel} — Facultatea de Marketing, ASE București`}
  active="acasa"
  erou="amplu"
  lede={intro.text}
>
  <a href={intro.action.href} class="btn btn--primary" slot="actiuni">{intro.action.text}</a>
  <a href={intro.secondary.href} class="btn btn--secondary" slot="actiuni">{intro.secondary.text}</a>

  <div class="container stack stack--loose">
    <aside class="situatie">
        <h2 class="situatie__titlu">Situația ta</h2>
        {
          activeRequest ? (
            <>
              <p class="situatie__linie">
                <span class="muted">Coordonator</span>
                <strong>{activeRequest.teacher_name}</strong>
              </p>
              <p class="situatie__linie">
                <span class="muted">Cerere</span>
                <strong>{activeRequest.status === 'approved' ? 'Aprobată' : 'În așteptare'}</strong>
              </p>
              {nextMilestone && (
                <p class="situatie__linie">
                  <span class="muted">
                    {nextMilestoneOverdue ? 'Termen depășit' : 'Următorul termen'}
                  </span>
                  <strong class:list={{ 'is-overdue': nextMilestoneOverdue }}>
                    {nextMilestone.title} · {formatDate(nextMilestone.due_on)}
                  </strong>
                </p>
              )}
            </>
          ) : (
            <>
              <p class="muted text-sm">
                Nu ai încă o cerere activă. Primul pas este să alegi un coordonator și să depui
                cererea de coordonare.
              </p>
              <a href="/coordonatori" class="btn btn--primary btn--sm">Alege coordonator</a>
            </>
          )
      }
    </aside>

    <section class="stack">
      <h2 class="section-title">Calendarul sesiunii</h2>
      <ol class="calendar">
        {
          stageList.map((e, i) => {
            const active = currentStageRow?.id === e.id
            const past = e.ends_on ? new Date(e.ends_on) < new Date() : false
            return (
              <li class:list={['etapa', { 'is-current': active, 'is-past': past }]}>
                <span class="etapa__index numeric" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="etapa__corp">
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <h3 class="etapa__titlu">{e.title}</h3>
                    {active && <span class="badge badge--asteptare">În curs</span>}
                    {past && <span class="badge badge--aprobata">Încheiată</span>}
                  </div>
                  <p class="etapa__interval numeric">{e.interval_label}</p>
                  {e.description && <p class="etapa__descriere">{e.description}</p>}
                </div>
              </li>
            )
          })
        }
      </ol>
    </section>

    <section class="stack">
      <h2 class="section-title">Resurse academice</h2>
      <div class="grid-auto">
        {
          RESOURCES.map((r) => (
            <a href={r.href} class="resursa">
              <strong>{r.title}</strong>
              <span class="muted">{r.text}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</StudentLayout>

<style>
  /* Titlul, fraza și cele două butoane stau acum pe banda de sus, care este
     aceeași pe tot portalul. Aici rămâne doar cartonașul cu situația
     cititorului — prima întrebare a fiecărui student: unde sunt cu cererea. */
  .situatie {
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .situatie__titlu {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .situatie__linie {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--t-sm);
  }
  .is-overdue {
    color: var(--danger);
  }

  .situatie__linie .muted {
    font-size: var(--t-xs);
  }

  .calendar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .etapa {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .etapa:last-child {
    border-bottom: 0;
  }

  /* The numbering is real here: the stages are a sequence in a required order. */
  .etapa__index {
    font-family: var(--serif);
    font-size: var(--t-xl);
    color: var(--border-strong);
    line-height: 1.2;
    flex: none;
    width: 2.2rem;
  }
  .etapa.is-current .etapa__index {
    color: var(--red);
  }
  .etapa.is-past .etapa__index {
    color: var(--ok);
  }

  .etapa__corp {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .etapa__titlu {
    font-size: var(--t-md);
    font-weight: 600;
  }

  .etapa__interval {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .etapa__descriere {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 70ch;
    text-wrap: pretty;
  }

  .resursa {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--fast) var(--ease);
  }
  .resursa:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }
  .resursa strong {
    font-size: var(--t-sm);
  }
  .resursa .muted {
    font-size: var(--t-xs);
  }

</style>
