---
import ProfesorLayout from '../layouts/ProfesorLayout.astro'
import StudentLayout from '../layouts/StudentLayout.astro'

/**
 * The page that does not exist.
 *
 * Until now, a wrong address took the user out of the portal altogether: Astro
 * served its own default page, in English, with its violet palette and without
 * any link back. To somebody who clicked an old link in an email, that looks
 * like a portal that is down.
 *
 * The same page also serves the areas the user has no business in: the text
 * does not confirm that that place exists.
 */

Astro.response.status = 404

const u = Astro.locals.user

/* The wrong address renders in the reader's own shell. A coordinator who
 * mistyped one used to land in the student top bar — and, since the portal has
 * no crossing between the two areas any more, with no way back to their own. */
const Shell = !u || u.role === 'student' ? StudentLayout : ProfesorLayout

const links = u
  ? [
      { href: '/', text: 'Acasă' },
      { href: '/coordonatori', text: 'Coordonatori & Teme' },
      ...(u.role === 'student'
        ? [{ href: '/lucrarea-mea', text: 'Cererile mele' }]
        : [{ href: '/profesor', text: 'Panoul meu' }]),
      { href: '/ghid', text: 'Ghid & Regulament' },
    ]
  : /* Nothing else in the portal opens without a session: a link to „Acasă” or
       to the catalogue would only bounce off the gate and land back here. */
    [
      { href: '/autentificare', text: 'Autentificare' },
      { href: '/confidentialitate', text: 'Ce date păstrăm despre tine' },
    ]
---

<Shell title="Pagina nu a fost găsită" docTitle="404" erou="fara">
  <div class="container">
    <div class="patru04">
      <p class="patru04__cod numeric">404</p>
      <h1 class="page-title">Pagina aceasta nu există</h1>
      <p class="page-lede">
        Se poate să fi fost mutată, sau legătura pe care ai urmat-o să fie dintr-o sesiune
        încheiată. Nimic nu s-a stricat — restul portalului funcționează.
      </p>

      <nav class="patru04__drumuri" aria-label="Unde poți merge">
        {
          links.map((d, i) => (
            <a href={d.href} class:list={['btn', i === 0 ? 'btn--primary' : 'btn--secondary']}>
              {d.text}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</Shell>

<style>
  .patru04 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    max-width: 60ch;
    padding-block: var(--s-8);
  }

  .patru04__cod {
    font-family: var(--serif);
    font-size: var(--t-3xl);
    line-height: 1;
    color: var(--red);
  }

  .patru04__drumuri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
</style>
