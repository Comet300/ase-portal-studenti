---
import StudentLayout from '../layouts/StudentLayout.astro'

/**
 * Pagina care nu există.
 *
 * Până acum, o adresă greșită scotea utilizatorul din portal cu totul: Astro
 * servea pagina lui implicită, în engleză, cu paleta ei violet și fără nicio
 * legătură înapoi. Pentru cineva care a dat clic pe un link vechi dintr-un
 * email, asta arată ca un portal căzut.
 *
 * Aceeași pagină servește și zonele în care utilizatorul nu are ce căuta:
 * textul nu confirmă că locul acela există.
 */

Astro.response.status = 404

const u = Astro.locals.user

const drumuri = u
  ? [
      { href: '/', text: 'Acasă' },
      { href: '/coordonatori', text: 'Coordonatori & Teme' },
      ...(u.role === 'student'
        ? [{ href: '/cererile-mele', text: 'Cererile mele' }]
        : [{ href: '/profesor', text: 'Zona cadrelor didactice' }]),
      { href: '/ghid', text: 'Ghid & Regulament' },
    ]
  : [
      { href: '/', text: 'Acasă' },
      { href: '/coordonatori', text: 'Coordonatori & Teme' },
      { href: '/autentificare', text: 'Autentificare' },
    ]
---

<StudentLayout title="Pagina nu a fost găsită" docTitle="404">
  <div class="container">
    <div class="patru04">
      <p class="patru04__cod numeric">404</p>
      <h1 class="page-title">Pagina aceasta nu există</h1>
      <p class="page-lede">
        Se poate să fi fost mutată, sau legătura pe care ai urmat-o să fie dintr-o sesiune
        încheiată. Nimic nu s-a stricat — restul portalului funcționează.
      </p>

      <nav class="patru04__drumuri" aria-label="Unde poți merge">
        {
          drumuri.map((d, i) => (
            <a href={d.href} class:list={['btn', i === 0 ? 'btn--primary' : 'btn--secondary']}>
              {d.text}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</StudentLayout>

<style>
  .patru04 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    max-width: 60ch;
    padding-block: var(--s-8);
  }

  .patru04__cod {
    font-family: var(--serif);
    font-size: var(--t-3xl);
    line-height: 1;
    color: var(--red);
  }

  .patru04__drumuri {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
</style>
