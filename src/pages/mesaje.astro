---
import Chat from '../components/Chat.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import {
  conversationMessages,
  MESSAGES_PER_PAGE,
  ensureSupervisorConversation,
  markRead,
  myConversation,
  myConversations,
} from '../lib/chat'
import { query } from '../lib/db'

const u = Astro.locals.user!

if (u.role !== 'student') return Astro.redirect('/profesor/mesaje', 302)

// The thread with the supervisor opens on first visit, once a request is approved.
await ensureSupervisorConversation(u.id)

const conversations = await myConversations(u.id, true)
const requested = Astro.url.searchParams.get('conversatie')
const active = requested ? await myConversation(u.id, requested) : (conversations[0] ?? null)

if (active) await markRead(u.id, active.id)
/* How many messages are asked for.
 *
 * The thread opens on the last ones; „mai vechi” doubles the window and anchors
 * to the message that used to be the first, so the reading position is not lost.
 * Capped, so that a hand-written parameter cannot ask for the whole database. */
const requestedCount = Number(Astro.url.searchParams.get('mesaje') ?? '')
const pageSize = Number.isFinite(requestedCount)
  ? Math.min(Math.max(requestedCount, MESSAGES_PER_PAGE), MESSAGES_PER_PAGE * 16)
  : MESSAGES_PER_PAGE

const thread = active
  ? await conversationMessages(u.id, active.id, pageSize)
  : { mesaje: [], olderCount: 0 }
const messages = thread.mesaje

/** Everything exchanged in the open thread, newest first — the files drawer. */
const files = active
  ? (
      await query<{
        id: string
        original_name: string
        size_bytes: string | null
        created_at: string
        uploaded_by: string
      }>(
        `SELECT f.id, f.original_name, f.size_bytes, f.created_at, f.uploaded_by
           FROM files f WHERE f.conversation_id = $1 ORDER BY f.created_at DESC`,
        [active.id],
      )
    ).map((f) => ({ ...f, size_label: fileSize(f.size_bytes) }))
  : []

function fileSize(bytes: string | null): string {
  const n = Number(bytes ?? 0)
  if (!n) return ''
  if (n < 1024) return `${n} B`
  if (n < 1024 * 1024) return `${Math.round(n / 1024)} KB`
  return `${(n / (1024 * 1024)).toFixed(1)} MB`
}
---

<StudentLayout
  title="Mesaje"
  active="mesaje"
  lede="Discuția cu coordonatorul tău. Poți atașa fișiere — capitole, chestionare, date."
>
  <div class="container stack">

    <div class="chat-wrap">
      <Chat
        conversations={conversations}
        active={active}
        messages={messages}
        olderCount={thread.olderCount}
        pageSize={pageSize}
        userId={u.id}
        base="/mesaje"
        files={files}
        emptyText="Firul de discuție se deschide după ce un coordonator îți aprobă cererea."
      />
    </div>
  </div>
</StudentLayout>

<style>
  /* The thread fills its own box, so the page has to give it one: otherwise
     `height: 100%` is measured against a parent with no height, and the page
     scrolls instead of the conversation. */
  .chat-wrap {
    height: min(74vh, 780px);
    min-height: 420px;
  }

  .chat-wrap :global(.chat) {
    height: 100%;
  }
</style>
