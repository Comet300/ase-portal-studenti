---
import Avatar from '../components/Avatar.astro'
import ProfesorLayout from '../layouts/ProfesorLayout.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import { pairings, publicTopics, studentRequests, supervisors } from '../lib/repo'
import { officialName } from '../lib/text'
import { LANGUAGE_LABELS, LEVEL_LABELS, groupLabel, languageLabel } from '../lib/years'

/**
 * The catalogue, from both ends.
 *
 * A student who knows whom they want browses coordinators. A student who knows
 * what they want to write about browses topics and finds the coordinator through
 * one — the far more common case, and the one the previous version had no answer
 * for. Same data, two entry points, one URL parameter apart.
 *
 * Coordinators who have filled their seats stay in the list. Hiding them would
 * answer "why is my professor not here" with silence; showing them greyed, with
 * the students they already supervise, answers it.
 */

const u = Astro.locals.user

/* Whether the reader is still choosing.
 *
 * A student with an approved request is not browsing a catalogue: they have a
 * coordinator, and this screen was showing them „Depune cerere de coordonare”
 * on nine cards they cannot use. The same address answers a different question
 * for them — „unde sunt cu lucrarea, și cu cine” — so it opens on that, and the
 * catalogue stays one click away, readable, without the buttons that would be
 * refused.
 *
 * The seat arithmetic is also personal: `supervisors` and `publicTopics` can
 * compute availability for one reader's level and programme, which is the only
 * honest answer to „mai are locuri” — a coordinator can be full for Marketing
 * online and open for Cercetări de marketing in the same instant. */
const isStudent = u?.role === 'student'
const viewer = isStudent && u ? { programme_id: u.programme_id, program: u.program } : null

const myRequests = isStudent && u ? await studentRequests(u.id) : []
const myCoordination = myRequests.find((r) => r.status === 'approved') ?? null

const view = Astro.url.searchParams.get('vedere') === 'teme' ? 'teme' : 'coordonatori'

const [teachers, allTopics, allPairings] = await Promise.all([
  supervisors({ viewer }),
  publicTopics({ viewer }),
  pairings(),
])

const departments = [...new Set(teachers.map((p) => p.department).filter(Boolean))] as string[]

const topicsByTeacher = new Map<string, typeof allTopics>()
for (const t of allTopics) {
  const list = topicsByTeacher.get(t.teacher_id) ?? []
  list.push(t)
  topicsByTeacher.set(t.teacher_id, list)
}

const studentsByTeacher = new Map<string, typeof allPairings>()
for (const p of allPairings) {
  const list = studentsByTeacher.get(p.teacher_id) ?? []
  list.push(p)
  studentsByTeacher.set(p.teacher_id, list)
}

// A student arrives already belonging to a group; the catalogue opens on their
// own level and language instead of on everything.
const defaultLevel = isStudent ? (u?.program ?? '') : ''
const defaultLanguage = isStudent ? (u?.study_language ?? '') : ''

/* The catalogue is read by both roles — a coordinator looks up who supervises
 * what as often as a student does — so it renders in the reader's own shell. */
const Shell = isStudent ? StudentLayout : ProfesorLayout

const languages = [...new Set(allTopics.map((t) => t.language))]
const freeTeachers = teachers.filter((t) => !t.is_full).length

---

<Shell
  title="Coordonatori & Teme"
  description="Catalogul cadrelor didactice și temele propuse pentru sesiunea în curs"
  active="coordonatori"
  lede={
    myCoordination
      ? 'Cine ce coordonează în sesiunea asta. Lucrarea ta, cu tot ce ai convenit, stă pe „Lucrarea mea”.'
      : 'Alege un cadru didactic și o direcție de cercetare, apoi depune cererea de coordonare. Poți porni de la persoană sau de la temă — și poți propune o temă proprie.'
  }
>
  <div class="container stack stack--loose">

    <nav class="vederi" aria-label="Mod de răsfoire">
      <a href="/coordonatori?vedere=coordonatori" class:list={['vedere', { 'is-activ': view === 'coordonatori' }]}>
        După coordonator
        <span class="vedere__contor numeric">{teachers.length}</span>
      </a>
      <a href="/coordonatori?vedere=teme" class:list={['vedere', { 'is-activ': view === 'teme' }]}>
        După temă
        <span class="vedere__contor numeric">{allTopics.length}</span>
      </a>
    </nav>

    <div class="filtre panel">
      <div class="panel__body filters__row">
        <div class="field filters__search">
          <label class="label" for="cauta">Caută</label>
          <input
            class="input"
            id="cauta"
            type="search"
            placeholder={view === 'teme' ? 'Cuvânt din temă, metodă sau nume…' : 'Nume cadru didactic sau cuvânt din temă…'}
            autocomplete="off"
          />
        </div>
        <div class="field filtre__camp">
          <label class="label" for="nivel">Nivel</label>
          <select class="select" id="nivel">
            <option value="">Licență și master</option>
            {
              Object.entries(LEVEL_LABELS).map(([v, t]) => (
                <option value={v} selected={defaultLevel === v}>{t}</option>
              ))
            }
          </select>
        </div>
        <div class="field filtre__camp">
          <label class="label" for="limba">Limba lucrării</label>
          <select class="select" id="limba">
            <option value="">Toate limbile</option>
            {
              languages.map((l) => (
                <option value={l} selected={defaultLanguage === l}>{LANGUAGE_LABELS[l] ?? l}</option>
              ))
            }
          </select>
        </div>
        {
          view === 'coordonatori' && (
            <div class="field filtre__camp filtre__camp--lat">
              <label class="label" for="departament">Departament</label>
              <select class="select" id="departament">
                <option value="">Toate departamentele</option>
                {departments.map((d) => <option value={d}>{d}</option>)}
              </select>
            </div>
          )
        }
        <label class="doar-libere">
          <input type="checkbox" id="doar-libere" />
          <span>Doar cu locuri libere</span>
        </label>
        {/* To see everything you had to walk three dropdowns back by hand. */}
        <button class="btn btn--ghost btn--sm" type="button" id="goleste-filtre" hidden>
          Golește filtrele
        </button>
      </div>
    </div>

    <p class="muted" id="rezultat" style="font-size:var(--t-sm)" aria-live="polite">
      {
        view === 'teme'
          ? `${allTopics.length} teme propuse`
          : `${teachers.length} cadre didactice · ${freeTeachers} cu locuri libere`
      }
    </p>

    {/* --------------------------------------------------- by coordinator */}
    {
      view === 'coordonatori' && (
        <ul class="lista-coord" id="lista">
          {teachers.map((p) => {
            const theirTopics = topicsByTeacher.get(p.id) ?? []
            const theirStudents = studentsByTeacher.get(p.id) ?? []
            const free = p.bachelor_seats + p.master_seats - (p.bachelor_taken + p.master_taken)
            return (
              <li
                class:list={['coord', { 'is-full': p.is_full }]}
                data-nume={`${p.name} ${p.interests ?? ''}`.toLowerCase()}
                data-departament={p.department ?? ''}
                data-teme={theirTopics.map((t) => `${t.title} ${t.domain ?? ''} ${t.methodology ?? ''}`).join(' ').toLowerCase()}
                data-niveluri={[...new Set(theirTopics.map((t) => t.level))].join(' ')}
                data-limbi={[...new Set(theirTopics.map((t) => t.language))].join(' ')}
                data-liber={p.is_full ? 'nu' : 'da'}
              >
                <div class="coord__head">
                  <Avatar name={p.name} src={p.avatar_path} size="md" href={`/profil/${p.id}`} />
                  <div class="coord__ident">
                    <h2 class="coord__name">
                      <a href={`/profil/${p.id}`}>{p.name}</a>
                    </h2>
                    <p class="muted text-xs">
                      {p.department}
                      {p.office ? ` · ${p.office}` : ''}
                    </p>
                  </div>

                  {p.is_full ? (
                    <span class="badge badge--neutru">Fără locuri disponibile</span>
                  ) : (
                    <span class="badge badge--aprobata">
                      {free} {free === 1 ? 'loc liber' : 'locuri libere'}
                    </span>
                  )}

                  {/* «Depune cerere de coordonare» dispare de îndată ce ai una
                      aprobată: portalul acceptă o singură coordonare pe sesiune,
                      iar butonul ar duce la un formular care refuză. Catalogul
                      rămâne de citit — cine coordonează ce este exact
                      informația pentru care se revine aici. */}
                  {u?.role === 'student' && !myCoordination &&
                    (p.is_full ? (
                      <span class="btn btn--secondary coord__action is-disabled" aria-disabled="true">
                        Fără locuri disponibile
                      </span>
                    ) : (
                      <a class="btn btn--primary coord__action" href={`/lucrarea-mea?coordonator=${p.id}`}>
                        Depune cerere de coordonare
                      </a>
                    ))}
                </div>

                {p.interests && <p class="coord__interests">{p.interests}</p>}

                {theirTopics.length > 0 ? (
                  <ul class="teme">
                    {theirTopics.map((t) => (
                      <li class="tema" data-level={t.level} data-limba={t.language}>
                        <div class="row row--between" style="gap:var(--s-2);align-items:flex-start">
                          <h3 class="tema__titlu">{t.title}</h3>
                          <span class="badge badge--taxon">
                            {LEVEL_LABELS[t.level]}
                            {t.language !== 'ro' ? ` · ${languageLabel(t.language)}` : ''}
                          </span>
                        </div>
                        {t.programme_name && (
                          <p class="muted text-xs">{t.programme_name}</p>
                        )}
                        {t.domain && t.domain !== '—' && (
                          <p class="muted text-xs">Domeniu: {t.domain}</p>
                        )}
                        {t.methodology && t.methodology !== '—' && (
                          <p class="muted text-xs">Metodologie: {t.methodology}</p>
                        )}
                        {u?.role === 'student' && !myCoordination && !p.is_full && (
                          <a
                            class="btn btn--ghost btn--sm tema__alege"
                            href={`/lucrarea-mea?coordonator=${p.id}&tema=${t.id}`}
                          >
                            Alege tema
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="muted" style="font-size:var(--t-sm);padding:var(--s-3) 0">
                    Nu a publicat teme pentru această sesiune. Poți propune o temă proprie în cerere.
                  </p>
                )}

                {theirStudents.length > 0 && (
                  <button
                    class="coord__echipa"
                    type="button"
                    data-echipa={p.id}
                    aria-haspopup="dialog"
                  >
                    <span class="fete">
                      {theirStudents.slice(0, 5).map((s) => (
                        <Avatar name={s.student_name} size="xs" class="fete__fata" />
                      ))}
                      {theirStudents.length > 5 && (
                        <span class="fete__rest numeric">+{theirStudents.length - 5}</span>
                      )}
                    </span>
                    <span class="coord__echipa-text">
                      Coordonează {theirStudents.length}{' '}
                      {theirStudents.length === 1 ? 'student' : 'studenți'} în această sesiune
                    </span>
                  </button>
                )}
              </li>
            )
          })}
        </ul>
      )
    }

    {/* --------------------------------------------------------- by topic */}
    {
      view === 'teme' && (
        <ul class="lista-teme" id="lista">
          {allTopics.map((t) => (
            <li
              class:list={['card-tema', { 'is-full': t.teacher_is_full }]}
              data-nume={`${t.teacher_name} ${t.title} ${t.domain ?? ''} ${t.description ?? ''}`.toLowerCase()}
              data-teme={`${t.title} ${t.domain ?? ''} ${t.methodology ?? ''}`.toLowerCase()}
              data-niveluri={t.level}
              data-limbi={t.language}
              data-liber={t.teacher_is_full ? 'nu' : 'da'}
            >
              <div class="row row--between" style="gap:var(--s-3);align-items:flex-start">
                <h2 class="card-tema__titlu">{t.title}</h2>
                <span class="badge badge--taxon">
                  {LEVEL_LABELS[t.level]}
                  {t.language !== 'ro' ? ` · ${languageLabel(t.language)}` : ''}
                </span>
              </div>

              {t.description && <p class="card-tema__descriere">{t.description}</p>}

              {/* «Locuri pe temă» stătea aici și nu însemna nimic: locurile
                  sunt ale coordonatorului, pe nivel și pe program, iar poarta
                  de la depunere doar pe acelea le-a verificat vreodată. */}
              <dl class="card-tema__detalii">
                {t.programme_name && (
                  <div>
                    <dt>Program de studii</dt>
                    <dd>{t.programme_name}</dd>
                  </div>
                )}
                {t.domain && t.domain !== '—' && (
                  <div>
                    <dt>Domeniu</dt>
                    <dd>{t.domain}</dd>
                  </div>
                )}
                {t.methodology && t.methodology !== '—' && (
                  <div>
                    <dt>Metodologie</dt>
                    <dd>{t.methodology}</dd>
                  </div>
                )}
                <div>
                  <dt>Studenți pe temă</dt>
                  <dd class="numeric">{t.taken}</dd>
                </div>
              </dl>

              <footer class="card-tema__pied">
                <a class="card-tema__profesor" href={`/profil/${t.teacher_id}`}>
                  <Avatar name={t.teacher_name} size="xs" />
                  <span class="stack stack--tight" style="gap:0">
                    <strong>{t.teacher_name}</strong>
                    <small class="muted">{t.department}</small>
                  </span>
                </a>

                {t.teacher_is_full ? (
                  <span class="badge badge--neutru">Coordonator fără locuri</span>
                ) : (
                  u?.role === 'student' && !myCoordination && (
                    <a
                      class="btn btn--primary btn--sm"
                      href={`/lucrarea-mea?coordonator=${t.teacher_id}&tema=${t.id}`}
                    >
                      Alege tema
                    </a>
                  )
                )}
              </footer>
            </li>
          ))}
        </ul>
      )
    }

    {/* The full list of a coordinator's students. A single dialog, filled in
        from the card that was pressed — 9 identical dialogs in the page would
        be 9 copies of the same markup. */}
    <dialog id="dialog-echipa" aria-labelledby="titlu-echipa">
      <div class="echipa">
        <div class="echipa__cap">
          <h2 class="section-title" id="echipa-titlu">Studenți coordonați</h2>
          <button class="btn btn--ghost btn--sm" type="button" data-inchide-echipa aria-label="Închide">✕</button>
        </div>
        <ul class="echipa__lista" id="echipa-lista"></ul>
      </div>
    </dialog>

    {
      teachers.map((p) => {
        const theirStudents = studentsByTeacher.get(p.id) ?? []
        return theirStudents.length > 0 ? (
          <script
            type="application/json"
            data-echipa-date={p.id}
            set:html={JSON.stringify({
              nume: p.name,
              students: theirStudents.map((s) => ({
                id: s.student_id,
                nume: officialName({ name: s.student_name, father_initial: s.father_initial }),
                titlu: s.title_ro,
                /* „Licență · Marketing” said nothing about which cohort: a
                   student reading this list is looking for people in their own
                   year and series, and the whole point of the dialog is to
                   recognise somebody in it. */
                group: groupLabel(s),
              })),
            })}
          />
        ) : null
      })
    }

    {/* It was a plain paragraph, styled unlike every other empty state in the
        portal, which advised unticking a checkbox without putting it within
        reach. */}
    <section class="panel" id="fara-rezultate" hidden>
      <div class="empty">
        <p class="empty__title">Nimic nu corespunde filtrelor</p>
        <p class="empty__text">
          Încearcă un alt cuvânt-cheie sau altă limbă. Dacă ai bifat „doar cu locuri libere”, s-ar
          putea să fie deja toate ocupate — coordonatorii plini rămân în listă.
        </p>
        <button class="btn btn--secondary btn--sm" type="button" id="goleste-filtre-gol">
          Golește filtrele
        </button>
      </div>
    </section>
  </div>
</Shell>

<script>
  /* Filtrarea catalogului.
   *
   * `?vedere=coordonare` nu are catalog: un student cu coordonare aprobată
   * deschide ecranul pe starea lucrării lui, iar câmpurile de mai jos nu există
   * în pagină. Fără ieșirea asta, prima linie de citire arunca — și cu ea
   * cădea tot scriptul, inclusiv dialogul echipei. */
  const search = document.getElementById('cauta') as HTMLInputElement | null
  const level = document.getElementById('nivel') as HTMLSelectElement | null
  const language = document.getElementById('limba') as HTMLSelectElement | null
  const dep = document.getElementById('departament') as HTMLSelectElement | null
  const onlyFree = document.getElementById('doar-libere') as HTMLInputElement | null
  const resultLabel = document.getElementById('rezultat')
  const emptyLabel = document.getElementById('fara-rezultate')
  const cards = [...document.querySelectorAll<HTMLLIElement>('[data-nume]')]
  const isTopicView = new URLSearchParams(location.search).get('vedere') === 'teme'
  const areFiltre = Boolean(search && level && language && onlyFree && resultLabel && emptyLabel)

  function filter() {
    if (!areFiltre) return
    const q = search!.value.trim().toLowerCase()
    const n = level!.value
    const l = language!.value
    const d = dep?.value ?? ''
    let visibleCount = 0

    for (const c of cards) {
      const matchesText =
        !q || (c.dataset.nume ?? '').includes(q) || (c.dataset.teme ?? '').includes(q)
      const matchesDept = !d || c.dataset.departament === d
      const matchesLevel = !n || (c.dataset.niveluri ?? '').includes(n)
      const matchesLanguage = !l || (c.dataset.limbi ?? '').includes(l)
      const matchesFree = !onlyFree!.checked || c.dataset.liber === 'da'
      const visible = matchesText && matchesDept && matchesLevel && matchesLanguage && matchesFree

      c.hidden = !visible
      if (visible) visibleCount++

      // In the coordinator view, the topics that do not match disappear too,
      // so that the list inside the card does not contradict the filter above.
      c.querySelectorAll<HTMLLIElement>('.tema').forEach((t) => {
        const okLevel = !n || t.dataset.level === n
        const okLanguage = !l || t.dataset.limba === l
        t.hidden = !(okLevel && okLanguage)
      })
    }

    resultLabel!.textContent = isTopicView
      ? visibleCount === 1
        ? '1 temă propusă'
        : `${visibleCount} teme propuse`
      : visibleCount === 1
        ? '1 cadru didactic'
        : `${visibleCount} cadre didactice`
    emptyLabel!.hidden = visibleCount > 0
  }

  /* --- the filters live in the address --------------------------------------
   *
   * The most used page in the portal was the only one whose filters never made
   * it into the URL: you could not send a colleague „cei patru coordonatori de
   * master în engleză cu locuri libere”, opening a profile and then Back
   * brought you back to an unfiltered list, and a reload wiped everything. The
   * neighbouring screen, /profesor/facultate, does exactly the same job with
   * GET parameters.
   *
   * `replaceState` on every keystroke would fill the history; it is written
   * after a short pause, and Back/Forward put the controls back. */
  const FILTER_FIELDS: [string, HTMLInputElement | HTMLSelectElement | null][] = [
    ['q', search],
    ['nivel', level],
    ['limba', language],
    ['departament', dep],
  ]

  let timer: ReturnType<typeof setTimeout> | undefined

  function writeUrl() {
    if (!areFiltre) return
    const p = new URLSearchParams(location.search)
    for (const [key, el] of FILTER_FIELDS) {
      if (el?.value) p.set(key, el.value)
      else p.delete(key)
    }
    if (onlyFree?.checked) p.set('libere', '1')
    else p.delete('libere')

    const q = p.toString()
    history.replaceState({}, '', q ? `${location.pathname}?${q}` : location.pathname)
  }

  function readUrl() {
    if (!areFiltre) return
    const p = new URLSearchParams(location.search)
    for (const [key, el] of FILTER_FIELDS) {
      if (el && p.has(key)) el.value = p.get(key) ?? ''
    }
    if (onlyFree) onlyFree.checked = p.get('libere') === '1'
  }

  for (const el of [search, level, language, dep, onlyFree]) {
    el?.addEventListener('input', () => {
      filter()
      clearTimeout(timer)
      timer = setTimeout(writeUrl, 250)
    })
  }

  // An address pasted into the bar has to show exactly the list it describes.
  if (areFiltre) readUrl()

  window.addEventListener('popstate', () => {
    readUrl()
    filter()
  })

  /* --- clearing the filters -----------------------------------------------
   *
   * To see everything you had to walk three dropdowns back by hand. */
  const reset = document.getElementById('goleste-filtre')
  const resetFromEmpty = document.getElementById('goleste-filtre-gol')

  function showReset() {
    if (!areFiltre) return
    const active =
      Boolean(search!.value) ||
      Boolean(level!.value) ||
      Boolean(language!.value) ||
      Boolean(dep?.value) ||
      onlyFree!.checked
    if (reset) reset.hidden = !active
  }

  const goleste = () => {
    if (!areFiltre) return
    search!.value = ''
    level!.value = ''
    language!.value = ''
    if (dep) dep.value = ''
    onlyFree!.checked = false
    filter()
    writeUrl()
    showReset()
    search!.focus()
  }

  reset?.addEventListener('click', goleste)
  resetFromEmpty?.addEventListener('click', goleste)

  for (const el of [search, level, language, dep, onlyFree]) {
    el?.addEventListener('input', showReset)
  }
  showReset()

  /* --- the full list of a coordinator's students -------------------------- */

  const echipa = document.getElementById('dialog-echipa') as HTMLDialogElement | null
  const teamList = document.getElementById('echipa-lista')
  const teamTitle = document.getElementById('echipa-titlu')

  document.querySelectorAll<HTMLButtonElement>('[data-echipa]').forEach((b) => {
    b.addEventListener('click', () => {
      const holder = document.querySelector(`[data-echipa-date="${b.dataset.echipa}"]`)
      if (!holder || !teamList) return

      const date = JSON.parse(holder.textContent ?? '{}')
      if (teamTitle) {
        teamTitle.textContent = `${date.nume} — ${date.students.length} ${
          date.students.length === 1 ? 'student coordonat' : 'studenți coordonați'
        }`
      }

      teamList.replaceChildren(
        ...date.students.map((s: { id: string; nume: string; titlu: string; group: string }) => {
          const li = document.createElement('li')
          const a = document.createElement('a')
          a.href = `/profil/${s.id}`
          a.className = 'echipa__student'
          a.innerHTML =
            `<strong></strong><small class="muted"></small><span class="muted echipa__titlu"></span>`
          a.querySelector('strong')!.textContent = s.nume
          a.querySelector('small')!.textContent = s.group
          a.querySelector('.echipa__titlu')!.textContent = s.titlu
          li.appendChild(a)
          return li
        }),
      )

      echipa?.showModal()
    })
  })

  echipa
    ?.querySelector('[data-inchide-echipa]')
    ?.addEventListener('click', () => echipa.close())

  // The filters start from the student's group, so the first run is not
  // redundant: it applies the level and the language already selected.
  filter()
</script>

<style>
  .vederi {
    display: flex;
    gap: var(--s-1);
    border-bottom: 1px solid var(--border);
  }

  .vedere {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-3);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }
  .vedere:hover {
    color: var(--ink);
  }
