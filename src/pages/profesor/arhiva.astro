---
import AlegeAn from '../../components/AlegeAn.astro'
import Avatar from '../../components/Avatar.astro'
import Metrica from '../../components/Metrica.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import { ROLE_LABELS } from '../../lib/auth'
import { queryOne, query } from '../../lib/db'
import { seatRequests } from '../../lib/lifecycle'
import { STATUS_CLASS, STATUS_LABELS, formatDate, teacherSeats, teacherStats } from '../../lib/repo'
import { allYears, LEVEL_LABELS } from '../../lib/years'

/**
 * Archive and profile.
 *
 * Deliberately not "average grade" and "similarity index": grading is out of the
 * portal's scope, and a similarity percentage without its sources says nothing.
 * These are the numbers a coordinator can actually act on.
 *
 * Seats are shown here but not edited here — they are the department's decision.
 * What a coordinator can do from this page is ask for more, in writing.
 */

const u = Astro.locals.user!
const years = await allYears()
const selectedYear = Astro.url.searchParams.get('an') ?? ''
const year = years.find((y) => y.id === selectedYear) ?? years.find((y) => y.is_current) ?? years[0]
const isCurrent = Boolean(year?.is_current)

const [stats, seats, mySeatRequests] = await Promise.all([
  teacherStats(u.id, year?.id),
  teacherSeats(u.id, year?.id),
  seatRequests({ teacherId: u.id }),
])

const topics = await queryOne<{ proposed: number; taken: number }>(
  `SELECT count(*)::int AS proposed,
          count(*) FILTER (WHERE EXISTS (
            SELECT 1 FROM requests r WHERE r.topic_id = t.id AND r.status = 'approved'
          ))::int AS taken
     FROM topics t WHERE t.teacher_id = $1 AND t.academic_year_id = $2`,
  [u.id, year?.id],
)

const rejected = await query<{
  number: string
  student_name: string
  title_ro: string
  status: string
  rejection_reason: string | null
  decided_at: string | null
}>(
  `SELECT r.number, s.name AS student_name, r.title_ro, r.status, r.rejection_reason, r.decided_at
     FROM requests r
     JOIN users s ON s.id = r.student_id
    WHERE r.teacher_id = $1 AND r.status IN ('rejected', 'expired') AND r.academic_year_id = $2
    ORDER BY r.decided_at DESC NULLS LAST
    LIMIT 20`,
  [u.id, year?.id],
)

const history = await query<{
  number: string
  student_name: string
  title_ro: string
  status: string
  submitted_at: string
  decided_at: string | null
}>(
  `SELECT r.number, s.name AS student_name, r.title_ro, r.status, r.submitted_at, r.decided_at
     FROM requests r
     JOIN users s ON s.id = r.student_id
    WHERE r.teacher_id = $1 AND r.academic_year_id = $2
    ORDER BY r.submitted_at DESC
    LIMIT 100`,
  [u.id, year?.id],
)

const saved = Astro.url.searchParams.get('salvat') === '1'
const openSeatRequest = mySeatRequests.find((r) => r.status === 'pending')
---

<ProfesorLayout
  title="Arhivă & Profil"
  lede="Istoricul cererilor pe ani universitari, locurile alocate și datele profilului tău."
  active="arhiva"
>
  <div slot="actiuni" class="row" style="gap:var(--s-2)">
    <AlegeAn years={years} selected={year?.id ?? ''} base="/profesor/arhiva" />
    {/* Exportul urmează anul ales de pe ecran, nu sesiunea curentă. */}
    <a class="btn btn--secondary btn--sm" href={`/profesor/export-coordonari?doar_ale_mele=1&an=${year?.id ?? ''}`}>
      Descarcă lista (CSV)
    </a>
  </div>

  <div class="stack stack--loose">
    <section class="stack">
      <h2 class="section-title">Sesiunea în cifre</h2>
      <div class="grid-auto">
        {/* „218h” cere o împărțire mentală. Peste două zile se scrie în zile. */}
        <Metrica
          valoare={
            stats?.avg_response_hours == null
              ? '—'
              : stats.avg_response_hours < 48
                ? `${stats.avg_response_hours} h`
                : `${(stats.avg_response_hours / 24).toFixed(1).replace('.', ',')} zile`
          }
          eticheta="timp mediu de răspuns"
          nota="de la depunere până la decizie"
        />
        <Metrica
          valoare={`${topics?.taken ?? 0} / ${topics?.proposed ?? 0}`}
          eticheta="teme preluate"
          nota={
            (topics?.proposed ?? 0) - (topics?.taken ?? 0) > 0
              ? `${(topics?.proposed ?? 0) - (topics?.taken ?? 0)} încă disponibile`
              : 'Toate temele au fost alese'
          }
        />
        <Metrica
          valoare={`${seats.total_taken} / ${seats.total_seats}`}
          eticheta="locuri ocupate"
          alerta={seats.free === 0 && seats.total_seats > 0}
          nota={
            seats.total_seats === 0
              ? 'Directorul nu ți-a alocat încă locuri'
              : seats.free === 0
                ? 'Nu mai apari ca disponibil în catalog'
                : `${seats.free} ${seats.free === 1 ? 'loc liber' : 'locuri libere'}`
          }
        />
        <Metrica
          valoare={(stats?.rejected ?? 0) + (stats?.expired ?? 0)}
          eticheta="cereri neacceptate"
          nota={
            stats?.expired ? `${stats.expired} expirate fără răspuns` : 'toate cu motivul comunicat'
          }
        />
      </div>
    </section>

    {/* ------------------------------------------------------------- locuri */}
    <section class="panel" id="locuri" tabindex="-1">
      <div class="panel__header">
        <h2 class="section-title">Locuri alocate</h2>
        <span class="muted text-sm">{year?.label}</span>
      </div>

      <div class="panel__body stack">
        <dl class="seats">
          <div>
            <dt>Licență</dt>
            <dd class="numeric">{seats.bachelor_taken} / {seats.bachelor_seats}</dd>
          </div>
          <div>
            <dt>Master</dt>
            <dd class="numeric">{seats.master_taken} / {seats.master_seats}</dd>
          </div>
          <div>
            <dt>Libere</dt>
            <dd class="numeric">{seats.free}</dd>
          </div>
        </dl>

        <p class="hint">
          Numărul de locuri este stabilit de directorul de departament. Când sunt toate ocupate,
          apari în catalogul studenților ca <strong>fără locuri disponibile</strong>, împreună cu
          studenții pe care îi coordonezi deja.
        </p>
      </div>

      {
        isCurrent && (
          <div class="panel__footer">
            {openSeatRequest ? (
              <p class="alert">
                Ai o cerere în așteptare pentru <strong>{openSeatRequest.extra_seats}</strong> locuri
                la {LEVEL_LABELS[openSeatRequest.level].toLowerCase()}, trimisă
                {' '}{formatDate(openSeatRequest.created_at)}. Directorul de departament decide.
              </p>
            ) : (
              <form method="POST" action="/api/locuri" class="stack">
                <input type="hidden" name="actiune" value="cere" />
                <div class="row row--wrap" style="gap:var(--s-3);align-items:flex-end">
                  <div class="field" style="min-width:150px">
                    <label class="label" for="nivel">Cere locuri la</label>
                    <select class="select" id="nivel" name="nivel">
                      <option value="bachelor">Licență</option>
                      <option value="master">Master</option>
                    </select>
                  </div>
                  <div class="field" style="min-width:110px">
                    <label class="label" for="locuri">Câte</label>
                    <input class="input" id="locuri" name="locuri" type="number" min="1" max="20" value="2" />
                  </div>
                </div>
                <div class="field">
                  <label class="label" for="motiv">Motivarea cererii</label>
                  <textarea
                    class="textarea"
                    id="motiv"
                    name="motiv"
                    rows="2"
                    minlength="20"
                    required
                    placeholder="Ex: am primit trei cereri peste capacitate, toate pe teme din aria mea de cercetare."
                  data-autogrow />
                  <span class="hint">Directorul decide pe baza acestui text.</span>
                </div>
                <div class="row row--end">
                  <button class="btn btn--secondary" type="submit">Trimite cererea directorului</button>
                </div>
              </form>
            )}

            {mySeatRequests.filter((r) => r.status !== 'pending').length > 0 && (
              <ul class="decizii">
                {mySeatRequests
                  .filter((r) => r.status !== 'pending')
                  .map((r) => (
                    <li>
                      <span class:list={['badge', r.status === 'approved' ? 'badge--aprobata' : 'badge--respinsa']}>
                        {r.status === 'approved' ? 'Aprobată' : 'Respinsă'}
                      </span>
                      <span>
                        {r.extra_seats} locuri la {LEVEL_LABELS[r.level].toLowerCase()} ·{' '}
                        {formatDate(r.decided_at)}
                      </span>
                      {r.decision_note && <span class="muted">„{r.decision_note}”</span>}
                    </li>
                  ))}
              </ul>
            )}
          </div>
        )
      }
    </section>

    {
      rejected.length > 0 && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cereri neacceptate și motivele</h2>
          </div>
          <ul class="rejected">
            {rejected.map((r) => (
              <li>
                <div class="row row--between row--wrap" style="gap:var(--s-2)">
                  <strong>{r.student_name}</strong>
                  <span class="muted numeric text-xs">
                    {r.number} · {formatDate(r.decided_at)}
                  </span>
                </div>
                <p class="muted text-sm">{r.title_ro}</p>
                {r.rejection_reason && <p class="reason">{r.rejection_reason}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Istoricul cererilor</h2>
        <span class="muted text-sm">
          {history.length} {history.length === 1 ? 'înregistrare' : 'înregistrări'} · {year?.label}
        </span>
      </div>
      {
        history.length === 0 ? (
          <div class="empty">
            <p class="empty__title">Nicio cerere în {year?.label}</p>
            <p class="empty__text">
              {isCurrent
                ? 'Istoricul se completează pe măsură ce studenții depun cereri către tine.'
                : 'În acest an universitar nu ai primit cereri prin portal.'}
            </p>
          </div>
        ) : (
          <div class="table-wrap" tabindex="0" role="region" aria-label="Lucrările din arhivă">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Cerere</th>
                  <th scope="col">Student</th>
                  <th scope="col">Titlul lucrării</th>
                  <th scope="col">Stare</th>
                  <th scope="col">Depusă</th>
                  <th scope="col">Decisă</th>
                </tr>
              </thead>
              <tbody>
                {history.map((r) => (
                  <tr>
                    <td class="numeric muted">{r.number}</td>
                    <td>{r.student_name}</td>
                    <td class="cell-title" title={r.title_ro}>{r.title_ro}</td>
                    <td>
                      <span class:list={['badge', STATUS_CLASS[r.status]]}>{STATUS_LABELS[r.status]}</span>
                    </td>
                    <td class="muted">{formatDate(r.submitted_at)}</td>
                    <td class="muted">{formatDate(r.decided_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {/* ------------------------------------------------------------- profil */}
    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Profilul meu</h2>
        {saved && <span class="badge badge--aprobata">Salvat</span>}
      </div>

      <form method="POST" action="/api/cont" enctype="multipart/form-data" class="panel__body stack">
        <div class="row row--wrap" style="gap:var(--s-4);align-items:center">
          <Avatar name={u.name} src={u.avatar_path} size="lg" />
          <div class="field" style="flex:1;min-width:240px">
            <label class="label" for="poza">Poză de profil</label>
            <input class="input" id="poza" name="poza" type="file" accept="image/*" />
            <span class="hint">JPG, PNG, WEBP sau GIF, maximum 2 MB. Studenții o văd în catalog.</span>
          </div>
        </div>

        <div class="row row--wrap" style="gap:var(--s-4)">
          <div class="field" style="flex:2;min-width:240px">
            <label class="label" for="nume">Nume afișat</label>
            <input class="input" id="nume" name="nume" value={u.name} required maxlength="120" />
          </div>
          <div class="field" style="flex:2;min-width:220px">
            <label class="label" for="birou">Birou</label>
            <input class="input" id="birou" name="birou" value={u.office ?? ''} placeholder="Corp Ion Angelescu, etaj 3, sala 2314" />
          </div>
        </div>

        <div class="field">
          <label class="label" for="descriere">Descriere</label>
          <textarea
            class="textarea"
            id="descriere"
            name="descriere"
            rows="3"
            maxlength="1200"
            placeholder="Ce fel de lucrări coordonezi și ce aștepți de la un student. Studenții citesc asta înainte să îți scrie."
            set:text={u.bio ?? ''}
          data-autogrow />
        </div>

        <div class="row row--wrap" style="gap:var(--s-4)">
          <div class="field" style="flex:2;min-width:240px">
            <label class="label" for="interese">Direcții de cercetare</label>
            <input class="input" id="interese" name="interese" value={u.interests ?? ''}
              placeholder="Comportamentul consumatorului · modelare structurală" />
            <span class="hint">Separate prin „·”, apar sub numele tău în catalog.</span>
          </div>
          <div class="field" style="flex:2;min-width:220px">
            <label class="label" for="pagina_web">Pagină web</label>
            <input class="input" id="pagina_web" name="pagina_web" type="url" value={u.website ?? ''}
              placeholder="https://" />
          </div>
        </div>

        <div class="row row--wrap" style="gap:var(--s-4)">
          <div class="field" style="flex:2;min-width:220px">
            <label class="label" for="email">Email instituțional</label>
            <input class="input" id="email" value={u.email} disabled />
            <span class="hint">Adresa cu care te autentifici; nu se poate schimba din portal.</span>
          </div>
          <div class="field" style="flex:1;min-width:200px">
            <label class="label" for="rol">Rol</label>
            <input class="input" id="rol" value={`${ROLE_LABELS[u.role]}${u.department ? ` · ${u.department}` : ''}`} disabled />
          </div>
        </div>

        <div class="row row--between row--wrap" style="gap:var(--s-3)">
          <a class="btn btn--ghost btn--sm" href={`/profil/${u.id}`}>Vezi profilul public</a>
          <button class="btn btn--primary" type="submit">Salvează modificările</button>
        </div>
      </form>
    </section>
  </div>
</ProfesorLayout>

<style>
  .seats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    margin: 0;
  }
  .seats dt {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
  .seats dd {
    margin: 0;
    font-size: var(--t-xl);
    font-weight: 600;
  }

  .alert {
    padding: var(--s-3) var(--s-4);
    background: var(--warn-tint);
    color: var(--warn);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
  }

  .decizii {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    font-size: var(--t-sm);
  }
  .decizii li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .rejected {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rejected li {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--border);
  }
  .rejected li:last-child {
    border-bottom: 0;
  }

  .reason {
    padding: var(--s-3);
    background: var(--danger-tint);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
    color: var(--ink);
    text-wrap: pretty;
  }

  .cell-title {
    max-width: 34ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
