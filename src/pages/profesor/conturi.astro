---
import Avatar from '../../components/Avatar.astro'
import Metrica from '../../components/Metrica.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import Taburi from '../../components/Taburi.astro'
import { query } from '../../lib/db'
import { ACCOUNT_COLUMNS, type ProgrammeChoice } from '../../lib/accounts'
import { formatDate } from '../../lib/repo'
import { numar, officialName } from '../../lib/text'
import { LANGUAGE_LABELS, LEVEL_LABELS, currentYear, programmes } from '../../lib/years'

/**
 * The portal's accounts.
 *
 * The screen that was missing. The portal could move a student between
 * programmes, could change their group and year — but could not bring them into
 * being: the only `INSERT INTO users` in the whole project was in a seed script.
 * A cohort was populated by running that script on production, and whoever had
 * one wrong letter in their address stayed locked out forever.
 *
 * Here they are added one by one, or brought in by the hundred from the
 * registrar's own file — which never has the portal's columns, in the portal's
 * order, and is mapped onto them on the third tab. Addresses are corrected
 * here, and access is closed for those who leave — without deleting anything
 * they did, because this is an academic register.
 */

const SECTIONS = ['toti', 'adauga', 'import'] as const
const requestedSection = Astro.url.searchParams.get('sectiune') ?? ''
const sectiune = (SECTIONS as readonly string[]).includes(requestedSection)
  ? requestedSection
  : 'toti'

const searchQuery = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase()
const roleFilter = Astro.url.searchParams.get('rol') ?? ''
const showInactive = Astro.url.searchParams.get('inactivi') === '1'

const conturi = await query<{
  id: string
  name: string
  email: string
  role: 'student' | 'teacher' | 'head'
  student_number: string | null
  specialization: string | null
  study_year: number | null
  study_group: string | null
  study_series: string | null
  father_initial: string | null
  first_login_at: string | null
  avatar_path: string | null
  is_active: boolean
  deactivated_at: string | null
  created_at: string
  coordonari: number
}>(
  `SELECT u.id, u.name, u.email, u.role, u.student_number, u.specialization,
          u.study_year, u.study_group, u.study_series, u.father_initial,
          u.first_login_at::text, u.avatar_path, u.is_active,
          u.deactivated_at::text, u.created_at::text,
          (SELECT count(*)::int FROM requests r
            WHERE (r.student_id = u.id OR r.teacher_id = u.id) AND r.status = 'approved') AS coordonari
     FROM users u
    ORDER BY u.is_active DESC, u.role, u.name`,
)

const visibleAccounts = conturi.filter((o) => {
  if (!showInactive && !o.is_active) return false
  if (roleFilter && o.role !== roleFilter) return false
  if (searchQuery) {
    const tot = `${officialName(o)} ${o.email} ${o.student_number ?? ''} ${o.specialization ?? ''} ${o.study_series ?? ''}`
    if (!tot.toLowerCase().includes(searchQuery)) return false
  }
  return true
})

const activeAccounts = conturi.filter((o) => o.is_active)
const total = {
  studenti: activeAccounts.filter((o) => o.role === 'student').length,
  cadre: activeAccounts.filter((o) => o.role !== 'student').length,
  closed: conturi.length - activeAccounts.length,
  withoutSupervision: activeAccounts.filter((o) => o.role === 'student' && o.coordonari === 0).length,
  /* The address is corrected on this screen, and this is the number that says
   * which addresses need looking at: an account nobody ever signed in with is
   * usually one wrong letter, and the person is waiting for a link that cannot
   * arrive. */
  neverUsed: activeAccounts.filter((o) => !o.first_login_at).length,
}

const an = await currentYear()
const yearProgrammes = an ? (await programmes(an.id)).filter((p) => p.is_active) : []

const ROLE_TEXT: Record<string, string> = {
  student: 'Student',
  teacher: 'Cadru didactic',
  head: 'Director de departament',
}

const backUrl = Astro.url.pathname + Astro.url.search

const sections = [
  { key: 'toti', text: 'Toate conturile', count: visibleAccounts.length },
  { key: 'adauga', text: 'Adaugă o persoană', count: null },
  { key: 'import', text: 'Importă o promoție', count: null },
]

/* What the mapping screen needs in the browser, and cannot ask the server for.
 *
 * The programmes are here so that „Program” can be chosen from the real list
 * instead of typed — a typo there orphans a whole cohort — and the addresses so
 * that „există deja” is shown on the row, before the write, rather than counted
 * in a message afterwards. Both are already on this screen for this same
 * person; nothing new is disclosed. `<` is escaped because a programme name
 * ending up as `</script>` would close the island. */
const programmeChoices: ProgrammeChoice[] = yearProgrammes.map((p) => ({
  level: p.level,
  name: p.name,
  language: p.language,
  label: `${LEVEL_LABELS[p.level]} · ${p.name} · ${LANGUAGE_LABELS[p.language]}`,
}))
const importData = JSON.stringify({
  programme: programmeChoices,
  existing: conturi.map((o) => o.email.toLowerCase()),
}).replace(/</g, '\\u003c')
---

<ProfesorLayout
  title="Conturi"
  lede="Cine are acces la portal și cu ce adresă. Aici se deschid conturi pentru o promoție nouă, se corectează adresele greșite și se închide accesul celor care pleacă."
  active="conturi"
>
  <Taburi
    taburi={sections.map((s) => ({ ...s, href: `/profesor/conturi?sectiune=${s.key}` }))}
    activ={sectiune}
    eticheta="Secțiuni"
  />

  {
    sectiune === 'toti' && (
      <div class="stack stack--loose">
        <div class="grid-auto">
          <Metrica value={total.studenti} label="studenți cu acces" />
          <Metrica value={total.cadre} label="cadre didactice" />
          <Metrica
            value={total.withoutSupervision}
            label="studenți fără coordonare"
            alerta={total.withoutSupervision > 0}
          />
          <Metrica
            value={total.neverUsed}
            label="conturi nefolosite niciodată"
            note="verifică adresa"
            alerta={total.neverUsed > 0}
          />
          <Metrica value={total.closed} label="conturi închise" />
        </div>

        <form method="GET" class="panel">
          <input type="hidden" name="sectiune" value="toti" />
          <div class="panel__body row row--wrap" style="gap:var(--s-3);align-items:flex-end">
            <div class="field" style="flex:2;min-width:220px">
              <label class="label" for="q">Caută</label>
              <input class="input" id="q" name="q" type="search" value={searchQuery}
                placeholder="Nume, adresă sau număr matricol…" />
            </div>
            <div class="field" style="min-width:180px">
              <label class="label" for="rol">Rol</label>
              <select class="select" id="rol" name="rol">
                <option value="">Toate rolurile</option>
                {Object.entries(ROLE_TEXT).map(([v, t]) => (
                  <option value={v} selected={roleFilter === v}>{t}</option>
                ))}
              </select>
            </div>
            <label class="doar-libere">
              <input type="checkbox" name="inactivi" value="1" checked={showInactive} />
              <span>Arată și conturile închise</span>
            </label>
            <button class="btn btn--secondary" type="submit">Filtrează</button>
          </div>
        </form>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Conturi</h2>
            <span class="muted text-sm">{numar(visibleAccounts.length, 'persoană', 'persoane')}</span>
          </div>

          {visibleAccounts.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Niciun cont pentru filtrele alese</p>
              <p class="empty__text">
                Schimbă rolul sau golește căutarea. Dacă portalul e gol, promoția se aduce
                dintr-un fișier de la secretariat — una câte una doar pentru cazurile rămase.
              </p>
              <a class="btn btn--primary btn--sm" href="/profesor/conturi?sectiune=import">
                Importă o promoție
              </a>
            </div>
          ) : (
            <div class="table-wrap" tabindex="0" role="region" aria-label="Conturile portalului">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Persoană</th>
                    <th scope="col">Adresă</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Grupă</th>
                    <th scope="col">Stare</th>
                    <th scope="col"><span class="visually-hidden">Acțiuni</span></th>
                  </tr>
                </thead>
                <tbody>
                  {visibleAccounts.map((o) => (
                    <>
                    <tr id={`cont-${o.id}`} class:list={{ 'is-inchis': !o.is_active }}>
                      <td>
                        <div class="row" style="gap:var(--s-3)">
                          <Avatar name={o.name} src={o.avatar_path} size="xs" href={`/profil/${o.id}`} />
                          <div class="stack stack--tight" style="gap:0">
                            <strong>{officialName(o)}</strong>
                            {o.student_number && <span class="muted text-xs">{o.student_number}</span>}
                          </div>
                        </div>
                      </td>
                      <td class="muted celula-email">{o.email}</td>
                      <td class="muted">{ROLE_TEXT[o.role]}</td>
                      <td class="muted text-xs">
                        {o.role === 'student'
                          ? [
                              o.specialization,
                              o.study_year ? `anul ${o.study_year}` : null,
                              o.study_series ? `seria ${o.study_series}` : null,
                              o.study_group,
                            ].filter(Boolean).join(' · ') || '—'
                          : '—'}
                      </td>
                      <td>
                        {/* „Nu a intrat” sits beside „Acces”, not instead of
                            it: the two say different things, and an account
                            that is open but has never been used is the one
                            whose address is worth re-reading. Never a date —
                            the privacy notice keeps presence inside a
                            coordination. */}
                        {o.is_active ? (
                          <span class="stack stack--tight" style="gap:2px">
                            <span class="badge badge--aprobata">Acces</span>
                            {!o.first_login_at && (
                              <span class="badge badge--asteptare">Nu a intrat niciodată</span>
                            )}
                          </span>
                        ) : (
                          <span class="badge badge--neutru" title={`Închis ${formatDate(o.deactivated_at)}`}>
                            Închis
                          </span>
                        )}
                      </td>
                      <td style="text-align:right">
                        <button class="btn btn--ghost btn--sm" type="button"
                          data-editeaza={o.id} aria-expanded="false">
                          Editează
                        </button>
                      </td>
                    </tr>

                    {/* The editing row, as on „Studenții facultății”: across the
                        full width, opened only when needed. The address and the
                        access sit together, because both decide whether the
                        person can get in. */}
                    <tr class="editor-rand" id={`editor-${o.id}`} hidden>
                      <td colspan="6">
                        <div class="editor">
                          <form method="POST" action="/api/conturi" class="editor__adresa">
                            <input type="hidden" name="actiune" value="schimba_email" />
                            <input type="hidden" name="utilizator_id" value={o.id} />
                            <input type="hidden" name="redirect" value={`${backUrl}#cont-${o.id}`} />
                            <div class="field" style="flex:1;min-width:240px">
                              <label class="label" for={`email-${o.id}`}>Adresă de email</label>
                              <input class="input" id={`email-${o.id}`} name="email" type="email"
                                value={o.email} required />
                              <span class="hint">
                                Autentificarea trece exclusiv prin ea. Schimbarea invalidează
                                linkurile de acces trimise până acum.
                              </span>
                            </div>
                            <button class="btn btn--primary btn--sm" type="submit">Salvează adresa</button>
                          </form>

                          <form method="POST" action="/api/conturi" class="editor__acces">
                            <input type="hidden" name="actiune"
                              value={o.is_active ? 'dezactiveaza' : 'reactiveaza'} />
                            <input type="hidden" name="utilizator_id" value={o.id} />
                            <input type="hidden" name="redirect" value={`${backUrl}#cont-${o.id}`} />
                            <p class="hint" style="margin:0">
                              {o.is_active
                                ? `Închiderea accesului nu șterge nimic: cele ${o.coordonari} coordonări și tot ce a scris rămân în arhivă.`
                                : 'Redeschiderea accesului îi permite din nou să ceară un link de intrare.'}
                            </p>
                            <button
                              class:list={['btn', 'btn--sm', o.is_active ? 'btn--danger' : 'btn--secondary']}
                              type="submit"
                            >
                              {o.is_active ? 'Închide accesul' : 'Redeschide accesul'}
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                    </>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    )
  }

  {
    sectiune === 'adauga' && (
      <div class="stack stack--loose">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Un singur cont</h2>
          </div>
          <form method="POST" action="/api/conturi" class="panel__body stack">
            <input type="hidden" name="actiune" value="adauga" />
            <input type="hidden" name="redirect" value="/profesor/conturi?sectiune=toti" />

            <div class="row row--wrap" style="gap:var(--s-3)">
              <div class="field" style="flex:2;min-width:220px">
                <label class="label" for="nume">Nume complet</label>
                <input class="input" id="nume" name="nume" required placeholder="Ex: Ioana Dumitru" />
              </div>
              <div class="field" style="flex:2;min-width:240px">
                <label class="label" for="email">Adresă de email</label>
                <input class="input" id="email" name="email" type="email" required
                  placeholder="ioana.dumitru@stud.ase.ro" />
              </div>
              <div class="field" style="min-width:190px">
                <label class="label" for="rol">Rol</label>
                <select class="select" id="rol" name="rol">
                  <option value="student">Student</option>
                  <option value="teacher">Cadru didactic</option>
                  <option value="head">Director de departament</option>
                </select>
              </div>
            </div>

            <div class="row row--wrap" style="gap:var(--s-3)">
              <div class="field" style="min-width:180px">
                <label class="label" for="numar_matricol">Număr matricol</label>
                <input class="input" id="numar_matricol" name="numar_matricol" placeholder="MK-2025-0142" />
                <span class="hint">Doar pentru studenți.</span>
              </div>
              <div class="field" style="flex:1;min-width:200px">
                <label class="label" for="program">Program de studiu</label>
                <select class="select" id="program" name="program">
                  <option value="">—</option>
                  {/* The value is the whole label, not the bare name: „Marketing”
                      exists at licență in Romanian and at master in English, and
                      one of those two cohorts would have been tied to the other
                      programme without anything reporting it. */}
                  {programmeChoices.map((p) => <option value={p.label}>{p.label}</option>)}
                </select>
              </div>
              <div class="field" style="min-width:110px">
                <label class="label" for="an">An</label>
                <input class="input input--num" id="an" name="an" type="number" min="1" max="6" />
              </div>
              <div class="field" style="min-width:110px">
                <label class="label" for="serie">Serie</label>
                <input class="input" id="serie" name="serie" placeholder="B" />
              </div>
              <div class="field" style="min-width:140px">
                <label class="label" for="grupa">Grupa</label>
                <input class="input" id="grupa" name="grupa" placeholder="RO-1503" />
              </div>
            </div>

            <div class="row row--wrap" style="gap:var(--s-3)">
              <div class="field" style="min-width:180px">
                <label class="label" for="initiala_tatalui">Inițiala tatălui</label>
                <input class="input" id="initiala_tatalui" name="initiala_tatalui"
                  maxlength="3" placeholder="I" />
                <span class="hint">
                  Face parte din numele oficial: „Popescu I. Maria”. Una sau două litere.
                </span>
              </div>
            </div>

            <div class="row row--end">
              <button class="btn btn--primary" type="submit">Deschide contul</button>
            </div>
          </form>
        </section>

        <p class="hint">
          Pentru o promoție întreagă, fișierul de la secretariat se încarcă în
          <a href="/profesor/conturi?sectiune=import">Importă o promoție</a>: acolo alegi
          ce coloană din fișier intră în ce câmp, iar rândurile se văd înainte de a fi scrise.
        </p>
      </div>
    )
  }

  {
    sectiune === 'import' && (
      <form method="POST" action="/api/conturi" class="stack stack--loose" data-import>
        <input type="hidden" name="actiune" value="importa" />
        <input type="hidden" name="redirect" value="/profesor/conturi?sectiune=toti" />

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">1. Fișierul de la secretariat</h2>
          </div>
          <div class="panel__body stack">
            <p class="hint">
              Fișierul nu pleacă din calculatorul tău: e citit aici, în pagină, iar la final
              se trimit doar rândurile de mai jos. <strong>.xlsx</strong> este formatul cel mai
              sigur — un .csv salvat din Excel pe Windows românesc scrie „ș” și „ț” în alt
              alfabet, iar portalul îți spune ce codificare a găsit și te lasă să o schimbi.
            </p>

            <div class="row row--wrap" style="gap:var(--s-5);align-items:flex-start">
              <div class="field" style="flex:1;min-width:260px">
                <label class="label" for="import-fisier">Fișierul</label>
                <input class="input" id="import-fisier" type="file" accept=".xlsx,.csv,.txt,.tsv" />
                <span class="hint">Excel (.xlsx), CSV sau text separat prin tab.</span>
              </div>
              <div class="field" style="flex:1;min-width:260px">
                <label class="label" for="import-lipire">Sau coloanele lipite din Excel</label>
                <textarea class="textarea" id="import-lipire" rows="4" spellcheck="false"
                  placeholder="Selectezi coloanele în Excel, Ctrl+C, apoi Ctrl+V aici."></textarea>
                <span class="hint">Merge la fel: și lipirea trece prin potrivirea coloanelor.</span>
              </div>
            </div>

            <p class="muted text-sm" id="import-stare" role="status" aria-live="polite"></p>
            <p class="error-text" id="import-eroare" role="alert" hidden></p>

            {/* Reading the file and mapping the columns both happen in the page.
                Without JavaScript steps 2 and 3 have nothing to show and the file
                field is a button that does nothing — so it is said, not hidden. */}
            <noscript>
              <p class="hint">
                Fișierul se citește în pagină, cu JavaScript. Fără el, scrie sau lipește
                rândurile direct în caseta „Rândurile care se trimit”, de la pasul 4.
              </p>
            </noscript>

            <div class="field" id="import-codificare-camp" style="max-width:340px" hidden>
              <label class="label" for="import-codificare">Codificarea fișierului</label>
              <select class="select" id="import-codificare">
                <option value="">Cea găsită de portal</option>
                <option value="utf-8">UTF-8</option>
                <option value="windows-1250">Windows-1250 (Europa Centrală)</option>
                <option value="windows-1252">Windows-1252 (Europa Occidentală)</option>
              </select>
              <span class="hint">
                Dacă numele se citesc „Ştefãnescu” în loc de „Ștefănescu”, alege altă
                codificare: fișierul se recitește pe loc.
              </span>
            </div>
          </div>
        </section>

        <section class="panel" id="pas-foaie" hidden>
          <div class="panel__header">
            <h2 class="section-title">2. Foaia și capul de tabel</h2>
          </div>
          <div class="panel__body stack">
            <div class="row row--wrap" style="gap:var(--s-4);align-items:flex-end">
              <div class="field" id="import-foaie-camp" style="min-width:240px" hidden>
                <label class="label" for="import-foaie">Foaia</label>
                <select class="select" id="import-foaie"></select>
              </div>
              <div class="field" style="min-width:200px">
                <label class="label" for="import-sari">Sari peste primele rânduri</label>
                <input class="input input--num" id="import-sari" type="number" min="0" max="50" value="0" />
                <span class="hint">Titlul și antetul dublu de deasupra tabelului.</span>
              </div>
              <label class="check" style="min-height:var(--tap);align-items:center">
                <input type="checkbox" id="import-cap" checked />
                <span>Primul rând este cap de tabel</span>
              </label>
            </div>

            <div class="table-wrap" tabindex="0" role="region" aria-label="Primele rânduri din fișier">
              <table class="table">
                <thead><tr id="import-antet"></tr></thead>
                <tbody id="import-primele"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section class="panel" id="pas-potrivire" hidden>
          <div class="panel__header">
            <h2 class="section-title">3. Ce coloană intră în ce câmp</h2>
          </div>
          <div class="panel__body stack">
            <p class="hint">
              Portalul ghicește după capul de tabel; exemplul din dreapta arată exact ce se va
              scrie pentru primul om din listă. Un câmp poate lua <strong>mai multe coloane</strong>
              — numele de familie și prenumele, în ordinea pe care o alegi — sau
              <strong>aceeași valoare pentru toți</strong>, pentru ce nu există ca o coloană în
              fișier: rolul, programul, anul.
            </p>

            <div class="potrivire" id="potrivire">
              <div class="potrivire__cap">
                <span>Câmp</span>
                <span>Din ce se compune</span>
                <span>Exemplu din primul rând</span>
              </div>
            </div>

            <p class="hint hint--atentie" id="potrivire-stare" role="status" hidden></p>
          </div>
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">4. Ce conturi se vor deschide</h2>
            <span class="muted text-sm" id="previzualizare-sumar"></span>
          </div>
          <div class="panel__body stack">
            <div class="field">
              <label class="label" for="randuri">Rândurile care se trimit</label>
              <textarea class="textarea" id="randuri" name="randuri" rows="4" required spellcheck="false"
                placeholder={`${ACCOUNT_COLUMNS.join(';')}
Dumitru Ioana;ioana.dumitru@stud.ase.ro;student;MK-2025-0142;Marketing;3;RO-1503;B;I`}
                data-autogrow />
              <span class="hint">
                Se completează singură din pașii de mai sus, dar rămâne a ta: poți scrie sau
                lipi direct aici, un rând pe persoană, câmpuri separate prin <strong>;</strong>
                sau prin tab. Portalul citește din nou acest text la trimitere — el este ce se
                scrie, nu tabelul de mai jos.
              </span>
            </div>

            {/* The preview, drawn by the reader the route runs. A list from the
                registrar always has two rows that cannot be read; those have to
                be seen — and corrected on the spot — before two hundred accounts
                are created. Whoever is already in the portal is marked here, not
                counted in a message afterwards: „12 existau deja” reads as
                success and names nobody. */}
            <div id="previzualizare" hidden>
              <div class="table-wrap" tabindex="0" role="region" aria-label="Rândurile citite">
                <table class="table">
                  <thead><tr id="previzualizare-cap"></tr></thead>
                  <tbody id="previzualizare-corp"></tbody>
                </table>
              </div>
              <div id="respinse" hidden>
                <p class="respinse__titlu">Rânduri care nu se pot scrie</p>
                <ul class="respinse__lista" id="respinse-lista"></ul>
              </div>
            </div>

            <div class="row row--end" style="gap:var(--s-2)">
              <button class="btn btn--secondary" type="button" id="verifica-randuri">
                Verifică rândurile
              </button>
              <button class="btn btn--primary" type="submit" id="trimite-import">
                Deschide conturile
              </button>
            </div>
          </div>
        </section>

        <script type="application/json" id="date-import" is:inline set:html={importData} />
      </form>
    )
  }
</ProfesorLayout>

<script>
  import { start as startImport } from '../../scripts/import-mapping'

  /* --- the editing row, one at a time -------------------------------------- */
  document.querySelectorAll<HTMLButtonElement>('[data-editeaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const rand = document.getElementById(`editor-${b.dataset.editeaza}`)
      if (!rand) return
      const wasOpen = !rand.hidden
      document.querySelectorAll<HTMLElement>('.editor-rand').forEach((r) => (r.hidden = true))
      document.querySelectorAll<HTMLButtonElement>('[data-editeaza]')
        .forEach((x) => x.setAttribute('aria-expanded', 'false'))
      if (wasOpen) return
      rand.hidden = false
      b.setAttribute('aria-expanded', 'true')
      rand.querySelector<HTMLInputElement>('input[name="email"]')?.focus()
    })
  })

  /* --- the import: a file, a mapping, a preview ----------------------------- *
   *
   * All of it in one module, because the four steps share one state — the
   * parsed file — and a wizard split across screens would lose it at the first
   * navigation. It composes into the `randuri` box and stops there: the route
   * reads that text again with the same reader, as it did when the only way in
   * was a paste. */
  startImport()
</script>

