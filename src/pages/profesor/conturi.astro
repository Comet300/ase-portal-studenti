---
/**
 * The address the accounts screen answered at.
 *
 * It held two administrations that are never done by the same person at the
 * same moment: the students of a cohort, and the teaching staff. They live
 * where each is already listed — students on „Studenții facultății”, with the
 * two tabs that bring them in one by one or by the hundred; the staff on
 * „Departament”, beside the seats they are given.
 *
 * The address stays because it is in bookmarks and in the sidebar of anyone who
 * has the page open right now. `?sectiune=` travels with it: whoever was on the
 * import lands on the import.
 */
const sectiune = Astro.url.searchParams.get('sectiune')
const tinta =
  sectiune === 'adauga' || sectiune === 'import'
    ? `/profesor/facultate?sectiune=${sectiune}`
    : '/profesor/facultate'

return Astro.redirect(tinta, 301)
---
