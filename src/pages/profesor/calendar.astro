---
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import { currentStage, formatDate, stages } from '../../lib/repo'

/**
 * Editing the session calendar.
 *
 * These stages are the spine every other screen navigates by, and the .ics that
 * students download is generated from them — so a date changed here is a date
 * changed everywhere, including in calendars people have already subscribed to.
 */

const [list, current] = await Promise.all([stages(), currentStage()])
const today = new Date().toISOString().slice(0, 10)
const currentYear = new Date().getFullYear()

/**
 * What can be read off a row without opening it.
 *
 * The row showed the title and the „interval afișat” — free text, written by
 * hand, that nobody checks — and nothing else. The real dates, the ones that end
 * up in the calendar file and that decide which stage is „în curs”, were visible
 * only after you opened the form, stage by stage. A stage with no dates looked
 * exactly like a complete one, even though it does not appear in the .ics and can
 * never be the current one.
 *
 * It is computed here, once, what has to be visible: what state the stage is in,
 * whether it has dates, and whether the manual order (the arrows) contradicts
 * the order of the dates.
 */
type StageState = 'fara-date' | 'trecuta' | 'curenta' | 'viitoare'

const STATE_LABELS: Record<StageState, { text: string; badgeClass: string }> = {
  'fara-date': { text: 'Fără date', badgeClass: 'badge--urgent' },
  trecuta: { text: 'Încheiată', badgeClass: 'badge--neutru' },
  curenta: { text: 'În curs', badgeClass: 'badge--asteptare' },
  viitoare: { text: 'Urmează', badgeClass: 'badge--info' },
}

const etape = list.map((s, i) => {
  const inceput = s.starts_on?.slice(0, 10) ?? ''
  const sfarsit = s.ends_on?.slice(0, 10) ?? ''
  const state: StageState = !inceput || !sfarsit
    ? 'fara-date'
    : current?.id === s.id
      ? 'curenta'
      : sfarsit < today
        ? 'trecuta'
        : 'viitoare'

  // Two contradictions that the position in the list does not show on its own.
  const reversed = Boolean(inceput && sfarsit && inceput > sfarsit)
  const previousStage = i > 0 ? list[i - 1] : null
  const outOfOrder = Boolean(
    inceput && previousStage?.starts_on && inceput < previousStage.starts_on.slice(0, 10),
  )

  return { ...s, inceput, sfarsit, state, reversed, outOfOrder }
})

const fara = etape.filter((e) => e.state === 'fara-date').length
const conflicts = etape.filter((e) => e.reversed || e.outOfOrder).length
---

<ProfesorLayout
  title="Calendarul sesiunii"
  lede="Etapele după care se orientează studenții și cadrele didactice. Sunt folosite și în fișierul de calendar descărcabil."
  active="calendar"
>
  <div class="stack stack--loose">
    {
      list.length > 0 && !current && (
        <p class="alert">
          Nicio etapă nu este în curs la data de astăzi ({formatDate(today)}). Studenții văd tot
          calendarul ca încheiat.
        </p>
      )
    }

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Etape</h2>
        <span class="muted text-sm">
          {list.length} etape
          {fara > 0 && ` · ${fara} fără date`}
          {conflicts > 0 && ` · ${conflicts} cu date contradictorii`}
        </span>
      </div>

      {
        list.length === 0 ? (
          <div class="empty">
            <p class="empty__title">Calendarul este gol</p>
            <p class="empty__text">
              Adaugă prima etapă mai jos. Fără etape, pagina de start a studenților rămâne fără
              reperele sesiunii.
            </p>
          </div>
        ) : (
          <ol class="stages">
            {etape.map((s, i) => (
              <li class:list={['stage', `is-${s.state}`]}>
                <div class="stage__order">
                  <span class="numeric">{String(i + 1).padStart(2, '0')}</span>
                  <div class="stage__move">
                    <form method="POST" action="/api/etape">
                      <input type="hidden" name="actiune" value="muta" />
                      <input type="hidden" name="etapa_id" value={s.id} />
                      <input type="hidden" name="directie" value="sus" />
                      <button class="btn btn--ghost btn--sm" type="submit" aria-label="Mută mai sus" disabled={i === 0}>↑</button>
                    </form>
                    <form method="POST" action="/api/etape">
                      <input type="hidden" name="actiune" value="muta" />
                      <input type="hidden" name="etapa_id" value={s.id} />
                      <input type="hidden" name="directie" value="jos" />
                      <button class="btn btn--ghost btn--sm" type="submit" aria-label="Mută mai jos" disabled={i === etape.length - 1}>↓</button>
                    </form>
                  </div>
                </div>

                <details class="stage__body">
                  <summary>
                    <span class="stage__ident">
                      <span class="stage__title">{s.title}</span>
                      {/* The hand-written label and the real dates, side by side:
                          they are different things and may not agree. */}
                      <span class="stage__days numeric">
                        {s.inceput && s.sfarsit
                          ? `${formatDate(s.inceput)} – ${formatDate(s.sfarsit)}`
                          : 'nicio dată — nu intră în calendarul descărcabil'}
                      </span>
                    </span>
                    <span class="stage__meta">
                      <span class="muted">{s.interval_label}</span>
                      <span class:list={['badge', STATE_LABELS[s.state].badgeClass]}>
                        {STATE_LABELS[s.state].text}
                      </span>
                      {s.reversed && (
                        <span class="badge badge--urgent" title="Data de început este după cea de sfârșit">
                          Interval inversat
                        </span>
                      )}
                      {!s.reversed && s.outOfOrder && (
                        <span class="badge badge--urgent" title="Începe înaintea etapei de deasupra ei">
                          Înaintea celei de sus
                        </span>
                      )}
                    </span>
                  </summary>

                  <form method="POST" action="/api/etape" class="stage__form">
                    {/* The name differs from the buttons' on purpose: two „actiune”
                        fields in the same form would both be submitted, in document
                        order, and `form.get` returns the first value — that is,
                        never the one of the button that was pressed. Deleting was
                        impossible. */}
                    <input type="hidden" name="actiune_implicita" value="actualizeaza" />
                    <input type="hidden" name="etapa_id" value={s.id} />

                    <div class="row row--wrap" style="gap:var(--s-3)">
                      <div class="field" style="flex:2;min-width:240px">
                        <label class="label" for={`titlu-${s.id}`}>Titlu</label>
                        <input class="input" id={`titlu-${s.id}`} name="titlu" value={s.title} required />
                      </div>
                      <div class="field" style="flex:2;min-width:220px">
                        <label class="label" for={`interval-${s.id}`}>Interval afișat</label>
                        <input class="input" id={`interval-${s.id}`} name="interval" value={s.interval_label} required />
                        <span class="hint">Textul citit de studenți, ex. „Mai {currentYear}”.</span>
                      </div>
                    </div>

                    <div class="row row--wrap" style="gap:var(--s-3)">
                      <div class="field" style="flex:1;min-width:170px">
                        <label class="label" for={`inceput-${s.id}`}>Începe</label>
                        <input class="input" id={`inceput-${s.id}`} name="inceput" type="date" value={s.starts_on?.slice(0, 10) ?? ''} />
                      </div>
                      <div class="field" style="flex:1;min-width:170px">
                        <label class="label" for={`sfarsit-${s.id}`}>Se încheie</label>
                        <input class="input" id={`sfarsit-${s.id}`} name="sfarsit" type="date" value={s.ends_on?.slice(0, 10) ?? ''} />
                      </div>
                    </div>

                    <div class="field">
                      <label class="label" for={`descriere-${s.id}`}>Descriere</label>
                      <textarea class="textarea" id={`descriere-${s.id}`} name="descriere" rows="2" style="min-height:64px" data-autogrow>{s.description ?? ''}</textarea>
                    </div>

                    <div class="row" style="gap:var(--s-2)">
                      <button class="btn btn--primary btn--sm" type="submit">Salvează</button>
                      <button class="btn btn--danger btn--sm" type="submit" name="actiune" value="sterge">
                        Șterge etapa
                      </button>
                    </div>
                  </form>
                </details>
              </li>
            ))}
          </ol>
        )
      }

      <div class="panel__footer">
        <form method="POST" action="/api/etape" class="row row--wrap" style="gap:var(--s-3);align-items:flex-end">
          <input type="hidden" name="actiune" value="adauga" />
          <div class="field" style="flex:2;min-width:220px">
            <label class="label" for="etapa-titlu">Etapă nouă</label>
            <input class="input" id="etapa-titlu" name="titlu" required placeholder="Ex: Depunere dosar" />
          </div>
          <div class="field" style="flex:2;min-width:200px">
            <label class="label" for="etapa-interval">Interval afișat</label>
            <input class="input" id="etapa-interval" name="interval" required placeholder={`Ex: Mai ${currentYear}`} />
          </div>
          <div class="field" style="flex:1;min-width:160px">
            <label class="label" for="etapa-inceput">Începe</label>
            <input class="input" id="etapa-inceput" name="inceput" type="date" />
          </div>
          <div class="field" style="flex:1;min-width:160px">
            <label class="label" for="etapa-sfarsit">Se încheie</label>
            <input class="input" id="etapa-sfarsit" name="sfarsit" type="date" />
          </div>
          <button class="btn btn--primary" type="submit">Adaugă etapa</button>
        </form>
        <p class="hint" style="margin-top:var(--s-2)">
          Modificările apar imediat pe pagina de start a studenților și în fișierul
          <a href="/documente/calendar-sesiune.ics">calendar-sesiune.ics</a>.
        </p>
      </div>
    </section>
  </div>
</ProfesorLayout>

<style>
  .alert {
    padding: var(--s-3) var(--s-4);
    background: var(--warn-tint);
    color: var(--warn);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
  }
  .stage:last-child {
    border-bottom: 0;
  }
  .stage.is-curenta {
    background: var(--red-tint);
  }

  /* A finished stage stays in the list — the order is the information — but no
     longer asks for attention. A stage without dates does ask for it: it does
     not appear in the downloadable file. */
  .stage.is-trecuta .stage__title,
  .stage.is-trecuta .stage__days {
    color: var(--ink-muted);
  }
  .stage.is-fara-date {
    background: var(--warn-tint);
  }

  .stage__order {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-1);
    flex: none;
    padding-top: var(--s-2);
  }
  .stage__order .numeric {
    font-family: var(--serif);
    font-size: var(--t-lg);
    color: var(--border-strong);
  }
  .stage.is-curenta .stage__order .numeric {
    color: var(--red);
  }

  .stage__move {
    display: flex;
    flex-direction: column;
  }
  .stage__move .btn {
    min-height: 22px;
    padding: 0 var(--s-2);
    line-height: 1;
  }

  .stage__body {
    flex: 1;
    min-width: 0;
  }

  .stage__body summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    cursor: pointer;
    list-style: none;
  }
  .stage__body summary::-webkit-details-marker {
    display: none;
  }
  .stage__body summary:hover {
    background: var(--surface-sunken);
  }

  .stage__ident {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* The title is the content of the row, not a label on it: it was set at 14px,
     that is, smaller than the portal's ordinary text. */
  .stage__title {
    font-size: var(--t-base);
    font-weight: 600;
  }

  .stage__days {
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  .stage__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--t-xs);
  }

  .stage__form {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-3) var(--s-5);
  }
</style>
