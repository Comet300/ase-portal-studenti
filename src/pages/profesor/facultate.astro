---
import AlegeAn from '../../components/AlegeAn.astro'
import Avatar from '../../components/Avatar.astro'
import Metrica from '../../components/Metrica.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import { isDepartmentHead } from '../../lib/auth'
import { studentDirectory } from '../../lib/repo'
import { officialName } from '../../lib/text'
import {
  LANGUAGE_LABELS,
  LEVEL_LABELS,
  allYears,
  currentYear,
  languageLabel,
  levelLabel,
  programmes,
  yearById,
} from '../../lib/years'

/**
 * The whole cohort, split the way the faculty thinks about it.
 *
 * A coordinator's own list answers "how are my students doing". This one answers
 * "who is out there" — which is the question behind choosing whom to invite, and
 * behind noticing that the entire English-language group is still unassigned two
 * weeks before the deadline.
 *
 * Grouping is server-side and the filters are links, so a particular slice of the
 * cohort is a URL somebody can send to a colleague.
 */

const nivel = Astro.url.searchParams.get('nivel') ?? ''
const limba = Astro.url.searchParams.get('limba') ?? ''
const serie = Astro.url.searchParams.get('serie') ?? ''
const cont = Astro.url.searchParams.get('cont') ?? ''
const stare = Astro.url.searchParams.get('stare') ?? ''
const searchQuery = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase()

/* The year, and what changing it actually does.
 *
 * `users` carries no cohort: a student belongs to the faculty, not to a
 * session. So the year does not decide *who* is in the list — it decides which
 * session's coordination is shown next to each name. On „2023–2024” the same
 * people appear with the coordinators they had then, and whoever had no request
 * that year reads „Nu a depus cerere”, which is exactly what happened.
 *
 * For the years where that distinction matters, `stare=depusa` narrows the list
 * to the students who did enter that session.
 */
const years = await allYears()
const askedYear = Astro.url.searchParams.get('an')
const year = (askedYear ? await yearById(askedYear) : null) ?? (await currentYear())

const all = await studentDirectory(year?.id)

/* Moving a student between programmes is an administrative task: it appears only
 * for the head of department, on the same screen where they are already looking
 * at who is in which group. */
const canAssign = isDepartmentHead(Astro.locals.user)
const an = canAssign ? year : null
const yearProgrammes = an ? (await programmes(an.id)).filter((p) => p.is_active) : []

const filtered = all.filter((s) => {
  if (nivel && s.program !== nivel) return false
  if (limba && s.study_language !== limba) return false
  if (serie && (s.study_series ?? '') !== serie) return false
  if (cont === 'folosit' && !s.first_login_at) return false
  if (cont === 'neintrat' && s.first_login_at) return false
  if (stare === 'coordonat' && s.request_status !== 'approved') return false
  if (stare === 'asteptare' && s.request_status !== 'pending') return false
  if (stare === 'neinceput' && s.request_status) return false
  if (searchQuery) {
    /* The official name, not the plain one: a head of department looking for
       „Popescu I.” in a year with four Popescu is looking for the initial. */
    const haystack = `${officialName(s)} ${s.student_number ?? ''} ${s.specialization ?? ''} ${s.study_series ?? ''} ${s.teacher_name ?? ''}`
    if (!haystack.toLowerCase().includes(searchQuery)) return false
  }
  return true
})

/** The groups: level · specialization · language — exactly the key the timetable uses. */
const groups = new Map<string, typeof filtered>()
for (const s of filtered) {
  const key = `${s.program ?? 'bachelor'}|${s.specialization ?? '—'}|${s.study_language}`
  const list = groups.get(key) ?? []
  list.push(s)
  groups.set(key, list)
}

const grouped = [...groups.entries()]
  .map(([key, students]) => {
    const [level, specialization, language] = key.split('|')
    return {
      key,
      level,
      specialization,
      language,
      students,
      supervised: students.filter((s) => s.request_status === 'approved').length,
    }
  })
  .sort(
    (a, b) =>
      a.level.localeCompare(b.level) ||
      a.specialization.localeCompare(b.specialization) ||
      a.language.localeCompare(b.language),
  )

const languages = [...new Set(all.map((s) => s.study_language))]

/* Only the series that exist. The column is free text typed from the
 * registrar's sheet, so there is no list to offer other than the one the cohort
 * actually contains. */
const series = [...new Set(all.map((s) => s.study_series).filter(Boolean))].sort() as string[]

const totals = {
  toti: all.length,
  supervised: all.filter((s) => s.request_status === 'approved').length,
  asteptare: all.filter((s) => s.request_status === 'pending').length,
  /* An account nobody ever signed in with is usually one wrong letter in an
   * address — and the person on the other end has been waiting for a link that
   * cannot arrive. Until now the only way to find out was for them to say so. */
  neintrati: all.filter((s) => !s.first_login_at).length,
}
const neinceput = totals.toti - totals.supervised - totals.asteptare

const STATUS_OPTIONS = [
  { value: '', text: 'Toate stările' },
  { value: 'coordonat', text: 'Cu coordonator' },
  { value: 'asteptare', text: 'Cerere în așteptare' },
  { value: 'depusa', text: 'A intrat în sesiunea aleasă' },
  { value: 'neinceput', text: 'Nu a depus cerere' },
]

const ACCOUNT_OPTIONS = [
  { value: '', text: 'Toate conturile' },
  { value: 'folosit', text: 'A intrat în portal' },
  { value: 'neintrat', text: 'Nu a intrat niciodată' },
]

/* Where a save comes back to.
 *
 * The filters lived only in the address, and `/api/studenti` redirected to the
 * bare page: after every correction, the head of department who was working on
 * „master, fără cerere depusă” got the whole faculty back, from the top. The
 * current address travels with the form.
 */
const backUrl = Astro.url.pathname + Astro.url.search

/* The download is the screen, not the table underneath it: whoever filtered
 * down to „master, seria B, fără cerere” expects those rows in the file. The
 * export route reads the same parameters, so the link only has to carry the
 * ones that are set. */
const exportParams = new URLSearchParams()
for (const [key, value] of Astro.url.searchParams) {
  if (value) exportParams.set(key, value)
}
if (year) exportParams.set('an', year.id)
const exportHref = (format: string) => {
  const p = new URLSearchParams(exportParams)
  p.set('format', format)
  return `/profesor/facultate/export?${p.toString()}`
}
---

<ProfesorLayout
  title="Studenții facultății"
  lede="Toți studenții din sesiune, grupați pe program, specializare și limbă de studiu."
  active="facultate"
>
  <a slot="actiuni" class="btn btn--secondary btn--sm" href={exportHref('xlsx')}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
    </svg>
    Descarcă lista (Excel)
  </a>
  <a slot="actiuni" class="btn btn--ghost btn--sm" href={exportHref('csv')}>CSV</a>

  <div class="stack stack--loose">
    <div class="grid-auto">
      {/* Primul cartonaș numără toți studenții facultății, nu rândurile rămase
          după filtre: „câți suntem” este întrebarea de la care pornește
          fiecare alta de pe ecranul ăsta. */}
      <Metrica value={totals.toti} label="studenți înmatriculați" />
      <Metrica value={totals.supervised} label="cu coordonator confirmat" />
      <Metrica value={totals.asteptare} label="cu cerere în așteptare" />
      <Metrica value={neinceput} label="fără cerere depusă" alerta={neinceput > 0} />
      <Metrica
        value={totals.neintrati}
        label="nu au intrat niciodată în portal"
        note="verifică adresa lor de email"
        alerta={totals.neintrati > 0}
      />
    </div>

    <form method="GET" class="panel">
      {/* Filtrarea nu schimbă sesiunea: fără asta, orice căutare te readucea în
          anul curent, tăcut. */}
      <input type="hidden" name="an" value={year?.id ?? ''} />
      <div class="panel__body row row--wrap" style="gap:var(--s-3);align-items:flex-end">
        <div class="field">
          <span class="label">Sesiunea</span>
          <AlegeAn
            years={years}
            selected={year?.id ?? ''}
            base="/profesor/facultate"
            label="An universitar"
            keep={Object.fromEntries([...Astro.url.searchParams].filter(([k, v]) => k !== 'an' && v))}
          />
        </div>
        <div class="field" style="flex:2;min-width:220px">
          <label class="label" for="q">Caută</label>
          <input class="input" id="q" name="q" type="search" value={searchQuery}
            placeholder="Nume, număr matricol sau coordonator…" />
        </div>
        <div class="field" style="min-width:150px">
          <label class="label" for="nivel">Nivel</label>
          <select class="select" id="nivel" name="nivel">
            <option value="">Licență și master</option>
            {
              Object.entries(LEVEL_LABELS).map(([v, t]) => (
                <option value={v} selected={nivel === v}>{t}</option>
              ))
            }
          </select>
        </div>
        <div class="field" style="min-width:150px">
          <label class="label" for="limba">Limbă</label>
          <select class="select" id="limba" name="limba">
            <option value="">Toate limbile</option>
            {
              languages.map((l) => (
                <option value={l} selected={limba === l}>{LANGUAGE_LABELS[l] ?? l}</option>
              ))
            }
          </select>
        </div>
        <div class="field" style="min-width:130px">
          <label class="label" for="serie">Serie</label>
          <select class="select" id="serie" name="serie">
            <option value="">Toate seriile</option>
            {series.map((v) => <option value={v} selected={serie === v}>{v}</option>)}
          </select>
        </div>
        <div class="field" style="min-width:200px">
          <label class="label" for="cont">Cont</label>
          <select class="select" id="cont" name="cont">
            {ACCOUNT_OPTIONS.map((o) => (
              <option value={o.value} selected={cont === o.value}>{o.text}</option>
            ))}
          </select>
        </div>
        <div class="field" style="min-width:190px">
          <label class="label" for="stare">Stare</label>
          <select class="select" id="stare" name="stare">
            {STATUS_OPTIONS.map((s) => <option value={s.value} selected={stare === s.value}>{s.text}</option>)}
          </select>
        </div>
        <button class="btn btn--secondary" type="submit">Filtrează</button>
      </div>
      {/* The marker is written on sign-in, and it started being written with
          this version: nothing reconstructs the sign-ins that happened before
          it. Saying so here is the difference between a filter somebody trusts
          and one that quietly accuses two dozen students of never having
          arrived. */}
      <p class="nota-cont">
        Portalul reține prima intrare de la această actualizare încoace. Un cont deschis mai demult
        și nefolosit de atunci apare ca „nu a intrat niciodată”, chiar dacă a fost folosit înainte.
      </p>
    </form>

    {
      grouped.length === 0 ? (
        <section class="panel">
          {/* „Niciun student pentru filtrele alese” was shown even when the
              faculty really has no students yet — two situations whose next
              steps are completely different. */}
          {all.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Niciun student în sesiune</p>
              <p class="empty__text">
                Studenții apar aici după ce sunt înscriși în anul universitar curent. Deschide un an
                și adaugă programele de studiu ca să începi.
              </p>
              <a class="btn btn--primary btn--sm" href="/profesor/an-universitar">
                Deschide anul universitar
              </a>
            </div>
          ) : (
            <div class="empty">
              <p class="empty__title">Niciun student pentru filtrele alese</p>
              <p class="empty__text">
                Cei {all.length} studenți din sesiune nu se potrivesc cu filtrele active. Schimbă
                nivelul, limba, seria, contul sau starea, ori golește căutarea.
              </p>
              <a class="btn btn--secondary btn--sm" href="/profesor/facultate">Golește filtrele</a>
            </div>
          )}
        </section>
      ) : (
        grouped.map((g) => (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">
                {levelLabel(g.level)} · {g.specialization}
                {g.language !== 'ro' ? ` · ${languageLabel(g.language).toLowerCase()}` : ''}
              </h2>
              <span class="muted text-sm">
                {g.supervised} din {g.students.length} au coordonator
              </span>
            </div>

            {/* A whole year gets corrected against the lists from the registry:
                thirty students from the same group, the same move thirty times
                over, with a page reload between every two. The bar applies one
                change to everyone ticked, in a single instruction.

                The form sits outside the table and the checkboxes refer to it
                through `form=`: a `<form>` cannot stretch across table rows. */}
            {canAssign && (
              <form
                method="POST"
                action="/api/studenti"
                id={`grup-${g.key}`}
                class="selectie"
                hidden
              >
                <input type="hidden" name="redirect" value={backUrl} />
                <p class="selectie__contor" aria-live="polite">
                  <strong data-contor-selectie>0</strong> selectați
                </p>
                {/* Nivelul întâi, programul după el — aceeași pereche ca la
                    „Teme propuse”. Într-o singură listă, cele unsprezece
                    programe ale celor două niveluri se citeau ca un teanc. */}
                <label class="label" for={`nivel-grup-${g.key}`}>Nivel</label>
                <select
                  class="select select--sm"
                  id={`nivel-grup-${g.key}`}
                  data-nivel-pentru={`prog-grup-${g.key}`}
                >
                  {Object.entries(LEVEL_LABELS).map(([v, t]) => (
                    <option value={v} selected={v === g.level}>{t}</option>
                  ))}
                </select>
                <label class="label" for={`prog-grup-${g.key}`}>Mută în programul</label>
                <select class="select select--sm" id={`prog-grup-${g.key}`} name="program_id" data-programe>
                  {yearProgrammes.map((p) => (
                    <option
                      value={p.id}
                      data-nivel={p.level}
                      hidden={p.level !== g.level}
                      selected={p.level === g.level && p.name === g.specialization && p.language === g.language}
                    >
                      {p.name}
                      {p.language !== 'ro' ? ` · ${LANGUAGE_LABELS[p.language]}` : ''}
                    </option>
                  ))}
                </select>
                <label class="label" for={`an-grup-${g.key}`}>An</label>
                <input class="input input--num" id={`an-grup-${g.key}`} name="an_studiu" type="number" min="1" max="6" placeholder="—" />
                <label class="label" for={`serie-grup-${g.key}`}>Serie</label>
                <input class="input input--num" id={`serie-grup-${g.key}`} name="serie" placeholder="Ex: B" />
                <label class="label" for={`gr-grup-${g.key}`}>Grupa</label>
                <input class="input input--num" id={`gr-grup-${g.key}`} name="grupa" placeholder="Ex: RO-1503" />
                {/* An empty field means „nu schimba”, as on the single row. */}
                <button class="btn btn--primary btn--sm" type="submit">Aplică selecției</button>
                <button class="btn btn--ghost btn--sm" type="button" data-goleste-selectie>
                  Deselectează
                </button>
              </form>
            )}

            <div class="table-wrap" tabindex="0" role="region" aria-label="Studenții facultății">
              <table class="table">
                <thead>
                  <tr>
                    {/* The „toți” checkbox sits in the head of the student
                        column, not in a column of its own: an extra column would
                        also have required a larger `colspan` on the editing row,
                        and those two drift apart silently at the first change. */}
                    <th scope="col">
                      <span class="cap-student">
                        {canAssign && (
                          <input
                            class="bifa-toti"
                            type="checkbox"
                            aria-label="Selectează toți studenții din grup"
                          />
                        )}
                        Student
                      </span>
                    </th>
                    {/* Year, series, group — the faculty's own order, from the
                        widest division to the narrowest. */}
                    <th scope="col">An</th>
                    <th scope="col">Serie</th>
                    <th scope="col">Grupa</th>
                    <th scope="col">Cont</th>
                    <th scope="col">Coordonator</th>
                    <th scope="col">Stare</th>
                    {canAssign && <th scope="col">Grupare</th>}
                  </tr>
                </thead>
                <tbody>
                  {g.students.map((s) => (
                    <>
                    <tr id={`student-${s.id}`}>
                      <td>
                        <div class="row" style="gap:var(--s-3)">
                          {/* The checkbox is outside the row form, inside the
                              group one: a `<form>` cannot stretch across table
                              rows, and the checkboxes have to leave together. */}
                          {canAssign && (
                            <input
                              class="bifa-student"
                              type="checkbox"
                              form={`grup-${g.key}`}
                              name="studenti"
                              value={s.id}
                              aria-label={`Selectează ${s.name}`}
                            />
                          )}
                          <Avatar name={s.name} src={s.avatar_path} size="xs" href={`/profil/${s.id}`} />
                          <div class="stack stack--tight" style="gap:0">
                            {/* The register's form, initial included: this is
                                the list the secretariat checks its own against,
                                and „Popescu Maria” and „Popescu I. Maria” are
                                two different students in a year with four
                                Popescu. */}
                            <strong>{officialName(s)}</strong>
                            <span class="muted text-xs">{s.student_number}</span>
                          </div>
                        </div>
                      </td>
                      <td class="muted numeric">{s.study_year ?? '—'}</td>
                      <td class="muted numeric">{s.study_series ?? '—'}</td>
                      <td class="muted numeric">{s.study_group ?? '—'}</td>
                      <td>
                        {/* Two states, never a date: „when were they last in
                            the portal” is the one thing the privacy notice
                            promises stays inside a coordination. This says only
                            whether the account was ever used. */}
                        {s.first_login_at ? (
                          <span class="badge badge--neutru">A intrat</span>
                        ) : (
                          <span class="badge badge--asteptare">Nu a intrat niciodată</span>
                        )}
                      </td>
                      <td>
                        {s.teacher_name ? (
                          <a href={`/profil/${s.teacher_id}`}>{s.teacher_name}</a>
                        ) : (
                          <span class="muted">—</span>
                        )}
                      </td>
                      <td>
                        {s.request_status === 'approved' ? (
                          <span class="badge badge--aprobata">Coordonat</span>
                        ) : s.request_status === 'pending' ? (
                          <span class="badge badge--asteptare">Cerere depusă</span>
                        ) : (
                          <span class="badge badge--ciorna">Nu a depus cerere</span>
                        )}
                      </td>
                      {canAssign && (
                        <td style="text-align:right">
                          <button
                            class="btn btn--secondary btn--sm"
                            type="button"
                            data-editeaza={s.id}
                            aria-expanded="false"
                            aria-controls={`editor-${s.id}`}
                          >
                            Grupare
                          </button>
                        </td>
                      )}
                    </tr>
                    {/* The editor used to sit in the cell: a 210px select plus
                        two fields plus a button forced the table past 1000px,
                        „Salvează” stayed cut off at 1280px, and the whole
                        document — not only the table — scrolled sideways on a
                        phone. Here it has a row of its own, opened only when
                        needed. */}
                    {canAssign && (
                      <tr class="editor-rand" id={`editor-${s.id}`} hidden>
                        {/* Eight columns now: student, an, serie, grupa, cont,
                            coordonator, stare, grupare. It has to be counted by
                            hand against the header above. */}
                        <td colspan="8">
                          <form method="POST" action="/api/studenti" class="atribuire">
                            <input type="hidden" name="student_id" value={s.id} />
                            <input type="hidden" name="redirect" value={`${backUrl}#student-${s.id}`} />
                            <label class="label" for={`nivel-${s.id}`}>Nivel</label>
                            <select
                              class="select select--sm"
                              id={`nivel-${s.id}`}
                              data-nivel-pentru={`prog-${s.id}`}
                            >
                              {Object.entries(LEVEL_LABELS).map(([v, t]) => (
                                <option value={v} selected={v === (s.program ?? 'bachelor')}>{t}</option>
                              ))}
                            </select>
                            <label class="label" for={`prog-${s.id}`}>Program de studii</label>
                            <select class="select select--sm" id={`prog-${s.id}`} name="program_id" data-programe>
                              {yearProgrammes.map((p) => (
                                <option
                                  value={p.id}
                                  data-nivel={p.level}
                                  hidden={p.level !== (s.program ?? 'bachelor')}
                                  selected={
                                    p.level === s.program &&
                                    p.name === s.specialization &&
                                    p.language === s.study_language
                                  }
                                >
                                  {p.name}
                                  {p.language !== 'ro' ? ` · ${LANGUAGE_LABELS[p.language]}` : ''}
                                </option>
                              ))}
                            </select>
                            <label class="label" for={`an-${s.id}`}>An</label>
                            <input
                              class="input input--num"
                              id={`an-${s.id}`}
                              name="an_studiu"
                              type="number"
                              min="1"
                              max="6"
                              value={s.study_year ?? ''}
                            />
                            {/* A row opened across the full width has space for
                                a real label; the placeholder stood in for a label
                                and vanished at the first keystroke. */}
                            <label class="label" for={`serie-${s.id}`}>Serie</label>
                            <input
                              class="input input--num"
                              id={`serie-${s.id}`}
                              name="serie"
                              value={s.study_series ?? ''}
                              placeholder="Ex: B"
                            />
                            <label class="label" for={`gr-${s.id}`}>Grupa</label>
                            <input
                              class="input input--num"
                              id={`gr-${s.id}`}
                              name="grupa"
                              value={s.study_group ?? ''}
                              placeholder="Ex: RO-1503"
                            />
                            <button class="btn btn--primary btn--sm" type="submit">Salvează</button>
                          </form>
                        </td>
                      </tr>
                    )}
                    </>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))
      )
    }
  </div>
</ProfesorLayout>

<script>
  /* «Nivel» decide ce programe se pot alege, ca la „Teme propuse”.
   *
   * Perechea apare de două ori pe ecran — o dată pe bara de selecție a fiecărei
   * grupe, o dată pe editorul fiecărui rând — deci legătura se face prin
   * `data-nivel-pentru`, nu prin poziție. Fără JavaScript, lista rămâne
   * întreagă și trimisibilă; `/api/studenti` verifică oricum perechea. */
  document.querySelectorAll<HTMLSelectElement>('[data-nivel-pentru]').forEach((nivel) => {
    const programe = document.getElementById(nivel.dataset.nivelPentru ?? '') as HTMLSelectElement | null
    if (!programe) return

    nivel.addEventListener('change', () => {
      let prima: HTMLOptionElement | null = null
      for (const o of programe.options) {
        const seVede = o.dataset.nivel === nivel.value
        o.hidden = !seVede
        o.disabled = !seVede
        if (seVede && !prima) prima = o
      }
      /* Un program rămas de la nivelul dinainte ar muta un student de licență
         într-un program de master, tăcut. */
      if (programe.selectedOptions[0]?.hidden) programe.value = prima?.value ?? ''
    })
  })

  // The grouping editor opens on the row below the student, one at a time.
  document.querySelectorAll<HTMLButtonElement>('[data-editeaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const rand = document.getElementById(`editor-${b.dataset.editeaza}`)
      if (!rand) return

      const wasOpen = !rand.hidden
      document.querySelectorAll<HTMLElement>('.editor-rand').forEach((r) => (r.hidden = true))
      document
        .querySelectorAll<HTMLButtonElement>('[data-editeaza]')
        .forEach((x) => x.setAttribute('aria-expanded', 'false'))

      if (wasOpen) return

      rand.hidden = false
      b.setAttribute('aria-expanded', 'true')
      rand.querySelector<HTMLSelectElement>('select')?.focus()
    })
  })

  /* --- selecting several students at once -----------------------------------
   *
   * The bar stays hidden while nobody is ticked: a row of controls permanently
   * above every group would be furniture for a rare action. Each group has its
   * own selection, because the move goes into one group's programme — a selection
   * that crossed two tables would suggest something other than what it does. */
  document.querySelectorAll<HTMLFormElement>('form.selectie').forEach((bar) => {
    const boxes = [...document.querySelectorAll<HTMLInputElement>(`input[form="${bar.id}"]`)]
    if (boxes.length === 0) return

    const table = boxes[0].closest('table')
    const toti = table?.querySelector<HTMLInputElement>('.bifa-toti') ?? null
    const contor = bar.querySelector<HTMLElement>('[data-contor-selectie]')

    const refresh = () => {
      const checked = boxes.filter((b) => b.checked)
      bar.hidden = checked.length === 0
      if (contor) contor.textContent = String(checked.length)
      if (toti) {
        toti.checked = checked.length === boxes.length && boxes.length > 0
        // The third state: some ticked. Without it, „toți” looks empty with half
        // of them selected.
        toti.indeterminate = checked.length > 0 && checked.length < boxes.length
      }
    }

    boxes.forEach((b) => b.addEventListener('change', refresh))

    toti?.addEventListener('change', () => {
      boxes.forEach((b) => (b.checked = toti.checked))
      refresh()
    })

    bar.querySelector<HTMLButtonElement>('[data-goleste-selectie]')?.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false))
      refresh()
      toti?.focus()
    })

    /* Shift-click ticks the whole range, the way anyone who has used a file
     * list expects: thirty students from one group are consecutive. */
    let lastIndex = -1
    boxes.forEach((b, i) => {
      b.addEventListener('click', (e) => {
        if ((e as MouseEvent).shiftKey && lastIndex >= 0) {
          const [de, la] = i < lastIndex ? [i, lastIndex] : [lastIndex, i]
          for (let k = de; k <= la; k++) boxes[k].checked = b.checked
          refresh()
        }
        lastIndex = i
      })
    })

    refresh()
  })
</script>

