  }

  .atribuire {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-3);
  }
  .atribuire .select--sm {
    /* No minimum width: inside a cell it pushed the table past 1000px. On a
       whole row there is room for it anyway. */
    flex: 1 1 260px;
