---
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import { teacherTopics } from '../../lib/repo'
import { numar } from '../../lib/text'
import { LANGUAGE_LABELS, allYears, currentYear, languageLabel, programmes } from '../../lib/years'

/**
 * The topics proposed by a member of the teaching staff.
 *
 * A screen of its own, not a tab: the topic catalogue is edited at the start of
 * the session and rarely afterwards, but it is what every student looking for a
 * coordinator sees — buried under „Studenți & Cereri" it was hard to find
 * exactly when it mattered.
 */

const u = Astro.locals.user!
const teme = await teacherTopics(u.id)

/* The programmes of the year under way, both levels together.
 *
 * All of them are rendered as options, each carrying its level, and the choice
 * of „Nivel” filters them in the browser. Rendering only one level's worth
 * would mean a form that cannot be filled in without JavaScript — and the
 * endpoint checks the pair anyway, because a browser is not a defence. */
const an = await currentYear()
const programe = an ? (await programmes(an.id)).filter((p) => p.is_active) : []
const areProgramePeNivel = {
  bachelor: programe.some((p) => p.level === 'bachelor'),
  master: programe.some((p) => p.level === 'master'),
}

/* Temele de anul trecut, ale acestui cadru didactic.
 *
 * Catalogul se reia de la zero în fiecare an, iar preluarea temelor era o
 * bifă în mâna directorului, la deschiderea anului: ori se copiau ale
 * tuturor, ori ale nimănui. Un coordonator care propune aceleași cinci
 * direcții de șase ani le rescria de fiecare dată — sau aștepta ca altcineva
 * să bifeze pentru el.
 *
 * Se arată doar cele care nu au deja un omonim în anul curent: o listă în care
 * jumătate din rânduri sunt deja preluate se citește ca o greșeală. */
const anTrecut = (await allYears()).filter((y) => !y.is_current && (!an || y.starts_on < an.starts_on))[0] ?? null

const titluriCurente = new Set(teme.map((t) => t.title.trim().toLowerCase()))
const temeDeAnulTrecut = anTrecut
  ? (await teacherTopics(u.id, anTrecut.id)).filter(
      (t) => !titluriCurente.has(t.title.trim().toLowerCase()),
    )
  : []
---

<ProfesorLayout
  title="Teme propuse"
  lede="Direcțiile de cercetare pe care le publici în catalogul studenților."
  active="teme"
>
    <section class="panel">
      <div class="panel__header">
        {/* The page title already says „Teme propuse”; the panel header
            repeated it word for word and added nothing. What is useful
            here is the count. */}
        <h2 class="section-title">În catalog</h2>
        <span class="muted text-sm">
          {teme.filter((t) => t.is_active).length} din {teme.length}
          {teme.length === 1 ? ' temă' : ' teme'} publicate
        </span>
      </div>

      {teme.length === 0 ? (
        <div class="empty">
          <p class="empty__title">Nicio temă propusă</p>
          <p class="empty__text">
            Temele propuse apar în catalogul public de coordonatori, iar studenții pot depune cereri
            direct pe ele.
          </p>
        </div>
      ) : (
        <ul class="teme">
          {teme.map((t) => (
            <li class:list={['tema', { 'is-inactive': !t.is_active }]}>
              <div class="tema__cap">
                <span class="badge badge--taxon">
                  {t.level === 'master' ? 'Master' : 'Licență'}
                  {t.language !== 'ro' ? ` · ${languageLabel(t.language)}` : ''}
                </span>
                <span class="muted text-xs">
                  {t.taken === 0
                    ? 'nicio cerere'
                    : t.taken === 1
                      ? 'un student'
                      : `${t.taken} studenți`}
                </span>
              </div>
              <h3 class="tema__titlu">{t.title}</h3>
              {t.programme_name ? (
                <p class="muted text-sm">{t.programme_name}</p>
              ) : (
                <p class="tema__lipsa text-sm">
                  Fără program de studii — alege unul ca tema să ajungă la studenții potriviți.
                </p>
              )}
              {t.domain && t.domain !== '—' && <p class="muted text-sm">Domeniu: {t.domain}</p>}
              {t.methodology && t.methodology !== '—' && (
                <p class="muted text-xs">Metodologie: {t.methodology}</p>
              )}
              <form method="POST" action="/api/teme" style="margin-top:auto">
                <input type="hidden" name="actiune" value="comuta" />
                <input type="hidden" name="tema_id" value={t.id} />
                {/* Ghost on a white background has no outline, so it looked like a
                    link, not a button — exactly the complaint received twice so far. */}
                <button class="btn btn--secondary btn--sm" type="submit">
                  {t.is_active ? 'Retrage din catalog' : 'Publică din nou'}
                </button>
              </form>
            </li>
          ))}
        </ul>
      )}

      {/* Preluarea din anul trecut stă între catalog și formularul de temă
          nouă: este scurtătura către același rezultat, iar cine o folosește nu
          mai are nevoie de formular. */}
      {
        temeDeAnulTrecut.length > 0 && (
          <form method="POST" action="/api/teme" class="panel__footer preia">
            <input type="hidden" name="actiune" value="preia" />
            <input type="hidden" name="an_sursa" value={anTrecut?.id} />

            <div class="preia__cap">
              <div class="stack stack--tight" style="gap:2px">
                <strong>Preia teme din {anTrecut?.label}</strong>
                <span class="muted text-sm">
                  {numar(temeDeAnulTrecut.length, 'temă care nu este încă în catalogul acestui an', 'teme care nu sunt încă în catalogul acestui an')}.
                  Programul de studii se potrivește după nume; unde anul acesta nu are unul la fel,
                  tema vine fără program și îl alegi tu.
                </span>
              </div>
              <button class="btn btn--secondary btn--sm" type="button" data-bifeaza-tot>
                Bifează tot
              </button>
            </div>

            <ul class="preia__lista">
              {temeDeAnulTrecut.map((t) => (
                <li>
                  <label class="preia__optiune">
                    <input type="checkbox" name="tema_id" value={t.id} />
                    <span class="stack stack--tight" style="gap:2px">
                      <strong>{t.title}</strong>
                      <span class="muted text-xs">
                        {t.level === 'master' ? 'Master' : 'Licență'}
                        {t.programme_name ? ` · ${t.programme_name}` : ''}
                        {t.domain && t.domain !== '—' ? ` · ${t.domain}` : ''}
                      </span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>

            <div class="row row--end">
              <button class="btn btn--primary btn--sm" type="submit">Preia temele bifate</button>
            </div>
          </form>
        )
      }

      <div class="panel__footer">
        <form method="POST" action="/api/teme" class="tema-noua">
          <input type="hidden" name="actiune" value="adauga" />

          <div class="field tema-noua__titlu">
            <label class="label" for="tema-titlu">Temă nouă</label>
            <input class="input" id="tema-titlu" name="titlu" required
              placeholder="Ex: Adopția plăților contactless în mediul rural" />
          </div>

          <div class="field tema-noua__nivel">
            <label class="label" for="tema-nivel">Nivel</label>
            <select class="select" id="tema-nivel" name="nivel">
              <option value="bachelor">Licență</option>
              <option value="master">Master</option>
            </select>
          </div>

          <div class="field tema-noua__program">
            <label class="label" for="tema-program">Program de studii</label>
            <select class="select" id="tema-program" name="program_id" data-programe required
              aria-describedby="ajutor-program">
              {/* Fără o opțiune goală, prima din listă ar fi un răspuns pe care
                  nimeni nu l-a dat: la licență aceea este programul în engleză,
                  iar tema ar ajunge tăcut în catalogul altcuiva. */}
              <option value="">Alege programul…</option>
              {/* Limba, când nu este româna: facultatea are două programe cu
                  același nume și limbi diferite, iar în listă apăreau ca două
                  rânduri identice, imposibil de deosebit. */}
              {programe.map((p) => (
                <option value={p.id} data-nivel={p.level} hidden={p.level !== 'bachelor'}>
                  {p.name}
                  {p.language !== 'ro' ? ` · ${LANGUAGE_LABELS[p.language]}` : ''}
                </option>
              ))}
            </select>
            <span class="hint" id="ajutor-program">
              Programul stabilește și limba lucrării. Lista se schimbă după nivelul ales.
            </span>
          </div>

          {/* The description is the only place where a student finds out what
              the topic is about. The catalogue displayed it and searched it
              from the start, but the form never asked for it, so every topic
              published from the portal was left without one. */}
          <div class="field tema-noua__descriere">
            <label class="label" for="tema-descriere">Descriere</label>
            <textarea
              class="textarea"
              id="tema-descriere"
              name="descriere"
              rows="3"
              maxlength="800"
              data-autogrow
              aria-describedby="contor-descriere"
              placeholder="Ce problemă abordează, ce date se folosesc și ce ar trebui să obțină studentul."
            ></textarea>
            <span class="hint" id="contor-descriere" data-contor-pentru="tema-descriere"></span>
          </div>

          <div class="field tema-noua__domeniu">
            <label class="label" for="tema-domeniu">Domeniu</label>
            <input class="input" id="tema-domeniu" name="domeniu" maxlength="200"
              placeholder="Ex: comportamentul consumatorului" />
          </div>

          <div class="field tema-noua__metodologie">
            <label class="label" for="tema-metodologie">Metodologie</label>
            <input class="input" id="tema-metodologie" name="metodologie" maxlength="200"
              placeholder="Ex: anchetă pe bază de chestionar, eșantion de 200" />
          </div>

          <button class="btn btn--primary tema-noua__actiune" type="submit">Publică tema</button>
        </form>
      </div>
    </section>
</ProfesorLayout>

<script>
  /* «Nivel» decide ce programe se pot alege.
   *
   * Toate opțiunile sunt în pagină de la început, fiecare cu nivelul ei, iar
   * aici rămân vizibile doar cele potrivite. Fără JavaScript formularul rămâne
   * complet și trimisibil — iar dacă perechea nu se potrivește, endpointul o
   * refuză cu o propoziție, pentru că browserul nu este o apărare. */
  /* „Bifează tot”, pentru cine reia catalogul întreg — cazul obișnuit. */
  document.querySelector<HTMLButtonElement>('[data-bifeaza-tot]')?.addEventListener('click', (e) => {
    const form = (e.currentTarget as HTMLElement).closest('form')
    const casete = [...(form?.querySelectorAll<HTMLInputElement>('input[name="tema_id"]') ?? [])]
    const toateBifate = casete.every((c) => c.checked)
    casete.forEach((c) => (c.checked = !toateBifate))
    ;(e.currentTarget as HTMLElement).textContent = toateBifate ? 'Bifează tot' : 'Debifează tot'
  })

  const nivel = document.querySelector<HTMLSelectElement>('#tema-nivel')
  const programe = document.querySelector<HTMLSelectElement>('[data-programe]')

  if (nivel && programe) {
    const optiuni = [...programe.options]

    const potrivite = () => {
      for (const o of optiuni) {
        const seVede = !o.dataset.nivel || o.dataset.nivel === nivel.value
        o.hidden = !seVede
        o.disabled = !seVede
      }
      /* Selecția rămasă de la nivelul anterior ar fi trimis un master la
         licență: dacă a devenit invizibilă, cade pe prima potrivită. */
      if (programe.selectedOptions[0]?.hidden) programe.value = ''
    }

    potrivite()
    nivel.addEventListener('change', potrivite)
  }
</script>

<style>
  /* --- preluarea din anul trecut ------------------------------------------ */

  .preia {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    border-bottom: 1px solid var(--border);
  }

  .preia__cap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: flex-start;
    justify-content: space-between;
  }

  .preia__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-2);
  }

  /* Rândul întreg este ținta, nu doar caseta de 13px. */
  .preia__optiune {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    min-height: var(--tap);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    cursor: pointer;
  }
  .preia__optiune:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }
  .preia__optiune input {
    margin-top: 3px;
    flex: none;
  }

  /* Twelve columns, each field with its own span declared.
     `auto-fit` gave them all the same width — a thesis title got 160px, just
     like the number of seats — and the inline styles left over from the flex
     version beat the rule below and pushed the fields on top of one another. */
  .tema-noua {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-4);
    align-items: start;
  }
  .tema-noua .field {
    min-width: 0;
  }

  .tema-noua__titlu {
    grid-column: span 12;
  }
  .tema-noua__nivel {
    grid-column: span 4;
  }
  .tema-noua__program {
    grid-column: span 8;
  }
  .tema-noua__descriere {
    grid-column: span 12;
  }
  .tema-noua__domeniu,
  .tema-noua__metodologie {
    grid-column: span 6;
  }
  .tema-noua__actiune {
    grid-column: 1 / -1;
    justify-self: start;
  }

  @media (max-width: 640px) {
    .tema-noua__nivel,
    .tema-noua__program,
    .tema-noua__domeniu,
    .tema-noua__metodologie {
      grid-column: span 12;
    }
  }

  /* O temă fără program nu ajunge la nimeni: catalogul o arată, dar niciun
     student nu o recunoaște ca fiind pentru el. Spune asta la fața locului. */
  .tema__lipsa {
    color: var(--warn);
  }

  .teme {
    list-style: none;
    margin: 0;
    padding: var(--s-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-4);
  }

  .tema {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }
  .tema.is-inactive {
    opacity: 0.55;
  }

  .tema__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
  }

  .tema__titlu {
    font-size: var(--t-sm);
    font-weight: 600;
    text-wrap: pretty;
  }
</style>
