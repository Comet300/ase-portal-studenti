---
import Avatar from '../../components/Avatar.astro'
import AlegeData from '../../components/AlegeData.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import Taburi from '../../components/Taburi.astro'
import { INVITATION_WINDOW_DAYS, teacherInvitations } from '../../lib/lifecycle'
import {
  BUCKET_LABELS,
  dueBucket,
  dueHint,
  groupMilestones,
  localDay,
  MILESTONE_LABELS,
  MILESTONE_STATE_CLASS,
  MILESTONE_STATE_LABELS,
  milestoneState,
  STATUS_CLASS,
  INVITATION_LABELS,
  STATUS_LABELS,
  timeAgo,
  teacherRequests,
  formatDate,
  requestMilestones,
  studentDirectory,
  teacherMilestones,
  teacherSeats,
  supervisedStudents,
  teacherTitleChanges,
  teacherTopics,
} from '../../lib/repo'
import type { Milestone } from '../../lib/repo'
import { numar, officialName } from '../../lib/text'
import {
  CHANGE_STATUS_CLASS,
  CHANGE_STATUS_LABELS,
  thesisDiff,
} from '../../lib/title-changes.ts'
import { allYears, currentYear, groupLabel } from '../../lib/years'

const u = Astro.locals.user!
// See departament.astro: an unknown value is not allowed to empty the page.
const SECTIONS = ['cereri', 'studenti', 'progres', 'modificari', 'invitatii'] as const
const requestedSection = Astro.url.searchParams.get('sectiune') ?? ''
const sectiune = (SECTIONS as readonly string[]).includes(requestedSection) ? requestedSection : 'cereri'
const openStudentId = Astro.url.searchParams.get('student')

const [allRequests, studenti, teme, seats, invitatii, studentDirectoryRows, years, titleChanges] =
  await Promise.all([
    teacherRequests(u.id),
    supervisedStudents(u.id),
    teacherTopics(u.id),
    teacherSeats(u.id),
    teacherInvitations(u.id),
    studentDirectory(),
    allYears(),
    teacherTitleChanges(u.id),
  ])

/* A change to an agreed thesis is a decision waiting on the coordinator, so it
 * carries a counter in the bar exactly as the request queue does. The thesis
 * itself stays „aprobată” throughout — see /api/modificari for why. */
const openChanges = titleChanges.filter((c) => c.status === 'pending')
const decidedChanges = titleChanges.filter((c) => c.status !== 'pending')

const pendingRequests = allRequests.filter((c) => c.status === 'pending')
const decidedRequests = allRequests.filter((c) => c.status !== 'pending')

// Only students who do not have a coordinator yet can receive a proposal; the
// others do not even show up in the picker, so that the invitation cannot be
// sent for nothing.
const invitabili = studentDirectoryRows.filter((s) => s.request_status !== 'approved')
const openInvitations = invitatii.filter((i) => i.status === 'pending')

/* One thesis, or all of them.
 *
 * The screen could only ever ask about one student at a time, so „ce am de
 * urmărit săptămâna asta” was a question with twenty page loads in it. The
 * choice travels in the address, like the section, so it can be linked. */
const view = Astro.url.searchParams.get('vedere') === 'toti' ? 'toti' : 'unul'

// The timeline is loaded for the open student; by default, the first supervised one.
const timelineRequest = openStudentId
  ? studenti.find((s) => s.id === openStudentId)
  : studenti[0]

const [milestones, agenda, academicYear] = await Promise.all([
  timelineRequest && view === 'unul' ? requestMilestones(u.id, timelineRequest.id) : [],
  sectiune === 'progres' && view === 'toti' ? teacherMilestones(u.id) : [],
  currentYear(),
])

/** The rows on screen: one thesis' deadlines, or every student's. */
type DeadlineRow = Milestone & {
  student_id?: string
  student_name?: string
  father_initial?: string | null
  thesis_title?: string
}

const deadlines: DeadlineRow[] = view === 'toti' ? agenda : milestones

const sections = [
  { key: 'cereri', text: 'Cereri', count: pendingRequests.length },
  { key: 'studenti', text: 'Studenți coordonați', count: studenti.length },
  { key: 'progres', text: 'Progresul lucrărilor', count: null },
  { key: 'modificari', text: 'Modificări de titlu', count: openChanges.length },
  { key: 'invitatii', text: 'Propuneri trimise', count: openInvitations.length },
]

const currentPath = `/profesor/studenti?sectiune=${sectiune}`
/* `toISOString()` goes through UTC and the portal runs on Europe/Bucharest: at
 * 00:30 the „today” it produced was yesterday, so a defence recorded just after
 * midnight was refused by its own `max`. */
const today = localDay(new Date())

const grouped = groupMilestones(deadlines, today)
const doneCount = grouped.done.length
const overdueCount = grouped.overdue.length

/* Where every deadline form comes back to. The view and the open student are
 * part of it, or saving a row threw you back to somebody else's timeline. */
const progressPath =
  view === 'toti'
    ? '/profesor/studenti?sectiune=progres&vedere=toti'
    : `/profesor/studenti?sectiune=progres&student=${timelineRequest?.id ?? ''}`

/* „Următoarele” is still a list of dates; these are the stretches a coordinator
 * plans in. The heading is drawn only when the bucket changes, so a stretch
 * with nothing in it costs no line. */
const withBuckets = (items: DeadlineRow[], showBuckets: boolean) =>
  items.map((m, i, all) => ({
    m,
    bucket: dueBucket(m.due_on, today),
    opensBucket:
      showBuckets &&
      (i === 0 || dueBucket(all[i - 1].due_on, today) !== dueBucket(m.due_on, today)),
  }))

const deadlineGroups = [
  {
    key: 'overdue',
    title: 'Depășite',
    hint: 'Cel mai vechi primul — de acolo se începe discuția.',
    rows: withBuckets(grouped.overdue, false),
    open: true,
  },
  { key: 'upcoming', title: 'Următoarele', hint: null, rows: withBuckets(grouped.upcoming, true), open: true },
  { key: 'done', title: 'Finalizate', hint: null, rows: withBuckets(grouped.done, false), open: false },
]

/** The bounds of the session, so a deadline cannot be set in another year. */
const deadlineMin = academicYear?.starts_on?.slice(0, 10)
const deadlineMax = academicYear?.ends_on?.slice(0, 10)

/**
 * How long is left to answer a request.
 *
 * A pending request is not open-ended: after a week without a decision the
 * portal refuses it on the coordinator's behalf. The queue has to say so before
 * that happens, and say it louder in the last two days.
 */
function deadline(expiresAt: string | null | undefined) {
  if (!expiresAt) return null
  const days = Math.ceil((new Date(expiresAt).getTime() - Date.now()) / 86_400_000)
  const text =
    days <= 0 ? 'expiră astăzi' : days === 1 ? '1 zi rămasă' : `${days} zile rămase`
  return { days, text, badgeClass: days <= 2 ? 'badge--urgent' : 'badge--asteptare' }
}
---

<ProfesorLayout
  title="Studenți & Cereri"
  lede="Triajul cererilor primite, studenții pe care îi coordonezi și termenele lucrărilor lor."
  active="studenti"
>
  <Taburi
    taburi={sections.map((s) => ({ ...s, href: `/profesor/studenti?sectiune=${s.key}` }))}
    activ={sectiune}
    eticheta="Secțiuni"
  />

  {/* ---------------------------------------------------------------- cereri */}
  {
    sectiune === 'cereri' && (
      <div class="stack">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">În așteptare</h2>
            <span class="muted text-sm">
              {pendingRequests.length} {pendingRequests.length === 1 ? 'cerere' : 'cereri'}
            </span>
          </div>

          {seats.free === 0 && pendingRequests.length > 0 && (
            <p class="fara-locuri">
              <strong>Toate locurile sunt ocupate</strong> ({seats.total_taken}/{seats.total_seats}).
              Nu poți accepta o cerere nouă până nu primești locuri suplimentare.
              <a class="link" href="/profesor/arhiva#locuri">Cere locuri directorului</a>
            </p>
          )}

          {pendingRequests.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere în așteptare</p>
              <p class="empty__text">
                Cererile noi apar aici imediat ce un student le depune. Vei primi și un email.
              </p>
            </div>
          ) : (
            <ul class="cereri">
              {pendingRequests.map((c) => {
                const termen = deadline(c.expires_at)
                return (
                  <li class="cerere" id={`cerere-${c.id}`}>
                    <div class="cerere__cap">
                      <Avatar name={c.student_name} />
                      <div class="cerere__ident">
                        <strong>{officialName({ name: c.student_name, father_initial: c.father_initial })}</strong>
                        <span class="muted">
                          {c.student_number} · {groupLabel(c)}
                          {c.study_group ? ` · grupa ${c.study_group}` : ''}
                        </span>
                      </div>
                      <span class="cerere__termen">
                        <span class="muted">depusă {timeAgo(c.submitted_at)}</span>
                        {termen && (
                          <span class:list={['badge', termen.badgeClass]}>{termen.text}</span>
                        )}
                      </span>
                    </div>

                    <h3 class="cerere__titlu">{c.title_ro}</h3>
                    {c.title_en && <p class="cerere__titlu-en">{c.title_en}</p>}
                    <p class="cerere__scop">{c.objectives}</p>

                    {c.motivation && (
                      <div class="cerere__motivatie">
                        <strong>De ce a ales această temă</strong>
                        <p>{c.motivation}</p>
                      </div>
                    )}

                    <div class="cerere__actiuni">
                      {/* With no free seats the server refuses the acceptance —
                          but only after the coordinator has written the message.
                          The refusal moves ahead of the work, not after it. */}
                      <button
                        class="btn btn--primary btn--sm"
                        type="button"
                        data-decizie="approved"
                        data-cerere={c.id}
                        data-nume={c.student_name}
                        disabled={seats.free === 0}
                        title={
                          seats.free === 0
                            ? `Toate cele ${seats.total_seats} locuri sunt ocupate. Cere locuri suplimentare directorului.`
                            : undefined
                        }
                      >
                        Acceptă coordonarea
                      </button>
                      <button
                        class="btn btn--danger btn--sm"
                        type="button"
                        data-decizie="rejected"
                        data-cerere={c.id}
                        data-nume={c.student_name}
                      >
                        Respinge
                      </button>
                      <a class="btn btn--ghost btn--sm" href={`/profil/${c.student_id}?de_la=${encodeURIComponent(currentPath)}`}>
                        Vezi profilul
                      </a>
                    </div>
                  </li>
                )
              })}
            </ul>
          )}
        </section>

        {decidedRequests.length > 0 && (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">Cereri decise</h2>
            </div>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Cereri decise">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Cerere</th>
                    <th scope="col">Student</th>
                    <th scope="col">Titlul lucrării</th>
                    <th scope="col">Stare</th>
                    <th scope="col">Decisă</th>
                    <th scope="col"><span class="visually-hidden">Document</span></th>
                  </tr>
                </thead>
                <tbody>
                  {decidedRequests.map((c) => (
                    <tr>
                      <td class="numeric muted">{c.number}</td>
                      {/* The name alone, without matricol or cohort, was the
                          one place a decided request could not be matched
                          against the register two rows below where it can. */}
                      <td>
                        <div class="stack stack--tight" style="gap:0">
                          <strong>{officialName({ name: c.student_name, father_initial: c.father_initial })}</strong>
                          <span class="muted text-xs">
                            {c.student_number} · {groupLabel(c)}
                          </span>
                        </div>
                      </td>
                      <td class="celula-title" title={c.title_ro}>{c.title_ro}</td>
                      <td>
                        <span class:list={['badge', STATUS_CLASS[c.status]]}>
                          {STATUS_LABELS[c.status]}
                        </span>
                      </td>
                      <td class="muted">{formatDate(c.decided_at)}</td>
                      <td style="text-align:right">
                        {c.status === 'approved' && (
                          <a class="btn btn--ghost btn--sm" href={`/documente/cerere/${c.id}`} target="_blank">
                            Cerere tipăribilă
                          </a>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    )
  }

  {/* -------------------------------------------------------------- studenți */}
  {
    sectiune === 'studenti' && (
      <section class="panel">
        <div class="panel__header">
          <h2 class="section-title">Studenți coordonați</h2>
          <span class="muted text-sm">
            {seats.total_taken} din {seats.total_seats} locuri · licență{' '}
            {seats.bachelor_taken}/{seats.bachelor_seats} · master{' '}
            {seats.master_taken}/{seats.master_seats}
          </span>
          {/* The coordinator's own export had been in the endpoint from the
              start and was linked from nowhere: the only buttons reached it from
              the head of department's screens, so a coordinator who needed his own
              list on paper — for the minutes, which still circulate printed — was
              copying it out of the table. */}
          {studenti.length > 0 && (
            <a
              class="btn btn--secondary btn--sm"
              href="/profesor/export-coordonari?doar_ale_mele=1"
            >
              Descarcă lista (CSV)
            </a>
          )}
        </div>

        {studenti.length === 0 ? (
          <div class="empty">
            <p class="empty__title">Niciun student coordonat încă</p>
            <p class="empty__text">
              După ce accepți o cerere, studentul apare aici împreună cu cronologia lucrării și firul
              de discuție.
            </p>
          </div>
        ) : (
          <div class="table-wrap" tabindex="0" role="region" aria-label="Directorul studenților">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Student</th>
                  <th scope="col">Titlul lucrării</th>
                  <th scope="col">Progres</th>
                  <th scope="col">Susținere</th>
                  <th scope="col">Mesaje</th>
                  <th scope="col"><span class="visually-hidden">Acțiuni</span></th>
                </tr>
              </thead>
              <tbody>
                {studenti.map((s) => {
                  const percent = s.milestones_total
                    ? Math.round((s.milestones_done / s.milestones_total) * 100)
                    : 0
                  return (
                    <tr>
                      <td>
                        <div class="row" style="gap:var(--s-3)">
                          <Avatar name={s.student_name} href={`/profil/${s.student_id}?de_la=${encodeURIComponent(currentPath)}`} />
                          <div class="celula-student">
                            <strong>{officialName({ name: s.student_name, father_initial: s.father_initial })}</strong>
                            <span class="muted" title={`${s.student_number} · ${groupLabel(s)}`}>
                              {s.student_number} · {groupLabel(s)}
                            </span>
                          </div>
                        </div>
                      </td>
                      <td class="celula-title" title={s.title_ro}>{s.title_ro}</td>
                      <td>
                        <div class="progres">
                          <div class="bara" role="img" aria-label={`Progres ${percent}%`}>
                            <span class="bara__fill" style={`--procent:${percent / 100}`} />
                          </div>
                          <span class="muted numeric text-xs">
                            {s.milestones_done}/{s.milestones_total}
                          </span>
                        </div>
                        {/* Colour alone would not say it, and „4 din 5” does not
                            say it at all: the number of missed deadlines is the
                            one thing a coordinator scanning twenty rows needs. */}
                        {s.milestones_overdue > 0 && (
                          <span class="badge badge--respinsa intarziere">
                            {numar(s.milestones_overdue, 'termen depășit', 'termene depășite')}
                          </span>
                        )}
                      </td>
                      {/* The defence session is not necessarily the one in which
                          the coordination started, and the archive uses the
                          former. */}
                      <td>
                        {/* The value is printed separately, below: the select
                            would widen the table past the edge of the sheet
                            without adding anything. */}
                        <form method="POST" action="/api/sustinere" class="row" style="gap:var(--s-2)" data-tipar="fără">
                          <input type="hidden" name="cerere_id" value={s.id} />
                          <label class="visually-hidden" for={`sus-${s.id}`}>
                            Sesiunea susținerii pentru {s.student_name}
                          </label>
                          <select
                            class="select select--compact"
                            id={`sus-${s.id}`}
                            name="an_id"
                            onchange="this.form.requestSubmit()"
                          >
                            {years.map((a) => (
                              <option
                                value={a.id}
                                selected={(s.graduation_year_id ?? '') === a.id ||
                                  (!s.graduation_year_id && a.is_current)}
                              >
                                {a.label}
                              </option>
                            ))}
                          </select>
                          <noscript>
                            <button class="btn btn--ghost btn--sm" type="submit">Salvează</button>
                          </noscript>
                        </form>
                        {/* On paper the form disappears; the session stays. */}
                        <span class="doar-tipar numeric">
                          {years.find((a) =>
                            (s.graduation_year_id ?? '') === a.id ||
                            (!s.graduation_year_id && a.is_current),
                          )?.label ?? ''}
                        </span>
                      </td>
                      <td>
                        {s.unread > 0 ? (
                          <span class="badge badge--asteptare">{s.unread} necitite</span>
                        ) : (
                          <span class="muted">—</span>
                        )}
                      </td>
                      <td>
                        <div class="row" style="gap:var(--s-2);justify-content:flex-end">
                          <a
                            class="btn btn--secondary btn--sm"
                            href={`/profesor/studenti?sectiune=progres&student=${s.id}`}
                          >
                            Termene
                          </a>
                          <a class="btn btn--ghost btn--sm" href={`/profesor/mesaje?student=${s.student_id}`}>
                            Mesaje
                          </a>
                          {/* The coordinator's own edit needs nobody's
                              approval, so it is applied on save — but it is
                              written into the same history as a student's
                              request, and the student is told. */}
                          <button
                            class="btn btn--ghost btn--sm"
                            type="button"
                            data-lucrare={s.id}
                            data-nume={s.student_name}
                            data-titlu-ro={s.title_ro}
                            data-titlu-en={s.title_en ?? ''}
                            data-obiective={s.objectives}
                          >
                            Editează lucrarea
                          </button>
                          <a
                            class="btn btn--ghost btn--sm"
                            href={`/profesor/consultatii?cu=${s.student_id}`}
                          >
                            Programează consultație
                          </a>
                          {/* Finishing the thesis had no state of its own: the
                              coordination stayed „aprobată” for ever, the seat
                              stayed taken, and the archive recorded the approval
                              date as the date of the defence. */}
                          <button
                            class="btn btn--secondary btn--sm"
                            type="button"
                            data-sustinuta={s.id}
                            data-nume={s.student_name}
                          >
                            A susținut
                          </button>
                        </div>
                      </td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )
  }

  {/* -------------------------------------------------------------- progres */}
  {
    sectiune === 'progres' && (
      <div class="stack">
        {studenti.length === 0 ? (
          <section class="panel">
            <div class="empty">
              <p class="empty__title">Nicio lucrare de urmărit</p>
              <p class="empty__text">
                Termenele devin disponibile după ce accepți prima cerere de coordonare.
              </p>
              <a class="btn btn--secondary btn--sm" href="/profesor/studenti?sectiune=cereri">
                Vezi cererile primite
              </a>
            </div>
          </section>
        ) : (
          <section class="panel">
            <div class="panel__header panel__header--agenda">
              <h2 class="section-title">
                {view === 'toti' ? 'Agenda termenelor' : 'Termenele lucrării'}
              </h2>

              {/* Links, not a script: the view is an address, and the whole
                  screen already works without JavaScript. */}
              <div class="comutator" role="group" aria-label="Ce se afișează">
                <a
                  class:list={['comutator__optiune', { 'is-activ': view === 'unul' }]}
                  href={`/profesor/studenti?sectiune=progres${timelineRequest ? `&student=${timelineRequest.id}` : ''}`}
                  aria-current={view === 'unul' ? 'true' : undefined}
                >
                  Un student
                </a>
                <a
                  class:list={['comutator__optiune', { 'is-activ': view === 'toti' }]}
                  href="/profesor/studenti?sectiune=progres&vedere=toti"
                  aria-current={view === 'toti' ? 'true' : undefined}
                >
                  Toți studenții
                </a>
              </div>

              <div class="row row--wrap" style="gap:var(--s-2)">
                {view === 'unul' && timelineRequest && (
                  <button class="btn btn--primary btn--sm" type="button" data-termen-nou={timelineRequest.id}>
                    Adaugă un termen
                  </button>
                )}
                <button class="btn btn--secondary btn--sm" type="button" data-termen-multi>
                  Termen pentru mai mulți studenți
                </button>
              </div>
            </div>

            {view === 'unul' && (
              <div class="panel__body panel__body--alegere">
                <form method="GET" class="row row--wrap" style="gap:var(--s-3);align-items:flex-end">
                  <input type="hidden" name="sectiune" value="progres" />
                  <div class="field" style="flex:1;min-width:280px">
                    <label class="label" for="student">Lucrarea urmărită</label>
                    <select class="select" id="student" name="student" onchange="this.form.submit()">
                      {studenti.map((s) => (
                        <option value={s.id} selected={timelineRequest?.id === s.id}>
                          {s.student_name} — {s.title_ro}
                          {s.milestones_overdue > 0 ? ` · ${s.milestones_overdue} depășite` : ''}
                        </option>
                      ))}
                    </select>
                  </div>
                  <noscript>
                    <button class="btn btn--secondary" type="submit">Afișează</button>
                  </noscript>
                </form>
              </div>
            )}

            {/* The count is the state of the work, so it says all three numbers:
                „4 din 5” alone hides whether the fifth is due next month or was
                due in March. */}
            <p class="sumar">
              <span>
                <strong class="numeric">{doneCount}</strong> din{' '}
                <strong class="numeric">{deadlines.length}</strong> finalizate
              </span>
              {overdueCount > 0 && (
                <span class="badge badge--respinsa">
                  {numar(overdueCount, 'termen depășit', 'termene depășite')}
                </span>
              )}
              {view === 'toti' && (
                <span class="muted">
                  peste {numar(studenti.length, 'lucrare', 'lucrări')}
                </span>
              )}
            </p>

            {deadlines.length === 0 ? (
              <div class="empty">
                <p class="empty__title">Niciun termen stabilit</p>
                <p class="empty__text">
                  {view === 'toti'
                    ? 'Pune același termen tuturor studenților dintr-o singură dată — titlul și data se scriu o dată.'
                    : 'Primul termen dă lucrării un început. Studentul îl vede imediat în portal.'}
                </p>
                {view === 'unul' && timelineRequest ? (
                  <button class="btn btn--primary btn--sm" type="button" data-termen-nou={timelineRequest.id}>
                    Adaugă primul termen
                  </button>
                ) : (
                  <button class="btn btn--primary btn--sm" type="button" data-termen-multi>
                    Termen pentru mai mulți studenți
                  </button>
                )}
              </div>
            ) : (
              <div class="grupe">
                {deadlineGroups
                  .filter((g) => g.rows.length > 0)
                  .map((g) => (
                    <details class:list={['grupa', `grupa--${g.key}`]} open={g.open}>
                      <summary class="grupa__cap">
                        <span class="grupa__titlu">{g.title}</span>
                        <span class="grupa__contor numeric">{g.rows.length}</span>
                        {g.hint && <span class="grupa__nota muted">{g.hint}</span>}
                      </summary>

                      <ol class="termene">
                        {g.rows.map(({ m, bucket, opensBucket }) => {
                          const stare = milestoneState(m.status, m.due_on, today)
                          const hint = dueHint(m.due_on, today)
                          return (
                            <>
                              {opensBucket && (
                                <li class="termene__sectiune" role="presentation">
                                  {BUCKET_LABELS[bucket]}
                                </li>
                              )}
                              <li class:list={['termen', `termen--${stare}`]}>
                                <span class="jalon__punct" aria-hidden="true" />
                                <div class="jalon__corp">
                                  <div class="jalon__cap">
                                    <strong class="jalon__titlu">{m.title}</strong>
                                    <span class:list={['badge', MILESTONE_STATE_CLASS[stare]]}>
                                      {MILESTONE_STATE_LABELS[stare]}
                                    </span>
                                  </div>

                                  <p class="jalon__meta">
                                    {view === 'toti' && m.student_name && (
                                      <a
                                        class="jalon__student"
                                        href={`/profesor/studenti?sectiune=progres&student=${m.request_id}`}
                                      >
                                        {officialName({
                                          name: m.student_name,
                                          father_initial: m.father_initial,
                                        })}
                                      </a>
                                    )}
                                    <span class="muted">
                                      {m.due_on ? formatDate(m.due_on) : 'fără termen'}
                                      {hint && stare !== 'done' ? ` · ${hint}` : ''}
                                    </span>
                                  </p>

                                  {m.description && (
                                    <p class="jalon__descriere" title={m.description}>
                                      {m.description}
                                    </p>
                                  )}

                                  <div class="jalon__actiuni">
                                    {/* Three buttons, one statement each: the
                                        state used to cost expanding the row,
                                        changing a select and a full save that
                                        carried the title and the date with it. */}
                                    <form
                                      method="POST"
                                      action="/api/termene"
                                      class="stare"
                                      aria-label={`Starea termenului „${m.title}”`}
                                    >
                                      <input type="hidden" name="actiune" value="stare" />
                                      <input type="hidden" name="termen_id" value={m.id} />
                                      <input type="hidden" name="redirect" value={progressPath} />
                                      {Object.entries(MILESTONE_LABELS).map(([valoare, eticheta]) => (
                                        <button
                                          class:list={['stare__optiune', { 'is-activ': m.status === valoare }]}
                                          type="submit"
                                          name="status"
                                          value={valoare}
                                          aria-pressed={m.status === valoare}
                                          disabled={m.status === valoare}
                                        >
                                          {eticheta}
                                        </button>
                                      ))}
                                    </form>

                                    <button
                                      class="btn btn--ghost btn--sm"
                                      type="button"
                                      data-termen-editeaza={m.id}
                                      data-titlu={m.title}
                                      data-data={m.due_on ? m.due_on.slice(0, 10) : ''}
                                      data-stare={m.status}
                                      data-descriere={m.description ?? ''}
                                    >
                                      Editează
                                    </button>
                                  </div>
                                </div>
                              </li>
                            </>
                          )
                        })}
                      </ol>
                    </details>
                  ))}
              </div>
            )}

            {/* Without JavaScript the dialog never opens, and adding a deadline
                is the one thing this screen exists for. The plain form stays. */}
            {view === 'unul' && timelineRequest && (
              <noscript>
                <div class="panel__footer">
                  <form
                    method="POST"
                    action="/api/termene"
                    class="row row--wrap"
                    style="gap:var(--s-3);align-items:flex-end"
                  >
                    <input type="hidden" name="actiune" value="adauga" />
                    <input type="hidden" name="cerere_id" value={timelineRequest.id} />
                    <input type="hidden" name="redirect" value={progressPath} />
                    <div class="field" style="flex:2;min-width:220px">
                      <label class="label" for="termen-nou-simplu">Termen nou</label>
                      <input
                        class="input"
                        id="termen-nou-simplu"
                        name="title"
                        placeholder="Ex: Predarea capitolului empiric"
                        required
                      />
                    </div>
                    <div class="field" style="flex:1;min-width:160px">
                      <label class="label" for="termen-data-simplu">Termen</label>
                      <input
                        class="input"
                        id="termen-data-simplu"
                        name="termen"
                        type="date"
                        min={deadlineMin}
                        max={deadlineMax}
                      />
                    </div>
                    <button class="btn btn--secondary" type="submit">Adaugă termenul</button>
                  </form>
                </div>
              </noscript>
            )}
          </section>
        )}
      </div>
    )
  }

  {/* ----------------------------------------------------------- modificări */}
  {
    sectiune === 'modificari' && (
      <div class="stack">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Modificări cerute de studenți</h2>
            <span class="muted text-sm">
              {openChanges.length} {openChanges.length === 1 ? 'cerere' : 'cereri'}
            </span>
          </div>

          {openChanges.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio modificare în așteptare</p>
              <p class="empty__text">
                Când un student cere să schimbe titlul sau obiectivele lucrării, cererea apare
                aici. Coordonarea rămâne activă până decizi — locul, conversația și documentul
                tipăribil nu se schimbă între timp.
              </p>
              <a class="btn btn--secondary btn--sm" href="/profesor/studenti?sectiune=studenti">
                Vezi studenții coordonați
              </a>
            </div>
          ) : (
            <ul class="cereri">
              {openChanges.map((c) => {
                const changes = thesisDiff(
                  { title_ro: c.old_title_ro, title_en: c.old_title_en, objectives: c.old_objectives },
                  { title_ro: c.new_title_ro, title_en: c.new_title_en, objectives: c.new_objectives },
                )
                return (
                  <li class="cerere" id={`modificare-${c.id}`}>
                    <div class="cerere__cap">
                      <Avatar name={c.student_name} />
                      <div class="cerere__ident">
                        <strong>
                          {officialName({ name: c.student_name, father_initial: c.father_initial })}
                        </strong>
                        <span class="muted">
                          {c.student_number} · cererea {c.number}
                        </span>
                      </div>
                      <span class="cerere__termen">
                        <span class="muted">cerută {timeAgo(c.created_at)}</span>
                      </span>
                    </div>

                    {/* The diff, not the whole request: only what differs is a
                        decision, and repeating the unchanged fields buries it. */}
                    <dl class="diferenta">
                      {changes.map((d) => (
                        <div class="diferenta__camp">
                          <dt>{d.label}</dt>
                          <dd>
                            <span class="diferenta__vechi">{d.from}</span>
                            <span class="diferenta__nou">{d.to}</span>
                          </dd>
                        </div>
                      ))}
                    </dl>

                    {c.reason && (
                      <div class="cerere__motivatie">
                        <strong>De ce cere modificarea</strong>
                        <p>{c.reason}</p>
                      </div>
                    )}

                    <div class="cerere__actiuni">
                      <button
                        class="btn btn--primary btn--sm"
                        type="button"
                        data-modificare="approved"
                        data-id={c.id}
                        data-nume={c.student_name}
                      >
                        Acceptă modificarea
                      </button>
                      <button
                        class="btn btn--danger btn--sm"
                        type="button"
                        data-modificare="rejected"
                        data-id={c.id}
                        data-nume={c.student_name}
                      >
                        Respinge modificarea
                      </button>
                      <a class="btn btn--ghost btn--sm" href={`/profesor/mesaje?student=${c.student_id}`}>
                        Scrie-i întâi
                      </a>
                    </div>
                  </li>
                )
              })}
            </ul>
          )}
        </section>

        {decidedChanges.length > 0 && (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">Istoricul modificărilor</h2>
              <span class="muted text-sm">Inclusiv cele făcute de tine</span>
            </div>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Istoricul modificărilor de titlu">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Student</th>
                    <th scope="col">Cerută de</th>
                    <th scope="col">Titlul dinainte</th>
                    <th scope="col">Titlul de acum</th>
                    <th scope="col">Stare</th>
                    <th scope="col">Decisă</th>
                  </tr>
                </thead>
                <tbody>
                  {decidedChanges.map((c) => (
                    <tr>
                      <td>
                        <strong>
                          {officialName({ name: c.student_name, father_initial: c.father_initial })}
                        </strong>
                      </td>
                      <td class="muted">{c.by_teacher ? 'Tine' : 'Student'}</td>
                      <td class="celula-title" title={c.old_title_ro}>{c.old_title_ro}</td>
                      <td class="celula-title" title={c.new_title_ro}>{c.new_title_ro}</td>
                      <td>
                        <span class:list={['badge', CHANGE_STATUS_CLASS[c.status]]}>
                          {CHANGE_STATUS_LABELS[c.status]}
                        </span>
                      </td>
                      <td class="muted">{formatDate(c.decided_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    )
  }

  {/* --------------------------------------------------------- invitații */}
  {
    sectiune === 'invitatii' && (
      <div class="stack">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Propune coordonarea unui student</h2>
            <span class="muted text-sm">
              {seats.free} {seats.free === 1 ? 'loc liber' : 'locuri libere'}
            </span>
          </div>

          {seats.free === 0 ? (
            <div class="empty">
              <p class="empty__title">Nu mai ai locuri libere</p>
              <p class="empty__text">
                Nu poți invita un student cât timp toate locurile sunt ocupate. Cere locuri
                suplimentare directorului de departament din pagina Arhivă & Profil.
              </p>
              <a class="btn btn--secondary btn--sm" href="/profesor/arhiva">Cere locuri</a>
            </div>
          ) : (
            <form method="POST" action="/api/invitatii" class="panel__body stack">
              <input type="hidden" name="actiune" value="trimite" />

              {/* Two equal columns, aligned at the top. In a flex row, the hint
                  text under one field pushed only its own column, and the two
                  controls no longer sat on the same line. */}
              <div class="invitatie__rand">
                <div class="field">
                  <label class="label" for="student_nume">Student</label>
                  {/* A `<datalist>` makes the list searchable without it ceasing
                      to be a list: you can type in order to filter, or you can
                      browse. With twenty-five names, scrolling was the only
                      option. */}
                  <input
                    class="input"
                    id="student_nume"
                    list="lista-invitabili"
                    placeholder="Scrie un nume sau alege din listă…"
                    autocomplete="off"
                    aria-describedby="ajutor-invitabili"
                  />
                  <datalist id="lista-invitabili">
                    {invitabili.map((s) => (
                      <option
                        value={`${officialName(s)} — ${groupLabel(s)}${s.request_status === 'pending' ? ' · are o cerere depusă' : ''}`}
                        data-id={s.id}
                      />
                    ))}
                  </datalist>
                  <input type="hidden" id="student_id" name="student_id" required />
                  <span class="hint" id="ajutor-invitabili">
                    {invitabili.length}{' '}
                    {invitabili.length === 1 ? 'student disponibil' : 'studenți disponibili'} — doar
                    cei fără coordonator confirmat.
                  </span>
                </div>
                <div class="field">
                  <label class="label" for="tema_id">Temă propusă <span class="muted">(opțional)</span></label>
                  <select class="select" id="tema_id" name="tema_id">
                    <option value="">Fără temă anume</option>
                    {teme
                      .filter((t) => t.is_active)
                      .map((t) => (
                        <option value={t.id}>{t.title}</option>
                      ))}
                  </select>
                  <span class="hint">Studentul o vede în propunere, dar nu este obligată.</span>
                </div>
              </div>

              <div class="field">
                <label class="label" for="mesaj">Mesajul propunerii</label>
                <textarea
                  class="textarea"
                  id="mesaj"
                  name="mesaj"
                  rows="3"
                  minlength="30"
                  required
                  placeholder="Spune-i de ce l-ai ales și ce temă ai în minte. Studentul decide pe baza acestui mesaj."
                data-autogrow />
                <span class="hint">
                  Studentul primește propunerea pe email și în conversație. Expiră după{' '}
                  {INVITATION_WINDOW_DAYS} de zile.
                </span>
              </div>

              <div class="row row--end">
                <button class="btn btn--primary" type="submit">Trimite propunerea</button>
              </div>
            </form>
          )}
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Propuneri trimise</h2>
          </div>

          {invitatii.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio propunere trimisă</p>
              <p class="empty__text">
                Catalogul funcționează într-o singură direcție: studentul te caută. O propunere
                pornește pairing-ul din partea ta, iar studentul tot el decide.
              </p>
            </div>
          ) : (
            <ul class="invitatii">
              {invitatii.map((i) => (
                <li>
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <div class="row" style="gap:var(--s-3)">
                      <Avatar name={i.student_name} size="xs" />
                      <div class="stack stack--tight" style="gap:0">
                        <strong class="text-sm">
                          {officialName({ name: i.student_name, father_initial: i.father_initial })}
                        </strong>
                        <span class="muted text-xs">
                          {i.student_number} · trimisă {timeAgo(i.created_at)}
                        </span>
                      </div>
                    </div>
                    <span
                      class:list={[
                        'badge',
                        i.status === 'accepted'
                          ? 'badge--aprobata'
                          : i.status === 'pending'
                            ? 'badge--in-lucru'
                            : 'badge--respinsa',
                      ]}
                    >
                      {INVITATION_LABELS[i.status]}
                    </span>
                  </div>

                  {i.topic_title && (
                    <p class="muted text-xs">Temă propusă: {i.topic_title}</p>
                  )}
                  <p class="invitatii__mesaj">{i.message}</p>

                  {i.response_reason && (
                    <p class="reason">
                      <strong>Motivul refuzului:</strong> {i.response_reason}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    )
  }

  {/* Both decisions go through the same dialog, because both deserve a message:
      a rejection with no reason leaves the student guessing, and an acceptance
      without a word is a state change where a sentence was expected. */}
  {/* The defence, as a fact: the real date and, optionally, the mark. The
      coordination closes, the seat is freed, and the thesis enters the archive
      under the correct date. */}
  <dialog id="dialog-sustinere" aria-labelledby="titlu-sustinere">
    <form method="POST" action="/api/sustinere" class="dialog">
      <h2 id="titlu-sustinere" class="section-title">Înregistrează susținerea</h2>
      <input type="hidden" name="actiune" value="sustinuta" />
      <input type="hidden" name="cerere_id" id="sustinere-id" />

      <p class="muted text-sm">
        Confirmi că <strong id="sustinere-nume">studentul</strong> și-a susținut lucrarea. Coordonarea
        se închide, locul se eliberează, iar lucrarea intră în arhivă cu data susținerii.
      </p>

      <div class="row row--wrap" style="gap:var(--s-3)">
        <div class="field" style="flex:1;min-width:170px">
          <label class="label" for="sustinere-data">
            Data susținerii <span class="label__req" aria-hidden="true">*</span>
          </label>
          <input class="input" id="sustinere-data" name="data" type="date" max={today} required />
        </div>
        <div class="field" style="flex:1;min-width:130px">
          <label class="label" for="sustinere-nota">Nota <span class="muted">(opțional)</span></label>
          <input class="input" id="sustinere-nota" name="nota" type="number" min="1" max="10" step="0.01" />
        </div>
      </div>

      <div class="row row--end" style="gap:var(--s-2)">
        <button class="btn btn--ghost btn--sm" type="button" data-inchide-sustinere>Renunț</button>
        <button class="btn btn--primary btn--sm" type="submit">Înregistrează</button>
      </div>
    </form>
  </dialog>

  <dialog id="dialog-decizie" aria-labelledby="titlu-decizie">
    <form method="POST" action="/api/cereri/decizie" class="dialog">
      <h2 class="section-title" id="dialog-titlu">Decizia ta</h2>
      <p class="muted text-sm" id="dialog-explicatie">
        Mesajul ajunge la student prin email și rămâne în conversație.
      </p>

      <input type="hidden" name="cerere_id" id="dialog-cerere" />
      <input type="hidden" name="decizie" id="dialog-decizie-camp" />
      <input type="hidden" name="redirect" value={currentPath} />

      <div class="field">
        <label class="label" for="motiv" id="dialog-eticheta">Mesaj pentru student</label>
        <textarea class="textarea" id="motiv" name="motiv" rows="4" data-autogrow></textarea>
        <span class="hint" id="dialog-hint" />
      </div>

      <div class="row" style="justify-content:flex-end;gap:var(--s-2)">
        <button class="btn btn--secondary" type="button" data-inchide>Renunță</button>
        <button class="btn btn--primary" type="submit" id="dialog-trimite">Trimite</button>
      </div>
    </form>
  </dialog>
  {/* One window for both gestures. A separate „adaugă” form at the bottom of
      the page meant scrolling past the whole timeline to reach it, and a new
      deadline landed at the end of the list whatever its date; the editor was
      a second `<details>` to open and a second reload. */}
  <dialog id="dialog-termen" aria-labelledby="titlu-termen">
    <form method="POST" action="/api/termene" class="dialog">
      <div class="row row--between" style="gap:var(--s-3)">
        <h2 id="titlu-termen" class="section-title">Termen nou</h2>
        <button class="btn btn--ghost btn--sm" type="button" data-inchide-termen aria-label="Închide">✕</button>
      </div>

      <input type="hidden" name="actiune_implicita" id="termen-actiune" value="adauga" />
      <input type="hidden" name="termen_id" id="termen-id" />
      <input type="hidden" name="cerere_id" id="termen-cerere" />
      <input type="hidden" name="redirect" value={progressPath} />

      <div class="field">
        <label class="label" for="termen-titlu">
          Titlu <span class="label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="input"
          id="termen-titlu"
          name="title"
          required
          maxlength="160"
          placeholder="Ex: Predarea capitolului empiric"
        />
      </div>

      <div class="row row--wrap" style="gap:var(--s-3);align-items:flex-start">
        <AlegeData
          id="termen-data"
          name="termen"
          label="Termen"
          min={deadlineMin}
          max={deadlineMax}
          style="flex:1;min-width:190px"
          hint="Lăsat gol, termenul rămâne fără dată și stă la coada listei."
        />
        <div class="field" style="flex:1;min-width:170px">
          <label class="label" for="termen-stare">Stare</label>
          <select class="select" id="termen-stare" name="status">
            {Object.entries(MILESTONE_LABELS).map(([v, t]) => (
              <option value={v}>{t}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label class="label" for="termen-descriere">
          Descriere <span class="muted">(opțional)</span>
        </label>
        <textarea
          class="textarea"
          id="termen-descriere"
          name="descriere"
          rows="2"
          style="min-height:64px"
          placeholder="Ce anume se predă și în ce formă. Studentul vede exact acest text."
          data-autogrow
        />
      </div>

      <div class="row row--between row--wrap" style="gap:var(--s-2)">
        {/* Out of the primary flow, but still one click away, with the toast
            undo behind it — a confirmation dialog on every small gesture makes
            all of them tiring. */}
        <button
          class="btn btn--ghost btn--sm dialog__sterge"
          type="submit"
          name="actiune"
          value="sterge"
          id="termen-sterge"
          hidden
        >
          Șterge termenul
        </button>
        <div class="row" style="gap:var(--s-2);margin-left:auto">
          <button class="btn btn--secondary btn--sm" type="button" data-inchide-termen>Renunț</button>
          <button class="btn btn--primary btn--sm" type="submit" id="termen-trimite">
            Adaugă termenul
          </button>
        </div>
      </div>
    </form>
  </dialog>

  {/* Five students, one deadline: the title and the date are written once. */}
  <dialog id="dialog-termen-multi" aria-labelledby="titlu-termen-multi">
    <form method="POST" action="/api/termene" class="dialog">
      <div class="row row--between" style="gap:var(--s-3)">
        <h2 id="titlu-termen-multi" class="section-title">Termen pentru mai mulți studenți</h2>
        <button class="btn btn--ghost btn--sm" type="button" data-inchide-multi aria-label="Închide">✕</button>
      </div>

      <input type="hidden" name="actiune" value="adauga_multi" />
      <input type="hidden" name="redirect" value={progressPath} />

      <div class="field">
        <label class="label" for="multi-titlu">
          Titlu <span class="label__req" aria-hidden="true">*</span>
        </label>
        <input
          class="input"
          id="multi-titlu"
          name="title"
          required
          maxlength="160"
          placeholder="Ex: Predarea capitolului teoretic"
        />
      </div>

      <div class="row row--wrap" style="gap:var(--s-3);align-items:flex-start">
        <AlegeData
          id="multi-data"
          name="termen"
          label="Termen"
          min={deadlineMin}
          max={deadlineMax}
          style="flex:1;min-width:190px"
        />
        <div class="field" style="flex:2;min-width:220px">
          <label class="label" for="multi-descriere">
            Descriere <span class="muted">(opțional)</span>
          </label>
          <input class="input" id="multi-descriere" name="descriere" maxlength="400" />
        </div>
      </div>

      <fieldset class="alegere-studenti">
        <legend class="label">
          Studenți <span class="label__req" aria-hidden="true">*</span>
        </legend>
        <label class="alegere-studenti__tot">
          <input type="checkbox" id="multi-toti" />
          <span>Selectează toți cei {studenti.length} studenți</span>
        </label>
        <div class="alegere-studenti__lista">
          {studenti.map((s) => (
            <label class="alegere-studenti__rand">
              <input type="checkbox" name="cerere_id" value={s.id} data-student />
              <span class="alegere-studenti__nume">
                {officialName({ name: s.student_name, father_initial: s.father_initial })}
                <span class="muted text-xs"> · {groupLabel(s)}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="row row--end" style="gap:var(--s-2)">
        <button class="btn btn--secondary btn--sm" type="button" data-inchide-multi>Renunț</button>
        <button class="btn btn--primary btn--sm" type="submit" id="multi-trimite" disabled>
          Alege cel puțin un student
        </button>
      </div>
    </form>
  </dialog>
  {/* The decision on a student's change. The same shape as the decision on a
      request — two buttons carrying the verdict, one dialog, one COPY object —
      rather than a second pattern for the same gesture. */}
  <dialog id="dialog-modificare" aria-labelledby="titlu-modificare">
    <form method="POST" action="/api/modificari" class="dialog">
      <h2 class="section-title" id="titlu-modificare">Decizia ta</h2>
      <p class="muted text-sm" id="modificare-explicatie">
        Mesajul ajunge la student prin email și rămâne în conversație.
      </p>

      <input type="hidden" name="actiune" value="decizie" />
      <input type="hidden" name="modificare_id" id="modificare-id" />
      <input type="hidden" name="decizie" id="modificare-decizie" />
      <input type="hidden" name="redirect" value="/profesor/studenti?sectiune=modificari" />

      <div class="field">
        <label class="label" for="modificare-motiv" id="modificare-eticheta">
          Mesaj pentru student
        </label>
        <textarea class="textarea" id="modificare-motiv" name="motiv" rows="4" data-autogrow />
        <span class="hint" id="modificare-hint" />
      </div>

      <div class="row row--end" style="gap:var(--s-2)">
        <button class="btn btn--secondary btn--sm" type="button" data-inchide-modificare>Renunță</button>
        <button class="btn btn--primary btn--sm" type="submit" id="modificare-trimite">Trimite</button>
      </div>
    </form>
  </dialog>

  {/* The coordinator's own edit: applied on save, recorded, and announced. */}
  <dialog id="dialog-lucrare" aria-labelledby="titlu-lucrare">
    <form method="POST" action="/api/modificari" class="dialog">
      <div class="row row--between" style="gap:var(--s-3)">
        <h2 class="section-title" id="titlu-lucrare">Editează lucrarea</h2>
        <button class="btn btn--ghost btn--sm" type="button" data-inchide-lucrare aria-label="Închide">✕</button>
      </div>

      <input type="hidden" name="actiune" value="aplica" />
      <input type="hidden" name="cerere_id" id="lucrare-id" />
      <input type="hidden" name="redirect" value="/profesor/studenti?sectiune=studenti" />

      <p class="muted text-sm">
        Modificarea intră în vigoare la salvare, iar <strong id="lucrare-nume">studentul</strong> este
        anunțat. Titlul nou apare peste tot, inclusiv în arhivă și în cererea tipăribilă — dacă
        exemplarul semnat este deja la secretariat, va trebui tipărit din nou.
      </p>

      <div class="field">
        <label class="label" for="lucrare-titlu-ro">
          Titlul lucrării (română) <span class="label__req" aria-hidden="true">*</span>
        </label>
        <input class="input" id="lucrare-titlu-ro" name="titlu_ro" required maxlength="200" />
      </div>

      <div class="field">
        <label class="label" for="lucrare-titlu-en">
          Titlul lucrării în engleză <span class="muted">(opțional)</span>
        </label>
        <input class="input" id="lucrare-titlu-en" name="titlu_en" maxlength="200" />
      </div>

      <div class="field">
        <label class="label" for="lucrare-obiective">
          Scopul și obiectivele <span class="label__req" aria-hidden="true">*</span>
        </label>
        <textarea
          class="textarea"
          id="lucrare-obiective"
          name="scop_obiective"
          rows="5"
          required
          minlength="40"
          data-autogrow
        />
      </div>

      <div class="field">
        <label class="label" for="lucrare-motiv">
          De ce ai schimbat <span class="muted">(opțional, ajunge la student)</span>
        </label>
        <input
          class="input"
          id="lucrare-motiv"
          name="motiv"
          maxlength="400"
          placeholder="Ex: am restrâns tema la comerțul online, așa cum am discutat la consultație."
        />
      </div>

      <div class="row row--end" style="gap:var(--s-2)">
        <button class="btn btn--secondary btn--sm" type="button" data-inchide-lucrare>Renunț</button>
        <button class="btn btn--primary btn--sm" type="submit">Salvează și anunță studentul</button>
      </div>
    </form>
  </dialog>
</ProfesorLayout>

<script>
  const dialog = document.getElementById('dialog-decizie') as HTMLDialogElement | null
  const camp = document.getElementById('dialog-cerere') as HTMLInputElement | null
  const decisionField = document.getElementById('dialog-decizie-camp') as HTMLInputElement | null
  const textarea = document.getElementById('motiv') as HTMLTextAreaElement | null

  const COPY = {
    approved: {
      titlu: 'Acceptă coordonarea',
      button: 'Acceptă și trimite',
      eticheta: 'Mesaj pentru student (opțional)',
      hint: 'Apare în emailul de confirmare și în conversație. Un rând despre ce urmează ajută mai mult decât o notificare goală.',
      placeholder: 'Ex: Ne vedem la prima consultație de marți ca să stabilim bibliografia.',
      required: false,
    },
    rejected: {
      titlu: 'Respinge cererea',
      button: 'Trimite respingerea',
      eticheta: 'Motivul respingerii',
      hint: 'Minimum 10 caractere. Studentul trebuie să știe ce ar trebui schimbat.',
      placeholder: 'Ex: Tema se suprapune cu o lucrare deja alocată. Te rog reformulează direcția de cercetare.',
      required: true,
    },
  }

  document.querySelectorAll<HTMLButtonElement>('[data-decizie]').forEach((b) => {
    b.addEventListener('click', () => {
      const decizie = b.dataset.decizie === 'approved' ? 'approved' : 'rejected'
      const copy = COPY[decizie]

      if (camp) camp.value = b.dataset.cerere ?? ''
      if (decisionField) decisionField.value = decizie

      const set = (id: string, text: string) => {
        const el = document.getElementById(id)
        if (el) el.textContent = text
      }
      set('dialog-titlu', copy.titlu)
      set('dialog-trimite', copy.button)
      set('dialog-eticheta', copy.eticheta)
      set('dialog-hint', copy.hint)
      set(
        'dialog-explicatie',
        `Mesajul ajunge la ${b.dataset.nume ?? 'student'} prin email și rămâne în conversație.`,
      )

      if (textarea) {
        textarea.value = ''
        textarea.placeholder = copy.placeholder
        textarea.required = copy.required
        textarea.minLength = copy.required ? 10 : 0
      }

      dialog?.showModal()
    })
  })

  dialog?.querySelector('[data-inchide]')?.addEventListener('click', () => dialog.close())

  // An online slot needs a link, one held at the faculty needs an address. The
  // irrelevant field disappears instead of staying empty and required.
  document.querySelectorAll<HTMLFormElement>('form').forEach((form) => {
    const mod = form.querySelector<HTMLSelectElement>('[data-mod]')
    if (!mod) return

    const locationField = form.querySelector<HTMLElement>('[data-camp-locatie]')
    const link = form.querySelector<HTMLInputElement>('input[name="link_online"]')
    const optional = form.querySelector<HTMLElement>('[data-link-optional]')

    const sync = () => {
      const online = mod.value === 'online'
      if (locationField) locationField.hidden = online
      if (link) link.required = online
      if (optional) optional.hidden = online
    }

    mod.addEventListener('change', sync)
    sync()
  })

  /* --- the defence --------------------------------------------------------- */
  const defenceDialog = document.getElementById('dialog-sustinere') as HTMLDialogElement | null

  document.querySelectorAll<HTMLButtonElement>('[data-sustinuta]').forEach((b) => {
    b.addEventListener('click', () => {
      const camp = document.getElementById('sustinere-id') as HTMLInputElement | null
      const nume = document.getElementById('sustinere-nume')
      if (camp) camp.value = b.dataset.sustinuta ?? ''
      if (nume) nume.textContent = b.dataset.nume ?? 'studentul'
      defenceDialog?.showModal()
      document.getElementById('sustinere-data')?.focus()
    })
  })

  defenceDialog
    ?.querySelectorAll('[data-inchide-sustinere]')
    .forEach((b) => b.addEventListener('click', () => defenceDialog.close()))

  /* --- deciding on a change of title --------------------------------------
   *
   * The same shape as the decision on a request: two buttons carrying the
   * verdict, one dialog, one COPY object swapped in. A second pattern for the
   * same gesture would be a second place to keep the wording right. */
  const changeDialog = document.getElementById('dialog-modificare') as HTMLDialogElement | null

  const CHANGE_COPY = {
    approved: {
      titlu: 'Acceptă modificarea',
      button: 'Acceptă și aplică',
      eticheta: 'Mesaj pentru student (opțional)',
      hint: 'Titlul nou intră imediat peste tot: în portal, în arhivă și în cererea tipăribilă.',
      placeholder: 'Ex: De acord cu restrângerea temei. Actualizează și bibliografia până la următoarea consultație.',
      required: false,
    },
    rejected: {
      titlu: 'Respinge modificarea',
      button: 'Trimite respingerea',
      eticheta: 'Motivul respingerii',
      hint: 'Minimum 10 caractere. Lucrarea rămâne cu titlul de dinainte, iar studentul trebuie să știe de ce.',
      placeholder: 'Ex: Titlul nou nu mai acoperă obiectivele aprobate. Reformulează-l păstrând componenta empirică.',
      required: true,
    },
  }

  document.querySelectorAll<HTMLButtonElement>('[data-modificare]').forEach((b) => {
    b.addEventListener('click', () => {
      const verdict = b.dataset.modificare === 'approved' ? 'approved' : 'rejected'
      const copy = CHANGE_COPY[verdict]

      const idField = document.getElementById('modificare-id') as HTMLInputElement | null
      const verdictField = document.getElementById('modificare-decizie') as HTMLInputElement | null
      const motiv = document.getElementById('modificare-motiv') as HTMLTextAreaElement | null

      if (idField) idField.value = b.dataset.id ?? ''
      if (verdictField) verdictField.value = verdict

      const set = (id: string, text: string) => {
        const el = document.getElementById(id)
        if (el) el.textContent = text
      }
      set('titlu-modificare', copy.titlu)
      set('modificare-trimite', copy.button)
      set('modificare-eticheta', copy.eticheta)
      set('modificare-hint', copy.hint)
      set(
        'modificare-explicatie',
        `Mesajul ajunge la ${b.dataset.nume ?? 'student'} prin email și rămâne în conversație.`,
      )

      if (motiv) {
        motiv.value = ''
        motiv.placeholder = copy.placeholder
        motiv.required = copy.required
        motiv.minLength = copy.required ? 10 : 0
      }

      changeDialog?.showModal()
      motiv?.focus()
    })
  })

  changeDialog
    ?.querySelectorAll('[data-inchide-modificare]')
    .forEach((b) => b.addEventListener('click', () => changeDialog.close()))

  /* --- the coordinator's own edit ------------------------------------------ */
  const thesisDialog = document.getElementById('dialog-lucrare') as HTMLDialogElement | null

  document.querySelectorAll<HTMLButtonElement>('[data-lucrare]').forEach((b) => {
    b.addEventListener('click', () => {
      const fill = (id: string, value: string) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null
        if (el) el.value = value
      }
      fill('lucrare-id', b.dataset.lucrare ?? '')
      fill('lucrare-titlu-ro', b.dataset.titluRo ?? '')
      fill('lucrare-titlu-en', b.dataset.titluEn ?? '')
      fill('lucrare-obiective', b.dataset.obiective ?? '')
      fill('lucrare-motiv', '')

      const nume = document.getElementById('lucrare-nume')
      if (nume) nume.textContent = b.dataset.nume ?? 'studentul'

      thesisDialog?.showModal()
      document.getElementById('lucrare-titlu-ro')?.focus()
    })
  })

  thesisDialog
    ?.querySelectorAll('[data-inchide-lucrare]')
    .forEach((b) => b.addEventListener('click', () => thesisDialog.close()))

  /* --- the deadline window -------------------------------------------------
   *
   * One dialog for both gestures. Which one it is decides three things — the
   * heading, the label on the submit button and whether „Șterge” exists — and
   * the hidden `actiune_implicita`, because `formAction` reads the button's
   * own `actiune` first (see lib/forms.ts). */
  const deadlineDialog = document.getElementById('dialog-termen') as HTMLDialogElement | null
  const deadlineForm = deadlineDialog?.querySelector('form') ?? null

  const deadlineField = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null

  function openDeadline(mode: 'adauga' | 'actualizeaza', data: DOMStringMap & { requestId?: string }) {
    const actiune = deadlineField<HTMLInputElement>('termen-actiune')
    const idField = deadlineField<HTMLInputElement>('termen-id')
    const requestField = deadlineField<HTMLInputElement>('termen-cerere')
    const title = deadlineField<HTMLInputElement>('termen-titlu')
    const date = deadlineField<HTMLInputElement>('termen-data')
    const status = deadlineField<HTMLSelectElement>('termen-stare')
    const description = deadlineField<HTMLTextAreaElement>('termen-descriere')
    const remove = deadlineField<HTMLButtonElement>('termen-sterge')
    const submit = deadlineField<HTMLButtonElement>('termen-trimite')
    const heading = document.getElementById('titlu-termen')

    const editing = mode === 'actualizeaza'
    if (actiune) actiune.value = mode
    if (idField) idField.value = editing ? (data.termenEditeaza ?? '') : ''
    if (requestField) requestField.value = editing ? '' : (data.requestId ?? '')
    if (title) title.value = data.titlu ?? ''
    if (status) status.value = data.stare ?? 'planned'
    if (description) description.value = data.descriere ?? ''
    if (date) {
      date.value = data.data ?? ''
      // The prose read-out beside the field follows the input, not the assignment.
      date.dispatchEvent(new Event('input', { bubbles: true }))
    }
    if (remove) remove.hidden = !editing
    if (submit) submit.textContent = editing ? 'Salvează termenul' : 'Adaugă termenul'
    if (heading) heading.textContent = editing ? 'Editează termenul' : 'Termen nou'

    deadlineDialog?.showModal()
    title?.focus()
  }

  document.querySelectorAll<HTMLButtonElement>('[data-termen-nou]').forEach((b) => {
    b.addEventListener('click', () =>
      openDeadline('adauga', { ...b.dataset, requestId: b.dataset.termenNou ?? '' }),
    )
  })

  document.querySelectorAll<HTMLButtonElement>('[data-termen-editeaza]').forEach((b) => {
    b.addEventListener('click', () => openDeadline('actualizeaza', { ...b.dataset }))
  })

  deadlineDialog
    ?.querySelectorAll('[data-inchide-termen]')
    .forEach((b) => b.addEventListener('click', () => deadlineDialog.close()))

  /* „Șterge” is a submit inside the same form, so the browser would refuse it
   * while „Titlu” is empty — the required field the deletion does not need. */
  deadlineField<HTMLButtonElement>('termen-sterge')?.addEventListener('click', () => {
    deadlineForm?.querySelectorAll<HTMLInputElement>('[required]').forEach((f) => (f.required = false))
  })

  /* --- the same deadline for several students ----------------------------- */
  const bulkDialog = document.getElementById('dialog-termen-multi') as HTMLDialogElement | null
  const bulkBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-student]')]
  const bulkAll = document.getElementById('multi-toti') as HTMLInputElement | null
  const bulkSubmit = document.getElementById('multi-trimite') as HTMLButtonElement | null

  /* The button counts, so the size of the gesture is on the button that makes
   * it: one click writes as many rows as there are ticks. */
  function syncBulk() {
    const chosen = bulkBoxes.filter((b) => b.checked).length
    if (bulkSubmit) {
      bulkSubmit.disabled = chosen === 0
      bulkSubmit.textContent =
        chosen === 0
          ? 'Alege cel puțin un student'
          : chosen === 1
            ? 'Adaugă pentru 1 student'
            : `Adaugă pentru ${chosen} studenți`
    }
    if (bulkAll) {
      bulkAll.checked = chosen === bulkBoxes.length && chosen > 0
      bulkAll.indeterminate = chosen > 0 && chosen < bulkBoxes.length
    }
  }

  bulkBoxes.forEach((b) => b.addEventListener('change', syncBulk))
  bulkAll?.addEventListener('change', () => {
    bulkBoxes.forEach((b) => (b.checked = bulkAll.checked))
    syncBulk()
  })
  syncBulk()

  document.querySelectorAll<HTMLButtonElement>('[data-termen-multi]').forEach((b) => {
    b.addEventListener('click', () => {
      bulkDialog?.showModal()
      document.getElementById('multi-titlu')?.focus()
    })
  })

  bulkDialog
    ?.querySelectorAll('[data-inchide-multi]')
    .forEach((b) => b.addEventListener('click', () => bulkDialog.close()))

  /* --- choosing the student to invite -------------------------------------
   *
   * The visible field carries the name, so that it can be searched; the form
   * needs the id, so one is translated into the other. If the text matches no
   * option, the id stays empty and the `required` on it stops the submission —
   * so a half-written name cannot reach the server. */
  const nameField = document.getElementById('student_nume') as HTMLInputElement | null
  const idField = document.getElementById('student_id') as HTMLInputElement | null
  const lista = document.getElementById('lista-invitabili')

  if (nameField && idField && lista) {
    const matchStudent = () => {
      const opt = [...lista.querySelectorAll<HTMLOptionElement>('option')].find(
        (o) => o.value === nameField.value,
      )
      idField.value = opt?.dataset.id ?? ''
      nameField.setAttribute('aria-invalid', nameField.value && !opt ? 'true' : 'false')
    }

    nameField.addEventListener('input', matchStudent)
    nameField.addEventListener('change', matchStudent)
    nameField.form?.addEventListener('reluat', matchStudent)
    matchStudent()
  }
</script>

<style>
  /* The fields start their label on the same line and end their control on the
     same line; the hint text grows downwards, it does not push the neighbour. */
  .invitatie__rand {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }

  @media (max-width: 640px) {
    .invitatie__rand {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .taburi {
    display: flex;
    gap: var(--s-1);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--border);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-3);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab.is-activ {
    color: var(--red);
    font-weight: 600;
    border-bottom-color: var(--red);
  }

  .tab__contor {
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--surface-sunken);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .tab.is-activ .tab__contor {
    background: var(--red-tint);
    color: var(--red);
  }

  .cereri {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cerere {
    padding: var(--s-5);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .cerere:last-child {
    border-bottom: 0;
  }

  .cerere__cap {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .cerere__ident {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    flex: 1;
    min-width: 0;
  }
  .cerere__ident strong {
    font-size: var(--t-sm);
  }
  .cerere__ident .muted {
    font-size: var(--t-xs);
  }

  .cerere__titlu {
    font-family: var(--serif);
    font-size: var(--t-lg);
    font-weight: 600;
  }

  .cerere__titlu-en {
    font-size: var(--t-sm);
    color: var(--ink-muted);
    font-style: italic;
    margin-top: -6px;
  }

  .cerere__scop {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    max-width: 78ch;
    text-wrap: pretty;
  }

  .cerere__actiuni {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .select--compact {
    min-height: 30px;
    padding-block: 0;
    font-size: var(--t-xs);
    min-width: 116px;
  }

  /* The student column is not allowed to break into six lines just because the
     table has gained another column: the name on one line, the rest truncated
     with a title on hover. */
  .celula-student {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .celula-student strong {
    white-space: nowrap;
  }
  .celula-student .muted {
    font-size: var(--t-xs);
    max-width: 26ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .celula-title {
    max-width: 34ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .progres {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 120px;
  }

  .bara {
    flex: 1;
    height: 6px;
    background: var(--surface-sunken);
    border-radius: 999px;
    overflow: hidden;
  }
  .bara__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ok);
    border-radius: 999px;
    transform-origin: left center;
    transform: scaleX(var(--procent, 0));
  }

  /* --- the deadline agenda ------------------------------------------------ */

  .panel__header--agenda {
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Two links that look like one control. The current one is named by
     `aria-current`, not only by the fill. */
  .comutator {
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .comutator__optiune {
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    background: var(--surface);
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .comutator__optiune + .comutator__optiune {
    border-left: 1px solid var(--border-strong);
  }
  .comutator__optiune:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .comutator__optiune.is-activ {
    background: var(--surface-sunken);
    color: var(--ink);
    font-weight: 600;
