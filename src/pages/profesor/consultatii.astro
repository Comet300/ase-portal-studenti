---
import AlegeData from '../../components/AlegeData.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import RandSlot from '../../components/RandSlot.astro'
import Taburi from '../../components/Taburi.astro'
import {
  formatDate,
  formatTime,
  localDay,
  startOfWeek,
  supervisedStudents,
  teacherSlots,
  teacherSlotHistory,
  weekLabel,
  type Slot,
} from '../../lib/repo'
import { numar, officialName } from '../../lib/text'

/**
 * The consultation schedule.
 *
 * A screen of its own, not a tab: it is the only thing in the portal with a
 * fixed hour, and a coordinator who wants to open two hours tomorrow should not
 * have to go through the request triage to get to it.
 *
 * It reads in the order the work happens. Opening hours comes first because it
 * is the habitual gesture — a coordinator publishes hours every week and
 * summons a particular student a few times a semester. Summoning follows it,
 * and the schedule closes the page as the record of what the two of them
 * produced. Before, the rarer of the two forms occupied the whole of the first
 * screen and the common one was hidden in a footer *under* the table it fills,
 * where it read as a caption.
 */

const u = Astro.locals.user!

const [sloturi, studenti, incheiate] = await Promise.all([
  teacherSlots(u.id),
  supervisedStudents(u.id),
  /* Consultațiile ținute.
   *
   * Stăteau pe „Activitatea mea”, ecran care a fost scos. Aici este locul lor:
   * programul de deasupra ajunge doar cu o zi în urmă, iar „când ne-am văzut
   * ultima oară” este o întrebare despre consultații, nu despre statistici. Se
   * consemnează doar orele la care s-a prezentat cineva. */
  teacherSlotHistory(u.id),
])

const oreTinute = incheiate.reduce(
  (t, c) => t + (new Date(c.ends_at).getTime() - new Date(c.starts_at).getTime()) / 3_600_000,
  0,
)
const studentiVazuti = new Set(incheiate.flatMap((c) => c.student_names)).size

/**
 * The two kinds of consultation, as two tabs.
 *
 * They are the same interval and the same form; what differs is who is on the
 * other side of it, and that changes everything around it. A „finalizare
 * studii” hour is for the students this person coordinates: it is announced to
 * them by email, and nobody else can see it. A public hour is for whoever in
 * the faculty has a question — so it is visible to every student in the portal
 * and it is announced to nobody, because a notice to the whole faculty every
 * time somebody opens an afternoon is a reason to switch notifications off.
 *
 * The schedule below stays whole, on purpose: „am I free on Thursday” is one
 * question, not two, and a coordinator who had to add up two tabs to answer it
 * would keep the answer in a paper diary instead.
 */
const tip = Astro.url.searchParams.get('tip') === 'publice' ? 'publice' : 'finalizare'
const audienta = tip === 'publice' ? 'public' : 'thesis'

const today = localDay(new Date())
const withStudentId = Astro.url.searchParams.get('cu') ?? ''

/**
 * The schedule, split the way it is read.
 *
 * There were thirty rows in a single table, in chronological order — so past
 * hours sat at the head of the list, and the ones something can be done about
 * started around halfway down, after scrolling. A schedule is consulted by
 * weeks and almost only forwards.
 *
 * What has passed is not deleted: it stays, counted and gathered together,
 * because somebody really does ask „when did we last see each other”.
 */
const acum = Date.now()
const upcoming = sloturi.filter((s) => new Date(s.ends_at).getTime() >= acum)
const viitoarePe = (a: 'public' | 'thesis') =>
  upcoming.filter((s) => s.audience === a && !s.is_cancelled).length
const past = sloturi
  .filter((s) => new Date(s.ends_at).getTime() < acum)
  .sort((a, b) => (a.starts_at < b.starts_at ? 1 : -1))

const weeks = [
  ...upcoming
    .reduce((byWeek, s) => {
      const monday = startOfWeek(s.starts_at)
      byWeek.set(monday, [...(byWeek.get(monday) ?? []), s])
      return byWeek
    }, new Map<string, typeof upcoming>())
    .entries(),
].sort(([a], [b]) => (a < b ? -1 : 1))

const cancelled = sloturi.filter((s) => s.is_cancelled).length

/**
 * How many hours are still standing on each day.
 *
 * Being away is a property of a day, not of an hour: a coordinator with four
 * published hours on Thursday who is called to a committee cancels Thursday.
 * The count travels down to the row so the confirmation can offer the whole day
 * by name, and is computed once here rather than by each row.
 */
const hoursPerDay = new Map<string, number>()
for (const s of upcoming) {
  if (s.is_cancelled) continue
  const day = localDay(new Date(s.starts_at))
  hoursPerDay.set(day, (hoursPerDay.get(day) ?? 0) + 1)
}
const dayCount = (s: Slot) => hoursPerDay.get(localDay(new Date(s.starts_at))) ?? 1
---

<ProfesorLayout
  title="Consultații"
  lede="Programul de consultații al cadrului didactic: ore publicate, rezervări primite și programări individuale."
  active="consultatii"
>
<div class="stack stack--loose" id="consultatii">
  <p class="orientare">
    {
      upcoming.length > 0
        ? `${numar(upcoming.length, 'oră de consultație programată', 'ore de consultație programate')}.`
        : 'Nicio oră de consultație programată.'
    }
    {upcoming.length > 0 && <a class="link" href="#program">Vezi programul</a>}
  </p>

  {/* Opening hours comes first: it is what a coordinator does habitually, and
      it is the half of the screen the students actually depend on. */}
  <Taburi
    eticheta="Felul consultațiilor"
    activ={tip}
    taburi={[
      {
        key: 'finalizare',
        text: 'Finalizare studii',
        href: '/profesor/consultatii?tip=finalizare#ore-deschise',
        count: viitoarePe('thesis'),
      },
      {
        key: 'publice',
        text: 'Publice',
        href: '/profesor/consultatii?tip=publice#ore-deschise',
        count: viitoarePe('public'),
      },
    ]}
  />

  <section class="panel" id="ore-deschise">
    <div class="panel__header">
      <h2 class="section-title">Publicare ore</h2>
      <span class="muted text-sm">
        {tip === 'publice' ? 'Toată facultatea' : 'Studenți coordonați'}
      </span>
    </div>

    <form method="POST" action="/api/sloturi" class="panel__body stack">
      <input type="hidden" name="actiune" value="publica" />
      <input type="hidden" name="audienta" value={audienta} />

      <p class="explicatie">
        Intervalul se împarte în ore. Un interval 14:00–17:00 generează trei ore, rezervate
        individual. Invitația în calendar se transmite la momentul rezervării, cu locul și linkul
        completate mai jos.
        {
          tip === 'publice'
            ? ' Orele publice sunt vizibile tuturor studenților facultății și nu se anunță pe email.'
            : ' Orele se anunță pe email studenților coordonați și nu sunt vizibile altcuiva.'
        }
      </p>

      <div class="ore grila-campuri">
        <AlegeData id="ore-zi" name="zi" label="Ziua" min={today} required />
        <div class="field">
          <label class="label" for="ore-start">De la</label>
          <input class="input" id="ore-start" name="ora_start" type="time" value="14:00" step="900" required />
        </div>
        <div class="field">
          <label class="label" for="ore-final">Până la</label>
          <input class="input" id="ore-final" name="ora_final" type="time" value="16:00" step="900" required />
        </div>
        <div class="field">
          <label class="label" for="ore-locuri">Locuri</label>
          <input class="input" id="ore-locuri" name="locuri" type="number" min="1" max="30" value="1"
            aria-describedby="ajutor-locuri" />
          <span class="hint" id="ajutor-locuri">Un loc înseamnă consultație individuală.</span>
        </div>
        <div class="field">
          <label class="label" for="ore-mod">Desfășurare</label>
          <select class="select" id="ore-mod" name="mod" data-mod>
            <option value="in_person">La facultate</option>
            <option value="online">Online</option>
          </select>
        </div>
      </div>

      <div class="ore__unde grila-campuri">
        <div class="field" data-camp-locatie>
          <label class="label" for="ore-locatie">Locul desfășurării</label>
          <input class="input" id="ore-locatie" name="locatie" value={u.office ?? ''}
            placeholder="Clădirea Ion Angelescu, Piața Romană 6, etaj 2, sala 2203" />
        </div>
        <div class="field">
          <label class="label" for="ore-link">
            Link întâlnire <span class="muted" data-link-optional>(opțional)</span>
          </label>
          <input class="input" id="ore-link" name="link_online" type="url" placeholder="https://meet…"
            aria-describedby="ajutor-ore-link" />
          <span class="hint" id="ajutor-ore-link">Se include în invitația de calendar.</span>
        </div>
      </div>

      <div class="row row--end">
        <button class="btn btn--primary" type="submit">Publică orele</button>
      </div>
    </form>
  </section>

  {/* Summoning a named student is the occasional case, so it follows — and it
      belongs to the coordinated tab alone: you can only summon somebody whose
      thesis you are supervising, so on the public tab the panel would be a form
      that always refuses. The anchor is what `/profesor/studenti` links to with
      `?cu=`; without it the pre-ticked checkbox landed below the fold and the
      link appeared to do nothing at all. */}
  {
    tip === 'finalizare' && (
      <section class="panel" id="cheama">
        <div class="panel__header">
          <h2 class="section-title">Programare individuală</h2>
          <span class="muted text-sm">Programare directă</span>
        </div>

        {studenti.length === 0 ? (
          <div class="empty">
            <p class="empty__title">Niciun student coordonat</p>
            <p class="empty__text">
              Programarea individuală este disponibilă pentru studenții coordonați. Publicarea
              orelor se poate face și până atunci.
            </p>
            <a class="btn btn--primary btn--sm" href="/profesor/studenti?sectiune=cereri">
              Vezi cererile de coordonare
            </a>
          </div>
        ) : (
          <form method="POST" action="/api/sloturi" class="panel__body stack" id="form-programare">
            <input type="hidden" name="actiune" value="programeaza" />

            <p class="explicatie">
              Consultația se creează rezervată. Fiecare student selectat primește invitația în
              calendar și o notificare în conversație.
            </p>

            {withStudentId && (
              <p class="hint">Studentul selectat anterior este deja bifat.</p>
            )}

            <div class="programare">
              <div class="field programare__cine">
                {/* A consultation can be with several students at once — three who
                    are working on the same chapter do not need three separate
                    hours. Multiple selection calls for checkboxes, not a drop-down
                    list. */}
                <span class="label" id="et-cu-cine">Studenți</span>
                <fieldset class="alege-studenti" aria-labelledby="et-cu-cine" aria-describedby="numar-alesi">
                  <label class="alege-studenti__toti">
                    <input type="checkbox" id="toti-studentii" />
                    <span>Selectează toți studenții coordonați</span>
                  </label>
                  <div class="alege-studenti__lista">
                    {studenti.map((s) => (
                      <label class="student-optiune">
                        <input
                          type="checkbox"
                          name="student_id"
                          value={s.student_id}
                          checked={s.student_id === withStudentId}
                        />
                        <span class="student-optiune__corp">
                          <strong>{officialName({ name: s.student_name, father_initial: s.father_initial })}</strong>
                          <small class="muted">{s.title_ro}</small>
                        </span>
                      </label>
                    ))}
                  </div>
                  <p class="hint" id="numar-alesi" aria-live="polite" />
                </fieldset>
              </div>
              {/* The right-hand column is its own stack, not cells in the same grid
                  as the student list: otherwise the rows stretch to fill the height
                  of the list and gaps appear between „Ziua” and „Durata”. */}
              <div class="programare__detalii">
                <div class="programare__pereche programare__pereche--zi grila-campuri">
                  <AlegeData id="prog-zi" name="zi" label="Ziua" min={today} required />
                  {/* This was a numeric field with whole hours, and the SQL
                      concatenated „hours”: a consultation at 14:30 simply could not
                      be expressed. */}
                  <div class="field">
                    <label class="label" for="prog-ora">Ora de început</label>
                    <input class="input" id="prog-ora" name="ora_start" type="time" value="14:00" step="900" required />
                  </div>
                </div>

                <div class="programare__pereche grila-campuri">
                  <div class="field">
                    <label class="label" for="prog-durata">Cât ține</label>
                    <select class="select" id="prog-durata" name="durata">
                      <option value="0.5">30 de minute</option>
                      <option value="1" selected>1 oră</option>
                      <option value="1.5">1 oră și jumătate</option>
                      <option value="2">2 ore</option>
                      <option value="3">3 ore</option>
                    </select>
                  </div>
                  <div class="field">
                    <label class="label" for="prog-mod">Cum are loc</label>
                    <select class="select" id="prog-mod" name="mod" data-mod>
                      <option value="in_person">La facultate</option>
                      <option value="online">Online</option>
                    </select>
                  </div>
                </div>

                <div class="field" data-camp-locatie>
                  <label class="label" for="prog-locatie">Clădirea, etajul și sala</label>
                  <input class="input" id="prog-locatie" name="locatie" value={u.office ?? ''}
                    placeholder="Clădirea Ion Angelescu, Piața Romană 6, etaj 2, sala 2203" />
                </div>

                <div class="field">
                  <label class="label" for="prog-link">
                    Link întâlnire <span class="muted" data-link-optional>(opțional)</span>
                  </label>
                  <input class="input" id="prog-link" name="link_online" type="url"
                    placeholder="https://meet…" aria-describedby="ajutor-link" />
                  <span class="hint" id="ajutor-link">Se include în invitația de calendar.</span>
                </div>
              </div>
            </div>

            <div class="field">
              <label class="label" for="prog-subiect">Subiect <span class="muted">(opțional)</span></label>
              <input class="input" id="prog-subiect" name="subiect"
                placeholder="Ex: discutăm metodologia și eșantionul" aria-describedby="ajutor-subiect" />
              <span class="hint" id="ajutor-subiect">
                Se transmite în email și în invitația de calendar.
              </span>
            </div>

            <div class="row row--end">
              <button class="btn btn--primary" type="submit" id="programeaza">
                Programează consultația
              </button>
            </div>
          </form>
        )}
      </section>
    )
  }

  <section class="panel" id="program">
    <div class="panel__header">
      <h2 class="section-title">Program</h2>
      <span class="muted text-sm">
        {numar(upcoming.length, 'oră', 'ore')} de acum înainte
        {past.length > 0 && ` · ${numar(past.length, 'oră încheiată', 'ore încheiate')}`}
        {cancelled > 0 && ` · ${numar(cancelled, 'oră anulată', 'ore anulate')}`}
      </span>
    </div>

    {sloturi.length === 0 ? (
      <div class="empty">
        <p class="empty__title">Program neconfigurat</p>
        <p class="empty__text">
          Orele publicate apar aici, împreună cu studenții înscriși la fiecare.
        </p>
        <a class="btn btn--primary btn--sm" href="#ore-deschise">Publică primele ore</a>
      </div>
    ) : (
      <div class="table-wrap" tabindex="0" role="region" aria-label="Programul de consultații">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Ziua</th>
              <th scope="col">Ora</th>
              <th scope="col">Unde are loc</th>
              <th scope="col">Cine vine</th>
              <th scope="col"><span class="visually-hidden">Acțiuni</span></th>
            </tr>
          </thead>
          {weeks.map(([monday, weekSlots]) => {
            const et = weekLabel(monday, today)
            return (
              <tbody>
                <tr class="rand-grup">
                  <th colspan="5" scope="colgroup">
                    {et.name}
                    {et.interval && <span class="muted"> · {et.interval}</span>}
                    <span class="muted"> · {numar(weekSlots.length, 'oră', 'ore')}</span>
                  </th>
                </tr>
                {weekSlots.map((s) => (
                  <RandSlot interval={s} oreInZi={dayCount(s)} />
                ))}
              </tbody>
            )
          })}

          {/* What has ended sits at the tail, not at the head: the only hours
              something can still be done about are the ones coming up. The
              list's window is one day — an older history does not exist here at
              all, not even now. */}
          {past.length > 0 && (
            <tbody>
              <tr class="rand-grup rand-grup--stins">
                <th colspan="5" scope="colgroup">
                  Încheiate
                  <span class="muted"> · {numar(past.length, 'oră', 'ore')}, din ultima zi</span>
                </th>
              </tr>
              {past.map((s) => (
                <RandSlot interval={s} incheiat />
              ))}
            </tbody>
          )}

        </table>
      </div>
    )}
  </section>

  <section class="panel" id="incheiate">
    <div class="panel__header">
      <h2 class="section-title">Consultații ținute</h2>
      <span class="muted text-sm">
        {numar(incheiate.length, 'consultație', 'consultații')}
        {incheiate.length > 0 &&
          ` · ${numar(Math.round(oreTinute), 'oră', 'ore')} · ${numar(studentiVazuti, 'student', 'studenți')}`}
      </span>
    </div>

    {
      incheiate.length === 0 ? (
        <div class="empty">
          <p class="empty__title">Nicio consultație încheiată</p>
          <p class="empty__text">
            Se consemnează aici orele la care s-a prezentat cel puțin un student. Orele anulate și
            cele rămase libere nu se contabilizează.
          </p>
        </div>
      ) : (
        <div class="table-wrap" tabindex="0" role="region" aria-label="Consultațiile ținute">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Data</th>
                <th scope="col">Interval</th>
                <th scope="col">Participanți</th>
                <th scope="col">Locul desfășurării</th>
                <th scope="col">Subiect</th>
              </tr>
            </thead>
            <tbody>
              {incheiate.map((c) => (
                <tr>
                  <td>{formatDate(c.starts_at)}</td>
                  <td class="numeric muted">
                    {formatTime(c.starts_at)}–{formatTime(c.ends_at)}
                  </td>
                  <td>{c.student_names.join(', ')}</td>
                  <td class="muted">{c.mode === 'online' ? 'Online' : (c.location ?? 'Cabinet')}</td>
                  <td class="muted">{c.note ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</div>

{/* Cancelling writes to the calendar of everybody who had booked and sends each
    of them an email. It is the one irreversible thing on this screen, and it
    used to be a bare button inside a table row — one click, no question asked,
    while the student's own cancellation went through a full dialog. */}
<dialog id="dialog-anulare" aria-labelledby="titlu-anulare">
  <form method="POST" action="/api/sloturi" class="dialog">
    <h2 id="titlu-anulare" class="section-title">Anulare consultație</h2>
    <p class="anulare__cand" id="anulare-cand"></p>
    <p class="muted text-sm" id="anulare-cine"></p>

    <input type="hidden" name="actiune" value="anuleaza" />
    <input type="hidden" name="slot_id" id="anulare-slot" />

    <label class="anulare__zi" id="anulare-zi-camp" hidden>
      <input type="checkbox" name="toata_ziua" value="1" id="anulare-toata-ziua" />
      <span id="anulare-zi-text"></span>
    </label>

    <div class="field">
      <label class="label" for="anulare-motiv">Motivul anulării</label>
      <textarea class="textarea" id="anulare-motiv" name="motiv" rows="3" maxlength="400"
        style="min-height:80px" placeholder="Ex: sunt convocat la o comisie de licență"
        aria-describedby="anulare-motiv-ajutor" data-autogrow></textarea>
      <span class="hint" id="anulare-motiv-ajutor">
        Se transmite fiecărui student înscris și rămâne consemnat în program.
      </span>
    </div>

    <div class="row" style="justify-content:flex-end;gap:var(--s-2)">
      <button class="btn btn--secondary" type="button" data-inchide-anulare>Renunță</button>
      <button class="btn btn--danger" type="submit" id="anulare-confirma">Anulează ora</button>
    </div>
  </form>
</dialog>
</ProfesorLayout>

<style>
  /* One line of orientation above three panels: how much is coming, and the way
     to it. The schedule is the last panel on the page precisely because it is
     the record rather than an action, so it needs a door at the top. */
  .orientare {
    font-size: var(--t-body);
    color: var(--ink-soft);
  }
  .orientare a {
    margin-left: var(--s-2);
  }

  /* What each form does, in prose, at reading size. It was one three-line hint
     in `--t-xs` at the very bottom of the page — that is, the only explanation
     of the difference between the two forms was set in the size reserved for
     metadata, below everything it explained. */
  .explicatie {
    font-size: var(--t-body);
    color: var(--ink-soft);
    max-width: 68ch;
    text-wrap: pretty;
  }

  /* An anchor jumped to a panel whose header ended up under the sticky bar. */
  #program,
  #ore-deschise,
  #cheama {
    scroll-margin-top: var(--s-4);
  }

  /* The open-hours row: day, the two ends of the interval, seats, mode.
     `.grila-campuri` (app.css) owns the rows, so a field with a hint under it
     and one without still line up top and bottom. */
  .ore {
    grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 0.8fr)) minmax(0, 1fr) minmax(0, 1.1fr);
  }
  .ore__unde {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  @media (max-width: 1200px) {
    .ore {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .ore,
    .ore__unde {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The week header.
   *
   * A table of thirty rows in chronological order has no landmarks: „what have I
   * got on Thursday” takes counting. Each `tbody` is one week, and this row is
   * its title — sticky under the header, so it is not lost while scrolling. */
  .rand-grup th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--s-2) var(--s-4);
    background: var(--surface-sunken);
    border-block: 1px solid var(--border);
    text-align: left;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .rand-grup--stins th {
    color: var(--ink-muted);
    font-weight: 500;
  }

  /* Twelve columns, aligned to the top.
     In a flex row, the student box was 330px tall and „Ziua / Ora / Durata”
     centred vertically against it — three fields floating in the middle of a
     gap, with no common line. */
  .programare {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .programare :where(.field) {
    min-width: 0;
  }
  .programare__cine {
    display: flex;
    flex-direction: column;
  }

  .programare__detalii {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
  }

  .programare__pereche {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }

  /* A day written out — „12 septembrie 2026” — needs more room than „14:00”.
     Split down the middle, the date was the only field on the screen that had to
     be truncated to fit its own box; under 1200px there is no split that leaves
     both of them enough, so they stack. */
  .programare__pereche--zi {
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }
  @media (max-width: 1200px) {
    .programare__pereche--zi {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The student list stops at the height of the right-hand column, so that the
     two columns end on the same line. */
  .programare__cine .alege-studenti {
    flex: 1;
    min-height: 0;
  }
  .programare__cine .alege-studenti__lista {
    flex: 1;
    max-height: none;
  }

  @media (max-width: 900px) {
    .programare,
    .programare__pereche {
      grid-template-columns: minmax(0, 1fr);
    }
    .programare__cine .alege-studenti__lista {
      max-height: 15rem;
    }
  }

  .alege-studenti {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .alege-studenti__toti {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
  }

  /* The list cut the last row in half, with no visible scrollbar and no sign at
     all that somebody else followed — it looked like a rendering defect. A fade
     at the bottom of the box says there is more, and the height stops on a whole
     row. */
  .alege-studenti__lista {
    display: flex;
    flex-direction: column;
    max-height: 15rem;
    overflow-y: auto;
    scrollbar-width: thin;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.25rem), transparent);
  }

  .student-optiune {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .student-optiune:hover {
    background: var(--surface-sunken);
  }

  .student-optiune__corp {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.35;
  }
  .student-optiune__corp strong {
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .student-optiune__corp small {
    font-size: var(--t-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The confirmation. The hour being called off is the one thing that must be
     unmistakable, so it is set at reading size, not as metadata. */
  .anulare__cand {
    font-size: var(--t-md);
    font-weight: 600;
  }

  .anulare__zi {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: var(--s-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
    cursor: pointer;
  }
  .anulare__zi[hidden] {
    display: none;
  }
</style>

<script>
  import { numar } from '../../lib/text'

  /* --- who is being summoned ------------------------------------------------ */

  const toti = document.getElementById('toti-studentii') as HTMLInputElement | null
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[name="student_id"]')]
  const counterEl = document.getElementById('numar-alesi')
  const submitButton = document.getElementById('programeaza') as HTMLButtonElement | null

  function syncSelection() {
    const alesi = boxes.filter((c) => c.checked).length
    if (toti) {
      toti.checked = alesi === boxes.length && boxes.length > 0
      toti.indeterminate = alesi > 0 && alesi < boxes.length
    }
    if (counterEl) {
      counterEl.textContent =
        alesi === 0
          ? 'Alege cel puțin un student.'
          : alesi === 1
            ? 'Un student ales — primește invitația în calendar și o notificare în portal.'
            : `${numar(alesi, 'student ales', 'studenți aleși')} — fiecare primește invitația lui în calendar.`
    }
    if (submitButton) submitButton.disabled = alesi === 0
  }

  toti?.addEventListener('change', () => {
    boxes.forEach((c) => (c.checked = toti.checked))
    syncSelection()
  })
  boxes.forEach((c) => c.addEventListener('change', syncSelection))
  syncSelection()

  /* Arriving from a student's row, the ticked checkbox is two panels down: on a
     laptop it is below the fold, so the link looked like it had done nothing. */
  if (new URL(location.href).searchParams.get('cu')) {
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches
    document
      .getElementById('cheama')
      ?.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' })
  }

  // An online hour needs a link, one at the faculty needs an address. The
  // irrelevant field disappears instead of staying empty and required.
  document.querySelectorAll<HTMLFormElement>('form').forEach((form) => {
    const mod = form.querySelector<HTMLSelectElement>('[data-mod]')
    if (!mod) return

    const locationField = form.querySelector<HTMLElement>('[data-camp-locatie]')
    const link = form.querySelector<HTMLInputElement>('input[name="link_online"]')
    const optional = form.querySelector<HTMLElement>('[data-link-optional]')

    const sync = () => {
      const online = mod.value === 'online'
      if (locationField) locationField.hidden = online
      if (link) link.required = online
      if (optional) optional.hidden = online
    }

    mod.addEventListener('change', sync)
    sync()
  })

  /* --- cancelling ----------------------------------------------------------- */

  const anulare = document.getElementById('dialog-anulare') as HTMLDialogElement | null
  const campSlot = document.getElementById('anulare-slot') as HTMLInputElement | null
  const cand = document.getElementById('anulare-cand')
  const cine = document.getElementById('anulare-cine')
  const ziCamp = document.getElementById('anulare-zi-camp')
  const ziText = document.getElementById('anulare-zi-text')
  const toataZiua = document.getElementById('anulare-toata-ziua') as HTMLInputElement | null
  const motiv = document.getElementById('anulare-motiv') as HTMLTextAreaElement | null
  const confirma = document.getElementById('anulare-confirma')

  document.querySelectorAll<HTMLButtonElement>('[data-anuleaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const oreInZi = Number(b.dataset.oreInZi ?? '1')
      const rezervari = Number(b.dataset.rezervari ?? '0')

      if (campSlot) campSlot.value = b.dataset.anuleaza ?? ''
      if (cand) cand.textContent = b.dataset.cand ?? ''
      if (cine) cine.textContent = b.dataset.cine ?? ''

      /* The whole day is offered only when there is a whole day to offer, and
         it starts unticked: an absence is the reason for it, not the default. */
      if (toataZiua) toataZiua.checked = false
      if (ziCamp) ziCamp.hidden = oreInZi < 2
      if (ziText) {
        ziText.textContent = `Anulează toate cele ${oreInZi} ore din ${b.dataset.zi ?? 'ziua asta'} — fiecare student cu loc rezervat primește un singur email.`
      }

      /* With somebody booked, the reason is the message they receive; with
         nobody booked there is no one to explain anything to. */
      if (motiv) {
        motiv.required = rezervari > 0
        motiv.value = ''
      }
      if (confirma) {
        confirma.textContent = rezervari > 0 ? 'Anulează și anunță studenții' : 'Anulează ora'
      }

      anulare?.showModal()
    })
  })

  anulare
    ?.querySelector('[data-inchide-anulare]')
    ?.addEventListener('click', () => anulare.close())
</script>
