---
import AlegeData from '../../components/AlegeData.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import RandSlot from '../../components/RandSlot.astro'
import { localDay, startOfWeek, supervisedStudents, teacherSlots, weekLabel } from '../../lib/repo'
import { officialName } from '../../lib/text'

/**
 * The consultation schedule.
 *
 * A screen of its own, not a tab: it is the only thing in the portal with a
 * fixed hour, and a coordinator who wants to open two hours tomorrow should not
 * have to go through the request triage to get to it.
 */

const u = Astro.locals.user!
const [sloturi, studenti] = await Promise.all([teacherSlots(u.id), supervisedStudents(u.id)])

const today = localDay(new Date())
const withStudentId = Astro.url.searchParams.get('cu') ?? ''

/**
 * The schedule, split the way it is read.
 *
 * There were thirty rows in a single table, in chronological order — so past
 * intervals sat at the head of the list, and the ones something can be done
 * about started around halfway down, after scrolling. A schedule is consulted by
 * weeks and almost only forwards.
 *
 * What has passed is not deleted: it stays, counted and gathered together,
 * because somebody really does ask „when did we last see each other”.
 */
const acum = Date.now()
const upcoming = sloturi.filter((s) => new Date(s.ends_at).getTime() >= acum)
const past = sloturi
  .filter((s) => new Date(s.ends_at).getTime() < acum)
  .sort((a, b) => (a.starts_at < b.starts_at ? 1 : -1))

const weeks = [
  ...upcoming
    .reduce((byWeek, s) => {
      const monday = startOfWeek(s.starts_at)
      byWeek.set(monday, [...(byWeek.get(monday) ?? []), s])
      return byWeek
    }, new Map<string, typeof upcoming>())
    .entries(),
].sort(([a], [b]) => (a < b ? -1 : 1))

const active = sloturi.filter((s) => !s.is_cancelled).length
---

<ProfesorLayout
  title="Consultații"
  lede="Programează o întâlnire cu un student sau publică ore deschise pe care le poate rezerva oricine coordonezi."
  active="consultatii"
>
<div class="stack" id="consultatii">
  {/* Scheduling with one particular student comes first: it is the action asked
      for most often, and open hours are the background it sits on. */}
  <section class="panel">
    <div class="panel__header">
      <h2 class="section-title">Programează o consultație</h2>
    </div>

    {studenti.length === 0 ? (
      <div class="empty">
        <p class="empty__title">Niciun student coordonat</p>
        <p class="empty__text">
          Poți programa o consultație doar cu studenții pe care îi coordonezi. Acceptă o
          cerere și opțiunea devine disponibilă.
        </p>
      </div>
    ) : (
      <form method="POST" action="/api/sloturi" class="panel__body stack" id="form-programare">
        <input type="hidden" name="actiune" value="programeaza" />

        <div class="programare">
          <div class="field programare__cine">
            {/* A consultation can be with several students at once — three who
                are working on the same chapter do not need three separate
                hours. Multiple selection calls for checkboxes, not a drop-down
                list. */}
            <span class="label" id="et-cu-cine">Cu cine</span>
            <fieldset class="alege-studenti" aria-labelledby="et-cu-cine" aria-describedby="numar-alesi">
              <label class="alege-studenti__toti">
                <input type="checkbox" id="toti-studentii" />
                <span>Selectează toți studenții coordonați</span>
              </label>
              <div class="alege-studenti__lista">
                {studenti.map((s) => (
                  <label class="student-optiune">
                    <input
                      type="checkbox"
                      name="student_id"
                      value={s.student_id}
                      checked={s.student_id === withStudentId}
                    />
                    <span class="student-optiune__corp">
                      <strong>{officialName({ name: s.student_name, father_initial: s.father_initial })}</strong>
                      <small class="muted">{s.title_ro}</small>
                    </span>
                  </label>
                ))}
              </div>
              <p class="hint" id="numar-alesi" aria-live="polite" />
            </fieldset>
          </div>
          {/* The right-hand column is its own stack, not cells in the same grid
              as the student list: otherwise the rows stretch to fill the height
              of the list and gaps appear between „Ziua” and „Durata”. */}
          <div class="programare__detalii">
            <div class="programare__pereche programare__pereche--zi">
              <AlegeData id="prog-zi" name="zi" label="Ziua" min={today} required />
              {/* This was a numeric field with whole hours, and the SQL
                  concatenated „hours”: a consultation at 14:30 simply could not
                  be expressed. */}
              <div class="field">
                <label class="label" for="prog-ora">Ora</label>
                <input class="input" id="prog-ora" name="ora_start" type="time" value="14:00" step="900" required />
              </div>
            </div>

            <div class="programare__pereche">
              <div class="field">
                <label class="label" for="prog-durata">Durata</label>
                <select class="select" id="prog-durata" name="durata">
                  <option value="0.5">30 de minute</option>
                  <option value="1" selected>1 oră</option>
                  <option value="1.5">1 oră și jumătate</option>
                  <option value="2">2 ore</option>
                  <option value="3">3 ore</option>
                </select>
              </div>
              <div class="field">
                <label class="label" for="prog-mod">Unde</label>
                <select class="select" id="prog-mod" name="mod" data-mod>
                  <option value="in_person">La facultate</option>
                  <option value="online">Online</option>
                </select>
              </div>
            </div>

            <div class="field" data-camp-locatie>
              <label class="label" for="prog-locatie">Clădirea, etajul și sala</label>
              <input class="input" id="prog-locatie" name="locatie" value={u.office ?? ''}
                placeholder="Clădirea Ion Angelescu, Piața Romană 6, etaj 2, sala 2203" />
            </div>

            <div class="field">
              <label class="label" for="prog-link">
                Link întâlnire <span class="muted" data-link-optional>(opțional)</span>
              </label>
              <input class="input" id="prog-link" name="link_online" type="url"
                placeholder="https://meet…" aria-describedby="ajutor-link" />
              <span class="hint" id="ajutor-link">Se trimite în invitația de calendar, alături de adresă.</span>
            </div>
          </div>
        </div>

        <div class="field">
          <label class="label" for="prog-subiect">Subiectul consultației <span class="muted">(opțional)</span></label>
          <input class="input" id="prog-subiect" name="subiect"
            placeholder="Ex: discutăm metodologia și eșantionul" />
        </div>

        <div class="row row--end">
          <button class="btn btn--primary" type="submit" id="programeaza">
            Programează și trimite invitația
          </button>
        </div>
      </form>
    )}
  </section>

  <section class="panel">
    <div class="panel__header">
      <h2 class="section-title">Program de consultații</h2>
      <span class="muted text-sm">
        {upcoming.length} {upcoming.length === 1 ? 'interval' : 'intervale'} de acum înainte
        {past.length > 0 && ` · ${past.length} încheiate`}
        {active !== sloturi.length && ` · ${sloturi.length - active} anulate`}
      </span>
    </div>

    {sloturi.length === 0 ? (
      <div class="empty">
        <p class="empty__title">Niciun interval publicat</p>
        <p class="empty__text">
          Publică intervale, iar studenții coordonați își pot rezerva singuri un loc. Primesc
          automat invitație în calendar.
        </p>
      </div>
    ) : (
      <div class="table-wrap" tabindex="0" role="region" aria-label="Intervalele de consultație publicate">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Data</th>
              <th scope="col">Interval</th>
              <th scope="col">Unde</th>
              <th scope="col">Rezervare</th>
              <th scope="col"><span class="visually-hidden">Acțiuni</span></th>
            </tr>
          </thead>
          {weeks.map(([monday, weekSlots]) => {
            const et = weekLabel(monday, today)
            return (
              <tbody>
                <tr class="rand-grup">
                  <th colspan="5" scope="colgroup">
                    {et.name}
                    {et.interval && <span class="muted"> · {et.interval}</span>}
                    <span class="muted">
                      {' '}· {weekSlots.length}{' '}
                      {weekSlots.length === 1 ? 'interval' : 'intervale'}
                    </span>
                  </th>
                </tr>
                {weekSlots.map((s) => (
                  <RandSlot interval={s} />
                ))}
              </tbody>
            )
          })}

          {/* What has ended sits at the tail, not at the head: the only
              intervals something can still be done about are the ones coming
              up. The list's window is one day — an older history does not exist
              here at all, not even now. */}
          {past.length > 0 && (
            <tbody>
              <tr class="rand-grup rand-grup--stins">
                <th colspan="5" scope="colgroup">
                  Încheiate
                  <span class="muted">
                    {' '}· {past.length}{' '}
                    {past.length === 1 ? 'interval' : 'intervale'}, din ultima zi
                  </span>
                </th>
              </tr>
              {past.map((s) => (
                <RandSlot interval={s} incheiat />
              ))}
            </tbody>
          )}

        </table>
      </div>
    )}

    <div class="panel__footer">
      <form method="POST" action="/api/sloturi" class="stack">
        <input type="hidden" name="actiune" value="publica" />
        <div class="row row--wrap" style="gap:var(--s-3);align-items:flex-end">
          <AlegeData
            id="slot-zi"
            name="zi"
            label="Ore deschise în ziua"
            min={today}
            required
            style="flex:1;min-width:240px"
          />
          <div class="field" style="min-width:96px">
            <label class="label" for="slot-start">De la</label>
            <input class="input" id="slot-start" name="ora_start" type="time" value="14:00" step="900" required />
          </div>
          <div class="field" style="min-width:96px">
            <label class="label" for="slot-final">Până la</label>
            <input class="input" id="slot-final" name="ora_final" type="time" value="16:00" step="900" required />
          </div>
          <div class="field" style="min-width:110px">
            <label class="label" for="slot-locuri">Locuri</label>
            <input class="input" id="slot-locuri" name="locuri" type="number" min="1" max="30" value="1" />
            <span class="hint">Câți studenți pot lua același interval.</span>
          </div>
          <div class="field" style="min-width:150px">
            <label class="label" for="slot-mod">Unde</label>
            <select class="select" id="slot-mod" name="mod" data-mod>
              <option value="in_person">La facultate</option>
              <option value="online">Online</option>
            </select>
          </div>
        </div>

        <div class="row row--wrap" style="gap:var(--s-3);align-items:flex-end">
          <div class="field" style="flex:2;min-width:260px" data-camp-locatie>
            <label class="label" for="slot-locatie">Clădirea, etajul și sala</label>
            <input class="input" id="slot-locatie" name="locatie" value={u.office ?? ''}
              placeholder="Clădirea Ion Angelescu, Piața Romană 6, etaj 2, sala 2203" />
          </div>
          <div class="field" style="flex:2;min-width:240px">
            <label class="label" for="slot-link">
              Link întâlnire <span class="muted" data-link-optional>(opțional)</span>
            </label>
            <input class="input" id="slot-link" name="link_online" type="url" placeholder="https://meet…" />
          </div>
          <button class="btn btn--primary" type="submit">Publică intervalele</button>
        </div>
      </form>
      <p class="hint" style="margin-top:var(--s-2)">
        Se creează câte un interval de o oră. Toți studenții coordonați primesc un email
        imediat ce publici — inclusiv când publici un singur interval — și primesc invitație
        în calendar la rezervare, cu adresa și linkul completate aici.
      </p>
    </div>
  </section>
</div>
</ProfesorLayout>

<style>
  /* The week header.
   *
   * A table of thirty rows in chronological order has no landmarks: „what have I
   * got on Thursday” takes counting. Each `tbody` is one week, and this row is
   * its title — sticky under the header, so it is not lost while scrolling. */
  .rand-grup th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--s-2) var(--s-4);
    background: var(--surface-sunken);
    border-block: 1px solid var(--border);
    text-align: left;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
  }

  .rand-grup--stins th {
    color: var(--ink-muted);
    font-weight: 500;
  }

  /* Twelve columns, aligned to the top.
     In a flex row, the student box was 330px tall and „Ziua / Ora / Durata”
     centred vertically against it — three fields floating in the middle of a
     gap, with no common line. */
  .programare {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .programare .field {
    min-width: 0;
  }
  .programare__cine {
    display: flex;
    flex-direction: column;
  }

  .programare__detalii {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
  }

  .programare__pereche {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }

  /* A day written out — „12 septembrie 2026” — needs more room than „14:00”.
     Split down the middle, the date was the only field on the screen that had to
     be truncated to fit its own box; under 1200px there is no split that leaves
     both of them enough, so they stack. */
  .programare__pereche--zi {
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }
  @media (max-width: 1200px) {
    .programare__pereche--zi {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The student list stops at the height of the right-hand column, so that the
     two columns end on the same line. */
  .programare__cine .alege-studenti {
    flex: 1;
    min-height: 0;
  }
  .programare__cine .alege-studenti__lista {
    flex: 1;
    max-height: none;
  }

  @media (max-width: 900px) {
    .programare,
    .programare__pereche {
      grid-template-columns: minmax(0, 1fr);
    }
    .programare__cine .alege-studenti__lista {
      max-height: 15rem;
    }
  }

  .alege-studenti {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .alege-studenti__toti {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
  }

  /* The list cut the last row in half, with no visible scrollbar and no sign at
     all that somebody else followed — it looked like a rendering defect. A fade
     at the bottom of the box says there is more, and the height stops on a whole
     row. */
  .alege-studenti__lista {
    display: flex;
    flex-direction: column;
    max-height: 15rem;
    overflow-y: auto;
    scrollbar-width: thin;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.25rem), transparent);
  }

  .student-optiune {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .student-optiune:hover {
    background: var(--surface-sunken);
  }

  .student-optiune__corp {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.35;
  }
  .student-optiune__corp strong {
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .student-optiune__corp small {
    font-size: var(--t-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  /* --- student selection --------------------------------------------------- */

  const toti = document.getElementById('toti-studentii') as HTMLInputElement | null
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[name="student_id"]')]
  const counterEl = document.getElementById('numar-alesi')
  const submitButton = document.getElementById('programeaza') as HTMLButtonElement | null

  function syncSelection() {
    const alesi = boxes.filter((c) => c.checked).length
    if (toti) {
      toti.checked = alesi === boxes.length && boxes.length > 0
      toti.indeterminate = alesi > 0 && alesi < boxes.length
    }
    if (counterEl) {
      counterEl.textContent =
        alesi === 0
          ? 'Alege cel puțin un student.'
          : alesi === 1
            ? '1 student ales — primește invitația în calendar.'
            : `${alesi} studenți aleși — fiecare primește invitația în calendar.`
    }
    if (submitButton) submitButton.disabled = alesi === 0
  }

  toti?.addEventListener('change', () => {
    boxes.forEach((c) => (c.checked = toti.checked))
    syncSelection()
  })
  boxes.forEach((c) => c.addEventListener('change', syncSelection))
  syncSelection()

  // An online interval needs a link, one at the faculty needs an address. The
  // irrelevant field disappears instead of staying empty and required.
  document.querySelectorAll<HTMLFormElement>('form').forEach((form) => {
    const mod = form.querySelector<HTMLSelectElement>('[data-mod]')
    if (!mod) return

    const locationField = form.querySelector<HTMLElement>('[data-camp-locatie]')
    const link = form.querySelector<HTMLInputElement>('input[name="link_online"]')
    const optional = form.querySelector<HTMLElement>('[data-link-optional]')

    const sync = () => {
      const online = mod.value === 'online'
      if (locationField) locationField.hidden = online
      if (link) link.required = online
      if (optional) optional.hidden = online
    }

    mod.addEventListener('change', sync)
    sync()
  })
</script>
