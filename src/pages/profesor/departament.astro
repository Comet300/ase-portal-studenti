---
import Avatar from '../../components/Avatar.astro'
import Metrica from '../../components/Metrica.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import Taburi from '../../components/Taburi.astro'
import { query, queryOne } from '../../lib/db'
import { seatRequests } from '../../lib/lifecycle'
import {
  STATUS_CLASS,
  STATUS_LABELS,
  formatDate,
  programLabel,
  seatGrants,
  seatProgrammes,
  teacherCapacities,
  timeAgo,
} from '../../lib/repo'
import { EXTRA_SEATS_MAX_PER_LEVEL, GRANT_MAX, GRANT_MIN } from '../../lib/seats'
import { numar, officialName } from '../../lib/text'
import { LANGUAGE_LABELS, LEVEL_LABELS, currentYear } from '../../lib/years'

/**
 * Department-wide view for the head of department.
 *
 * Not per-student work: this answers coverage and bottleneck questions — who is
 * unassigned, who is over capacity, which topics nobody took — and it is where
 * seats are handed out, because that authority belongs to this role and nowhere
 * else in the portal.
 */

/* An unknown `?sectiune` left the page with the tab bar, the header and zero
 * content: both guards were false and nothing took over. Any unrecognised
 * value falls back to the default section. */
const SECTIONS = ['situatie', 'locuri', 'cadre'] as const
const requestedSection = Astro.url.searchParams.get('sectiune') ?? ''
const sectiune = (SECTIONS as readonly string[]).includes(requestedSection) ? requestedSection : 'situatie'

const teacherFilter = Astro.url.searchParams.get('coordonator') ?? ''
const programFilter = Astro.url.searchParams.get('program') ?? ''
const statusFilter = Astro.url.searchParams.get('status') ?? ''
const seriesFilter = Astro.url.searchParams.get('serie') ?? ''

const year = await currentYear()

interface Row {
  id: string
  number: string
  title_ro: string
  status: string
  submitted_at: string
  student_name: string
  student_number: string | null
  father_initial: string | null
  program: string | null
  specialization: string | null
  study_year: number | null
  study_series: string | null
  study_group: string | null
  teacher_id: string
  teacher_name: string
}

/* The cohort travelled with the student everywhere except here, where the
 * department's own table showed a name and a programme and nothing that says
 * which year, series or group the request comes from — the one screen where the
 * head compares cohorts against each other. */
const rows = await query<Row>(
  `SELECT r.id, r.number, r.title_ro, r.status, r.submitted_at,
          s.name AS student_name, s.student_number, s.father_initial,
          s.program, s.specialization, s.study_year, s.study_series, s.study_group,
          t.id AS teacher_id, t.name AS teacher_name
     FROM requests r
     JOIN users s ON s.id = r.student_id
     JOIN users t ON t.id = r.teacher_id
    WHERE r.academic_year_id = $4
      AND ($1::uuid IS NULL OR r.teacher_id = $1)
      AND ($2::text IS NULL OR s.program = $2)
      AND ($3::text IS NULL OR r.status = $3)
      AND ($5::text IS NULL OR s.study_series = $5)
    ORDER BY r.submitted_at DESC
    LIMIT 300`,
  [teacherFilter || null, programFilter || null, statusFilter || null, year?.id, seriesFilter || null],
)

/** The series the department actually has; there is no list to offer besides. */
const seriesOptions = (
  await query<{ study_series: string }>(
    `SELECT DISTINCT study_series FROM users
      WHERE role = 'student' AND study_series IS NOT NULL AND study_series <> ''
      ORDER BY study_series`,
  )
).map((r) => r.study_series)

const totals = await queryOne<{
  students: number
  with_request: number
  approved: number
  pending: number
  rejected: number
  expired: number
}>(
  `SELECT
     (SELECT count(*)::int FROM users WHERE role = 'student') AS students,
     /* "Has submitted" meant any request from that year, including a rejected,
        an expired or a withdrawn one — so a student left without a coordinator
        was counted among the settled ones, and this screen announced "All the
        students have submitted" while the other screen of the same head showed
        four with no request. Only the live requests are counted. */
     (SELECT count(DISTINCT student_id)::int
        FROM requests
       WHERE academic_year_id = $1 AND status IN ('approved', 'pending')) AS with_request,
     count(*) FILTER (WHERE status = 'approved')::int AS approved,
     count(*) FILTER (WHERE status = 'pending')::int  AS pending,
     count(*) FILTER (WHERE status = 'rejected')::int AS rejected,
     count(*) FILTER (WHERE status = 'expired')::int  AS expired
   FROM requests WHERE academic_year_id = $1`,
  [year?.id],
)

/** Load per coordinator, so an overloaded or idle one is visible at a glance. */
const load = await query<{
  id: string
  name: string
  avatar_path: string | null
  pending: number
  free_topics: number
}>(
  `SELECT t.id, t.name, t.avatar_path,
          (SELECT count(*)::int FROM requests r WHERE r.teacher_id = t.id
            AND r.status = 'pending' AND r.academic_year_id = $1)     AS pending,
          (SELECT count(*)::int FROM topics tp WHERE tp.teacher_id = t.id AND tp.is_active
             AND tp.academic_year_id = $1
             AND NOT EXISTS (SELECT 1 FROM requests r2 WHERE r2.topic_id = tp.id AND r2.status = 'approved')) AS free_topics
     FROM users t
    WHERE t.role IN ('teacher', 'head')
    ORDER BY t.name`,
  [year?.id],
)

/* The seat numbers come from `teacherCapacities`, not from `seat_allocations`.
 *
 * This screen read `a.bachelor_seats` — the fused base+extras column migration
 * 0019 froze and nothing has written since. So the director's own table showed
 * whatever the number happened to be the day of that migration: every base set
 * here afterwards landed in `bachelor_base` and was never read back, and the
 * „Alocă locuri” form opened pre-filled with the stale value it was about to
 * overwrite. One function answers capacity for the whole portal now, and it is
 * the same one the three gates ask. */
const capacities = await teacherCapacities()
const seatRequestRows = await seatRequests()
const pendingSeatRequests = seatRequestRows.filter((r) => r.status === 'pending')
const grantRows = await seatGrants()
const liveGrants = grantRows.filter((g) => !g.revoked_at)
/* A live grant that names no programme is a seat nobody can spend: `freeFor`
 * matches a student's programme against the pot's, and NULL matches no student
 * who exists. Migration 0026 makes one impossible; this keeps them visible for
 * a database that predates it, rather than leaving the director looking at
 * seats the ledger counts and no coordinator can use. */
const deadGrants = liveGrants.filter((g) => !g.programme_id)
const programmeChoices = await seatProgrammes()
const activeProgrammes = programmeChoices.filter((p) => p.is_active)

const unassigned = (totals?.students ?? 0) - (totals?.with_request ?? 0)
const withSeats = load.map((t) => {
  const cap = capacities.get(t.id)!
  return {
    ...t,
    bachelor: cap.bachelor,
    master: cap.master,
    seats: cap.bachelor.total + cap.master.total,
    taken: cap.bachelor.taken + cap.master.taken,
  }
})
const overloaded = withSeats.filter((t) => t.seats > 0 && t.taken > t.seats)
const fullyBooked = withSeats.filter((t) => t.seats > 0 && t.taken >= t.seats)
const withoutSeats = withSeats.filter((t) => t.seats === 0)

const exportUrl = `/profesor/departament/export-cereri?${new URLSearchParams({
  ...(teacherFilter ? { coordonator: teacherFilter } : {}),
  ...(programFilter ? { program: programFilter } : {}),
  ...(statusFilter ? { status: statusFilter } : {}),
  ...(seriesFilter ? { serie: seriesFilter } : {}),
}).toString()}`

const currentPath = Astro.url.pathname + Astro.url.search

/* Conturile corpului didactic.
 *
 * Stăteau pe „Conturi”, un ecran care ținea la un loc studenții și cadrele
 * didactice — două administrări care nu se fac de aceeași persoană, în același
 * moment. Studenții au plecat pe „Studenții facultății”, unde sunt oricum
 * listați; cadrele didactice stau aici, lângă locurile pe care le primesc.
 *
 * `coordonari` spune ce se pierde dacă li se închide accesul, ca decizia să nu
 * fie luată pe nevăzute. */
const cadre = await query<{
  id: string
  name: string
  email: string
  role: 'student' | 'teacher' | 'head'
  academic_title: string | null
  first_login_at: string | null
  avatar_path: string | null
  is_active: boolean
  deactivated_at: string | null
  coordonari: number
}>(
  `SELECT u.id, u.name, u.email, u.role, u.academic_title,
          u.first_login_at::text, u.avatar_path, u.is_active, u.deactivated_at::text,
          (SELECT count(*)::int FROM requests r
            WHERE r.teacher_id = u.id AND r.status IN ('approved', 'defended')) AS coordonari
     FROM users u
    WHERE u.role <> 'student'
    ORDER BY u.is_active DESC, u.role, u.name`,
)

const ROLE_TEXT: Record<string, string> = {
  teacher: 'Cadru didactic',
  head: 'Director de departament',
}

/** How a programme is named in a picker: its title, plus the language. */
const programmeOption = (p: { name: string; language: string }) =>
  `${p.name} · ${LANGUAGE_LABELS[p.language] ?? p.language}`

const sections = [
  { key: 'situatie', text: 'Situația sesiunii', count: null },
  /* The count moved here with the panels it counts: it is the number of
     coordinators waiting on a decision from this screen, and it sat on a tab
     about coverage. */
  { key: 'locuri', text: 'Locuri', count: pendingSeatRequests.length + deadGrants.length },
  { key: 'cadre', text: 'Cadre didactice', count: null },
]
---

<ProfesorLayout
  title="Departament"
  lede={`Situația întregii sesiuni ${year?.label ?? ''}: acoperire, încărcare pe coordonatori și alocarea locurilor.`}
  active="departament"
>
  <div slot="actiuni" class="row row--wrap" style="gap:var(--s-2)">
    <a class="btn btn--secondary btn--sm" href="/profesor/export-coordonari">Export coordonări</a>
    <a class="btn btn--ghost btn--sm" href={exportUrl}>Export cereri</a>
  </div>

  <Taburi
    taburi={sections.map((s) => ({ ...s, href: `/profesor/departament?sectiune=${s.key}` }))}
    activ={sectiune}
    eticheta="Secțiuni"
  />

  {/* --------------------------------------------------------- situation */}
  {
    sectiune === 'situatie' && (
      <div class="stack stack--loose">
        <section class="stack">
          <h2 class="section-title">Acoperire</h2>
          <div class="grid-auto">
            <Metrica value={totals?.students ?? 0} label="studenți în sesiune" />
            <Metrica
              value={unassigned}
              label="fără cerere activă"
              alerta={unassigned > 0}
              note={
                (totals?.students ?? 0) === 0
                  ? 'Niciun student înscris în sesiune'
                  : unassigned > 0
                    ? 'Fie nu au depus, fie cererea a fost respinsă'
                    : 'Toți au o cerere în lucru sau aprobată'
              }
            />
            {/* Rejections and expirations no longer vanish into "has submitted":
                they are exactly the students the head has to go looking for. */}
            <Metrica
              value={(totals?.rejected ?? 0) + (totals?.expired ?? 0)}
              label="cereri respinse sau expirate"
              note={
                (totals?.expired ?? 0) > 0
                  ? `${totals?.expired} expirate fără răspuns`
                  : 'toate cu motivul comunicat'
              }
            />
            <Metrica
              value={totals?.pending ?? 0}
              label="cereri în așteptare"
              note={`la ${load.filter((t) => t.pending > 0).length} coordonatori`}
            />
            <Metrica
              value={totals?.approved ?? 0}
              label="coordonări confirmate"
              note={
                totals?.expired ? `${totals.expired} cereri au expirat fără răspuns` : undefined
              }
            />
          </div>
        </section>

        {overloaded.length > 0 && (
          <p class="alert">
            <strong>Peste capacitate:</strong>{' '}
            {overloaded.map((t) => `${t.name} (${t.taken}/${t.seats})`).join(' · ')}
          </p>
        )}

        {withoutSeats.length > 0 && (
          <p class="alert">
            <strong>Fără locuri alocate:</strong>{' '}
            {withoutSeats.map((t) => t.name).join(' · ')}. Studenții nu le pot depune cereri.{' '}
            <a href="/profesor/departament?sectiune=locuri">Alocă locuri</a>
          </p>
        )}

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cereri</h2>
            <span class="muted text-sm">{rows.length} afișate</span>
          </div>

          <form method="GET" class="panel__body row row--wrap" style="gap:var(--s-3);align-items:flex-end">
            <input type="hidden" name="sectiune" value="situatie" />
            <div class="field" style="flex:2;min-width:220px">
              <label class="label" for="coordonator">Coordonator</label>
              <select class="select" id="coordonator" name="coordonator">
                <option value="">Toți coordonatorii</option>
                {load.map((t) => (
                  <option value={t.id} selected={t.id === teacherFilter}>
                    {t.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="field" style="flex:1;min-width:150px">
              <label class="label" for="program">Program</label>
              <select class="select" id="program" name="program">
                <option value="">Licență și master</option>
                <option value="bachelor" selected={programFilter === 'bachelor'}>Licență</option>
                <option value="master" selected={programFilter === 'master'}>Master</option>
              </select>
            </div>
            <div class="field" style="flex:1;min-width:130px">
              <label class="label" for="serie">Serie</label>
              <select class="select" id="serie" name="serie">
                <option value="">Toate seriile</option>
                {seriesOptions.map((v) => (
                  <option value={v} selected={seriesFilter === v}>
                    {v}
                  </option>
                ))}
              </select>
            </div>
            <div class="field" style="flex:1;min-width:150px">
              <label class="label" for="status">Stare</label>
              <select class="select" id="status" name="status">
                <option value="">Toate stările</option>
                {Object.entries(STATUS_LABELS).map(([v, l]) => (
                  <option value={v} selected={statusFilter === v}>
                    {l}
                  </option>
                ))}
              </select>
            </div>
            <button class="btn btn--secondary" type="submit">Filtrează</button>
          </form>

          {rows.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere pentru filtrele alese</p>
              <p class="empty__text">Schimbă coordonatorul, programul, seria sau starea.</p>
            </div>
          ) : (
            <div class="table-wrap" tabindex="0" role="region" aria-label="Cereri de locuri suplimentare">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Student</th>
                    <th scope="col">Program</th>
                    <th scope="col">Coordonator</th>
                    <th scope="col">Titlul lucrării</th>
                    <th scope="col">Stare</th>
                    <th scope="col">Depusă</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      <td>
                        <div class="stack stack--tight" style="gap:0">
                          <strong>{officialName({ name: r.student_name, father_initial: r.father_initial })}</strong>
                          <span class="muted text-xs">
                            {[
                              r.student_number,
                              r.study_year ? `anul ${r.study_year}` : null,
                              r.study_series ? `seria ${r.study_series}` : null,
                              r.study_group,
                            ].filter(Boolean).join(' · ')}
                          </span>
                        </div>
                      </td>
                      <td>
                        <span class="muted">{programLabel(r.program)}</span>
                      </td>
                      <td>{r.teacher_name}</td>
                      <td class="cell-title" title={r.title_ro}>{r.title_ro}</td>
                      <td>
                        <span class:list={['badge', STATUS_CLASS[r.status]]}>{STATUS_LABELS[r.status]}</span>
                      </td>
                      <td class="muted">{formatDate(r.submitted_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    )
  }

  {/* ------------------------------------------------------------- seats */}
  {
    sectiune === 'locuri' && (
      <div class="stack stack--loose">
        {/* Un loc acordat fără program nu poate fi ocupat de nimeni: `freeFor`
            compară programul studentului cu cel al rezervei, iar NULL nu se
            potrivește cu niciun student. Migrarea 0026 face imposibilă o
            asemenea acordare; rândurile de dinaintea ei se arată aici, ca
            directorul să le retragă și să le dea din nou pe un program, nu să
            le lase să umfle un total pe care nimeni nu îl poate cheltui. */}
        {deadGrants.length > 0 && (
          <p class="alert">
            <strong>Locuri acordate fără program de studiu:</strong>{' '}
            {deadGrants.map((g) => `${g.teacher_name} (${g.seats})`).join(' · ')}. Un loc
            suplimentar se rezervă unui singur program, deci acestea nu pot fi ocupate de niciun
            student. Retrage-le din jurnalul de mai jos și acordă-le din nou, alegând programul.
          </p>
        )}

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Încărcare pe coordonatori</h2>
            <span class="muted text-sm">
              {fullyBooked.length} din {load.length} au locurile ocupate
            </span>
          </div>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Locurile alocate pe cadru didactic">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Coordonator</th>
                  <th scope="col">Licență</th>
                  <th scope="col">Master</th>
                  <th scope="col">Total</th>
                  <th scope="col">Rezervate</th>
                  <th scope="col">În așteptare</th>
                  <th scope="col"><span class="visually-hidden">Alocare</span></th>
                </tr>
              </thead>
              <tbody>
                {withSeats.map((t) => (
                  <>
                  <tr id={`coordonator-${t.id}`}>
                    <td>
                      <div class="row" style="gap:var(--s-3)">
                        <Avatar name={t.name} src={t.avatar_path} size="xs" href={`/profil/${t.id}`} />
                        {t.name}
                      </div>
                    </td>
                    <td class="numeric">{t.bachelor.taken} / {t.bachelor.total}</td>
                    <td class="numeric">{t.master.taken} / {t.master.total}</td>
                    <td class="numeric">
                      <span class:list={{ 'at-capacity': t.seats > 0 && t.taken === t.seats, 'over-capacity': t.seats > 0 && t.taken > t.seats }}>
                        {t.taken} / {t.seats}
                      </span>
                    </td>
                    {/* „x din y” ascundea exact lucrul pe care îl decide acest
                        ecran: câte din locurile libere sunt rezervate unui
                        program anume și deci nu pot fi ocupate de oricine. */}
                    <td class="numeric muted">
                      {t.bachelor.granted + t.master.granted > 0
                        ? t.bachelor.granted + t.master.granted
                        : '—'}
                    </td>
                    <td class="numeric">
                      {t.pending > 0 ? (
                        <span class="badge badge--asteptare">{t.pending}</span>
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                    <td style="text-align:right">
                      <button
                        class="btn btn--secondary btn--sm"
                        type="button"
                        data-editeaza={t.id}
                        aria-expanded="false"
                        aria-controls={`locuri-rand-${t.id}`}
                      >
                        Alocă locuri
                      </button>
                    </td>
                  </tr>

                  {/* Alocarea stă pe rândul coordonatorului, nu pe o filă
                      separată: erau două tabele cu aceleași nume, unul care
                      spunea câte locuri sunt ocupate și altul unde se scria
                      câte sunt — și trebuia ținut minte de la unul la altul. */}
                  <tr class="editor-rand" id={`locuri-rand-${t.id}`} hidden>
                    <td colspan="7">
                      <div class="locuri-editor">
                        <form method="POST" action="/api/locuri" class="alocare">
                          <input type="hidden" name="actiune" value="aloca" />
                          <input type="hidden" name="profesor_id" value={t.id} />

                          {/* Întoarcerea pe normă, ca bifă, pe fiecare nivel.
                              API-ul o știe de la 0019 — „pe_norma” — dar niciun
                              formular nu a trimis vreodată câmpul, așa că orice
                              salvare scria un număr fix și un coordonator nu mai
                              putea fi pus înapoi pe norma anului din portal.
                              Două bife cu același nume, citite cu `getAll`:
                              nivelurile sunt două decizii, iar `get` ar fi
                              întors-o doar pe prima. */}
                          <div class="field">
                            <label class="label" for={`lic-${t.id}`}>Locuri de bază, licență</label>
                            <input class="input input--num" id={`lic-${t.id}`} name="locuri_licenta"
                              type="number" min="0" max="40" value={t.bachelor.base} />
                            <label class="pe-norma" for={`norma-lic-${t.id}`}>
                              <input type="checkbox" id={`norma-lic-${t.id}`} name="pe_norma"
                                value="licenta" checked={t.bachelor.is_norm} />
                              <span>Pe norma anului ({year?.default_bachelor_seats ?? 0})</span>
                            </label>
                            <span class="hint">
                              {t.bachelor.taken} ocupate
                              {t.bachelor.is_norm ? ' · acum pe norma anului' : ''}
                            </span>
                          </div>

                          <div class="field">
                            <label class="label" for={`mas-${t.id}`}>Locuri de bază, master</label>
                            <input class="input input--num" id={`mas-${t.id}`} name="locuri_master"
                              type="number" min="0" max="40" value={t.master.base} />
                            <label class="pe-norma" for={`norma-mas-${t.id}`}>
                              <input type="checkbox" id={`norma-mas-${t.id}`} name="pe_norma"
                                value="master" checked={t.master.is_norm} />
                              <span>Pe norma anului ({year?.default_master_seats ?? 0})</span>
                            </label>
                            <span class="hint">
                              {t.master.taken} ocupate
                              {t.master.is_norm ? ' · acum pe norma anului' : ''}
                            </span>
                          </div>

                          <div class="field" style="flex:1;min-width:220px">
                            <label class="label" for={`nota-baza-${t.id}`}>De ce (opțional)</label>
                            <input class="input" id={`nota-baza-${t.id}`} name="nota"
                              placeholder="Ex: preia grupa colegei plecate în concediu." />
                            <span class="hint">
                              Rămâne în jurnalul locurilor. Cu bifa scoasă, salvarea fixează
                              numărul scris; cu bifa pusă, numărul de alături nu se citește, iar
                              o schimbare a normei anului îl atinge din nou.
                            </span>
                          </div>

                          <button class="btn btn--primary btn--sm" type="submit">
                            Salvează locurile de bază
                          </button>
                        </form>

                        {/* Locurile suplimentare nu aveau niciun formular: API-ul
                            le știa acorda de la 0019, dar nu exista ecran de pe
                            care să fie trimis `program_id`, deci directorul putea
                            doar să răspundă unei cereri scrise. Baza este comună
                            pe nivel, rezerva este a unui singur program — de aceea
                            sunt două formulare și nu două câmpuri. */}
                        <form method="POST" action="/api/locuri" class="alocare alocare--extra">
                          <input type="hidden" name="actiune" value="acorda" />
                          <input type="hidden" name="profesor_id" value={t.id} />

                          <div class="field" style="flex:2;min-width:260px">
                            <label class="label" for={`prog-${t.id}`}>
                              Locuri suplimentare, pentru programul
                            </label>
                            <select class="select" id={`prog-${t.id}`} name="program_id" required>
                              <option value="">Alege programul de studiu</option>
                              {(['bachelor', 'master'] as const).map((level) =>
                                activeProgrammes.filter((p) => p.level === level).length > 0 ? (
                                  <optgroup label={LEVEL_LABELS[level]}>
                                    {activeProgrammes
                                      .filter((p) => p.level === level)
                                      .map((p) => (
                                        <option value={p.id}>{programmeOption(p)}</option>
                                      ))}
                                  </optgroup>
                                ) : null,
                              )}
                            </select>
                            <span class="hint">
                              Nivelul vine de la program. Locurile rezervate aici pot fi ocupate
                              numai de studenții acestui program.
                            </span>
                          </div>

                          <div class="field">
                            <label class="label" for={`extra-${t.id}`}>Câte</label>
                            <input class="input input--num" id={`extra-${t.id}`} name="locuri"
                              type="number" min={GRANT_MIN} max={GRANT_MAX} value="2" />
                            <span class="hint">
                              Cel mult {EXTRA_SEATS_MAX_PER_LEVEL} pe nivel, într-un an.
                            </span>
                          </div>

                          <div class="field" style="flex:1;min-width:240px">
                            <label class="label" for={`motiv-${t.id}`}>De ce</label>
                            <input class="input" id={`motiv-${t.id}`} name="motiv" minlength="20"
                              required placeholder="Ex: a preluat trei studenți de la colegul pensionat." />
                            <span class="hint">
                              Cel puțin 20 de caractere. Rămâne în jurnal și este singurul care
                              explică decizia peste un an.
                            </span>
                          </div>

                          <button class="btn btn--secondary btn--sm" type="submit">
                            Rezervă locurile
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cereri de locuri suplimentare</h2>
            <span class="muted text-sm">
              {pendingSeatRequests.length} în așteptare
            </span>
          </div>

          {pendingSeatRequests.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere în așteptare</p>
              <p class="empty__text">
                Când un coordonator rămâne fără locuri pentru un program, îți poate cere altele de
                aici, cu o motivare scrisă. Le poți rezerva și fără să fii întrebat, din rândul
                coordonatorului de mai sus.
              </p>
            </div>
          ) : (
            <ul class="seat-requests">
              {pendingSeatRequests.map((r) => (
                <li>
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <strong>{r.teacher_name}</strong>
                    <span class="muted text-xs">
                      cerută {timeAgo(r.created_at)}
                    </span>
                  </div>
                  {/* Programul, nu doar nivelul. Un loc suplimentar este
                      rezervat unui singur program, deci „3 locuri la master”
                      nu spune pentru cine sunt — iar directorul aproba fără
                      să afle. */}
                  <p class="text-sm">
                    Solicită <strong>{r.extra_seats}</strong> locuri pentru{' '}
                    {r.programme_name ? (
                      <strong>{r.programme_name}</strong>
                    ) : (
                      <span class="fara-program">un program nenumit</span>
                    )}{' '}
                    ({LEVEL_LABELS[r.level].toLowerCase()}).
                  </p>
                  {!r.programme_id && (
                    <p class="hint" style="margin:0">
                      Cererea este dinaintea evidenței pe programe și nu poate fi aprobată ca atare:
                      locurile ar rămâne nefolosibile de oricine. Respinge-o și acordă locurile din
                      rândul coordonatorului, alegând programul.
                    </p>
                  )}
                  <p class="motivare">{r.reason}</p>

                  <form method="POST" action="/api/locuri" class="stack stack--tight">
                    <input type="hidden" name="actiune" value="decide" />
                    <input type="hidden" name="cerere_id" value={r.id} />
                    <div class="field">
                      <label class="label" for={`nota-${r.id}`}>Notă pentru coordonator (opțional)</label>
                      <input class="input" id={`nota-${r.id}`} name="nota" placeholder="Ex: aprobat până la finalul sesiunii curente." />
                    </div>
                    <div class="row" style="gap:var(--s-2)">
                      {r.programme_id && (
                        <button class="btn btn--primary btn--sm" type="submit" name="decizie" value="approved">
                          Rezervă {r.extra_seats} locuri pentru {r.programme_name}
                        </button>
                      )}
                      <button class="btn btn--danger btn--sm" type="submit" name="decizie" value="rejected">
                        Respinge
                      </button>
                    </div>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>

        {/* Jurnalul acordărilor. Exista în `seatGrants` de la 0019 și nu îl
            citea niciun ecran, deci locurile suplimentare se puteau da, dar nu
            se puteau nici vedea, nici retrage — iar mesajul care spune „retrage
            o acordare neocupată” trimitea într-un loc care nu exista. */}
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Jurnalul locurilor suplimentare</h2>
            <span class="muted text-sm">
              {liveGrants.reduce((n, g) => n + g.seats, 0)} rezervate acum
            </span>
          </div>

          {grantRows.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio acordare în acest an universitar</p>
              <p class="empty__text">
                Locurile suplimentare se rezervă pe un program anume, din rândul coordonatorului de
                mai sus sau răspunzând unei cereri scrise.
              </p>
            </div>
          ) : (
            <ul class="seat-requests">
              {grantRows.map((g) => (
                <li class:list={{ 'is-retras': Boolean(g.revoked_at) }}>
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <strong>{g.teacher_name}</strong>
                    <span class="muted text-xs">
                      {g.seat_request_id ? 'la cerere' : 'din inițiativa directorului'} ·{' '}
                      {formatDate(g.granted_at)}
                      {g.granted_by_name ? ` · ${g.granted_by_name}` : ''}
                    </span>
                  </div>
                  <p class="text-sm">
                    <strong>{g.seats}</strong>{' '}
                    {g.programme_name ? (
                      <>
                        pentru {g.programme_name}
                        {g.programme_language && g.programme_language !== 'ro'
                          ? ` · ${LANGUAGE_LABELS[g.programme_language]}`
                          : ''}
                      </>
                    ) : (
                      <span class="fara-program">fără program de studiu — nimeni nu le poate ocupa</span>
                    )}{' '}
                    ({LEVEL_LABELS[g.level].toLowerCase()})
                  </p>
                  <p class="motivare">{g.reason}</p>

                  {g.revoked_at ? (
                    <p class="muted text-xs">
                      Retrase {formatDate(g.revoked_at)}
                      {g.revoked_by_name ? ` de ${g.revoked_by_name}` : ''}
                      {g.revoke_reason ? ` — „${g.revoke_reason}”` : ''}
                    </p>
                  ) : (
                    <form method="POST" action="/api/locuri" class="row row--wrap" style="gap:var(--s-2);align-items:flex-end">
                      <input type="hidden" name="actiune" value="retrage" />
                      <input type="hidden" name="acordare_id" value={g.id} />
                      <div class="field" style="flex:1;min-width:240px">
                        <label class="label" for={`retragere-${g.id}`}>De ce le retragi</label>
                        <input class="input" id={`retragere-${g.id}`} name="motiv" minlength="10"
                          required placeholder="Ex: promoția a ieșit mai mică decât se aștepta." />
                        <span class="hint">
                          Cel puțin 10 caractere. Cadrul didactic vede acest text. Locurile deja
                          ocupate nu se pot retrage.
                        </span>
                      </div>
                      <button class="btn btn--danger btn--sm" type="submit">Retrage locurile</button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>

        {seatRequestRows.filter((r) => r.status !== 'pending').length > 0 && (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">Decizii anterioare</h2>
            </div>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Deciziile anterioare pe cereri de locuri">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Coordonator</th>
                    <th scope="col">Cerea</th>
                    <th scope="col">Pentru</th>
                    <th scope="col">Decizie</th>
                    <th scope="col">Data</th>
                    <th scope="col">Notă</th>
                  </tr>
                </thead>
                <tbody>
                  {seatRequestRows
                    .filter((r) => r.status !== 'pending')
                    .map((r) => (
                      <tr>
                        <td>{r.teacher_name}</td>
                        <td class="numeric">
                          {r.extra_seats} · {LEVEL_LABELS[r.level].toLowerCase()}
                        </td>
                        <td class="muted cell-title">{r.programme_name ?? '—'}</td>
                        <td>
                          <span
                            class:list={[
                              'badge',
                              r.status === 'approved' ? 'badge--aprobata' : 'badge--respinsa',
                            ]}
                          >
                            {r.status === 'approved' ? 'Aprobată' : 'Respinsă'}
                          </span>
                        </td>
                        <td class="muted">{formatDate(r.decided_at)}</td>
                        <td class="muted cell-title">{r.decision_note ?? '—'}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    )
  }


  {/* -------------------------------------------------------------- seats */}

  {
    sectiune === 'cadre' && (
      <div class="stack stack--loose">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cadrele didactice</h2>
            <span class="muted text-sm">
              {numar(cadre.filter((o) => o.is_active).length, 'cont deschis', 'conturi deschise')}
            </span>
          </div>

          <div class="table-wrap" tabindex="0" role="region" aria-label="Conturile cadrelor didactice">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Nume</th>
                  <th scope="col">Adresă de email</th>
                  <th scope="col">Rol</th>
                  <th scope="col">Coordonări</th>
                  <th scope="col">Acces</th>
                  <th scope="col"><span class="visually-hidden">Editează</span></th>
                </tr>
              </thead>
              <tbody>
                {cadre.map((o) => (
                  <>
                  <tr id={`cont-${o.id}`} class:list={{ 'is-inactive': !o.is_active }}>
                    <td>
                      <div class="row" style="gap:var(--s-3)">
                        <Avatar name={o.name} src={o.avatar_path} size="xs" href={`/profil/${o.id}`} />
                        {o.name}
                      </div>
                    </td>
                    <td class="muted">{o.email}</td>
                    <td class="muted">{ROLE_TEXT[o.role]}</td>
                    <td class="numeric muted">{o.coordonari}</td>
                    <td>
                      {o.is_active ? (
                        <span class="stack stack--tight" style="gap:2px">
                          <span class="badge badge--aprobata">Acces</span>
                          {/* Un cont deschis și niciodată folosit este, de
                              obicei, o literă greșită în adresă — iar omul de la
                              celălalt capăt așteaptă un link care nu poate veni. */}
                          {!o.first_login_at && (
                            <span class="badge badge--asteptare">Nu a intrat niciodată</span>
                          )}
                        </span>
                      ) : (
                        <span class="badge badge--neutru" title={`Închis ${formatDate(o.deactivated_at)}`}>
                          Închis
                        </span>
                      )}
                    </td>
                    <td style="text-align:right">
                      <button class="btn btn--ghost btn--sm" type="button"
                        data-editeaza={o.id} aria-expanded="false" aria-controls={`editor-${o.id}`}>
                        Editează
                      </button>
                    </td>
                  </tr>

                  <tr class="editor-rand" id={`editor-${o.id}`} hidden>
                    <td colspan="6">
                      <div class="editor">
                        <form method="POST" action="/api/conturi" class="editor__adresa">
                          <input type="hidden" name="actiune" value="schimba_email" />
                          <input type="hidden" name="utilizator_id" value={o.id} />
                          <input type="hidden" name="redirect" value={`${currentPath}#cont-${o.id}`} />
                          <div class="field" style="flex:1;min-width:240px">
                            <label class="label" for={`email-${o.id}`}>Adresă de email</label>
                            <input class="input" id={`email-${o.id}`} name="email" type="email"
                              value={o.email} required />
                            <span class="hint">
                              Autentificarea trece exclusiv prin ea. Schimbarea invalidează linkurile
                              de acces trimise până acum.
                            </span>
                          </div>
                          <button class="btn btn--primary btn--sm" type="submit">Salvează adresa</button>
                        </form>

                        <form method="POST" action="/api/conturi" class="editor__acces">
                          <input type="hidden" name="actiune"
                            value={o.is_active ? 'dezactiveaza' : 'reactiveaza'} />
                          <input type="hidden" name="utilizator_id" value={o.id} />
                          <input type="hidden" name="redirect" value={`${currentPath}#cont-${o.id}`} />
                          <p class="hint" style="margin:0">
                            {o.is_active
                              ? `Închiderea accesului nu șterge nimic: cele ${o.coordonari} coordonări și tot ce a scris rămân în arhivă.`
                              : 'Redeschiderea accesului îi permite din nou să ceară un link de intrare.'}
                          </p>
                          <button
                            class:list={['btn', 'btn--sm', o.is_active ? 'btn--danger' : 'btn--secondary']}
                            type="submit"
                          >
                            {o.is_active ? 'Închide accesul' : 'Redeschide accesul'}
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Adaugă un cadru didactic</h2>
          </div>
          <form method="POST" action="/api/conturi" class="panel__body stack">
            <input type="hidden" name="actiune" value="adauga" />
            <input type="hidden" name="redirect" value="/profesor/departament?sectiune=cadre" />

            <div class="row row--wrap" style="gap:var(--s-3)">
              <div class="field" style="flex:2;min-width:220px">
                <label class="label" for="nume">Nume complet</label>
                <input class="input" id="nume" name="nume" required
                  placeholder="Ex: Conf. univ. dr. Elena Dumitrescu" />
                <span class="hint">Titlul didactic face parte din nume, așa cum apare în catalog.</span>
              </div>
              <div class="field" style="flex:2;min-width:240px">
                <label class="label" for="email">Adresă de email</label>
                <input class="input" id="email" name="email" type="email" required
                  placeholder="elena.dumitrescu@ase.ro" />
              </div>
              <div class="field" style="min-width:210px">
                <label class="label" for="rol">Rol</label>
                <select class="select" id="rol" name="rol">
                  <option value="teacher">Cadru didactic</option>
                  <option value="head">Director de departament</option>
                </select>
              </div>
            </div>

            <div class="row row--end">
              <button class="btn btn--primary" type="submit">Deschide contul</button>
            </div>
          </form>
        </section>
      </div>
    )
  }

</ProfesorLayout>

<script>
  /* Rândul de editare se deschide unul singur, ca pe „Studenții facultății”:
     alocarea locurilor și adresa unui cadru didactic folosesc același tipar,
     iar două rânduri deschise deodată împing tabelul de două ori. */
  document.querySelectorAll<HTMLButtonElement>('[data-editeaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.getAttribute('aria-controls') ?? ''
      const rand = document.getElementById(id)
      if (!rand) return

      const eraDeschis = !rand.hidden
      document.querySelectorAll<HTMLElement>('.editor-rand').forEach((r) => (r.hidden = true))
      document
        .querySelectorAll<HTMLButtonElement>('[data-editeaza]')
        .forEach((x) => x.setAttribute('aria-expanded', 'false'))
      if (eraDeschis) return

      rand.hidden = false
      b.setAttribute('aria-expanded', 'true')
      rand.querySelector<HTMLInputElement>('input:not([type="hidden"])')?.focus()
    })
  })
</script>

<style>
  /* Alocarea, pe rândul coordonatorului: două numere, o notă și butonul, pe o
     singură linie. Stivuite, rândul creștea cât jumătate de tabel. */
  .alocare {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-4);
    padding: var(--s-4) 0;
  }
  .alocare .field {
    min-width: 120px;
  }
  /* Bifa stă sub numărul pe care îl anulează, nu lângă el: alăturate, se
     citeau ca două câmpuri de completat, iar ținta de atingere a bifei o
     lipea de input. `--tap` o ține apăsabilă cu degetul. */
  .pe-norma {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    font-size: var(--t-sm);
    color: var(--ink-soft);
    cursor: pointer;
    white-space: nowrap;
  }
  /* Două decizii diferite, una sub alta: baza este comună pe nivel, rezerva
     este a unui singur program. Puse pe același rând s-ar fi citit ca patru
     câmpuri ale aceluiași formular, iar butonul greșit ar fi fost la fel de
     ușor de apăsat ca cel bun. */
  .locuri-editor {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .alocare--extra {
    border-top: 1px solid var(--border);
  }

  /* O acordare retrasă rămâne în jurnal — asta este rostul lui — dar nu mai
     cere atenția uneia în vigoare. */
  .is-retras {
    color: var(--ink-muted);
  }
  .is-retras strong {
    font-weight: 500;
  }

  /* Culoarea nu poartă singură informația: propoziția de lângă spune că
     locurile nu pot fi ocupate de nimeni. */
  .fara-program {
    color: var(--danger);
    font-weight: 600;
  }

/* A closed account stays legible — it is part of the register — but no longer
     asks for attention the way an active one does. */
  .is-inchis td {
    color: var(--ink-muted);
  }

.is-inchis strong {
    font-weight: 500;
  }

.celula-email {
    font-size: var(--t-xs);
    word-break: break-all;
  }

.editor-rand td {
    background: var(--surface-sunken);
  }

/* The address and the access, side by side: both decide whether the person
     can get in. */
  .editor {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-5);
    padding: var(--s-4) 0;
    align-items: start;
  }

.editor__adresa,
  .editor__acces {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-3);
  }

.editor__acces {
    flex-direction: column;
    align-items: flex-start;
    border-left: 1px solid var(--border);
    padding-left: var(--s-5);
  }

@media (max-width: 900px) {
    .editor {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
    .editor__acces {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
      padding-top: var(--s-4);
    }
  }

  .taburi {
    display: flex;
    gap: var(--s-1);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--border);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab.is-activ {
    color: var(--red);
    font-weight: 600;
    border-bottom-color: var(--red);
  }

  .tab__contor {
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--surface-sunken);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .tab.is-activ .tab__contor {
    background: var(--red-tint);
    color: var(--red);
  }

  .alert {
    padding: var(--s-3) var(--s-4);
    background: var(--warn-tint);
    color: var(--warn);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
  }
  .alert a {
    color: inherit;
  }

  /* Exactly full is not a problem — it is the plan fulfilled. The red was put
     on `taken >= seats`, so a coordinator with 8 out of 8 looked like an
     overrun, on the same screen that said higher up that everything was fine. */
  .at-capacity {
    color: var(--warn);
    font-weight: 600;
  }

  .over-capacity {
    color: var(--danger);
    font-weight: 600;
  }

  .cell-title {
    max-width: 32ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .seat-requests {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .seat-requests li {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--border);
  }
  .seat-requests li:last-child {
    border-bottom: 0;
  }

  .motivare {
    padding: var(--s-3) var(--s-4);
    background: var(--surface-sunken);
    border-left: 2px solid var(--border-strong);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-wrap: pretty;
    max-width: 78ch;
  }

