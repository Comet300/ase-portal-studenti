---
import Avatar from '../../components/Avatar.astro'
import Metrica from '../../components/Metrica.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import Taburi from '../../components/Taburi.astro'
import { query, queryOne } from '../../lib/db'
import { seatRequests } from '../../lib/lifecycle'
import { STATUS_CLASS, STATUS_LABELS, formatDate, programLabel, timeAgo } from '../../lib/repo'
import { numar, officialName } from '../../lib/text'
import { LEVEL_LABELS, currentYear } from '../../lib/years'

/**
 * Department-wide view for the head of department.
 *
 * Not per-student work: this answers coverage and bottleneck questions — who is
 * unassigned, who is over capacity, which topics nobody took — and it is where
 * seats are handed out, because that authority belongs to this role and nowhere
 * else in the portal.
 */

/* An unknown `?sectiune` left the page with the tab bar, the header and zero
 * content: both guards were false and nothing took over. Any unrecognised
 * value falls back to the default section. */
const SECTIONS = ['situatie', 'cadre'] as const
const requestedSection = Astro.url.searchParams.get('sectiune') ?? ''
const sectiune = (SECTIONS as readonly string[]).includes(requestedSection) ? requestedSection : 'situatie'

const teacherFilter = Astro.url.searchParams.get('coordonator') ?? ''
const programFilter = Astro.url.searchParams.get('program') ?? ''
const statusFilter = Astro.url.searchParams.get('status') ?? ''
const seriesFilter = Astro.url.searchParams.get('serie') ?? ''

const year = await currentYear()

interface Row {
  id: string
  number: string
  title_ro: string
  status: string
  submitted_at: string
  student_name: string
  student_number: string | null
  father_initial: string | null
  program: string | null
  specialization: string | null
  study_year: number | null
  study_series: string | null
  study_group: string | null
  teacher_id: string
  teacher_name: string
}

/* The cohort travelled with the student everywhere except here, where the
 * department's own table showed a name and a programme and nothing that says
 * which year, series or group the request comes from — the one screen where the
 * head compares cohorts against each other. */
const rows = await query<Row>(
  `SELECT r.id, r.number, r.title_ro, r.status, r.submitted_at,
          s.name AS student_name, s.student_number, s.father_initial,
          s.program, s.specialization, s.study_year, s.study_series, s.study_group,
          t.id AS teacher_id, t.name AS teacher_name
     FROM requests r
     JOIN users s ON s.id = r.student_id
     JOIN users t ON t.id = r.teacher_id
    WHERE r.academic_year_id = $4
      AND ($1::uuid IS NULL OR r.teacher_id = $1)
      AND ($2::text IS NULL OR s.program = $2)
      AND ($3::text IS NULL OR r.status = $3)
      AND ($5::text IS NULL OR s.study_series = $5)
    ORDER BY r.submitted_at DESC
    LIMIT 300`,
  [teacherFilter || null, programFilter || null, statusFilter || null, year?.id, seriesFilter || null],
)

/** The series the department actually has; there is no list to offer besides. */
const seriesOptions = (
  await query<{ study_series: string }>(
    `SELECT DISTINCT study_series FROM users
      WHERE role = 'student' AND study_series IS NOT NULL AND study_series <> ''
      ORDER BY study_series`,
  )
).map((r) => r.study_series)

const totals = await queryOne<{
  students: number
  with_request: number
  approved: number
  pending: number
  rejected: number
  expired: number
}>(
  `SELECT
     (SELECT count(*)::int FROM users WHERE role = 'student') AS students,
     /* "Has submitted" meant any request from that year, including a rejected,
        an expired or a withdrawn one — so a student left without a coordinator
        was counted among the settled ones, and this screen announced "All the
        students have submitted" while the other screen of the same head showed
        four with no request. Only the live requests are counted. */
     (SELECT count(DISTINCT student_id)::int
        FROM requests
       WHERE academic_year_id = $1 AND status IN ('approved', 'pending')) AS with_request,
     count(*) FILTER (WHERE status = 'approved')::int AS approved,
     count(*) FILTER (WHERE status = 'pending')::int  AS pending,
     count(*) FILTER (WHERE status = 'rejected')::int AS rejected,
     count(*) FILTER (WHERE status = 'expired')::int  AS expired
   FROM requests WHERE academic_year_id = $1`,
  [year?.id],
)

/** Load per coordinator, so an overloaded or idle one is visible at a glance. */
const load = await query<{
  id: string
  name: string
  avatar_path: string | null
  bachelor_seats: number
  master_seats: number
  bachelor_taken: number
  master_taken: number
  pending: number
  free_topics: number
}>(
  `SELECT t.id, t.name, t.avatar_path,
          COALESCE(a.bachelor_seats, 0) AS bachelor_seats,
          COALESCE(a.master_seats, 0)   AS master_seats,
          (SELECT count(*)::int FROM requests r JOIN users s ON s.id = r.student_id
            WHERE r.teacher_id = t.id AND r.status = 'approved'
              AND r.academic_year_id = $1 AND s.program = 'bachelor') AS bachelor_taken,
          (SELECT count(*)::int FROM requests r JOIN users s ON s.id = r.student_id
            WHERE r.teacher_id = t.id AND r.status = 'approved'
              AND r.academic_year_id = $1 AND s.program = 'master')   AS master_taken,
          (SELECT count(*)::int FROM requests r WHERE r.teacher_id = t.id
            AND r.status = 'pending' AND r.academic_year_id = $1)     AS pending,
          (SELECT count(*)::int FROM topics tp WHERE tp.teacher_id = t.id AND tp.is_active
             AND tp.academic_year_id = $1
             AND NOT EXISTS (SELECT 1 FROM requests r2 WHERE r2.topic_id = tp.id AND r2.status = 'approved')) AS free_topics
     FROM users t
     LEFT JOIN seat_allocations a ON a.teacher_id = t.id AND a.academic_year_id = $1
    WHERE t.role IN ('teacher', 'head')
    ORDER BY t.name`,
  [year?.id],
)

const seatRequestRows = await seatRequests()
const pendingSeatRequests = seatRequestRows.filter((r) => r.status === 'pending')

const unassigned = (totals?.students ?? 0) - (totals?.with_request ?? 0)
const withSeats = load.map((t) => ({
  ...t,
  seats: t.bachelor_seats + t.master_seats,
  taken: t.bachelor_taken + t.master_taken,
}))
const overloaded = withSeats.filter((t) => t.seats > 0 && t.taken > t.seats)
const fullyBooked = withSeats.filter((t) => t.seats > 0 && t.taken >= t.seats)
const withoutSeats = withSeats.filter((t) => t.seats === 0)

const exportUrl = `/profesor/departament/export-cereri?${new URLSearchParams({
  ...(teacherFilter ? { coordonator: teacherFilter } : {}),
  ...(programFilter ? { program: programFilter } : {}),
  ...(statusFilter ? { status: statusFilter } : {}),
  ...(seriesFilter ? { serie: seriesFilter } : {}),
}).toString()}`

const currentPath = Astro.url.pathname + Astro.url.search

/* Conturile corpului didactic.
 *
 * Stăteau pe „Conturi”, un ecran care ținea la un loc studenții și cadrele
 * didactice — două administrări care nu se fac de aceeași persoană, în același
 * moment. Studenții au plecat pe „Studenții facultății”, unde sunt oricum
 * listați; cadrele didactice stau aici, lângă locurile pe care le primesc.
 *
 * `coordonari` spune ce se pierde dacă li se închide accesul, ca decizia să nu
 * fie luată pe nevăzute. */
const cadre = await query<{
  id: string
  name: string
  email: string
  role: 'student' | 'teacher' | 'head'
  academic_title: string | null
  first_login_at: string | null
  avatar_path: string | null
  is_active: boolean
  deactivated_at: string | null
  coordonari: number
}>(
  `SELECT u.id, u.name, u.email, u.role, u.academic_title,
          u.first_login_at::text, u.avatar_path, u.is_active, u.deactivated_at::text,
          (SELECT count(*)::int FROM requests r
            WHERE r.teacher_id = u.id AND r.status IN ('approved', 'defended')) AS coordonari
     FROM users u
    WHERE u.role <> 'student'
    ORDER BY u.is_active DESC, u.role, u.name`,
)

const ROLE_TEXT: Record<string, string> = {
  teacher: 'Cadru didactic',
  head: 'Director de departament',
}

const sections = [
  { key: 'situatie', text: 'Situația sesiunii', count: pendingSeatRequests.length },
  { key: 'cadre', text: 'Cadre didactice', count: null },
]
---

<ProfesorLayout
  title="Departament"
  lede={`Situația întregii sesiuni ${year?.label ?? ''}: acoperire, încărcare pe coordonatori și alocarea locurilor.`}
  active="departament"
>
  <div slot="actiuni" class="row row--wrap" style="gap:var(--s-2)">
    <a class="btn btn--secondary btn--sm" href="/profesor/export-coordonari">Export coordonări</a>
    <a class="btn btn--ghost btn--sm" href={exportUrl}>Export cereri</a>
  </div>

  <Taburi
    taburi={sections.map((s) => ({ ...s, href: `/profesor/departament?sectiune=${s.key}` }))}
    activ={sectiune}
    eticheta="Secțiuni"
  />

  {/* --------------------------------------------------------- situation */}
  {
    sectiune === 'situatie' && (
      <div class="stack stack--loose">
        <section class="stack">
          <h2 class="section-title">Acoperire</h2>
          <div class="grid-auto">
            <Metrica value={totals?.students ?? 0} label="studenți în sesiune" />
            <Metrica
              value={unassigned}
              label="fără cerere activă"
              alerta={unassigned > 0}
              note={
                (totals?.students ?? 0) === 0
                  ? 'Niciun student înscris în sesiune'
                  : unassigned > 0
                    ? 'Fie nu au depus, fie cererea a fost respinsă'
                    : 'Toți au o cerere în lucru sau aprobată'
              }
            />
            {/* Rejections and expirations no longer vanish into "has submitted":
                they are exactly the students the head has to go looking for. */}
            <Metrica
              value={(totals?.rejected ?? 0) + (totals?.expired ?? 0)}
              label="cereri respinse sau expirate"
              note={
                (totals?.expired ?? 0) > 0
                  ? `${totals?.expired} expirate fără răspuns`
                  : 'toate cu motivul comunicat'
              }
            />
            <Metrica
              value={totals?.pending ?? 0}
              label="cereri în așteptare"
              note={`la ${load.filter((t) => t.pending > 0).length} coordonatori`}
            />
            <Metrica
              value={totals?.approved ?? 0}
              label="coordonări confirmate"
              note={
                totals?.expired ? `${totals.expired} cereri au expirat fără răspuns` : undefined
              }
            />
          </div>
        </section>

        {overloaded.length > 0 && (
          <p class="alert">
            <strong>Peste capacitate:</strong>{' '}
            {overloaded.map((t) => `${t.name} (${t.taken}/${t.seats})`).join(' · ')}
          </p>
        )}

        {withoutSeats.length > 0 && (
          <p class="alert">
            <strong>Fără locuri alocate:</strong>{' '}
            {withoutSeats.map((t) => t.name).join(' · ')}. Studenții nu le pot depune cereri.{' '}
            <a href="/profesor/departament?sectiune=locuri">Alocă locuri</a>
          </p>
        )}

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Încărcare pe coordonatori</h2>
            <span class="muted text-sm">
              {fullyBooked.length} din {load.length} au locurile ocupate
            </span>
          </div>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Locurile alocate pe cadru didactic">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Coordonator</th>
                  <th scope="col">Licență</th>
                  <th scope="col">Master</th>
                  <th scope="col">Total</th>
                  <th scope="col">În așteptare</th>
                  <th scope="col">Teme nepreluate</th>
                  <th scope="col"><span class="visually-hidden">Alocare</span></th>
                </tr>
              </thead>
              <tbody>
                {withSeats.map((t) => (
                  <>
                  <tr id={`coordonator-${t.id}`}>
                    <td>
                      <div class="row" style="gap:var(--s-3)">
                        <Avatar name={t.name} src={t.avatar_path} size="xs" href={`/profil/${t.id}`} />
                        {t.name}
                      </div>
                    </td>
                    <td class="numeric">{t.bachelor_taken} / {t.bachelor_seats}</td>
                    <td class="numeric">{t.master_taken} / {t.master_seats}</td>
                    <td class="numeric">
                      <span class:list={{ 'at-capacity': t.seats > 0 && t.taken === t.seats, 'over-capacity': t.seats > 0 && t.taken > t.seats }}>
                        {t.taken} / {t.seats}
                      </span>
                    </td>
                    <td class="numeric">
                      {t.pending > 0 ? (
                        <span class="badge badge--asteptare">{t.pending}</span>
                      ) : (
                        <span class="muted">—</span>
                      )}
                    </td>
                    <td class="numeric muted">{t.free_topics}</td>
                    <td style="text-align:right">
                      <button
                        class="btn btn--secondary btn--sm"
                        type="button"
                        data-editeaza={t.id}
                        aria-expanded="false"
                        aria-controls={`locuri-rand-${t.id}`}
                      >
                        Alocă locuri
                      </button>
                    </td>
                  </tr>

                  {/* Alocarea stă pe rândul coordonatorului, nu pe o filă
                      separată: erau două tabele cu aceleași nume, unul care
                      spunea câte locuri sunt ocupate și altul unde se scria
                      câte sunt — și trebuia ținut minte de la unul la altul. */}
                  <tr class="editor-rand" id={`locuri-rand-${t.id}`} hidden>
                    <td colspan="7">
                      <form method="POST" action="/api/locuri" class="alocare">
                        <input type="hidden" name="actiune" value="aloca" />
                        <input type="hidden" name="profesor_id" value={t.id} />
                        <input type="hidden" name="redirect" value={`${currentPath}#coordonator-${t.id}`} />

                        <div class="field">
                          <label class="label" for={`lic-${t.id}`}>Locuri licență</label>
                          <input class="input input--num" id={`lic-${t.id}`} name="locuri_licenta"
                            type="number" min="0" max="40" value={t.bachelor_seats} />
                          <span class="hint">{t.bachelor_taken} ocupate acum</span>
                        </div>

                        <div class="field">
                          <label class="label" for={`mas-${t.id}`}>Locuri master</label>
                          <input class="input input--num" id={`mas-${t.id}`} name="locuri_master"
                            type="number" min="0" max="40" value={t.master_seats} />
                          <span class="hint">{t.master_taken} ocupate acum</span>
                        </div>

                        <p class="hint alocare__nota">
                          Locurile se resetează la fiecare an universitar. Un coordonator cu toate
                          locurile ocupate rămâne în catalog, estompat, cu studenții lui vizibili.
                        </p>

                        <button class="btn btn--primary btn--sm" type="submit">Salvează</button>
                      </form>
                    </td>
                  </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cereri</h2>
            <span class="muted text-sm">{rows.length} afișate</span>
          </div>

          <form method="GET" class="panel__body row row--wrap" style="gap:var(--s-3);align-items:flex-end">
            <input type="hidden" name="sectiune" value="situatie" />
            <div class="field" style="flex:2;min-width:220px">
              <label class="label" for="coordonator">Coordonator</label>
              <select class="select" id="coordonator" name="coordonator">
                <option value="">Toți coordonatorii</option>
                {load.map((t) => (
                  <option value={t.id} selected={t.id === teacherFilter}>
                    {t.name}
                  </option>
                ))}
              </select>
            </div>
            <div class="field" style="flex:1;min-width:150px">
              <label class="label" for="program">Program</label>
              <select class="select" id="program" name="program">
                <option value="">Licență și master</option>
                <option value="bachelor" selected={programFilter === 'bachelor'}>Licență</option>
                <option value="master" selected={programFilter === 'master'}>Master</option>
              </select>
            </div>
            <div class="field" style="flex:1;min-width:130px">
              <label class="label" for="serie">Serie</label>
              <select class="select" id="serie" name="serie">
                <option value="">Toate seriile</option>
                {seriesOptions.map((v) => (
                  <option value={v} selected={seriesFilter === v}>
                    {v}
                  </option>
                ))}
              </select>
            </div>
            <div class="field" style="flex:1;min-width:150px">
              <label class="label" for="status">Stare</label>
              <select class="select" id="status" name="status">
                <option value="">Toate stările</option>
                {Object.entries(STATUS_LABELS).map(([v, l]) => (
                  <option value={v} selected={statusFilter === v}>
                    {l}
                  </option>
                ))}
              </select>
            </div>
            <button class="btn btn--secondary" type="submit">Filtrează</button>
          </form>

          {rows.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere pentru filtrele alese</p>
              <p class="empty__text">Schimbă coordonatorul, programul, seria sau starea.</p>
            </div>
          ) : (
            <div class="table-wrap" tabindex="0" role="region" aria-label="Cereri de locuri suplimentare">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Student</th>
                    <th scope="col">Program</th>
                    <th scope="col">Coordonator</th>
                    <th scope="col">Titlul lucrării</th>
                    <th scope="col">Stare</th>
                    <th scope="col">Depusă</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      <td>
                        <div class="stack stack--tight" style="gap:0">
                          <strong>{officialName({ name: r.student_name, father_initial: r.father_initial })}</strong>
                          <span class="muted text-xs">
                            {[
                              r.student_number,
                              r.study_year ? `anul ${r.study_year}` : null,
                              r.study_series ? `seria ${r.study_series}` : null,
                              r.study_group,
                            ].filter(Boolean).join(' · ')}
                          </span>
                        </div>
                      </td>
                      <td>
                        <span class="muted">{programLabel(r.program)}</span>
                      </td>
                      <td>{r.teacher_name}</td>
                      <td class="cell-title" title={r.title_ro}>{r.title_ro}</td>
                      <td>
                        <span class:list={['badge', STATUS_CLASS[r.status]]}>{STATUS_LABELS[r.status]}</span>
                      </td>
                      <td class="muted">{formatDate(r.submitted_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cereri de locuri suplimentare</h2>
            <span class="muted text-sm">
              {pendingSeatRequests.length} în așteptare
            </span>
          </div>

          {pendingSeatRequests.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere în așteptare</p>
              <p class="empty__text">
                Când un coordonator rămâne fără locuri, îți poate cere altele de aici, cu o
                motivare scrisă.
              </p>
            </div>
          ) : (
            <ul class="seat-requests">
              {pendingSeatRequests.map((r) => (
                <li>
                  <div class="row row--between row--wrap" style="gap:var(--s-2)">
                    <strong>{r.teacher_name}</strong>
                    <span class="muted text-xs">
                      cerută {timeAgo(r.created_at)}
                    </span>
                  </div>
                  <p class="text-sm">
                    Solicită <strong>{r.extra_seats}</strong> locuri la{' '}
                    {LEVEL_LABELS[r.level].toLowerCase()}.
                  </p>
                  <p class="motivare">{r.reason}</p>

                  <form method="POST" action="/api/locuri" class="stack stack--tight">
                    <input type="hidden" name="actiune" value="decide" />
                    <input type="hidden" name="cerere_id" value={r.id} />
                    <div class="field">
                      <label class="label" for={`nota-${r.id}`}>Notă pentru coordonator (opțional)</label>
                      <input class="input" id={`nota-${r.id}`} name="nota" placeholder="Ex: aprobat până la finalul sesiunii curente." />
                    </div>
                    <div class="row" style="gap:var(--s-2)">
                      <button class="btn btn--primary btn--sm" type="submit" name="decizie" value="approved">
                        Alocă {r.extra_seats} locuri
                      </button>
                      <button class="btn btn--danger btn--sm" type="submit" name="decizie" value="rejected">
                        Respinge
                      </button>
                    </div>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>

        {seatRequestRows.filter((r) => r.status !== 'pending').length > 0 && (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">Decizii anterioare</h2>
            </div>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Situația pe programe de studiu">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Coordonator</th>
                    <th scope="col">Cerea</th>
                    <th scope="col">Decizie</th>
                    <th scope="col">Data</th>
                    <th scope="col">Notă</th>
                  </tr>
                </thead>
                <tbody>
                  {seatRequestRows
                    .filter((r) => r.status !== 'pending')
                    .map((r) => (
                      <tr>
                        <td>{r.teacher_name}</td>
                        <td class="numeric">
                          {r.extra_seats} · {LEVEL_LABELS[r.level].toLowerCase()}
                        </td>
                        <td>
                          <span
                            class:list={[
                              'badge',
                              r.status === 'approved' ? 'badge--aprobata' : 'badge--respinsa',
                            ]}
                          >
                            {r.status === 'approved' ? 'Aprobată' : 'Respinsă'}
                          </span>
                        </td>
                        <td class="muted">{formatDate(r.decided_at)}</td>
                        <td class="muted cell-title">{r.decision_note ?? '—'}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </div>
    )
  }

  {/* -------------------------------------------------------------- seats */}

  {
    sectiune === 'cadre' && (
      <div class="stack stack--loose">
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cadrele didactice</h2>
            <span class="muted text-sm">
              {numar(cadre.filter((o) => o.is_active).length, 'cont deschis', 'conturi deschise')}
            </span>
          </div>

          <div class="table-wrap" tabindex="0" role="region" aria-label="Conturile cadrelor didactice">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Nume</th>
                  <th scope="col">Adresă de email</th>
                  <th scope="col">Rol</th>
                  <th scope="col">Coordonări</th>
                  <th scope="col">Acces</th>
                  <th scope="col"><span class="visually-hidden">Editează</span></th>
                </tr>
              </thead>
              <tbody>
                {cadre.map((o) => (
                  <>
                  <tr id={`cont-${o.id}`} class:list={{ 'is-inactive': !o.is_active }}>
                    <td>
                      <div class="row" style="gap:var(--s-3)">
                        <Avatar name={o.name} src={o.avatar_path} size="xs" href={`/profil/${o.id}`} />
                        {o.name}
                      </div>
                    </td>
                    <td class="muted">{o.email}</td>
                    <td class="muted">{ROLE_TEXT[o.role]}</td>
                    <td class="numeric muted">{o.coordonari}</td>
                    <td>
                      {o.is_active ? (
                        <span class="stack stack--tight" style="gap:2px">
                          <span class="badge badge--aprobata">Acces</span>
                          {/* Un cont deschis și niciodată folosit este, de
                              obicei, o literă greșită în adresă — iar omul de la
                              celălalt capăt așteaptă un link care nu poate veni. */}
                          {!o.first_login_at && (
                            <span class="badge badge--asteptare">Nu a intrat niciodată</span>
                          )}
                        </span>
                      ) : (
                        <span class="badge badge--neutru" title={`Închis ${formatDate(o.deactivated_at)}`}>
                          Închis
                        </span>
                      )}
                    </td>
                    <td style="text-align:right">
                      <button class="btn btn--ghost btn--sm" type="button"
                        data-editeaza={o.id} aria-expanded="false" aria-controls={`editor-${o.id}`}>
                        Editează
                      </button>
                    </td>
                  </tr>

                  <tr class="editor-rand" id={`editor-${o.id}`} hidden>
                    <td colspan="6">
                      <div class="editor">
                        <form method="POST" action="/api/conturi" class="editor__adresa">
                          <input type="hidden" name="actiune" value="schimba_email" />
                          <input type="hidden" name="utilizator_id" value={o.id} />
                          <input type="hidden" name="redirect" value={`${currentPath}#cont-${o.id}`} />
                          <div class="field" style="flex:1;min-width:240px">
                            <label class="label" for={`email-${o.id}`}>Adresă de email</label>
                            <input class="input" id={`email-${o.id}`} name="email" type="email"
                              value={o.email} required />
                            <span class="hint">
                              Autentificarea trece exclusiv prin ea. Schimbarea invalidează linkurile
                              de acces trimise până acum.
                            </span>
                          </div>
                          <button class="btn btn--primary btn--sm" type="submit">Salvează adresa</button>
                        </form>

                        <form method="POST" action="/api/conturi" class="editor__acces">
                          <input type="hidden" name="actiune"
                            value={o.is_active ? 'dezactiveaza' : 'reactiveaza'} />
                          <input type="hidden" name="utilizator_id" value={o.id} />
                          <input type="hidden" name="redirect" value={`${currentPath}#cont-${o.id}`} />
                          <p class="hint" style="margin:0">
                            {o.is_active
                              ? `Închiderea accesului nu șterge nimic: cele ${o.coordonari} coordonări și tot ce a scris rămân în arhivă.`
                              : 'Redeschiderea accesului îi permite din nou să ceară un link de intrare.'}
                          </p>
                          <button
                            class:list={['btn', 'btn--sm', o.is_active ? 'btn--danger' : 'btn--secondary']}
                            type="submit"
                          >
                            {o.is_active ? 'Închide accesul' : 'Redeschide accesul'}
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Adaugă un cadru didactic</h2>
          </div>
          <form method="POST" action="/api/conturi" class="panel__body stack">
            <input type="hidden" name="actiune" value="adauga" />
            <input type="hidden" name="redirect" value="/profesor/departament?sectiune=cadre" />

            <div class="row row--wrap" style="gap:var(--s-3)">
              <div class="field" style="flex:2;min-width:220px">
                <label class="label" for="nume">Nume complet</label>
                <input class="input" id="nume" name="nume" required
                  placeholder="Ex: Conf. univ. dr. Elena Dumitrescu" />
                <span class="hint">Titlul didactic face parte din nume, așa cum apare în catalog.</span>
              </div>
              <div class="field" style="flex:2;min-width:240px">
                <label class="label" for="email">Adresă de email</label>
                <input class="input" id="email" name="email" type="email" required
                  placeholder="elena.dumitrescu@ase.ro" />
              </div>
              <div class="field" style="min-width:210px">
                <label class="label" for="rol">Rol</label>
                <select class="select" id="rol" name="rol">
                  <option value="teacher">Cadru didactic</option>
                  <option value="head">Director de departament</option>
                </select>
              </div>
            </div>

            <div class="row row--end">
              <button class="btn btn--primary" type="submit">Deschide contul</button>
            </div>
          </form>
        </section>
      </div>
    )
  }

</ProfesorLayout>

<script>
  /* Rândul de editare se deschide unul singur, ca pe „Studenții facultății”:
     alocarea locurilor și adresa unui cadru didactic folosesc același tipar,
     iar două rânduri deschise deodată împing tabelul de două ori. */
  document.querySelectorAll<HTMLButtonElement>('[data-editeaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.getAttribute('aria-controls') ?? ''
      const rand = document.getElementById(id)
      if (!rand) return

      const eraDeschis = !rand.hidden
      document.querySelectorAll<HTMLElement>('.editor-rand').forEach((r) => (r.hidden = true))
      document
        .querySelectorAll<HTMLButtonElement>('[data-editeaza]')
        .forEach((x) => x.setAttribute('aria-expanded', 'false'))
      if (eraDeschis) return

      rand.hidden = false
      b.setAttribute('aria-expanded', 'true')
      rand.querySelector<HTMLInputElement>('input:not([type="hidden"])')?.focus()
    })
  })
</script>

