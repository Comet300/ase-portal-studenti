---
import BaseLayout from '../layouts/BaseLayout.astro'
import { demoAccounts, DEMO_MODE, initials, ROLE_LABELS } from '../lib/auth'

const redirect = Astro.url.searchParams.get('redirect') ?? ''
const trimis = Astro.url.searchParams.get('trimis') === '1'
const eroare = Astro.url.searchParams.get('eroare')
const emailScris = Astro.url.searchParams.get('email') ?? ''
const conturi = await demoAccounts()

if (Astro.locals.user && !trimis) {
  const u = Astro.locals.user
  return Astro.redirect(u.role === 'student' ? '/cererile-mele' : '/profesor', 302)
}

---

<BaseLayout title="Autentificare" description="Acces cu contul instituțional ASE">
  <div class="ecran">
    <main class="card" id="continut">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>Portal Studenți</strong>
          <small>Facultatea de Marketing · ASE București</small>
        </span>
      </a>

      {
        trimis ? (
          <div class="stack">
            <h1 class="title">Verifică-ți emailul</h1>
            {/* „Verifică-ți emailul” fără să spună care lăsa pe cineva care a
                greșit domeniul să aștepte un mesaj care nu pleca nicăieri. */}
            <p class="muted">
              Am trimis linkul de autentificare la{' '}
              {emailScris ? <strong>{emailScris}</strong> : 'adresa introdusă'}. Este valabil 20 de
              minute și poate fi folosit o singură dată.
            </p>

            <details class="ajutor">
              <summary>Nu a ajuns niciun email?</summary>
              <ul>
                <li>Așteaptă un minut — uneori întârzie.</li>
                <li>Caută în Spam sau în „Promoții”.</li>
                <li>
                  Verifică domeniul: <strong>@stud.ase.ro</strong> pentru studenți,
                  <strong> @ase.ro</strong> pentru cadre didactice.
                </li>
                <li>
                  Dacă tot nu ajunge, scrie la{' '}
                  <a href="mailto:secretariat.marketing@ase.ro">secretariat.marketing@ase.ro</a>.
                </li>
              </ul>
            </details>

            <div class="row row--wrap" style="gap:var(--s-2)">
              <a href={`/autentificare${emailScris ? `?email=${encodeURIComponent(emailScris)}` : ''}`}
                class="btn btn--secondary">
                Trimite din nou
              </a>
              <a href="/autentificare" class="btn btn--ghost">Încearcă altă adresă</a>
            </div>
          </div>
        ) : (
          <div class="stack">
            <div class="stack stack--tight">
              <h1 class="title">Autentificare</h1>
              <p class="muted">
                Introdu adresa instituțională. Primești un link de acces prin email — fără parolă.
              </p>
            </div>

            <form method="POST" action="/api/autentificare" class="stack">
              <input type="hidden" name="redirect" value={redirect} />
              <div class="field">
                <label class="label" for="email">Adresă de email</label>
                {/* Adresa scrisă se păstrează: greșeala e aproape întotdeauna o
                    literă, iar retastarea întregii adrese pentru o literă este
                    exact felul de mărunțiș care face un portal obositor. */}
                <input
                  class="input"
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="prenume.nume@stud.ase.ro"
                  value={emailScris}
                  aria-invalid={eroare ? 'true' : undefined}
                  aria-describedby={eroare ? 'eroare-email ajutor-email' : 'ajutor-email'}
                  autofocus
                />
                {eroare && (
                  <p class="error-text" id="eroare-email" role="alert">
                    {eroare}
                  </p>
                )}
                <span class="hint" id="ajutor-email">
                  Conturi @stud.ase.ro pentru studenți, @ase.ro pentru cadre didactice.
                </span>
                {/* Un domeniu greșit nu producea nicio reacție: portalul răspundea
                    „ți-am trimis linkul” și nu trimitea nimic, fiindcă adresa nu
                    exista. Corectura se propune înainte de trimitere. */}
                <p class="hint corectura" id="corectura" hidden>
                  Ai vrut să scrii <button class="corectura__buton" type="button" id="corectura-text"></button>?
                </p>
              </div>
              <button class="btn btn--primary" type="submit">Trimite linkul de acces</button>
            </form>
          </div>
        )
      }

      {
        DEMO_MODE && conturi.length > 0 && (
          <section class="demo">
            <h2 class="demo__titlu">Conturi demonstrative</h2>
            <p class="demo__text">
              Modul demonstrativ este activ: poți intra direct, fără email. Datele sunt fictive.
            </p>
            <ul class="demo__lista">
              {conturi.map((c) => (
                <li>
                  <form method="POST" action="/api/demo-login">
                    <input type="hidden" name="utilizator_id" value={c.id} />
                    <input type="hidden" name="redirect" value={redirect} />
                    <button class="demo__cont" type="submit">
                      <span class="demo__avatar">{initials(c.name)}</span>
                      <span class="demo__meta">
                        <strong>{c.name}</strong>
                        <small>
                          {ROLE_LABELS[c.role]}
                          {c.role === 'student' &&
                            (c.has_supervisor ? ' · are coordonator' : ' · fără coordonator')}
                        </small>
                      </span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>

<script>
  /* Domeniile instituționale, și greșelile care duc la ele.
   *
   * O adresă cu domeniul greșit nu producea nicio reacție: portalul răspundea
   * „ți-am trimis linkul” — răspuns identic indiferent dacă adresa există, ca să
   * nu devină o unealtă de aflat cine are cont — și nu trimitea nimic. Corectura
   * se propune înainte, unde încă se poate face ceva.
   */
  const DOMENII = ['stud.ase.ro', 'ase.ro']

  const APROPIATE: Record<string, string> = {
    'stud.ase.com': 'stud.ase.ro',
    'stud.ase.r': 'stud.ase.ro',
    'stud.ase.roo': 'stud.ase.ro',
    'studase.ro': 'stud.ase.ro',
    'stud.ase.com.ro': 'stud.ase.ro',
    'ase.com': 'ase.ro',
    'ase.r': 'ase.ro',
    'ase.roo': 'ase.ro',
    'asero': 'ase.ro',
  }

  const camp = document.getElementById('email') as HTMLInputElement | null
  const rand = document.getElementById('corectura')
  const buton = document.getElementById('corectura-text')

  if (camp && rand && buton) {
    const propune = () => {
      const [local, domeniu] = camp.value.trim().toLowerCase().split('@')
      if (!local || !domeniu || DOMENII.includes(domeniu)) {
        rand.hidden = true
        return
      }

      const corect = APROPIATE[domeniu]
      if (!corect) {
        rand.hidden = true
        return
      }

      buton.textContent = `${local}@${corect}`
      rand.hidden = false
    }

    camp.addEventListener('input', propune)
    camp.addEventListener('blur', propune)

    buton.addEventListener('click', () => {
      camp.value = buton.textContent ?? camp.value
      rand.hidden = true
      camp.focus()
    })

    propune()
  }
</script>

<style>
  .ecran {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--s-5);
    background: var(--bg);
  }

  .card {
    width: 100%;
    max-width: 440px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .title {
    font-family: var(--serif);
    font-size: var(--t-2xl);
  }

  .corectura__buton {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--red);
    text-decoration: underline;
    cursor: pointer;
  }

  .ajutor {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
  .ajutor summary {
    cursor: pointer;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .ajutor ul {
    margin: var(--s-3) 0 0;
    padding-left: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-wrap: pretty;
  }

  .demo {
    border-top: 1px solid var(--border);
    padding-top: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .demo__titlu {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .demo__text {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .demo__lista {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .demo__cont {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
  }

  .demo__cont:hover {
    border-color: var(--border-strong);
    background: var(--surface-sunken);
  }

  .demo__cont svg {
    width: 16px;
    height: 16px;
    margin-left: auto;
    color: var(--ink-muted);
    flex: none;
  }

  .demo__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-sunken);
    border: 1px solid var(--border-strong);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
    flex: none;
  }

  .demo__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .demo__meta strong {
    font-size: var(--t-sm);
  }
  .demo__meta small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
</style>
