---
import BaseLayout from '../layouts/BaseLayout.astro'
import { demoAccounts, DEMO_MODE, initials, ROLE_LABELS } from '../lib/auth'

const redirect = Astro.url.searchParams.get('redirect') ?? ''
const trimis = Astro.url.searchParams.get('trimis') === '1'
const eroare = Astro.url.searchParams.get('eroare')
const typedEmail = Astro.url.searchParams.get('email') ?? ''
const demoAccountList = await demoAccounts()

if (Astro.locals.user && !trimis) {
  const u = Astro.locals.user
  return Astro.redirect(u.role === 'student' ? '/cererile-mele' : '/profesor', 302)
}

---

<BaseLayout title="Autentificare" description="Acces cu contul instituțional ASE">
  <div class="screen">
    <main class="card" id="continut">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>Portal Studenți</strong>
          <small>Facultatea de Marketing · ASE București</small>
        </span>
      </a>

      {
        trimis ? (
          <div class="stack">
            <h1 class="title">Verifică-ți emailul</h1>
            {/* „Verifică-ți emailul” without saying which one left somebody who
                got the domain wrong waiting for a message that went nowhere. */}
            <p class="muted">
              Am trimis linkul de autentificare la{' '}
              {typedEmail ? <strong>{typedEmail}</strong> : 'adresa introdusă'}. Este valabil 20 de
              minute și poate fi folosit o singură dată.
            </p>

            <details class="ajutor">
              <summary>Nu a ajuns niciun email?</summary>
              <ul>
                <li>Așteaptă un minut — uneori întârzie.</li>
                <li>Caută în Spam sau în „Promoții”.</li>
                <li>
                  Verifică domeniul: <strong>@stud.ase.ro</strong> pentru studenți,
                  <strong> @ase.ro</strong> pentru cadre didactice.
                </li>
                <li>
                  Dacă tot nu ajunge, scrie la{' '}
                  <a href="mailto:secretariat.marketing@ase.ro">secretariat.marketing@ase.ro</a>.
                </li>
              </ul>
            </details>

            <div class="row row--wrap" style="gap:var(--s-2)">
              <a href={`/autentificare${typedEmail ? `?email=${encodeURIComponent(typedEmail)}` : ''}`}
                class="btn btn--secondary">
                Trimite din nou
              </a>
              <a href="/autentificare" class="btn btn--ghost">Încearcă altă adresă</a>
            </div>
          </div>
        ) : (
          <div class="stack">
            <div class="stack stack--tight">
              <h1 class="title">Autentificare</h1>
              <p class="muted">
                Introdu adresa instituțională. Primești un link de acces prin email — fără parolă.
              </p>
            </div>

            <form method="POST" action="/api/autentificare" class="stack">
              <input type="hidden" name="redirect" value={redirect} />
              <div class="field">
                <label class="label" for="email">Adresă de email</label>
                {/* The typed address is kept: the mistake is almost always one
                    letter, and retyping the whole address for one letter is
                    exactly the kind of small change that makes a portal
                    tiring. */}
                <input
                  class="input"
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="prenume.nume@stud.ase.ro"
                  value={typedEmail}
                  aria-invalid={eroare ? 'true' : undefined}
                  aria-describedby={eroare ? 'eroare-email ajutor-email' : 'ajutor-email'}
                  autofocus
                />
                {eroare && (
                  <p class="error-text" id="eroare-email" role="alert">
                    {eroare}
                  </p>
                )}
                <span class="hint" id="ajutor-email">
                  Conturi @stud.ase.ro pentru studenți, @ase.ro pentru cadre didactice.
                </span>
                {/* A wrong domain produced no reaction at all: the portal
                    answered „ți-am trimis linkul” and sent nothing, because the
                    address did not exist. The correction is offered before
                    sending. */}
                <p class="hint corectura" id="corectura" hidden>
                  Ai vrut să scrii <button class="correction__button" type="button" id="corectura-text"></button>?
                </p>
              </div>
              <button class="btn btn--primary" type="submit">Trimite linkul de acces</button>
            </form>
          </div>
        )
      }

      {
        DEMO_MODE && demoAccountList.length > 0 && (
          <section class="demo">
            <h2 class="demo__title">Conturi demonstrative</h2>
            <p class="demo__text">
              Modul demonstrativ este activ: poți intra direct, fără email. Datele sunt fictive.
            </p>
            <ul class="demo__list">
              {demoAccountList.map((c) => (
                <li>
                  <form method="POST" action="/api/demo-login">
                    <input type="hidden" name="utilizator_id" value={c.id} />
                    <input type="hidden" name="redirect" value={redirect} />
                    <button class="demo__account" type="submit">
                      <span class="demo__avatar">{initials(c.name)}</span>
                      <span class="demo__meta">
                        <strong>{c.name}</strong>
                        <small>
                          {ROLE_LABELS[c.role]}
                          {c.role === 'student' &&
                            (c.has_supervisor ? ' · are coordonator' : ' · fără coordonator')}
                        </small>
                      </span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>

<script>
  /* The institutional domains, and the typos that lead to them.
   *
   * An address with the wrong domain produced no reaction at all: the portal
   * answered „ți-am trimis linkul” — the same answer whether or not the address
   * exists, so that it does not become a tool for finding out who has an
   * account — and sent nothing. The correction is offered beforehand, where
   * something can still be done about it.
   */
  const DOMAINS = ['stud.ase.ro', 'ase.ro']

  const DOMAIN_TYPOS: Record<string, string> = {
    'stud.ase.com': 'stud.ase.ro',
    'stud.ase.r': 'stud.ase.ro',
    'stud.ase.roo': 'stud.ase.ro',
    'studase.ro': 'stud.ase.ro',
    'stud.ase.com.ro': 'stud.ase.ro',
    'ase.com': 'ase.ro',
    'ase.r': 'ase.ro',
    'ase.roo': 'ase.ro',
    'asero': 'ase.ro',
  }

  const emailField = document.getElementById('email') as HTMLInputElement | null
  const hintRow = document.getElementById('corectura')
  const suggestionButton = document.getElementById('corectura-text')

  if (emailField && hintRow && suggestionButton) {
    const suggest = () => {
      const [local, domain] = emailField.value.trim().toLowerCase().split('@')
      if (!local || !domain || DOMAINS.includes(domain)) {
        hintRow.hidden = true
        return
      }

      const corrected = DOMAIN_TYPOS[domain]
      if (!corrected) {
        hintRow.hidden = true
        return
      }

      suggestionButton.textContent = `${local}@${corrected}`
      hintRow.hidden = false
    }

    emailField.addEventListener('input', suggest)
    emailField.addEventListener('blur', suggest)

    suggestionButton.addEventListener('click', () => {
      emailField.value = suggestionButton.textContent ?? emailField.value
      hintRow.hidden = true
      emailField.focus()
    })

    suggest()
  }
</script>

<style>
  .screen {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: var(--s-5);
    background: var(--bg);
  }

  .card {
    width: 100%;
    max-width: 440px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .title {
    font-family: var(--serif);
    font-size: var(--t-2xl);
  }

  .correction__button {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--red);
    text-decoration: underline;
    cursor: pointer;
  }

  .ajutor {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
  .ajutor summary {
    cursor: pointer;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .ajutor ul {
    margin: var(--s-3) 0 0;
    padding-left: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-wrap: pretty;
  }

  .demo {
    border-top: 1px solid var(--border);
    padding-top: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .demo__title {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .demo__text {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .demo__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .demo__account {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
  }

  .demo__account:hover {
    border-color: var(--border-strong);
    background: var(--surface-sunken);
  }

  .demo__account svg {
    width: 16px;
    height: 16px;
    margin-left: auto;
    color: var(--ink-muted);
    flex: none;
  }

  .demo__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-sunken);
    border: 1px solid var(--border-strong);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
    flex: none;
  }

  .demo__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .demo__meta strong {
    font-size: var(--t-sm);
  }
  .demo__meta small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
</style>
