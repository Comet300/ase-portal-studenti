---
import StudentLayout from '../layouts/StudentLayout.astro'
import { query, queryOne } from '../lib/db'
import { formatDate, formatTime } from '../lib/repo'

const u = Astro.locals.user!
if (u.role !== 'student') return Astro.redirect('/profesor/consultatii', 302)

interface Slot {
  id: string
  starts_at: string
  ends_at: string
  mode: 'in_person' | 'online'
  location: string | null
  meeting_url: string | null
  note: string | null
  capacity: number
  taken: number
  teacher_id: string
  teacher_name: string
  booked_by_me: boolean
  subject: string | null
  /** Set when the coordinator scheduled this meeting rather than opening it. */
  scheduled_for_me: boolean
}

/**
 * Only the coordinator's intervals, and only those meant for this student.
 *
 * Consultations are between a student and their own coordinator, not an open
 * catalogue — and an interval the coordinator scheduled with one named student
 * is not on offer to the rest, which is what `student_id` records.
 */
const slots = await query<Slot>(
  `SELECT s.id, s.starts_at, s.ends_at, s.mode, s.location, s.meeting_url, s.note, s.capacity,
          (SELECT count(*)::int FROM bookings r WHERE r.slot_id = s.id AND r.status = 'booked') AS taken,
          p.id AS teacher_id, p.name AS teacher_name,
          (s.student_id = $1) AS scheduled_for_me,
          EXISTS (
            SELECT 1 FROM bookings r
             WHERE r.slot_id = s.id AND r.student_id = $1 AND r.status = 'booked'
          ) AS booked_by_me,
          (SELECT r.subject FROM bookings r
            WHERE r.slot_id = s.id AND r.student_id = $1 AND r.status = 'booked') AS subject
     FROM consultation_slots s
     JOIN users p ON p.id = s.teacher_id
    WHERE s.is_cancelled = false
      AND s.starts_at > now()
      AND (s.student_id IS NULL OR s.student_id = $1)
      AND EXISTS (
        SELECT 1 FROM requests c
         WHERE c.student_id = $1 AND c.teacher_id = s.teacher_id AND c.status = 'approved'
      )
    ORDER BY s.starts_at`,
  [u.id],
)

const supervisor = await queryOne<{ name: string }>(
  `SELECT t.name
     FROM requests r
     JOIN users t ON t.id = r.teacher_id
    WHERE r.student_id = $1 AND r.status = 'approved'
    LIMIT 1`,
  [u.id],
)

const mine = slots.filter((s) => s.booked_by_me)
const free = slots.filter((s) => !s.booked_by_me && s.taken < s.capacity)

// Grupare pe day, ca lista să fie citibilă când sunt multe intervale.
const byDay = new Map<string, Slot[]>()
for (const s of free) {
  const key = formatDate(s.starts_at)
  byDay.set(key, [...(byDay.get(key) ?? []), s])
}
---

<StudentLayout title="Consultații" active="consultatii">
  <div class="container stack stack--loose">
    <header class="stack stack--tight">
      <h1 class="page-title">Consultații</h1>
      <p class="page-lede">
        Rezervă un interval la coordonatorul tău. Primești un email de fiecare dată când publică
        intervale noi, și invitația în calendar după ce rezervi.
      </p>
    </header>

    {
      mine.length > 0 && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Consultațiile mele</h2>
            <span class="muted text-sm">
              {mine.length} {mine.length === 1 ? 'programare' : 'programări'}
            </span>
          </div>
          <ul class="sloturi">
            {mine.map((s) => (
              <li class="slot slot--rezervat">
                <span class="data-chip">
                  <strong class="numeric">{new Date(s.starts_at).getDate()}</strong>
                  <small>{formatDate(s.starts_at).split(' ')[1]?.slice(0, 3)}</small>
                </span>
                <div class="slot__corp">
                  <div class="row row--wrap" style="gap:var(--s-2);align-items:baseline">
                    <strong class="numeric">
                      {formatTime(s.starts_at)}–{formatTime(s.ends_at)}
                    </strong>
                    {/* O consultație programată de coordonator nu este o rezervare
                        pe care ai făcut-o tu, iar diferența contează când te
                        gândești să o anulezi. */}
                    {s.scheduled_for_me && (
                      <span class="badge badge--asteptare">programată de coordonator</span>
                    )}
                  </div>

                  <span class="muted">{s.teacher_name}</span>

                  {s.mode === 'in_person' && s.location && (
                    <span class="muted">{s.location}</span>
                  )}
                  {s.mode === 'online' && !s.meeting_url && <span class="muted">Online</span>}

                  {(s.note ?? s.subject) && (
                    <span class="muted">Subiect: {s.note ?? s.subject}</span>
                  )}

                  {s.capacity > 1 && (
                    <span class="muted">
                      Consultație de grup · {s.taken} din {s.capacity} locuri ocupate
                    </span>
                  )}
                </div>
                <div class="slot__actiuni">
                  {s.meeting_url && (
                    <a class="btn btn--primary btn--sm" href={s.meeting_url} target="_blank" rel="noopener">
                      Intră în întâlnire
                    </a>
                  )}
                  {/* Invitația pleca doar prin email; cine o ștergea nu mai avea
                      de unde să o ia, deși portalul o poate genera oricând. */}
                  <a class="btn btn--secondary btn--sm" href={`/consultatii/${s.id}.ics`}>
                    Adaugă în calendar
                  </a>
                  <button
                    class="btn btn--danger btn--sm"
                    type="button"
                    data-anuleaza={s.id}
                    data-cand={`${formatDate(s.starts_at)}, ${formatTime(s.starts_at)}–${formatTime(s.ends_at)}`}
                  >
                    Anulează
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Intervale disponibile</h2>
      </div>

      {
        free.length === 0 ? (
          <div class="empty">
            <p class="empty__title">
              {supervisor ? 'Niciun interval disponibil' : 'Nu ai încă un coordonator'}
            </p>
            <p class="empty__text">
              {
                supervisor
                  ? `${supervisor.name} nu are momentan intervale libere publicate. Îi poți scrie direct din secțiunea Mesaje ca să stabiliți o întâlnire.`
                  : 'Consultațiile se programează cu coordonatorul lucrării. Alege un cadru didactic din catalog și depune cererea de coordonare — intervalele lui apar aici imediat ce cererea este aprobată.'
              }
            </p>
            {
              supervisor ? (
                <a href="/mesaje" class="btn btn--secondary btn--sm">Deschide mesajele</a>
              ) : (
                <a href="/coordonatori" class="btn btn--primary btn--sm">Vezi coordonatorii</a>
              )
            }
          </div>
        ) : (
          <div class="zile">
            {[...byDay.entries()].map(([dayLabel, daySlots]: [string, Slot[]]) => (
              <section class="zi">
                <h3 class="zi__titlu">{dayLabel}</h3>
                <ul class="sloturi">
                  {daySlots.map((s) => (
                    <li class="slot">
                      <div class="slot__corp">
                        <strong class="numeric">
                          {formatTime(s.starts_at)}–{formatTime(s.ends_at)}
                        </strong>
                        <span class="muted">
                          {s.mode === 'online' ? 'Online' : (s.location ?? 'Cabinet')} · {s.teacher_name}
                        </span>
                        {/* Un interval de grup nu arată ca unul individual: câte
                            locuri au mai rămas schimbă decizia de a rezerva. */}
                        {s.capacity > 1 && (
                          <span class="muted">
                            {s.capacity - s.taken} din {s.capacity} locuri libere
                          </span>
                        )}
                        {/* Linkul apare abia după rezervare — până atunci nu ești
                            invitat la nimic. */}
                      </div>
                      <button class="btn btn--primary btn--sm" type="button" data-rezerva={s.id}>
                        Rezervă
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </section>
  </div>

  {/* Anularea eliberează locul și anunță coordonatorul; nu este o acțiune de
      apăsat din greșeală în drum spre butonul de alături. */}
  <dialog id="dialog-anulare" aria-labelledby="titlu-anulare">
    <form method="POST" action="/api/rezervari" class="dialog">
      <h2 id="titlu-anulare" class="section-title">Anulezi consultația?</h2>
      <p class="muted text-sm">
        <span id="anulare-cand"></span> — locul se eliberează pentru alt student, iar
        coordonatorul vede anularea. Poți rezerva din nou dacă intervalul rămâne liber.
      </p>
      <input type="hidden" name="actiune" value="anuleaza" />
      <input type="hidden" name="slot_id" id="anulare-slot" />
      <div class="row" style="justify-content:flex-end;gap:var(--s-2)">
        <button class="btn btn--secondary" type="button" data-inchide-anulare>Păstrează</button>
        <button class="btn btn--danger" type="submit">Anulează consultația</button>
      </div>
    </form>
  </dialog>

  <dialog id="dialog-rezerva" aria-labelledby="titlu-rezerva">
    <form method="POST" action="/api/rezervari" class="dialog">
      <h2 id="titlu-rezerva" class="section-title">Rezervă consultația</h2>
      <input type="hidden" name="slot_id" id="dialog-slot" />
      <div class="field">
        <label class="label" for="subiect">Despre ce vrei să discuți? <span class="muted">(opțional)</span></label>
        <textarea
          class="textarea"
          id="subiect"
          name="subiect"
          rows="3"
          style="min-height:88px"
          placeholder="Ex: validarea chestionarului și structura capitolului empiric" data-autogrow></textarea>
        <span class="hint">Coordonatorul vede subiectul înainte de întâlnire.</span>
      </div>
      <div class="row" style="justify-content:flex-end;gap:var(--s-2)">
        <button class="btn btn--secondary" type="button" data-inchide>Renunță</button>
        <button class="btn btn--primary" type="submit">Confirmă rezervarea</button>
      </div>
    </form>
  </dialog>
</StudentLayout>

<script>
  const dialog = document.getElementById('dialog-rezerva') as HTMLDialogElement | null
  document.querySelectorAll<HTMLButtonElement>('[data-rezerva]').forEach((b) => {
    b.addEventListener('click', () => {
      const camp = document.getElementById('dialog-slot') as HTMLInputElement | null
      if (camp) camp.value = b.dataset.rezerva ?? ''
      dialog?.showModal()
    })
  })
  dialog?.querySelector('[data-inchide]')?.addEventListener('click', () => dialog.close())

  const anulare = document.getElementById('dialog-anulare') as HTMLDialogElement | null
  document.querySelectorAll<HTMLButtonElement>('[data-anuleaza]').forEach((b) => {
    b.addEventListener('click', () => {
      const camp = document.getElementById('anulare-slot') as HTMLInputElement | null
      const cand = document.getElementById('anulare-cand')
      if (camp) camp.value = b.dataset.anuleaza ?? ''
      if (cand) cand.textContent = b.dataset.cand ?? ''
      anulare?.showModal()
    })
  })
  anulare
    ?.querySelector('[data-inchide-anulare]')
    ?.addEventListener('click', () => anulare.close())
</script>

<style>
  .zile {
    display: flex;
    flex-direction: column;
  }

  .zi {
    border-bottom: 1px solid var(--border);
  }
  .zi:last-child {
    border-bottom: 0;
  }

  .zi__titlu {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-soft);
    padding: var(--s-3) var(--s-5) 0;
  }

  .sloturi {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .slot {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
  }
  .slot--rezervat {
    border-bottom: 1px solid var(--border);
  }
  .slot--rezervat:last-child {
    border-bottom: 0;
  }

  .slot__corp {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .slot__corp strong {
    font-size: var(--t-sm);
  }
  .slot__corp .muted {
    font-size: var(--t-xs);
  }

  .slot__actiuni {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }

  .data-chip {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--red-tint);
    line-height: 1;
    flex: none;
  }
  .data-chip strong {
    font-size: var(--t-sm);
    color: var(--red);
  }
  .data-chip small {
    font-size: var(--t-xs);
    color: var(--red);
  }

  .dialog {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-5);
  }

  /* Pe telefon, rândul rămânea orizontal: butoanele își păstrau lățimea, iar
     coloana cu text se strângea la câțiva pixeli, scriind numele coordonatorului
     câte un cuvânt pe rând. */
  @media (max-width: 640px) {
    .slot {
      flex-wrap: wrap;
      padding-inline: var(--s-4);
    }
    .slot__actiuni {
      width: 100%;
      display: flex;
      gap: var(--s-2);
    }
    .slot__actiuni > * {
      flex: 1;
    }
  }
</style>
