---
import Avatar from '../components/Avatar.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import { pairings, supervisors } from '../lib/repo'
import { currentYear, groupLabel } from '../lib/years'

/**
 * Who coordinates whom, visible to everyone signed in.
 *
 * The rule is asymmetric and worth stating plainly: one coordinator takes many
 * students, a student has exactly one coordinator. The database enforces the
 * second half with a partial unique index on live requests; this page is where
 * both halves become checkable by the people they concern, instead of being
 * reconstructed from who replied to which email.
 */

const [year, allPairings, teachers] = await Promise.all([currentYear(), pairings(), supervisors()])

const search = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase()
const filtered = search
  ? allPairings.filter((p) =>
      `${p.student_name} ${p.teacher_name} ${p.title_ro} ${p.specialization ?? ''}`
        .toLowerCase()
        .includes(search),
    )
  : allPairings

const byTeacher = new Map<string, typeof filtered>()
for (const p of filtered) {
  const list = byTeacher.get(p.teacher_id) ?? []
  list.push(p)
  byTeacher.set(p.teacher_id, list)
}

const rows = teachers
  .map((t) => ({
    teacher: t,
    students: byTeacher.get(t.id) ?? [],
    seats: t.bachelor_seats + t.master_seats,
  }))
  .filter((r) => r.students.length > 0 || !search)
  .sort((a, b) => b.students.length - a.students.length || a.teacher.name.localeCompare(b.teacher.name, 'ro'))
---

<StudentLayout
  title="Coordonări"
  description="Perechile coordonator–student din sesiunea în curs"
  active="coordonari"
>
  <div class="container stack stack--loose">
    <header class="stack stack--tight">
      <h1 class="page-title">Coordonări</h1>
      <p class="page-lede">
        Toate perechile coordonator–student din sesiunea {year?.label}. Un cadru didactic
        coordonează mai mulți studenți; un student are un singur coordonator.
      </p>
    </header>

    <form method="GET" class="panel">
      <div class="panel__body row row--wrap" style="gap:var(--s-4);align-items:flex-end">
        <div class="field" style="flex:2;min-width:260px">
          <label class="label" for="q">Caută</label>
          <input class="input" id="q" name="q" type="search" value={search}
            placeholder="Nume student, coordonator, titlu sau specializare…" />
        </div>
        <button class="btn btn--secondary" type="submit">Caută</button>
        {search && <a class="btn btn--ghost" href="/coordonari">Golește</a>}
      </div>
    </form>

    <p class="muted" style="font-size:var(--t-sm)">
      {filtered.length}
      {filtered.length === 1 ? ' coordonare confirmată' : ' coordonări confirmate'} ·{' '}
      {rows.filter((r) => r.students.length > 0).length} cadre didactice cu studenți
    </p>

    {
      filtered.length === 0 ? (
        <section class="panel">
          <div class="empty">
            <p class="empty__title">
              {search ? 'Nimic nu corespunde căutării' : 'Nicio coordonare confirmată încă'}
            </p>
            <p class="empty__text">
              {search
                ? 'Încearcă alt nume sau alt cuvânt din titlu.'
                : 'Perechile apar aici imediat ce un cadru didactic acceptă prima cerere.'}
            </p>
          </div>
        </section>
      ) : (
        rows.map(({ teacher, students, seats }) => (
          <section class="panel">
            <div class="panel__header">
              <div class="row" style="gap:var(--s-3)">
                <Avatar name={teacher.name} src={teacher.avatar_path} href={`/profil/${teacher.id}`} />
                <div class="stack stack--tight" style="gap:0">
                  <h2 class="section-title">
                    <a href={`/profil/${teacher.id}`}>{teacher.name}</a>
                  </h2>
                  <span class="muted" style="font-size:var(--t-xs)">{teacher.department}</span>
                </div>
              </div>
              <span
                class:list={[
                  'badge',
                  teacher.is_full ? 'badge--respinsa' : 'badge--aprobata',
                ]}
              >
                {students.length} / {seats} locuri
              </span>
            </div>

            {students.length === 0 ? (
              <p class="panel__body muted" style="font-size:var(--t-sm)">
                Nu coordonează încă niciun student în această sesiune.
              </p>
            ) : (
              <ul class="perechi">
                {students.map((s) => (
                  <li>
                    <Avatar name={s.student_name} size="xs" href={`/profil/${s.student_id}`} />
                    <div class="stack stack--tight" style="gap:0;flex:1;min-width:0">
                      <strong>
                        <a href={`/profil/${s.student_id}`}>{s.student_name}</a>
                      </strong>
                      <span class="muted" style="font-size:var(--t-xs)">
                        {s.student_number} · {groupLabel(s)}
                      </span>
                    </div>
                    <span class="perechi__titlu">{s.title_ro}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      )
    }
  </div>
</StudentLayout>

<style>
  .section-title a {
    color: inherit;
    text-decoration: none;
  }
  .section-title a:hover {
    color: var(--red);
  }

  .perechi {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .perechi li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }
  .perechi li:last-child {
    border-bottom: 0;
  }
  .perechi a {
    color: inherit;
    text-decoration: none;
  }
  .perechi a:hover {
    color: var(--red);
  }

  .perechi__titlu {
    flex: 2;
    min-width: 0;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .perechi li {
      flex-wrap: wrap;
    }
    .perechi__titlu {
      flex: 1 1 100%;
      white-space: normal;
      font-size: var(--t-xs);
    }
  }
</style>
