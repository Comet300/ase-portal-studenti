---
import { consumeMagicLink, createSession, SESSION_COOKIE } from '../lib/auth'
import { internalPath } from '../lib/http'

/**
 * Consumă tokenul din email, deschide sesiunea și trimite utilizatorul unde trebuie.
 *
 * Ultima instrucțiune din frontmatter-ul unui fișier .astro fără corp nu este
 * verificată de `astro check` — aici a supraviețuit luni de zile un `redirectLa`
 * inexistent, rămas dintr-o redenumire. De aceea logica stă în `lib/http.ts`, iar
 * aici rămâne doar apelul.
 */

const token = Astro.url.searchParams.get('token') ?? ''
const result = await consumeMagicLink(token)

if (!result) {
  return Astro.redirect(
    '/autentificare?eroare=' +
      encodeURIComponent('Linkul este expirat sau a fost deja folosit. Cere unul nou.'),
    302,
  )
}

Astro.cookies.set(SESSION_COOKIE, await createSession(result.user.id), {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure: Astro.url.protocol === 'https:',
  maxAge: 60 * 60 * 24 * 30,
})

const destination = internalPath(
  result.redirectTo,
  result.user.role === 'student' ? '/cererile-mele' : '/profesor',
)

return Astro.redirect(destination, 302)
---
