---
import { consumeMagicLink, createSession, SESSION_COOKIE } from '../lib/auth'

/** Consumă tokenul din email, deschide sesiunea și trimite utilizatorul unde trebuie. */

const token = Astro.url.searchParams.get('token') ?? ''
const result = await consumeMagicLink(token)

if (!result) {
  return Astro.redirect(
    '/autentificare?eroare=' +
      encodeURIComponent('Linkul este expirat sau a fost deja folosit. Cere unul nou.'),
    302,
  )
}

const sesiuneId = await createSession(result.user.id)

Astro.cookies.set(SESSION_COOKIE, sesiuneId, {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure: Astro.url.protocol === 'https:',
  maxAge: 60 * 60 * 24 * 30,
})

const implicit = result.user.role === 'student' ? '/cererile-mele' : '/profesor'
return Astro.redirect(result.redirectLa || implicit, 302)
---
