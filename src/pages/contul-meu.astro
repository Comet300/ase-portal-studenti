---
import Avatar from '../components/Avatar.astro'
import ProfesorLayout from '../layouts/ProfesorLayout.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import { ROLE_LABELS } from '../lib/auth'
import { formatDate, studentRequests } from '../lib/repo'
import { officialName } from '../lib/text'
import { languageLabel, levelLabel } from '../lib/years'

/**
 * The account, for every role.
 *
 * It used to bounce anyone who was not a student to „Arhivă & Profil”, the
 * screen that carried the coordinator's profile form at the bottom of five
 * other sections — so a teacher who opened „Contul meu” from the student portal
 * was thrown into an archive, and the account menu of their own shell had no
 * entry at all. One address now, one form, in the shell of whoever is reading.
 *
 * What is not editable is written as a definition list rather than as disabled
 * inputs: a control you cannot use still reads as a control you should try.
 * Email, role and the registrar's record of a student come from the faculty, and
 * the sentence under each block says who corrects them.
 */

const u = Astro.locals.user!
const isStudent = u.role === 'student'

const requests = isStudent ? await studentRequests(u.id) : []
const active = requests.find((r) => r.status === 'approved' || r.status === 'pending')
const saved = Astro.url.searchParams.get('salvat') === '1'

const lede = isStudent
  ? 'Datele din evidența facultății, profilul pe care îl văd coordonatorii și sesiunea curentă.'
  : 'Ce văd studenții despre tine în catalog și pe profilul public, plus datele cu care intri în portal.'

/* The page renders in the shell of whoever is reading it, as the profile does:
 * a coordinator sent into the student top bar loses their navigation and reads
 * it as a different portal. Both shells now print the title and the lede on the
 * banner, so the page starts straight at its first panel. */
const Shell = isStudent ? StudentLayout : ProfesorLayout
---

<Shell title="Contul meu" description="Datele contului și profilul public" lede={lede} active="cont">
  <div class="container stack stack--loose">
    <section class="panel">
      <div class="panel__body identity">
        <Avatar name={u.name} src={u.avatar_path} size="lg" />
        <div class="stack stack--tight" style="gap:2px;flex:1;min-width:0">
          <strong class="identity__name">{u.name}</strong>
          <span class="muted">
            {ROLE_LABELS[u.role]}
            {!isStudent && u.department ? ` · ${u.department}` : ''}
          </span>
        </div>
        <a class="btn btn--ghost btn--sm" href={`/profil/${u.id}`}>Vezi profilul public</a>
      </div>

      <dl class="details">
        {/* The name as it is printed on the cerere and read at the counter. It
            is here because a typo in the initial is a document handed back, and
            until now nobody could see the initial in order to report it. */}
        {
          isStudent && (
            <div>
              <dt>Nume în acte</dt>
              <dd>
                {officialName(u)}
                {!u.father_initial && (
                  <span class="muted text-sm">
                    {' '}— fără inițiala tatălui; scrie secretariatului dacă lipsește
                  </span>
                )}
              </dd>
            </div>
          )
        }
        <div>
          <dt>Email instituțional</dt>
          <dd>{u.email}</dd>
        </div>
        {
          isStudent ? (
            <>
              <div>
                <dt>Număr matricol</dt>
                <dd>{u.student_number ?? '—'}</dd>
              </div>
              <div>
                <dt>Program</dt>
                <dd>{levelLabel(u.program)}</dd>
              </div>
              <div>
                <dt>Specializare</dt>
                <dd>{u.specialization ?? '—'}</dd>
              </div>
              <div>
                <dt>Limba de studiu</dt>
                <dd>{languageLabel(u.study_language)}</dd>
              </div>
              <div>
                <dt>An de studiu</dt>
                <dd>{u.study_year ?? '—'}</dd>
              </div>
              <div>
                <dt>Serie</dt>
                <dd>{u.study_series ?? '—'}</dd>
              </div>
              <div>
                <dt>Grupa</dt>
                <dd>{u.study_group ?? '—'}</dd>
              </div>
              <div>
                <dt>Coordonator</dt>
                <dd>
                  {active?.status === 'approved' ? (
                    <a href={`/profil/${active.teacher_id}`}>{active.teacher_name}</a>
                  ) : active?.status === 'pending' ? (
                    <span class="muted">cerere depusă la {active.teacher_name}</span>
                  ) : (
                    'Nealocat'
                  )}
                </dd>
              </div>
            </>
          ) : (
            <>
              <div>
                <dt>Rol în portal</dt>
                <dd>{ROLE_LABELS[u.role]}</dd>
              </div>
              <div>
                <dt>Departament</dt>
                <dd>{u.department ?? '—'}</dd>
              </div>
            </>
          )
        }
      </dl>

      <p class="panel__footer hint">
        {
          isStudent
            ? 'Datele de identificare vin din evidența facultății și nu pot fi modificate din portal. Pentru corecturi, scrie secretariatului.'
            : 'Adresa instituțională, rolul și departamentul vin din evidența facultății și nu pot fi schimbate din portal. Pentru corecturi, scrie directorului de departament. Locurile de coordonare se cer din Panoul meu.'
        }
      </p>
    </section>

    {/* --------------------------------------------------------- profile */}
    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Profilul public</h2>
        {saved && <span class="badge badge--aprobata">Salvat</span>}
      </div>

      <form method="POST" action="/api/cont" enctype="multipart/form-data" class="panel__body stack">
        <p class="hint">
          {
            isStudent
              ? 'Coordonatorii îți văd profilul când primesc cererea. Un rând despre ce te interesează spune mai mult decât numărul matricol.'
              : 'Studenții citesc profilul în catalog, înainte să îți scrie. Ce este scris aici hotărăște cine îți trimite cereri.'
          }
        </p>

        <div class="row row--wrap" style="gap:var(--s-4);align-items:center">
          <Avatar name={u.name} src={u.avatar_path} size="md" />
          <div class="field" style="flex:1;min-width:240px">
            <label class="label" for="poza">Poză de profil</label>
            <input class="input" id="poza" name="poza" type="file" accept="image/*" />
            {/* One sentence for both screens: the two used to explain the same
                mechanism differently, one saying it is shrunk, the other saying
                it is displayed small. */}
            <span class="hint">
              JPG, PNG, WEBP sau GIF, maximum 2 MB. Pozele mari sunt micșorate automat înainte de
              trimitere; portalul le afișează la cel mult 72 px.
            </span>
          </div>
        </div>

        <div class="row row--wrap" style="gap:var(--s-4)">
          <div class="field" style="flex:2;min-width:240px">
            <label class="label" for="nume">Nume afișat</label>
            <input class="input" id="nume" name="nume" value={u.name} required maxlength="120" />
          </div>
          {
            !isStudent && (
              <div class="field" style="flex:1;min-width:200px">
                <label class="label" for="titlu">Titlu didactic</label>
                <input
                  class="input"
                  id="titlu"
                  name="titlu"
                  value={u.academic_title ?? ''}
                  maxlength="60"
                  placeholder="Conf. univ. dr."
                />
                {/* It was printed on the request form and in the coordination
                    export, and no screen in the portal could write it: outside
                    the seed it stayed empty for good. */}
                <span class="hint">
                  Se tipărește pe cererea studentului și în exportul de coordonări.
                </span>
              </div>
            )
          }
        </div>

        {
          !isStudent && (
            <div class="row row--wrap" style="gap:var(--s-4)">
              <div class="field" style="flex:2;min-width:240px">
                <label class="label" for="birou">Birou</label>
                <input
                  class="input"
                  id="birou"
                  name="birou"
                  value={u.office ?? ''}
                  placeholder="Corp Ion Angelescu, etaj 3, sala 2314"
                />
                <span class="hint">Unde te găsesc studenții la consultațiile față în față.</span>
              </div>
              <div class="field" style="flex:1;min-width:220px">
                <label class="label" for="pagina_web">Pagină web</label>
                <input
                  class="input"
                  id="pagina_web"
                  name="pagina_web"
                  type="url"
                  value={u.website ?? ''}
                  placeholder="https://"
                />
              </div>
            </div>
          )
        }

        <div class="field">
          <label class="label" for="descriere">Despre mine</label>
          <textarea
            class="textarea"
            id="descriere"
            name="descriere"
            rows="3"
            maxlength="1200"
            placeholder={
              isStudent
                ? 'Unde lucrezi sau ai făcut practică, ce cursuri ți-au plăcut, ce vrei să faci după absolvire.'
                : 'Ce fel de lucrări coordonezi și ce aștepți de la un student. Studenții citesc asta înainte să îți scrie.'
            }
            set:text={u.bio ?? ''}
          data-autogrow />
        </div>

        <div class="field">
          <label class="label" for="interese">
            {isStudent ? 'Domenii de interes' : 'Direcții de cercetare'}
          </label>
          <input class="input" id="interese" name="interese" value={u.interests ?? ''}
            placeholder={
              isStudent
                ? 'Marketing digital · analiza datelor · comportamentul consumatorului'
                : 'Comportamentul consumatorului · modelare structurală'
            } />
          <span class="hint">
            {
              isStudent
                ? 'Separate prin „·”.'
                : 'Separate prin „·”; apar sub numele tău în catalogul studenților.'
            }
          </span>
        </div>

        <div class="row row--end">
          <button class="btn btn--primary" type="submit">Salvează profilul</button>
        </div>
      </form>
    </section>

    {
      isStudent && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Cererile mele</h2>
            <a href="/lucrarea-mea" class="btn btn--ghost btn--sm">
              Vezi toate
            </a>
          </div>
          {requests.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio cerere depusă</p>
              <p class="empty__text">Alege un coordonator din catalog și depune prima cerere.</p>
              <a href="/coordonatori" class="btn btn--primary btn--sm">
                Vezi coordonatorii
              </a>
            </div>
          ) : (
            <ul class="requests">
              {requests.map((r) => (
                <li>
                  <span class="numeric muted">{r.number}</span>
                  <span class="requests__title">{r.title_ro}</span>
                  <span class="muted">{formatDate(r.submitted_at)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Sesiune</h2>
      </div>
      <div class="panel__body row row--between row--wrap" style="gap:var(--s-4)">
        <p class="muted" style="font-size:var(--t-sm);max-width:52ch">
          Ieșirea din cont închide sesiunea pe acest dispozitiv. Poți reveni oricând cerând un
          link nou de autentificare pe adresa instituțională.
        </p>
        <form method="POST" action="/api/deconectare">
          <button class="btn btn--danger" type="submit">Ieși din cont</button>
        </form>
      </div>
    </section>
  </div>
</Shell>

<style>
  .identity {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .identity__name {
    font-family: var(--serif);
    font-size: var(--t-lg);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0 var(--s-5) var(--s-5);
  }
  .details dt {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
  .details dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .requests {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .requests li {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }
  .requests li:last-child {
    border-bottom: 0;
  }
  .requests__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
