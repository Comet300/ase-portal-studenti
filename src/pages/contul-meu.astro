---
import Avatar from '../components/Avatar.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import { ROLE_LABELS } from '../lib/auth'
import { formatDate, studentRequests } from '../lib/repo'
import { languageLabel, levelLabel } from '../lib/years'

const u = Astro.locals.user!

// A teacher landing here has a richer page of their own.
if (u.role !== 'student') return Astro.redirect('/profesor/arhiva', 302)

const requests = await studentRequests(u.id)
const active = requests.find((r) => r.status === 'approved' || r.status === 'pending')
const saved = Astro.url.searchParams.get('salvat') === '1'
---

<StudentLayout title="Contul meu" active="cont">
  <div class="container stack stack--loose">
    <header class="stack stack--tight">
      <h1 class="page-title">Contul meu</h1>
      <p class="page-lede">
        Datele din evidența facultății, profilul pe care îl văd coordonatorii și sesiunea curentă.
      </p>
    </header>

    <section class="panel">
      <div class="panel__body identity">
        <Avatar name={u.name} src={u.avatar_path} size="lg" />
        <div class="stack stack--tight" style="gap:2px;flex:1;min-width:0">
          <strong class="identity__name">{u.name}</strong>
          <span class="muted">{ROLE_LABELS[u.role]}</span>
        </div>
        <a class="btn btn--ghost btn--sm" href={`/profil/${u.id}`}>Vezi profilul public</a>
      </div>

      <dl class="details">
        <div>
          <dt>Email instituțional</dt>
          <dd>{u.email}</dd>
        </div>
        <div>
          <dt>Număr matricol</dt>
          <dd>{u.student_number ?? '—'}</dd>
        </div>
        <div>
          <dt>Program</dt>
          <dd>{levelLabel(u.program)}</dd>
        </div>
        <div>
          <dt>Specializare</dt>
          <dd>{u.specialization ?? '—'}</dd>
        </div>
        <div>
          <dt>Limba de studiu</dt>
          <dd>{languageLabel(u.study_language)}</dd>
        </div>
        <div>
          <dt>An de studiu</dt>
          <dd>{u.study_year ?? '—'}</dd>
        </div>
        <div>
          <dt>Grupa</dt>
          <dd>{u.study_group ?? '—'}</dd>
        </div>
        <div>
          <dt>Coordonator</dt>
          <dd>
            {
              active?.status === 'approved' ? (
                <a href={`/profil/${active.teacher_id}`}>{active.teacher_name}</a>
              ) : active?.status === 'pending' ? (
                <span class="muted">cerere depusă la {active.teacher_name}</span>
              ) : (
                'Nealocat'
              )
            }
          </dd>
        </div>
      </dl>

      <p class="panel__footer hint">
        Datele de identificare vin din evidența facultății și nu pot fi modificate din portal.
        Pentru corecturi, contactează secretariatul.
      </p>
    </section>

    {/* --------------------------------------------------------- profile */}
    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Profilul public</h2>
        {saved && <span class="badge badge--aprobata">Salvat</span>}
      </div>

      <form method="POST" action="/api/cont" enctype="multipart/form-data" class="panel__body stack">
        <p class="hint">
          Coordonatorii îți văd profilul când primesc cererea. Un rând despre ce te interesează
          spune mai mult decât numărul matricol.
        </p>

        <div class="row row--wrap" style="gap:var(--s-4);align-items:center">
          <Avatar name={u.name} src={u.avatar_path} size="md" />
          <div class="field" style="flex:1;min-width:240px">
            <label class="label" for="poza">Poză de profil</label>
            <input class="input" id="poza" name="poza" type="file" accept="image/*" />
            <span class="hint">
              JPG, PNG, WEBP sau GIF, maximum 2 MB. Pozele mari sunt micșorate
              automat înainte de trimitere — portalul le afișează la cel mult 72 px.
            </span>
          </div>
        </div>

        <div class="field">
          <label class="label" for="nume">Nume afișat</label>
          <input class="input" id="nume" name="nume" value={u.name} required maxlength="120" />
        </div>

        <div class="field">
          <label class="label" for="descriere">Despre mine</label>
          <textarea
            class="textarea"
            id="descriere"
            name="descriere"
            rows="3"
            maxlength="1200"
            placeholder="Unde lucrezi sau ai făcut practică, ce cursuri ți-au plăcut, ce vrei să faci după absolvire."
            set:text={u.bio ?? ''}
          data-autogrow />
        </div>

        <div class="field">
          <label class="label" for="interese">Domenii de interes</label>
          <input class="input" id="interese" name="interese" value={u.interests ?? ''}
            placeholder="Marketing digital · analiza datelor · comportamentul consumatorului" />
          <span class="hint">Separate prin „·”.</span>
        </div>

        <div class="row row--end">
          <button class="btn btn--primary" type="submit">Salvează profilul</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Cererile mele</h2>
        <a href="/cererile-mele" class="btn btn--ghost btn--sm">Vezi toate</a>
      </div>
      {
        requests.length === 0 ? (
          <div class="empty">
            <p class="empty__title">Nicio cerere depusă</p>
            <p class="empty__text">Alege un coordonator din catalog și depune prima cerere.</p>
            <a href="/coordonatori" class="btn btn--primary btn--sm">Vezi coordonatorii</a>
          </div>
        ) : (
          <ul class="requests">
            {requests.map((r) => (
              <li>
                <span class="numeric muted">{r.number}</span>
                <span class="requests__title">{r.title_ro}</span>
                <span class="muted">{formatDate(r.submitted_at)}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="panel">
      <div class="panel__header">
        <h2 class="section-title">Sesiune</h2>
      </div>
      <div class="panel__body row row--between row--wrap" style="gap:var(--s-4)">
        <p class="muted" style="font-size:var(--t-sm);max-width:52ch">
          Ieșirea din cont închide sesiunea pe acest dispozitiv. Poți reveni oricând cerând un
          link nou de autentificare pe adresa instituțională.
        </p>
        <form method="POST" action="/api/deconectare">
          <button class="btn btn--danger" type="submit">Ieși din cont</button>
        </form>
      </div>
    </section>
  </div>
</StudentLayout>

<style>
  .identity {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .identity__name {
    font-family: var(--serif);
    font-size: var(--t-lg);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0 var(--s-5) var(--s-5);
  }
  .details dt {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
  .details dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .requests {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .requests li {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }
  .requests li:last-child {
    border-bottom: 0;
  }
  .requests__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
