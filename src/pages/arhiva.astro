---
import AlegeAn from '../components/AlegeAn.astro'
import Metrica from '../components/Metrica.astro'
import ProfesorLayout from '../layouts/ProfesorLayout.astro'
import StudentLayout from '../layouts/StudentLayout.astro'
import { archiveRows, formatDate } from '../lib/repo'
import { LEVEL_LABELS, allYears, languageLabel, levelLabel } from '../lib/years'

/**
 * The archive of finished theses.
 *
 * Open to everyone signed in, students included: knowing what was written last
 * year, and by whom, under which coordinator, is how a student picks a direction
 * — and until now that knowledge lived in a spreadsheet three people had.
 *
 * Two sources read as one list. Sessions the portal ran produce their own rows;
 * sessions before it existed are typed in by the head of department. The
 * provenance is shown, but it does not split the table.
 *
 * It renders in the shell of whoever is reading it. Until the teaching-staff
 * sidebar got an entry for it, the only way here from the teacher area was the
 * „Portalul studenților” exit — and that dropped a coordinator into the student
 * top bar, which reads as a different portal.
 */

const u = Astro.locals.user!
const isStudent = u.role === 'student'

const years = await allYears()
const requested = Astro.url.searchParams.get('an') ?? ''
/* The default is the last session that ended, not the one under way: theses are
 * defended at the end, so the current year is empty until then and whoever
 * landed on it concluded the archive was broken. The picker says which year it
 * is showing, and the note under it says why that one. */
const previousYear = years.find((y) => !y.is_current)
const year = years.find((y) => y.id === requested) ?? previousYear ?? years[0]

const rows = year ? await archiveRows(year.id) : []
const search = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase()

const filtered = search
  ? rows.filter((r) =>
      `${r.student_name} ${r.teacher_name} ${r.title_ro} ${r.programme ?? ''}`
        .toLowerCase()
        .includes(search),
    )
  : rows

const byTeacher = new Map<string, typeof filtered>()
for (const r of filtered) {
  const list = byTeacher.get(r.teacher_name) ?? []
  list.push(r)
  byTeacher.set(r.teacher_name, list)
}
const grouped = [...byTeacher.entries()].sort((a, b) => a[0].localeCompare(b[0], 'ro'))

const levels = {
  bachelor: filtered.filter((r) => r.level === 'bachelor').length,
  master: filtered.filter((r) => r.level === 'master').length,
}

const hasImported = filtered.some((r) => r.source === 'import')

// A pasted paragraph in the search box must not become a three-line heading.
const searchLabel = search.length > 40 ? `${search.slice(0, 40)}…` : search

const lede =
  'Lucrările de finalizare susținute în sesiunile anterioare, cu coordonatorii lor. Citește-o înainte să scrii cuiva: aici se vede ce direcții a coordonat efectiv un cadru didactic.'

const Shell = isStudent ? StudentLayout : ProfesorLayout
---

<Shell
  title="Arhivă"
  description="Lucrările de finalizare a studiilor din sesiunile anterioare, cu coordonatorii lor"
  lede={lede}
  active="arhiva"
>
  <div class="container stack stack--loose">
    {
      isStudent && (
        <header class="stack stack--tight">
          <h1 class="page-title">Arhivă</h1>
          <p class="page-lede">{lede}</p>
        </header>
      )
    }

    <div class="panel">
      <div class="panel__body row row--wrap" style="gap:var(--s-4);align-items:flex-end">
        <AlegeAn years={years} selected={year?.id ?? ''} base="/arhiva"
          keep={search ? { q: search } : {}} />
        <form method="GET" class="row row--wrap" style="gap:var(--s-3);align-items:flex-end;flex:1">
          <input type="hidden" name="an" value={year?.id} />
          <div class="field" style="flex:2;min-width:240px">
            <label class="label" for="q">Caută în arhivă</label>
            <input class="input" id="q" name="q" type="search" value={search}
              placeholder="Nume de student, coordonator, titlu sau specializare…" />
          </div>
          <button class="btn btn--secondary" type="submit">Caută</button>
        </form>
      </div>
      <p class="panel__footer hint">
        Arhiva se deschide pe ultima sesiune încheiată: o lucrare intră în sesiunea în care este
        susținută, nu în cea în care a început coordonarea — un student poate alege coordonatorul în
        anul II și susține la finalul anului III.
      </p>
    </div>

    <div class="grid-auto">
      <Metrica
        value={filtered.length}
        label={`${filtered.length === 1 ? 'lucrare' : 'lucrări'} în ${year?.label ?? ''}`}
      />
      <Metrica value={levels.bachelor} label={LEVEL_LABELS.bachelor.toLowerCase()} />
      <Metrica value={levels.master} label={LEVEL_LABELS.master.toLowerCase()} />
      <Metrica
        value={grouped.length}
        label={grouped.length === 1 ? 'coordonator' : 'coordonatori'}
      />
    </div>

    {
      filtered.length === 0 ? (
        <section class="panel">
          <div class="empty">
            <p class="empty__title">
              {search
                ? `Nicio lucrare nu conține „${searchLabel}” în ${year?.label}`
                : `Nicio lucrare înregistrată în ${year?.label}`}
            </p>
            <p class="empty__text">
              {search
                ? 'Caută după un singur cuvânt din titlu sau după numele coordonatorului, ori schimbă anul universitar.'
                : year?.is_current
                  ? 'Sesiunea este în curs: lucrările intră în arhivă după susținere. Până atunci, ultima sesiune încheiată este cea cu ce s-a scris.'
                  : 'Pentru acest an nu au fost încă introduse date. Sesiunile dinaintea portalului se importă din evidența facultății.'}
            </p>
            {search ? (
              <a class="btn btn--secondary btn--sm" href={`/arhiva?an=${year?.id ?? ''}`}>
                Șterge căutarea
              </a>
            ) : year?.is_current && previousYear ? (
              <a class="btn btn--primary btn--sm" href={`/arhiva?an=${previousYear.id}`}>
                Vezi sesiunea {previousYear.label}
              </a>
            ) : (
              !year?.is_current &&
              u.role === 'head' && (
                <a class="btn btn--primary btn--sm" href="/profesor/an-universitar">
                  Importă datele sesiunii
                </a>
              )
            )}
          </div>
        </section>
      ) : (
        grouped.map(([teacher, list]) => (
          <section class="panel">
            <div class="panel__header">
              <h2 class="section-title">{teacher}</h2>
              <span class="muted text-sm">
                {list.length} {list.length === 1 ? 'lucrare' : 'lucrări'}
              </span>
            </div>
            <ul class="lucrari">
              {list.map((r) => (
                <li>
                  <div class="stack stack--tight" style="gap:2px">
                    <strong class="lucrari__titlu">{r.title_ro}</strong>
                    <span class="muted text-xs">
                      {r.student_name}
                      {r.student_number ? ` · ${r.student_number}` : ''}
                      {r.programme ? ` · ${r.programme}` : ''}
                      {r.level ? ` · ${levelLabel(r.level).toLowerCase()}` : ''}
                      {r.language && r.language !== 'ro'
                        ? ` · ${languageLabel(r.language).toLowerCase()}`
                        : ''}
                    </span>
                  </div>
                  <span class="lucrari__meta">
                    {r.defended_on && (
                      <span class="muted text-xs">
                        {formatDate(r.defended_on)}
                      </span>
                    )}
                    {r.source === 'import' && (
                      <span class="badge badge--ciorna">din evidență</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }

    {/* The badge used to explain itself only in a `title` attribute — invisible
        on a phone, and to anyone who does not hover a grey label. */}
    {
      hasImported && (
        <p class="hint">
          Rândurile marcate <span class="badge badge--ciorna">din evidență</span> au fost
          introduse din registrele facultății, din sesiuni dinaintea portalului. Restul sunt
          coordonări înregistrate aici, cerere cu cerere.
        </p>
      )
    }
  </div>
</Shell>

<style>
  .lucrari {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lucrari li {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
  }
  .lucrari li:last-child {
    border-bottom: 0;
  }

  .lucrari__titlu {
    font-size: var(--t-sm);
    font-weight: 500;
    text-wrap: pretty;
  }

  .lucrari__meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
  }
</style>
