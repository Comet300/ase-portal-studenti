---
import Avatar from '../../components/Avatar.astro'
import ProfesorLayout from '../../layouts/ProfesorLayout.astro'
import StudentLayout from '../../layouts/StudentLayout.astro'
import { screenName } from '../../lib/navigation'
import { internalPath } from '../../lib/http'
import { ROLE_LABELS } from '../../lib/auth'
import { queryOne, query } from '../../lib/db'
import { id as routeId } from '../../lib/ids'
import { formatDate, studentRequests, teacherSeats } from '../../lib/repo'
import { groupLabel, languageLabel, levelLabel } from '../../lib/years'

/**
 * One profile page for both roles.
 *
 * A coordinator's profile is a decision aid: a student reads it before writing.
 * A student's profile is context: a coordinator reads it before accepting. They
 * differ in what they carry, not in how they are built — same shell, same
 * vocabulary, so neither side feels like the afterthought.
 *
 * Visible to anyone signed in. Nothing here is private: it is the same
 * information the catalogue, the pairings list and the archive already show.
 */

const me = Astro.locals.user!

// A hand-edited URL must read as "no such person", not as a database error.
const id = routeId(Astro.params.id ?? null)
if (!id) return Astro.rewrite('/404')

const person = await queryOne<{
  id: string
  name: string
  email: string
  role: 'student' | 'teacher' | 'head'
  academic_title: string | null
  department: string | null
  office: string | null
  bio: string | null
  avatar_path: string | null
  interests: string | null
  website: string | null
  student_number: string | null
  program: string | null
  specialization: string | null
  study_language: string
  study_group: string | null
  study_year: number | null
}>(
  `SELECT id, name, email, role, academic_title, department, office, bio, avatar_path,
          interests, website, student_number, program, specialization,
          study_language, study_group, study_year
     FROM users WHERE id = $1`,
  [id],
)

if (!person) return Astro.rewrite('/404')

const isTeacherProfile = person.role !== 'student'
const isMe = person.id === me.id

const seats = isTeacherProfile ? await teacherSeats(person.id) : null

// A student with a request under way cannot submit another; the button has to
// know that.
const hasActiveRequest =
  me.role === 'student' &&
  (await studentRequests(me.id)).some((c) => c.status === 'pending' || c.status === 'approved')

const topics = isTeacherProfile
  ? await query<{ id: string; title: string; level: string; language: string; methods: string | null }>(
      `SELECT id, title, level, language, methods
         FROM topics
        WHERE teacher_id = $1 AND is_active
          AND academic_year_id = (SELECT id FROM academic_years WHERE is_current)
        ORDER BY title`,
      [person.id],
    )
  : []

const supervised = isTeacherProfile
  ? await query<{ student_id: string; student_name: string; title_ro: string }>(
      `SELECT s.id AS student_id, s.name AS student_name, r.title_ro
         FROM requests r JOIN users s ON s.id = r.student_id
        WHERE r.teacher_id = $1 AND r.status = 'approved'
          AND r.academic_year_id = (SELECT id FROM academic_years WHERE is_current)
        ORDER BY s.name`,
      [person.id],
    )
  : []

const coordination = !isTeacherProfile
  ? await queryOne<{
      teacher_id: string
      teacher_name: string
      title_ro: string
      decided_at: string | null
    }>(
      `SELECT t.id AS teacher_id, t.name AS teacher_name, r.title_ro, r.decided_at
         FROM requests r JOIN users t ON t.id = r.teacher_id
        WHERE r.student_id = $1 AND r.status = 'approved'
          AND r.academic_year_id = (SELECT id FROM academic_years WHERE is_current)`,
      [person.id],
    )
  : null

const editHref = isTeacherProfile ? '/profesor/arhiva' : '/contul-meu'

/* The page renders in the shell of whoever is reading it.
 *
 * It was always the student layout, so a teacher who opened a student's profile
 * from the request queue lost their sidebar and had no way back — the page
 * looked like a different portal.
 *
 * `?de_la=` carries the way back, passed through `internalPath` so that an
 * external address slipped in there cannot take anyone out of the portal. */
const Shell = me.role === 'student' ? StudentLayout : ProfesorLayout

/* The way back, even when whoever sent you here forgot to write it.
 *
 * `?de_la=` exists, but out of the eight links to a profile only two set it, so
 * the „Înapoi” button was missing from most of the routes — including the one
 * from the request queue, where it is exactly the one that is needed. When the
 * parameter is not given, it is taken from `Referer`, if that is a page of the
 * portal: the same thing the caller would have written, only it no longer
 * depends on the caller to remember it.
 *
 * Through `internalPath` as well, with the same reservation: a `Referer` is
 * text controlled by the client. A return to the current profile is not
 * accepted — it would be a button that does nothing. */
const fromParam = Astro.url.searchParams.get('de_la')
const referrerPath = (() => {
  if (fromParam) return internalPath(fromParam, '')
  const referer = Astro.request.headers.get('referer')
  if (!referer) return ''
  try {
    const refererUrl = new URL(referer)
    if (refererUrl.origin !== Astro.url.origin) return ''
    if (refererUrl.pathname === Astro.url.pathname) return ''
    return internalPath(refererUrl.pathname + refererUrl.search, '')
  } catch {
    return ''
  }
})()
const inapoi = referrerPath

// The page depends on the header it came from, so that header enters the cache
// key.
Astro.response.headers.set('vary', 'referer')
---

<Shell title={person.name} description={`Profilul ${person.name}`} lede={undefined}>
  <div class="container stack stack--loose">
    {inapoi && (
      <a class="inapoi" href={inapoi}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {/* The button knows where it leads, so it says so: „Înapoi” on its own
            asks you to remember where you came from, exactly what you do not do
            after three profiles opened. */}
        {screenName(inapoi) ? `Înapoi la ${screenName(inapoi)}` : 'Înapoi'}
      </a>
    )}
    <section class="panel">
      <div class="panel__body identitate">
        <Avatar name={person.name} src={person.avatar_path} size="lg" />
        <div class="stack stack--tight" style="gap:4px;flex:1;min-width:0">
          <h1 class="identitate__nume">{person.name}</h1>
          <p class="muted">
            {ROLE_LABELS[person.role]}
            {person.department ? ` · ${person.department}` : ''}
          </p>
          {
            !isTeacherProfile && (
              <p class="muted text-sm">
                {person.student_number} · {groupLabel(person)}
                {person.study_group ? ` · grupa ${person.study_group}` : ''}
              </p>
            )
          }
          {
            isTeacherProfile && seats && (
              <p class="muted text-sm">
                {seats.total_taken} din {seats.total_seats} locuri ocupate
                {seats.free > 0 ? ` · ${seats.free} libere` : ' · fără locuri disponibile'}
              </p>
            )
          }
        </div>

        <div class="row row--wrap" style="gap:var(--s-2)">
          {isMe && <a class="btn btn--secondary btn--sm" href={editHref}>Editează profilul</a>}
          {/* The button took no account of the student already having a
              request: the most visible control on the page led to a form that
              stayed hidden, with no message at all. */}
          {
            !isMe && me.role === 'student' && isTeacherProfile && (
              hasActiveRequest ? (
                <span class="hint">
                  Ai deja o cerere activă. Poți depune alta doar după ce o retragi sau primești o
                  decizie.
                </span>
              ) : seats?.free === 0 ? (
                <span class="hint">
                  {person.name} nu mai are locuri libere în această sesiune.
                </span>
              ) : (
                <a class="btn btn--primary btn--sm" href={`/cererile-mele?coordonator=${person.id}`}>
                  Depune cerere
                </a>
              )
            )
          }
        </div>
      </div>

      <dl class="details">
        <div>
          <dt>Email instituțional</dt>
          <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
        </div>
        {
          isTeacherProfile && (
            <div>
              <dt>Birou</dt>
              <dd>{person.office ?? '—'}</dd>
            </div>
          )
        }
        {
          isTeacherProfile && person.website && (
            <div>
              <dt>Pagină web</dt>
              <dd>
                <a href={person.website} target="_blank" rel="noopener">
                  {person.website.replace(/^https?:\/\//, '')}
                </a>
              </dd>
            </div>
          )
        }
        {
          !isTeacherProfile && (
            <div>
              <dt>Limba de studiu</dt>
              <dd>{languageLabel(person.study_language)}</dd>
            </div>
          )
        }
      </dl>
    </section>

    {
      person.bio && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Despre</h2>
          </div>
          <p class="panel__body description">{person.bio}</p>
        </section>
      )
    }

    {
      person.interests && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">
              {isTeacherProfile ? 'Direcții de cercetare' : 'Domenii de interes'}
            </h2>
          </div>
          <p class="panel__body description">{person.interests}</p>
        </section>
      )
    }

    {/* ---------------------------------------------------------- teacher */}
    {
      isTeacherProfile && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Teme propuse în sesiunea curentă</h2>
            <span class="muted text-sm">{topics.length}</span>
          </div>

          {topics.length === 0 ? (
            <div class="empty">
              <p class="empty__title">Nicio temă publicată</p>
              <p class="empty__text">
                {isMe
                  ? 'Publică teme din „Studenți & Cereri”, secțiunea Teme propuse.'
                  : 'Poți propune o temă proprie când depui cererea.'}
              </p>
            </div>
          ) : (
            <ul class="teme">
              {topics.map((t) => (
                <li>
                  <div class="stack stack--tight" style="gap:2px">
                    <strong>{t.title}</strong>
                    {t.methods && (
                      <span class="muted text-xs">Metode: {t.methods}</span>
                    )}
                  </div>
                  <span class="badge badge--taxon">
                    {levelLabel(t.level)}
                    {t.language !== 'ro' ? ` · ${languageLabel(t.language)}` : ''}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      isTeacherProfile && supervised.length > 0 && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Studenți coordonați</h2>
            <span class="muted text-sm">{supervised.length}</span>
          </div>
          <ul class="teme">
            {supervised.map((s) => (
              <li>
                <div class="stack stack--tight" style="gap:2px">
                  <strong>
                    <a href={`/profil/${s.student_id}`}>{s.student_name}</a>
                  </strong>
                  <span class="muted text-xs">{s.title_ro}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ---------------------------------------------------------- student */}
    {
      !isTeacherProfile && (
        <section class="panel">
          <div class="panel__header">
            <h2 class="section-title">Lucrarea de finalizare</h2>
          </div>
          {coordination ? (
            <div class="panel__body stack stack--tight">
              <strong style="font-family:var(--serif);font-size:var(--t-md)">
                {coordination.title_ro}
              </strong>
              <p class="muted text-sm">
                Coordonator:{' '}
                <a href={`/profil/${coordination.teacher_id}`}>{coordination.teacher_name}</a>
                {coordination.decided_at
                  ? ` · confirmată ${formatDate(coordination.decided_at)}`
                  : ''}
              </p>
            </div>
          ) : (
            <div class="empty">
              <p class="empty__title">Fără coordonator confirmat</p>
              <p class="empty__text">
                {isMe
                  ? 'Alege un coordonator din catalog și depune cererea.'
                  : 'Studentul nu are încă o coordonare confirmată în sesiunea curentă.'}
              </p>
              {isMe && <a class="btn btn--primary btn--sm" href="/coordonatori">Vezi coordonatorii</a>}
            </div>
          )}
        </section>
      )
    }
  </div>
</Shell>

<style>
  /* The way back, when the page was opened from another part of the portal. */
  .inapoi {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    align-self: flex-start;
    min-height: var(--tap);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .inapoi:hover {
    color: var(--red);
  }
  .inapoi svg {
    width: 15px;
    height: 15px;
  }

  .identitate {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .identitate__nume {
    font-family: var(--serif);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0 var(--s-5) var(--s-5);
  }
  .details dt {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
  .details dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .description {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    white-space: pre-wrap;
    text-wrap: pretty;
    max-width: 72ch;
  }

  .teme {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .teme li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-5);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }
  .teme li:last-child {
    border-bottom: 0;
  }
  .teme a {
    color: inherit;
    text-decoration: none;
  }
  .teme a:hover {
    color: var(--red);
  }
</style>
