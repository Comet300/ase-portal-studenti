---
import BaseLayout from './BaseLayout.astro'
import { initials, DEMO_MODE } from '../lib/auth'
import { currentYearLabel } from '../lib/years'

interface Props {
  title: string
  lede?: string
  active?: string
  /**
   * Screens that fill the viewport instead of growing with their content.
   *
   * The chat sized itself with `calc(100vh - 210px)`, a guess at the header and
   * the demo banner — so on this layout it overflowed and the whole page
   * scrolled, carrying the thread list and the composer off-screen. With `fill`
   * the shell owns the height and the body is the only thing that scrolls.
   */
  fill?: boolean
}

const { title, lede, active, fill = false } = Astro.props
const u = Astro.locals.user!
const sesiune = await currentYearLabel()

const linkuri = [
  { href: '/profesor', cheie: 'dashboard', text: 'Dashboard', icon: 'grid' },
  { href: '/profesor/studenti', cheie: 'studenti', text: 'Studenți & Cereri', icon: 'users' },
  { href: '/profesor/teme', cheie: 'teme', text: 'Teme propuse', icon: 'book' },
  { href: '/profesor/consultatii', cheie: 'consultatii', text: 'Consultații', icon: 'clock' },
  { href: '/profesor/mesaje', cheie: 'mesaje', text: 'Mesaje', icon: 'chat' },
  { href: '/profesor/facultate', cheie: 'facultate', text: 'Studenții facultății', icon: 'list' },
  ...(u.role === 'head'
    ? [
        { href: '/profesor/departament', cheie: 'departament', text: 'Departament', icon: 'chart' },
        { href: '/profesor/calendar', cheie: 'calendar', text: 'Calendarul sesiunii', icon: 'calendar' },
        { href: '/profesor/an-universitar', cheie: 'an', text: 'An universitar', icon: 'refresh' },
      ]
    : []),
  { href: '/profesor/arhiva', cheie: 'arhiva', text: 'Arhivă & Profil', icon: 'archive' },
]

const cai: Record<string, string> = {
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  users: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  chat: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
  list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  chart: 'M18 20V10M12 20V4M6 20v-6',
  archive: 'M21 8v13H3V8M1 3h22v5H1zM10 12h4',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  refresh: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
}
---

<BaseLayout title={title}>
  <div class:list={['shell', { 'shell--fill': fill }]}>
    <aside class="sidebar" id="sidebar">
      <a href="/profesor" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>SFS {sesiune}</strong>
          <small>Facultatea de Marketing</small>
        </span>
      </a>

      <nav class="nav" aria-label="Navigație cadru didactic">
        {
          linkuri.map((l) => (
            <a href={l.href} class:list={['nav__link', { 'is-active': active === l.cheie }]}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d={cai[l.icon]} />
              </svg>
              {l.text}
            </a>
          ))
        }
      </nav>

      <div class="sidebar__end">
        <a href="/" class="nav__link nav__link--quiet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
            ><path d="M3 12l9-9 9 9M5 10v10h14V10"></path></svg
          >
          Portalul studenților
        </a>
        <div class="user">
          <span class="user__avatar">{initials(u.name)}</span>
          <span class="user__meta">
            <strong>{u.name}</strong>
            <small>{u.role === 'head' ? 'Director de departament' : 'Cadru didactic'}</small>
          </span>
          <form method="POST" action="/api/deconectare">
            <button class="btn btn--ghost btn--sm" type="submit" title="Deconectare" aria-label="Deconectare">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                ><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg
              >
            </button>
          </form>
        </div>
      </div>
    </aside>

    <div class="content">
      <header class="content__header">
        <button class="hamburger" aria-label="Deschide meniul" aria-expanded="false" aria-controls="sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M3 6h18M3 12h18M3 18h18"></path></svg
          >
        </button>
        <div>
          <h1 class="page-title">{title}</h1>
          {lede && <p class="page-lede">{lede}</p>}
        </div>
        <slot name="actiuni" />
      </header>

      {
        DEMO_MODE && (
          <p class="demo-note">
            <strong>Mod demonstrativ activ.</strong> Datele sunt fictive, iar autentificarea fără email este
            permisă. Emailurile sunt redirecționate către o singură adresă de test.
          </p>
        )
      }

      <main id="continut" class="content__body">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  const buton = document.querySelector<HTMLButtonElement>('.hamburger')
  const bara = document.getElementById('sidebar')
  buton?.addEventListener('click', () => {
    const deschis = bara?.classList.toggle('is-open') ?? false
    buton.setAttribute('aria-expanded', String(deschis))
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      bara?.classList.remove('is-open')
      buton?.setAttribute('aria-expanded', 'false')
    }
  })
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    min-height: 100vh;
  }

  /* Bara laterală este al doilea strat neutru: închisă, ca să nu concureze cu conținutul. */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding: var(--s-5) var(--s-4);
    background: var(--navy);
    color: #d7dbe0;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: #fff;
    padding-inline: var(--s-2);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: #9aa2ab;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-md);
    color: #c3c9d1;
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 500;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .nav__link svg {
    width: 17px;
    height: 17px;
    flex: none;
    opacity: 0.8;
  }

  .nav__link:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .nav__link.is-active {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-weight: 600;
  }
  .nav__link.is-active svg {
    color: #ff8a80;
    opacity: 1;
  }

  .nav__link--quiet {
    font-size: var(--t-xs);
    color: #9aa2ab;
  }

  .sidebar__end {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .user {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
    flex: none;
  }

  .user__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
    flex: 1;
  }
  .user__meta strong {
    font-size: var(--t-sm);
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .user__meta small {
    font-size: var(--t-xs);
    color: #9aa2ab;
  }

  .user .btn--ghost {
    color: #9aa2ab;
    padding: 0 var(--s-2);
  }
  .user .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .content {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .shell--fill {
    height: 100vh;
  }
  .shell--fill .content {
    height: 100vh;
    overflow: hidden;
  }
  .shell--fill .content__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .content__header {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-6) var(--s-5);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .content__header > div {
    flex: 1;
    min-width: 0;
  }

  .content__body {
    padding: var(--s-6);
    flex: 1;
  }

  .demo-note {
    margin: var(--s-5) var(--s-6) 0;
    padding: var(--s-3) var(--s-4);
    background: var(--warn-tint);
    color: var(--warn);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
  }

  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    cursor: pointer;
    flex: none;
  }
  .hamburger svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 900px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-w);
      z-index: var(--z-drawer);
      transform: translateX(-100%);
      transition: transform var(--base) var(--ease);
      box-shadow: var(--shadow-overlay);
    }
    .sidebar.is-open {
      transform: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .content__header,
    .content__body {
      padding-inline: var(--s-4);
    }
    /* At phone width a serif display title and an action button cannot share a
       row: the title wraps to three lines and collides with the button. */
    .content__header {
      flex-wrap: wrap;
      gap: var(--s-3);
    }
    .content__header > div {
      flex: 1 1 100%;
      order: 2;
    }
    .content__header :global(.row) {
      order: 3;
      flex: 1 1 100%;
    }
    .content__header .page-title {
      font-size: var(--t-xl);
    }
    .demo-note {
      margin-inline: var(--s-4);
    }
  }
</style>
