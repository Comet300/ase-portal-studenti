---
import BaseLayout from './BaseLayout.astro'
import Clopotel from '../components/Clopotel.astro'
import { initials, DEMO_MODE } from '../lib/auth'
import { SCREENS } from '../lib/navigation'
import { currentYearLabel } from '../lib/years'

interface Props {
  title: string
  /** The title in the browser bar, when the one on the page is a greeting, not a screen name. */
  docTitle?: string
  lede?: string
  active?: string
  /**
   * Screens that fill the viewport instead of growing with their content.
   *
   * The chat sized itself with `calc(100vh - 210px)`, a guess at the header and
   * the demo banner — so on this layout it overflowed and the whole page
   * scrolled, carrying the thread list and the composer off-screen. With `fill`
   * the shell owns the height and the body is the only thing that scrolls.
   */
  fill?: boolean
}

const { title, docTitle, lede, active, fill = false } = Astro.props
const u = Astro.locals.user!
const yearLabel = await currentYearLabel()

/* Ten entries in a row, with no hierarchy at all, and the head of department
 * got three more mixed in among them. They are split into what you do daily,
 * what belongs to the faculty and what is configured once a year.
 *
 * „Dashboard” was the only English word in a wholly Romanian navigation. */
const navGroups = [
  {
    titlu: 'Coordonare',
    links: [
      { href: '/profesor', key: 'dashboard', text: SCREENS['/profesor'], icon: 'grid' },
      { href: '/profesor/studenti', key: 'studenti', text: SCREENS['/profesor/studenti'], icon: 'users' },
      { href: '/profesor/teme', key: 'teme', text: SCREENS['/profesor/teme'], icon: 'book' },
      { href: '/profesor/consultatii', key: 'consultatii', text: SCREENS['/profesor/consultatii'], icon: 'clock' },
      { href: '/profesor/mesaje', key: 'mesaje', text: SCREENS['/profesor/mesaje'], icon: 'chat' },
    ],
  },
  {
    titlu: 'Facultate',
    links: [
      { href: '/profesor/facultate', key: 'facultate', text: SCREENS['/profesor/facultate'], icon: 'list' },
      { href: '/profesor/arhiva', key: 'arhiva', text: SCREENS['/profesor/arhiva'], icon: 'archive' },
      ...(u.role === 'head'
        ? [{ href: '/profesor/departament', key: 'departament', text: SCREENS['/profesor/departament'], icon: 'chart' }]
        : []),
      ...(u.role === 'head'
        ? [{ href: '/profesor/conturi', key: 'conturi', text: SCREENS['/profesor/conturi'], icon: 'users' }]
        : []),
    ],
  },
  ...(u.role === 'head'
    ? [
        {
          titlu: 'Administrare',
          links: [
            { href: '/profesor/calendar', key: 'calendar', text: SCREENS['/profesor/calendar'], icon: 'calendar' },
            { href: '/profesor/an-universitar', key: 'an', text: SCREENS['/profesor/an-universitar'], icon: 'refresh' },
          ],
        },
      ]
    : []),
]

const iconPaths: Record<string, string> = {
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  users: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  chat: 'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
  list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  chart: 'M18 20V10M12 20V4M6 20v-6',
  archive: 'M21 8v13H3V8M1 3h22v5H1zM10 12h4',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  refresh: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
}
---

<BaseLayout title={title} docTitle={docTitle}>
  <div class:list={['shell', { 'shell--fill': fill }]}>
    <aside class="sidebar" id="sidebar">
      <a href="/profesor" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>SFS {yearLabel}</strong>
          <small>Facultatea de Marketing</small>
        </span>
      </a>

      <nav class="nav" aria-label="Navigație cadru didactic">
        {
          navGroups.map((g) => (
            <div class="nav__grup">
              <p class="nav__grup-titlu">{g.titlu}</p>
              {/* `title` for a tablet in portrait: there the sidebar collapses
                  to icons, so the name has to stay said somewhere. */}
              {g.links.map((l) => (
                <a
                  href={l.href}
                  class:list={['nav__link', { 'is-active': active === l.key }]}
                  aria-current={active === l.key ? 'page' : undefined}
                  title={l.text}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d={iconPaths[l.icon]} />
                  </svg>
                  <span class="nav__text">{l.text}</span>
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <div class="sidebar__end">
        {/* Ctrl+K is not discovered on its own. The button says the shortcut,
            so that the second time it is no longer needed. */}
        <button class="nav__link nav__link--quiet paleta-buton" type="button" data-paleta>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.35-4.35" />
          </svg>
          <span class="nav__text">Mergi la…</span>
          <kbd class="nav__scurtatura">⌘K</kbd>
        </button>

        <a href="/" class="nav__link nav__link--quiet" title="Portalul studenților">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
            ><path d="M3 12l9-9 9 9M5 10v10h14V10"></path></svg
          >
          <span class="nav__text">Portalul studenților</span>
        </a>
        <div class="user">
          <span class="user__avatar">{initials(u.name)}</span>
          <span class="user__meta">
            <strong>{u.name}</strong>
            <small>{u.role === 'head' ? 'Director de departament' : 'Cadru didactic'}</small>
          </span>
          <Clopotel messagesBase="/profesor/mesaje" />
          <form method="POST" action="/api/deconectare">
            <button class="btn btn--ghost btn--sm" type="submit" title="Deconectare" aria-label="Deconectare">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                ><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg
              >
            </button>
          </form>
        </div>
      </div>
    </aside>

    <div class="content">
      {/* `main` starts above the title: otherwise the „Sari la conținut” link
          skipped over the page title itself, and the h1 stayed outside the main
          landmark. */}
      <main id="continut" tabindex="-1">
        <header class="content__header">
          <button class="hamburger" aria-label="Deschide meniul" aria-expanded="false" aria-controls="sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M3 6h18M3 12h18M3 18h18"></path></svg
            >
          </button>
          <div>
            <h1 class="page-title">{title}</h1>
            {lede && <p class="page-lede">{lede}</p>}
          </div>
          <slot name="actiuni" />
        </header>

        {
          DEMO_MODE && (
            <details class="demo-note">
              <summary>
                <strong>Mod demonstrativ activ.</strong> Datele sunt fictive.
              </summary>
              <p>
                Autentificarea fără email este permisă, iar emailurile sunt redirecționate către o
                singură adresă de test.
              </p>
            </details>
          )
        }

        <div class="content__body">
          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import { start, panels } from '../scripts/menu'

  // The sidebar stays on screen at large widths, so it does not get `hidden` —
  // only the class the styles already know.
  start({ button: '.hamburger', panel: '#sidebar', openClass: 'is-open', hide: false })
  panels('details.clopotel')
</script>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    min-height: 100svh;
  }

  /* The sidebar is the second neutral layer: dark, so it does not compete with the content. */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    padding: var(--s-5) var(--s-4);
    background: var(--dark-surface);
    color: var(--dark-ink-soft);
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow-y: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: #fff;
    padding-inline: var(--s-2);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: var(--dark-ink-muted);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-md);
    color: var(--dark-ink-quiet);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 500;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .nav__link svg {
    width: 17px;
    height: 17px;
    flex: none;
    opacity: 0.8;
  }

  .nav__link:hover {
    background: var(--dark-hover);
    color: #fff;
  }

  .nav__link.is-active {
    background: var(--dark-active);
    color: #fff;
    font-weight: 600;
  }
  .nav__link.is-active svg {
    color: var(--dark-accent);
    opacity: 1;
  }

  .nav__link--quiet {
    font-size: var(--t-xs);
    color: var(--dark-ink-muted);
  }

  .sidebar__end {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .user {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-2);
    border-top: 1px solid var(--dark-line);
  }

  .user__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--dark-active);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
    flex: none;
  }

  .user__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
    flex: 1;
  }
  .user__meta strong {
    font-size: var(--t-sm);
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The role is written on one line: with the avatar, the bell and the sign-out
     button in the same 260px sidebar, „Cadru didactic” broke in two. */
  .user__meta small {
    font-size: var(--t-xs);
    color: var(--dark-ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user .btn--ghost {
    color: var(--dark-ink-muted);
    padding: 0 var(--s-2);
  }
  .user .btn--ghost:hover {
    background: var(--dark-hover);
    color: #fff;
  }

  .content {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .shell--fill {
    height: 100dvh;
  }
  .shell--fill .content {
    height: 100dvh;
    overflow: hidden;
  }
  /* `main` sits between `.content` and `.content__body`, and it was missing from
   * the chain.
   *
   * Being `display: block` with `min-height: auto`, it grew with its content: on
   * a thread of forty messages it reached 3904px inside a window of 900, and
   * `.content` — bounded and with `overflow: hidden` — cut off the rest. The
   * messages underneath were not merely below the line: they could not be
   * reached by scrolling the page, nor by scrolling the thread, because the
   * thread no longer had a height to scroll from.
   *
   * It did not show, because the threads in the test data have six messages. */
  .shell--fill main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .shell--fill .content__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .content__header {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-6) var(--s-5);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .content__header > div {
    flex: 1;
    min-width: 0;
  }

  .content__body {
    padding: var(--s-6);
    flex: 1;
  }

  /* Three lines of warning ate a third of a phone screen, every time, to say
     the same thing. The first sentence stays; the rest unfolds on demand. */
  .demo-note {
    margin: var(--s-5) var(--s-6) 0;
    padding: var(--s-3) var(--s-4);
    background: var(--warn-tint);
    color: var(--warn);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
  }
  .demo-note summary {
    cursor: pointer;
    list-style-position: inside;
  }
  .demo-note p {
    margin-top: var(--s-2);
    padding-left: var(--s-4);
  }

  /* The bell sits at the bottom of a dark sidebar: the panel opens upwards,
     otherwise it would fall below the edge of the screen, and the icon takes the
     ink of the dark surface. Its styles are scoped inside the component, so they
     reach it through `:global`. */
  .user :global(.clopotel summary) {
    color: var(--dark-ink-quiet);
  }
  .user :global(.clopotel summary:hover) {
    background: var(--dark-hover);
    color: #fff;
  }
  .user :global(.clopotel__panou) {
    top: auto;
    bottom: calc(100% + var(--s-2));
    right: auto;
    left: 0;
  }

  .nav__grup {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav__grup + .nav__grup {
    margin-top: var(--s-4);
  }

  .nav__grup-titlu {
    padding: 0 var(--s-3) var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dark-ink-muted);
  }

  .paleta-buton {
    width: 100%;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .nav__scurtatura {
    margin-left: auto;
    padding: 1px 5px;
    border: 1px solid var(--dark-line);
    border-radius: var(--r-sm);
    font-family: var(--sans);
    font-size: var(--t-xs);
    color: var(--dark-ink-muted);
  }

  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    cursor: pointer;
    flex: none;
  }
  .hamburger svg {
    width: 18px;
    height: 18px;
  }

  /* Below 900px the thread no longer fills the screen, so the shell is not
   * allowed to cut it.
   *
   * `shell--fill` bounds everything to 100dvh with `overflow: hidden`, while the
   * conversation's phone rule gives it `height: auto` with `min-height: 70vh`:
   * the two fought each other, so a thread of forty messages had its composer
   * below the cut line and nothing scrolled down to it — neither the page nor
   * the thread. On a small screen the page scrolls, as it does everywhere else
   * in the portal. */
  @media (max-width: 900px) {
    .shell--fill,
    .shell--fill .content,
    .shell--fill main,
    .shell--fill .content__body {
      height: auto;
      min-height: 0;
      overflow: visible;
    }
  }

  /* Tablet in portrait: the sidebar shrinks, it does not disappear.
   *
   * Below 900px the navigation became a drawer behind a hamburger — and an iPad
   * in portrait is 810px, that is width enough for eleven icons and the content.
   * Whoever held the tablet upright lost the whole navigation and paid one extra
   * click for every step, for nothing. Below 640px, where it really does not
   * fit, the drawer stays. */
  @media (min-width: 641px) and (max-width: 900px) {
    .shell {
      grid-template-columns: 68px minmax(0, 1fr);
    }
    .sidebar {
      padding: var(--s-4) var(--s-2);
      gap: var(--s-5);
      align-items: center;
    }
    .nav__text,
    .nav__grup-titlu,
    .brand__text,
    .user__meta {
      display: none;
    }
    .nav__link {
      justify-content: center;
      padding: var(--s-3);
    }
    /* The groups stay distinct without titles: a line, not a word. */
    .nav__grup + .nav__grup {
      padding-top: var(--s-3);
      border-top: 1px solid var(--dark-line);
    }
    .brand {
      justify-content: center;
    }
    .user {
      flex-direction: column;
      gap: var(--s-2);
      padding: var(--s-3) 0;
    }
  }

  @media (max-width: 640px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      width: var(--sidebar-w);
      z-index: var(--z-drawer);
      transform: translateX(-100%);
      transition: transform var(--base) var(--ease);
      box-shadow: var(--shadow-overlay);
    }
    .sidebar.is-open {
      transform: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .content__header,
    .content__body {
      padding-inline: var(--s-4);
    }
    /* At phone width a serif display title and an action button cannot share a
       row: the title wraps to three lines and collides with the button. */
    .content__header {
      flex-wrap: wrap;
      gap: var(--s-3);
    }
    .content__header > div {
      flex: 1 1 100%;
      order: 2;
    }
    .content__header :global(.row) {
      order: 3;
      flex: 1 1 100%;
    }
    .content__header .page-title {
      font-size: var(--t-xl);
    }
    .demo-note {
      margin-inline: var(--s-4);
    }
  }
</style>
