---
import '../styles/app.css'
import { currentYearLabel } from '../lib/years'

interface Props {
  title: string
  /** The browser-bar title, for when the page's own is no good as a bookmark. */
  docTitle?: string
  description?: string
}

const { title, docTitle, description } = Astro.props

// The session is named after the year in the database, not after one written
// into the code: otherwise, on the morning the director opens a new year,
// every page title contradicts them.
const yearLabel = await currentYearLabel()

// The suffix stays short: with three tabs open, 45 identical characters make
// them impossible to tell apart. The session is visible in the footer and in
// the sidebar anyway.
const fullTitle = `${docTitle ?? title} · Portal Studenți ASE`
const metaDescription =
  description ?? `Sesiunea de Finalizare a Studiilor ${yearLabel} — Facultatea de Marketing, ASE București`
const site = Astro.site ?? new URL(Astro.url.origin)
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#990000" />
    <meta name="color-scheme" content="light" />

    {/* The link to the portal gets pasted into WhatsApp groups and into Teams
        — what is seen there is the card, not the address. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Portal Studenți · ASE București" />
    <meta property="og:title" content={`${docTitle ?? title} · Portal Studenți`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:locale" content="ro_RO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#continut" class="skip">Sari la conținut</a>

    {/* Every action is a POST that reloads the page. The bar shows that the
        request has left, over the interval in which nothing else on the screen
        changes. */}
    <div class="progres-sus" aria-hidden="true"></div>

    <p class="banner-offline" id="banner-offline" role="status" hidden>
      Ești offline. Ce ai scris rămâne aici — retrimite când revine conexiunea.
    </p>

    <slot />

    {/* Two hosts, two urgencies: confirmations are polite and leave on their
        own, errors interrupt and stay until they are closed. */}
    <div class="toast-host" id="toast-host" aria-live="polite" aria-atomic="false"></div>
    <div class="toast-host toast-host--erori" id="toast-host-erori" role="alert" aria-live="assertive"></div>

    <script>
      import { start as startNotifications } from '../scripts/notifications'
      import { start as startForms } from '../scripts/forms'
      import { start as startNetwork } from '../scripts/network'
      import { start as startDialogs } from '../scripts/dialogs'
      import { start as startValidation } from '../scripts/validation'
      import { startPhoto } from '../scripts/photo'
      import { start as startPalette } from '../scripts/palette'

      declare global {
        interface Window {
          notify: (message: string, kind?: 'info' | 'error') => void
        }
      }

      startNotifications()
      startForms()
      startNetwork()
      startDialogs()
      startValidation()
      // Does nothing on pages without a photo field, so it can live here.
      startPhoto()
      startPalette()
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 999;
        background: var(--red);
        color: #fff;
        padding: 10px 16px;
        border-radius: 0 0 var(--r-md) 0;
        font-weight: 600;
        text-decoration: none;
      }
      .skip:focus {
        left: 0;
        color: #fff;
      }
    </style>
  </body>
</html>
