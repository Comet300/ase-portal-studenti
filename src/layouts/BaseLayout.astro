---
import '../styles/app.css'

interface Props {
  titlu: string
  descriere?: string
}

const { title, description } = Astro.props
const titluComplet = `${titlu} · Portal Studenți — Sesiunea de Finalizare a Studiilor 2026`
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titluComplet}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#990000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23990000'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='16' font-weight='700' fill='white' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a href="#continut" class="skip">Sari la conținut</a>
    <slot />
    <div class="toast-host" id="toast-host" aria-live="polite" aria-atomic="true"></div>

    <script>
      // Un singur mecanism de notificare pentru toată aplicația.
      declare global {
        interface Window {
          notifica: (mesaj: string, tip?: 'info' | 'error') => void
        }
      }

      window.notifica = (mesaj, tip = 'info') => {
        const gazda = document.getElementById('toast-host')
        if (!gazda) return
        const el = document.createElement('div')
        el.className = tip === 'error' ? 'toast toast--error' : 'toast'
        el.textContent = mesaj
        gazda.appendChild(el)
        setTimeout(() => {
          el.style.transition = 'opacity 200ms'
          el.style.opacity = '0'
          setTimeout(() => el.remove(), 220)
        }, 4200)
      }

      // Mesajele venite prin redirect (?notificare=...) se afișează o singură dată.
      const params = new URLSearchParams(location.search)
      const notificare = params.get('notificare')
      if (notificare) {
        window.notifica(notificare, params.get('tip') === 'error' ? 'error' : 'info')
        params.delete('notificare')
        params.delete('tip')
        const rest = params.toString()
        history.replaceState({}, '', location.pathname + (rest ? `?${rest}` : ''))
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 999;
        background: var(--red);
        color: #fff;
        padding: 10px 16px;
        border-radius: 0 0 var(--r-md) 0;
        font-weight: 600;
        text-decoration: none;
      }
      .skip:focus {
        left: 0;
        color: #fff;
      }
    </style>
  </body>
</html>
