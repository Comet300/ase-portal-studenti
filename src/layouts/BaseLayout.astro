---
import '../styles/app.css'
import { currentYearLabel } from '../lib/years'

interface Props {
  title: string
  /** Titlul din bara browserului, când cel din pagină nu e bun de semn de carte. */
  docTitle?: string
  description?: string
}

const { title, docTitle, description } = Astro.props

// Sesiunea se numește după anul din baza de date, nu după unul scris în cod:
// altfel, în dimineața în care directorul deschide un an nou, fiecare titlu de
// pagină îl contrazice.
const sesiune = await currentYearLabel()

// Sufixul rămâne scurt: cu trei file deschise, 45 de caractere identice le fac
// imposibil de deosebit. Sesiunea se vede oricum în subsol și în bara laterală.
const fullTitle = `${docTitle ?? title} · Portal Studenți ASE`
const descriere =
  description ?? `Sesiunea de Finalizare a Studiilor ${sesiune} — Facultatea de Marketing, ASE București`
const site = Astro.site ?? new URL(Astro.url.origin)
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={descriere} />
    <meta name="theme-color" content="#990000" />
    <meta name="color-scheme" content="light" />

    {/* Legătura către portal se lipește în grupuri de WhatsApp și pe Teams —
        acolo se vede cardul, nu adresa. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Portal Studenți · ASE București" />
    <meta property="og:title" content={`${docTitle ?? title} · Portal Studenți`} />
    <meta property="og:description" content={descriere} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:locale" content="ro_RO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#continut" class="skip">Sari la conținut</a>

    {/* Fiecare acțiune este un POST care reîncarcă pagina. Bara arată că cererea
        a plecat, în intervalul în care altfel nu se schimbă nimic pe ecran. */}
    <div class="progres-sus" aria-hidden="true"></div>

    <p class="banner-offline" id="banner-offline" role="status" hidden>
      Ești offline. Ce ai scris rămâne aici — retrimite când revine conexiunea.
    </p>

    <slot />

    {/* Două gazde, două urgențe: confirmările sunt politicoase și pleacă singure,
        erorile întrerup și rămân până sunt închise. */}
    <div class="toast-host" id="toast-host" aria-live="polite" aria-atomic="false"></div>
    <div class="toast-host toast-host--erori" id="toast-host-erori" role="alert" aria-live="assertive"></div>

    <script>
      import { porneste as pornesteNotificari } from '../scripts/notificari'
      import { porneste as pornesteFormulare } from '../scripts/formulare'
      import { porneste as pornesteRetea } from '../scripts/retea'
      import { porneste as pornesteDialoguri } from '../scripts/dialoguri'
      import { porneste as pornesteValidare } from '../scripts/validare'
      import { pornestePoza } from '../scripts/poza'
      import { porneste as pornestePaleta } from '../scripts/paleta'

      declare global {
        interface Window {
          notifica: (mesaj: string, tip?: 'info' | 'error') => void
        }
      }

      pornesteNotificari()
      pornesteFormulare()
      pornesteRetea()
      pornesteDialoguri()
      pornesteValidare()
      // Nu face nimic pe paginile fără câmp de poză, deci poate sta aici.
      pornestePoza()
      pornestePaleta()
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 999;
        background: var(--red);
        color: #fff;
        padding: 10px 16px;
        border-radius: 0 0 var(--r-md) 0;
        font-weight: 600;
        text-decoration: none;
      }
      .skip:focus {
        left: 0;
        color: #fff;
      }
    </style>
  </body>
</html>
