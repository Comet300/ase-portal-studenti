---
import BaseLayout from './BaseLayout.astro'
import Avatar from '../components/Avatar.astro'
import Clopotel from '../components/Clopotel.astro'
import { SCREENS } from '../lib/navigation'
import { currentYearLabel } from '../lib/years'
import { hasApprovedRequest } from '../lib/repo'

interface Props {
  title: string
  /** The title in the browser bar, when the one in the page is no good as a
   * bookmark. */
  docTitle?: string
  description?: string
  active?: string
}

const { title, docTitle, description, active } = Astro.props
const u = Astro.locals.user
const yearLabel = await currentYearLabel()

const hasThesis = u?.role === 'student' && (await hasApprovedRequest(u.id))

/* Every screen in the bar is behind the session gate now, so with no session
 * there is nothing to put in it: the only page this layout still renders for a
 * signed-out visitor is the privacy notice, and there a row of links that all
 * bounce off the gate is seven ways of saying „autentifică-te”. The one way in
 * stays as the button on the right.
 *
 * And once the request is approved, the page is no longer about requests: it is
 * about the thesis, and it is named that way. */
const navLinks = u
  ? [
      { href: '/', text: SCREENS['/'], key: 'acasa' },
      { href: '/coordonatori', text: SCREENS['/coordonatori'], key: 'coordonatori' },
      {
        href: '/cererile-mele',
        text: hasThesis ? 'Lucrarea mea' : SCREENS['/cererile-mele'],
        key: 'cereri',
      },
      { href: '/mesaje', text: SCREENS['/mesaje'], key: 'mesaje' },
      { href: '/consultatii', text: SCREENS['/consultatii'], key: 'consultatii' },
      { href: '/arhiva', text: SCREENS['/arhiva'], key: 'arhiva' },
      { href: '/ghid', text: SCREENS['/ghid'], key: 'ghid' },
    ]
  : []

/* Only in the phone menu: on a small screen the avatar is easily lost, and it
 * is the only road to the account and to signing out. The „Zona cadrelor
 * didactice” button does not fit in the bar beside the mark and the menu — a
 * teacher who opened a student page on a phone pushed the header 89px off the
 * screen. */
const accountLinks = [
  ...(u && u.role !== 'student'
    ? [{ href: '/profesor', text: 'Zona cadrelor didactice', key: 'profesor' }]
    : []),
  { href: '/contul-meu', text: SCREENS['/contul-meu'], key: 'cont' },
]
---

<BaseLayout title={title} docTitle={docTitle} description={description}>
  <header class="topbar">
    <div class="topbar__inner container">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>Portal Studenți</strong>
          <small>Facultatea de Marketing · ASE</small>
        </span>
      </a>

      <nav class="nav" aria-label="Navigație principală">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class:list={['nav__link', { 'is-active': active === l.key }]}
              aria-current={active === l.key ? 'page' : undefined}
            >
              {l.text}
            </a>
          ))
        }
      </nav>

      <div class="topbar__end">
        {
          u ? (
            <>
              {(u.role === 'teacher' || u.role === 'head') && (
                <a href="/profesor" class="btn btn--secondary btn--sm">
                  Zona cadrelor didactice
                </a>
              )}
              <Clopotel messagesBase="/mesaje" />

              {/* The avatar was a 34px link, with no name and no label, and
                  signing out existed nowhere on desktop: it was reached only
                  through the account page. The same `<details>` mechanics as
                  at the year picker — without JavaScript. */}
              <details class="cont">
                <summary class="cont__buton" aria-label={`Meniul contului, ${u.name}`}>
                  <Avatar name={u.name} src={u.avatar_path} />
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>

                <div class="cont__panou">
                  <p class="cont__cine">
                    <strong>{u.name}</strong>
                    <small>{u.email}</small>
                  </p>
                  {/* Ctrl+K is not discovered on its own, and the top bar has
                      no room for one more button: it goes into the account
                      menu, where the things that are not navigation are looked
                      for anyway. */}
                  <button class="cont__optiune" type="button" data-paleta>
                    Mergi la… <kbd class="cont__scurtatura">⌘K</kbd>
                  </button>
                  <a class="cont__optiune" href="/contul-meu">Contul meu</a>
                  <a class="cont__optiune" href={`/profil/${u.id}`}>Profilul public</a>
                  <form method="POST" action="/api/deconectare">
                    <button class="cont__optiune cont__optiune--iesire" type="submit">
                      Deconectare
                    </button>
                  </form>
                </div>
              </details>
            </>
          ) : (
            <a href="/autentificare" class="btn btn--primary btn--sm">
              Autentificare
            </a>
          )
        }
        {/* With no session the drawer has nothing in it: the button opened an
            empty panel over the page. */}
        {u && (
          <button class="hamburger" aria-label="Deschide meniul" aria-expanded="false" aria-controls="meniu-mobil">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
          </button>
        )}
      </div>
    </div>

    <nav class="meniu-mobil" id="meniu-mobil" aria-label="Navigație mobilă" hidden>
      {
        [...navLinks, ...(u ? accountLinks : [])].map((l) => (
          <a
            href={l.href}
            class:list={['meniu-mobil__link', { 'is-active': active === l.key }]}
            aria-current={active === l.key ? 'page' : undefined}
          >
            {l.text}
          </a>
        ))
      }
      {/* Signing out has to exist here as well: on a phone the menu is the
          only place from which it is reached. */}
      {u && (
        <form method="POST" action="/api/deconectare">
          <button class="meniu-mobil__link meniu-mobil__iesire" type="submit">Deconectare</button>
        </form>
      )}
    </nav>
  </header>

  <main id="continut">
    <slot />
  </main>

  <footer class="footer">
    <div class="container row row--between row--wrap" style="gap:var(--s-4)">
      <p class="muted text-sm">
        Academia de Studii Economice din București · Facultatea de Marketing
      </p>
      <p class="muted text-sm">
        Sesiunea de Finalizare a Studiilor {yearLabel}
      </p>
      {/* The privacy notice has to be findable from any page. */}
      <a class="muted text-sm link" href="/confidentialitate">Confidențialitate</a>
    </div>
  </footer>
</BaseLayout>

<script>
  import { start, panels } from '../scripts/menu'

  start({ button: '.hamburger', panel: '#meniu-mobil' })
  panels('details.cont')
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--topbar-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
    /* `flex: none` on both ends meant the bar could not shrink below their
       sum: on a phone it overflowed the screen instead of tightening up. */
    min-width: 0;
  }
  .brand__text strong,
  .brand__text small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .nav {
    display: flex;
    gap: var(--s-1);
    margin-left: auto;
  }

  .nav__link {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .nav__link:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  /* The current state is marked in red — the seal, not decoration. */
  .nav__link.is-active {
    color: var(--red);
    font-weight: 600;
  }

  .topbar__end {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-left: auto;
    flex: none;
  }

  /* --- the account menu --------------------------------------------------- */

  .cont {
    position: relative;
    flex: none;
  }

  .cont__buton {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    min-height: var(--tap);
    padding-right: var(--s-1);
    border-radius: var(--r-md);
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
  }
  .cont__buton::-webkit-details-marker {
    display: none;
  }
  .cont__buton svg {
    width: 14px;
    height: 14px;
    transition: transform var(--fast) var(--ease);
  }
  .cont[open] .cont__buton svg {
    transform: rotate(180deg);
  }

  .cont__panou {
    position: absolute;
    top: calc(100% + var(--s-1));
    right: 0;
    z-index: var(--z-drawer);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-overlay);
    overflow: hidden;
  }

  .cont__cine {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
  }
  .cont__cine strong {
    font-size: var(--t-sm);
  }
  .cont__cine small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cont__scurtatura {
    float: right;
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-family: var(--sans);
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .cont__optiune {
    display: block;
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .cont__optiune:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .cont__optiune--iesire {
    border-top: 1px solid var(--border);
    color: var(--danger);
  }

  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    cursor: pointer;
  }
  .hamburger svg {
    width: 18px;
    height: 18px;
  }

  /* A panel that comes in from the edge, not a list that appears abruptly
     under the bar. */
  .meniu-mobil {
    display: none;
    flex-direction: column;
    padding: var(--s-4) var(--s-5) var(--s-6);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .meniu-mobil {
      position: fixed;
      inset: var(--topbar-h) 0 auto 0;
      z-index: var(--z-drawer);
      max-height: calc(100dvh - var(--topbar-h));
      overflow-y: auto;
      background: var(--surface);
      box-shadow: var(--shadow-overlay);
      transform: translateY(-8px);
      opacity: 0;
      transition:
        transform var(--base) var(--ease),
        opacity var(--base) var(--ease);
    }
    .meniu-mobil.is-deschis {
      transform: none;
      opacity: 1;
    }
  }

  .meniu-mobil__link {
    min-height: var(--tap);
    display: flex;
    align-items: center;
  }

  .meniu-mobil__iesire {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    font: inherit;
    font-weight: 500;
    color: var(--danger);
    text-align: left;
    cursor: pointer;
  }

  .meniu-mobil__link {
    padding: var(--s-3) var(--s-2);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .meniu-mobil__link.is-active {
    color: var(--red);
    font-weight: 600;
  }

  main {
    min-height: calc(100dvh - var(--topbar-h) - 72px);
    padding-block: var(--s-6) var(--s-7);
  }

  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--s-5);
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .meniu-mobil:not([hidden]) {
      display: flex;
    }
    .brand__text small {
      display: none;
    }
    /* „Zona cadrelor didactice” moves into the menu: beside the mark, the
       avatar and the hamburger it did not fit, and it pushed the header off
       the screen. */
    .topbar__end .btn--secondary {
      display: none;
    }
  }
</style>
