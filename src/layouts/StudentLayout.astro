---
import BaseLayout from './BaseLayout.astro'
import Avatar from '../components/Avatar.astro'
import Clopotel from '../components/Clopotel.astro'
import { ECRANE } from '../lib/navigare'
import { currentYearLabel } from '../lib/years'
import { hasApprovedRequest } from '../lib/repo'

interface Props {
  title: string
  /** Titlul din bara browserului, când cel din pagină nu e bun de semn de carte. */
  docTitle?: string
  description?: string
  active?: string
}

const { title, docTitle, description, active } = Astro.props
const u = Astro.locals.user
const sesiune = await currentYearLabel()

const areLucrare = u?.role === 'student' && (await hasApprovedRequest(u.id))

/* Un vizitator primea în bară patru legături care îl trimiteau direct în ecranul
 * de autentificare — inclusiv „Cererile Mele”, care pentru el nu înseamnă nimic.
 * Tot ce cere sesiune stă acum într-un singur loc, în spatele lui `u`.
 *
 * Iar odată ce cererea e aprobată, pagina nu mai este despre cereri: este despre
 * lucrare, și se numește așa. */
const linkuri = [
  { href: '/', text: ECRANE['/'], cheie: 'acasa' },
  { href: '/coordonatori', text: ECRANE['/coordonatori'], cheie: 'coordonatori' },
  ...(u
    ? [
        {
          href: '/cererile-mele',
          text: areLucrare ? 'Lucrarea mea' : ECRANE['/cererile-mele'],
          cheie: 'cereri',
        },
        { href: '/mesaje', text: ECRANE['/mesaje'], cheie: 'mesaje' },
        { href: '/consultatii', text: ECRANE['/consultatii'], cheie: 'consultatii' },
        { href: '/arhiva', text: ECRANE['/arhiva'], cheie: 'arhiva' },
      ]
    : []),
  { href: '/ghid', text: ECRANE['/ghid'], cheie: 'ghid' },
]

/* Doar în meniul de telefon: pe ecran mic avatarul se pierde ușor, iar el este
 * singurul drum către cont și deconectare. Butonul „Zona cadrelor didactice” nu
 * încape în bară alături de marcă și de meniu — un cadru didactic care deschidea
 * o pagină de student pe telefon împingea antetul cu 89px în afara ecranului. */
const linkuriCont = [
  ...(u && u.role !== 'student'
    ? [{ href: '/profesor', text: 'Zona cadrelor didactice', cheie: 'profesor' }]
    : []),
  { href: '/contul-meu', text: ECRANE['/contul-meu'], cheie: 'cont' },
]
---

<BaseLayout title={title} docTitle={docTitle} description={description}>
  <header class="topbar">
    <div class="topbar__inner container">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span class="brand__text">
          <strong>Portal Studenți</strong>
          <small>Facultatea de Marketing · ASE</small>
        </span>
      </a>

      <nav class="nav" aria-label="Navigație principală">
        {
          linkuri.map((l) => (
            <a
              href={l.href}
              class:list={['nav__link', { 'is-active': active === l.cheie }]}
              aria-current={active === l.cheie ? 'page' : undefined}
            >
              {l.text}
            </a>
          ))
        }
      </nav>

      <div class="topbar__end">
        {
          u ? (
            <>
              {(u.role === 'teacher' || u.role === 'head') && (
                <a href="/profesor" class="btn btn--secondary btn--sm">
                  Zona cadrelor didactice
                </a>
              )}
              <Clopotel baseMesaje="/mesaje" />

              {/* Avatarul era un link de 34px, fără nume și fără etichetă, iar
                  deconectarea nu exista nicăieri pe desktop: se ajungea la ea
                  doar prin pagina contului. Aceeași mecanică de `<details>` ca
                  la selectorul de an — fără JavaScript. */}
              <details class="cont">
                <summary class="cont__buton" aria-label={`Meniul contului, ${u.name}`}>
                  <Avatar name={u.name} src={u.avatar_path} />
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>

                <div class="cont__panou">
                  <p class="cont__cine">
                    <strong>{u.name}</strong>
                    <small>{u.email}</small>
                  </p>
                  <a class="cont__optiune" href="/contul-meu">Contul meu</a>
                  <a class="cont__optiune" href={`/profil/${u.id}`}>Profilul public</a>
                  <form method="POST" action="/api/deconectare">
                    <button class="cont__optiune cont__optiune--iesire" type="submit">
                      Deconectare
                    </button>
                  </form>
                </div>
              </details>
            </>
          ) : (
            <a href="/autentificare" class="btn btn--primary btn--sm">
              Autentificare
            </a>
          )
        }
        <button class="hamburger" aria-label="Deschide meniul" aria-expanded="false" aria-controls="meniu-mobil">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M3 6h18M3 12h18M3 18h18"></path></svg
          >
        </button>
      </div>
    </div>

    <nav class="meniu-mobil" id="meniu-mobil" aria-label="Navigație mobilă" hidden>
      {
        [...linkuri, ...(u ? linkuriCont : [])].map((l) => (
          <a
            href={l.href}
            class:list={['meniu-mobil__link', { 'is-active': active === l.cheie }]}
            aria-current={active === l.cheie ? 'page' : undefined}
          >
            {l.text}
          </a>
        ))
      }
      {/* Deconectarea trebuie să existe și aici: pe telefon meniul este singurul
          loc în care se ajunge la ea. */}
      {u && (
        <form method="POST" action="/api/deconectare">
          <button class="meniu-mobil__link meniu-mobil__iesire" type="submit">Deconectare</button>
        </form>
      )}
    </nav>
  </header>

  <main id="continut">
    <slot />
  </main>

  <footer class="footer">
    <div class="container row row--between row--wrap" style="gap:var(--s-4)">
      <p class="muted text-sm">
        Academia de Studii Economice din București · Facultatea de Marketing
      </p>
      <p class="muted text-sm">
        Sesiunea de Finalizare a Studiilor {sesiune}
      </p>
      {/* Nota de informare trebuie să fie găsibilă de pe orice pagină. */}
      <a class="muted text-sm link" href="/confidentialitate">Confidențialitate</a>
    </div>
  </footer>
</BaseLayout>

<script>
  import { porneste, panouri } from '../scripts/meniu'

  porneste({ buton: '.hamburger', panou: '#meniu-mobil' })
  panouri('details.cont')
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: var(--topbar-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
    /* `flex: none` pe ambele capete însemna că bara nu putea scădea sub suma
       lor: pe telefon depășea ecranul în loc să se strângă. */
    min-width: 0;
  }
  .brand__text strong,
  .brand__text small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: var(--red);
    color: #fff;
    border-radius: var(--r-md);
    font-family: var(--serif);
    font-weight: 700;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .brand__text strong {
    font-family: var(--serif);
    font-size: var(--t-md);
  }
  .brand__text small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .nav {
    display: flex;
    gap: var(--s-1);
    margin-left: auto;
  }

  .nav__link {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }

  .nav__link:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  /* Starea curentă este marcată cu roșu — sigiliul, nu decor. */
  .nav__link.is-active {
    color: var(--red);
    font-weight: 600;
  }

  .topbar__end {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-left: auto;
    flex: none;
  }

  /* --- meniul contului ----------------------------------------------------- */

  .cont {
    position: relative;
    flex: none;
  }

  .cont__buton {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    min-height: var(--tap);
    padding-right: var(--s-1);
    border-radius: var(--r-md);
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
  }
  .cont__buton::-webkit-details-marker {
    display: none;
  }
  .cont__buton svg {
    width: 14px;
    height: 14px;
    transition: transform var(--fast) var(--ease);
  }
  .cont[open] .cont__buton svg {
    transform: rotate(180deg);
  }

  .cont__panou {
    position: absolute;
    top: calc(100% + var(--s-1));
    right: 0;
    z-index: var(--z-drawer);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-overlay);
    overflow: hidden;
  }

  .cont__cine {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
  }
  .cont__cine strong {
    font-size: var(--t-sm);
  }
  .cont__cine small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cont__optiune {
    display: block;
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--ink-soft);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .cont__optiune:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .cont__optiune--iesire {
    border-top: 1px solid var(--border);
    color: var(--danger);
  }

  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    cursor: pointer;
  }
  .hamburger svg {
    width: 18px;
    height: 18px;
  }

  /* Un panou care intră dinspre margine, nu o listă care apare brusc sub bară. */
  .meniu-mobil {
    display: none;
    flex-direction: column;
    padding: var(--s-4) var(--s-5) var(--s-6);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .meniu-mobil {
      position: fixed;
      inset: var(--topbar-h) 0 auto 0;
      z-index: var(--z-drawer);
      max-height: calc(100dvh - var(--topbar-h));
      overflow-y: auto;
      background: var(--surface);
      box-shadow: var(--shadow-overlay);
      transform: translateY(-8px);
      opacity: 0;
      transition:
        transform var(--base) var(--ease),
        opacity var(--base) var(--ease);
    }
    .meniu-mobil.is-deschis {
      transform: none;
      opacity: 1;
    }
  }

  .meniu-mobil__link {
    min-height: var(--tap);
    display: flex;
    align-items: center;
  }

  .meniu-mobil__iesire {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    font: inherit;
    font-weight: 500;
    color: var(--danger);
    text-align: left;
    cursor: pointer;
  }

  .meniu-mobil__link {
    padding: var(--s-3) var(--s-2);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .meniu-mobil__link.is-active {
    color: var(--red);
    font-weight: 600;
  }

  main {
    min-height: calc(100dvh - var(--topbar-h) - 72px);
    padding-block: var(--s-6) var(--s-7);
  }

  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--s-5);
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .meniu-mobil:not([hidden]) {
      display: flex;
    }
    .brand__text small {
      display: none;
    }
    /* „Zona cadrelor didactice” trece în meniu: alături de marcă, avatar și
       hamburger nu încăpea, și împingea antetul în afara ecranului. */
    .topbar__end .btn--secondary {
      display: none;
    }
  }
</style>
