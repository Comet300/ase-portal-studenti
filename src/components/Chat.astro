---
import Avatar from './Avatar.astro'
import type { Conversation, Message } from '../lib/chat'
import { formatTime, shortMonth, timeAgo } from '../lib/repo'
import { ACCEPT } from '../lib/files'

/**
 * Events are things the portal did — a decision, an invitation, a scheduled
 * consultation. They live in the thread because that is where someone will look
 * for them a month later, but they must never read as the other person typing:
 * full width, centred, marked, and never in the "mine" colour.
 */
const EVENT_LABELS: Record<string, string> = {
  request_approved: 'Cerere aprobată',
  request_rejected: 'Cerere respinsă',
  request_expired: 'Cerere expirată',
  request_withdrawn: 'Cerere retrasă',
  invitation_sent: 'Propunere de coordonare',
  invitation_accepted: 'Propunere acceptată',
  invitation_declined: 'Propunere refuzată',
  consultation_scheduled: 'Consultație programată',
  consultation_cancelled: 'Consultație anulată',
  /* „Locuri alocate” a fost scos: nimic nu îl scrie niciodată. Locurile se
     acordă între director și coordonator, iar firele de discuție ale portalului
     sunt (student, coordonator) — evenimentul nu ar avea unde să existe. Anunțul
     rămâne pe email și pe ecranul de locuri. */
}

const EVENT_TONE: Record<string, string> = {
  request_approved: 'is-bine',
  invitation_accepted: 'is-bine',
  request_rejected: 'is-rau',
  request_expired: 'is-rau',
  invitation_declined: 'is-rau',
  consultation_cancelled: 'is-rau',
}

export interface ChatFile {
  id: string
  original_name: string
  size_label: string
  created_at: string
  uploaded_by: string
}

interface Props {
  conversations: Conversation[]
  active: Conversation | null
  messages: Message[]
  /** Everything exchanged in the open thread, newest first. */
  files?: ChatFile[]
  userId: string
  base: string
  emptyText: string
  /** Renders a third column when the caller provides `slot="context"`. */
  hasContext?: boolean
}

const {
  conversations,
  active,
  messages,
  files = [],
  userId,
  base,
  emptyText,
  hasContext = false,
} = Astro.props

/** Messages are grouped by day, the way a messaging app does it. */
type Bucata = Message & { continuare: boolean; ultimulDinGrup: boolean }

const days: { label: string; items: Bucata[] }[] = []
const today = new Date().toDateString()
const yesterday = new Date(Date.now() - 86400000).toDateString()

const PAUZA = 5 * 60 * 1000

for (const [i, m] of messages.entries()) {
  const d = new Date(m.created_at)
  const key = d.toDateString()
  const label =
    key === today ? 'Astăzi' : key === yesterday ? 'Ieri' : `${d.getDate()} ${shortMonth(m.created_at)}`

  /* Cinci replici la rând de la același om erau cinci cutii identice, fiecare
   * cu ora ei. Se leagă într-un bloc: doar ultima poartă ora, iar cele din
   * mijloc pierd coada și marginea. */
  const anterior = messages[i - 1]
  const urmator = messages[i + 1]
  const acelasiGrup = (a: Message | undefined, b: Message) =>
    !!a &&
    a.kind === 'text' &&
    b.kind === 'text' &&
    a.sender_id === b.sender_id &&
    new Date(a.created_at).toDateString() === new Date(b.created_at).toDateString() &&
    Math.abs(new Date(b.created_at).getTime() - new Date(a.created_at).getTime()) < PAUZA

  const bucata: Bucata = {
    ...m,
    continuare: m.kind === 'text' && acelasiGrup(anterior, m),
    ultimulDinGrup: m.kind !== 'text' || !acelasiGrup(m, urmator ?? m) || !urmator,
  }

  const last = days.at(-1)
  if (last?.label === label) last.items.push(bucata)
  else days.push({ label, items: [bucata] })
}

/** Tipurile pe care browserul le poate arăta în siguranță chiar în fir. */
const PREVIZUALIZABILE = ['image/png', 'image/jpeg', 'image/webp', 'image/gif']

const INCEPUTURI = [
  'Bună ziua! Mă bucur că lucrăm împreună.',
  'Am o întrebare despre structura lucrării.',
  'Am atașat prima versiune a capitolului.',
]
---

<div class:list={['chat', { 'chat--cu-context': hasContext }]} data-has-thread={active ? '' : undefined}>
  <aside class="chat__list" aria-label="Conversații">
    {
      conversations.length === 0 ? (
        <p class="chat__empty">{emptyText}</p>
      ) : (
        <ul>
          {conversations.map((c) => (
            <li>
              <a href={`${base}?conversatie=${c.id}`} class:list={['thread', { 'is-active': active?.id === c.id }]}>
                <Avatar name={c.peer_name} src={c.peer_avatar} size="md" />
                <span class="thread__body">
                  <span class="thread__top">
                    <strong>{c.peer_name}</strong>
                    <small>{c.last_message_at ? timeAgo(c.last_message_at) : ''}</small>
                  </span>
                  <span class="thread__preview">{c.last_message ?? 'Niciun mesaj încă'}</span>
                </span>
                {c.unread > 0 && <span class="thread__badge numeric">{c.unread}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </aside>

  <section class="chat__thread">
    {/* Ținta pentru fișierele trase peste fir. Stă peste tot firul, nu peste un
        colț: la o conversație lungă, o zonă mică e imposibil de nimerit. */}
    <div class="chat__drop" aria-hidden="true">
      <span>Lasă fișierul aici ca să îl atașezi</span>
    </div>

    {
      active ? (
        <>
          <header class="chat__header">
            {/* Pe telefon lista de conversații se ascunde ca să încapă firul, și
                nu mai exista niciun drum înapoi la ea în afară de butonul
                browserului: firul arăta ca toată pagina. */}
            <a class="chat__inapoi" href={base} aria-label="Toate conversațiile">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </a>
            <Avatar name={active.peer_name} src={active.peer_avatar} href={`/profil/${active.peer_id}`} />
            <span class="chat__peer">
              <strong>{active.peer_name}</strong>
              {active.peer_detail && <small class="muted">{active.peer_detail}</small>}
            </span>

            {/* Contextul lucrării — titlu, termene, coordonator — este a treia
                coloană doar peste 1200px. Sub această lățime era pur și simplu
                `display:none`, deci pe tabletă și pe telefon nu exista nicio cale
                la el: exact acolo unde firul are cea mai mare nevoie de el, fiind
                singurul lucru de pe ecran. Devine un sertar, ca fișierele. */}
            {hasContext && (
              <button class="chat__fisiere-buton chat__context-buton" type="button" id="comuta-context" aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                Lucrarea
              </button>
            )}

            <button class="chat__fisiere-buton" type="button" id="comuta-fisiere" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M4 4h5l2 2h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
              </svg>
              Fișiere
              {files.length > 0 && <span class="chat__fisiere-contor numeric">{files.length}</span>}
            </button>
          </header>

          <div class="chat__messages" id="chat-messages">
            {messages.length === 0 && (
              /* Un fir gol cere un început, nu o explicație. */
              <div class="chat__inceput">
                <p class="empty__title">Scrie primul mesaj</p>
                <p class="empty__text">
                  {active?.peer_name.split(' ').slice(-1)[0]} primește o notificare pe email dacă nu
                  este în portal.
                </p>
                <div class="chat__sugestii">
                  {INCEPUTURI.map((text) => (
                    <button class="chat__sugestie" type="button" data-inceput={text}>
                      {text}
                    </button>
                  ))}
                </div>
              </div>
            )}

            {days.map((day) => (
              <>
                <p class="chat__day"><span>{day.label}</span></p>
                {day.items.map((m) =>
                  m.kind === 'event' ? (
                    <article class:list={['eveniment', EVENT_TONE[m.event_type ?? ''] ?? '']}>
                      <span class="eveniment__eticheta">
                        {EVENT_LABELS[m.event_type ?? ''] ?? 'Actualizare'}
                      </span>
                      <p class="eveniment__corp">{m.body}</p>
                      <time class="eveniment__ora numeric" datetime={m.created_at}>
                        {formatTime(m.created_at)}
                      </time>
                    </article>
                  ) : (
                  <article
                    class:list={[
                      'bubble',
                      {
                        'bubble--mine': m.sender_id === userId,
                        'bubble--continuare': m.continuare,
                      },
                    ]}
                    id={m.id === messages.at(-1)?.id ? 'ultim-mesaj' : undefined}
                  >
                    {/* Rândurile scrise înainte de această schimbare mai poartă
                        vechiul text de umplutură; nu are ce căuta într-o bulă. */}
                    {m.body && m.body !== '(fișier atașat)' && <p class="bubble__body">{m.body}</p>}

                    {m.file_id &&
                      (PREVIZUALIZABILE.includes(m.file_mime ?? '') ? (
                        /* O imagine numită prin fișierul ei este o imagine pe care
                           nu o vezi. Se arată; clic o deschide întreagă. */
                        <a class="bubble__imagine" href={`/fisiere/${m.file_id}?inline=1`} target="_blank" rel="noopener">
                          <img src={`/fisiere/${m.file_id}?inline=1`} alt={m.file_name ?? 'Imagine atașată'} loading="lazy" />
                        </a>
                      ) : (
                        <a class="bubble__file" href={`/fisiere/${m.file_id}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                          </svg>
                          {m.file_name}
                        </a>
                      ))}

                    {m.ultimulDinGrup && (
                      <span class="bubble__time numeric">
                        <time datetime={m.created_at} title={formatTime(m.created_at)}>
                          {formatTime(m.created_at)}
                        </time>
                        {/* Starea de citit era deja în baza de date și nu o vedea
                            nimeni. O bifă: trimis. Două: citit. */}
                        {m.sender_id === userId && (
                          <span class="bubble__stare" title={m.read_at ? `Văzut ${formatTime(m.read_at)}` : 'Trimis'}>
                            {m.read_at ? '✓✓' : '✓'}
                          </span>
                        )}
                      </span>
                    )}
                  </article>
                  ),
                )}
              </>
            ))}
          </div>

          {/* Când conversația e derulată în sus, mesajul nou ajunge sub margine
              fără niciun semn. Pilula spune că s-a întâmplat ceva jos. */}
          <button class="chat__noi" type="button" id="mesaje-noi" hidden>
            Mesaje mai noi ↓
          </button>

          {/* Ceva a sosit cât timp firul era deschis. Pagina nu se schimbă sub
              mână — apeși dacă vrei să vezi. */}
          <button class="chat__noi chat__noi--primite" type="button" id="mesaje-primite" hidden></button>

          {/* Toate fișierele firului, în ordine cronologică. Stă peste conversație
              ca un sertar, ca să nu fure lățime când nu e nevoie de el. */}
          <aside class="fisiere-drawer" id="fisiere-drawer" role="dialog" aria-modal="false" aria-label="Fișiere din conversație" hidden>
            <div class="fisiere-drawer__cap">
              <strong>Fișiere din conversație</strong>
              <button class="btn btn--ghost btn--sm" type="button" id="inchide-fisiere" aria-label="Închide">✕</button>
            </div>

            {files.length > 4 && (
              <div class="fisiere-drawer__cauta">
                <input
                  class="input"
                  type="search"
                  id="cauta-fisier"
                  placeholder="Caută după nume…"
                  aria-label="Caută un fișier"
                />
              </div>
            )}

            {files.length === 0 ? (
              <p class="fisiere-drawer__gol">
                Niciun fișier încă. Atașează unul cu agrafa de lângă câmpul de mesaj.
              </p>
            ) : (
              <ul class="fisiere-drawer__lista">
                <li class="fisiere-drawer__gol" id="fisiere-fara-rezultat" hidden>
                  Niciun fișier cu numele acesta.
                </li>
                {files.map((f) => (
                  <li data-nume-fisier={f.original_name.toLowerCase()}>
                    <a class="fisier" href={`/fisiere/${f.id}`}>
                      <span class="fisier__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" />
                        </svg>
                      </span>
                      <span class="fisier__corp">
                        <strong>{f.original_name}</strong>
                        <small class="muted">
                          {[f.size_label, timeAgo(f.created_at)].filter(Boolean).join(' · ')}
                          {f.uploaded_by === userId ? ' · trimis de tine' : ''}
                        </small>
                      </span>
                      <svg class="fisier__descarca" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M12 3v12M7 12l5 5 5-5M4 21h16" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </aside>

          <form class="chat__compose" method="POST" action="/api/mesaje" enctype="multipart/form-data">
            <input type="hidden" name="conversation_id" value={active.id} />
            <input type="hidden" name="redirect" value={`${base}?conversatie=${active.id}`} />

            {/* Butonul este un buton, nu o etichetă: o etichetă nu primește
                focus de la tastatură, deci atașarea unui fișier era imposibilă
                fără mouse. Câmpul rămâne în pagină, ascuns vizual dar accesibil. */}
            <input type="file" name="file" class="visually-hidden" id="camp-fisier" accept={ACCEPT} />
            <button class="attach" type="button" id="alege-fisier">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              <span class="visually-hidden">Atașează un fișier</span>
            </button>

            <div class="chat__camp">
              {/* Fișierul ales se vede înainte de trimitere: altfel nu ai cum să
                  știi că s-a atașat, nici cum să te răzgândești. Bara de jos
                  arată cât a urcat, iar „✕” devine „oprește” cât timp urcă. */}
              <div class="atasament" id="atasament" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" />
                </svg>
                <span class="atasament__corp">
                  <strong id="atasament-nume"></strong>
                  <small class="muted" id="atasament-marime"></small>
                </span>
                <button class="atasament__scoate" type="button" id="scoate-atasament" aria-label="Elimină fișierul">✕</button>
                <span class="atasament__bara" id="atasament-bara"></span>
              </div>

              <textarea class="chat__input" name="body" rows="1" placeholder="Scrie un mesaj…" aria-label="Mesaj" data-autogrow></textarea>
            </div>

            <button class="btn btn--primary" type="submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
              </svg>
              <span class="chat__send-label">Trimite</span>
            </button>
          </form>
        </>
      ) : (
        <div class="empty" style="margin:auto">
          <p class="empty__title">Alege o conversație</p>
          <p class="empty__text">{emptyText}</p>
        </div>
      )
    }
  </section>

  {
    hasContext && (
      <aside class="chat__context" id="chat-context">
        {/* Închide sertarul; la lățime mare butonul nu se vede deloc, pentru că
            acolo coloana este mereu deschisă. */}
        <button class="chat__context-inchide" type="button" id="inchide-context" aria-label="Închide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
        <slot name="context" />
      </aside>
    )
  }
</div>

<script>
  import { porneste } from '../scripts/chat'

  porneste()
</script>

<style>
  .chat {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    /* Fills whatever the page gives it. The old `calc(100vh - 210px)` guessed
       at the chrome above and overflowed the professor layout. */
    height: 100%;
    min-height: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .chat__list {
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }
  .chat__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chat__empty {
    padding: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .thread {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--fast) var(--ease);
  }
  .thread:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .thread.is-active {
    background: var(--red-tint);
  }

  .thread__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .thread__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .thread__top strong {
    font-size: var(--t-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .thread__top small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    flex: none;
  }

  .thread__preview {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thread__badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
    flex: none;
  }

  .chat--cu-context {
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr) minmax(260px, 320px);
  }

  .chat__context {
    border-left: 1px solid var(--border);
    overflow-y: auto;
    background: var(--surface);
    min-width: 0;
  }

  .chat__thread {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    /* Fără această linie, minimul automat al unui element flex este dat de
       conținut: firul crește peste celula lui de grilă, lista de mesaje nu mai
       derulează niciodată, iar `.chat { overflow: hidden }` taie zona de scris
       sub marginea de jos. Pe telefon nu se vedea, pentru că regula de mai jos
       îi dă o înălțime explicită. */
    min-height: 0;
    background: var(--bg);
  }

  .chat__header {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .chat__peer {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .chat__peer strong {
    font-size: var(--t-sm);
  }
  .chat__peer small {
    font-size: var(--t-xs);
  }

  .chat__messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .chat__day {
    align-self: center;
    margin-block: var(--s-3);
  }
  .chat__day span {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-sunken);
    color: var(--ink-muted);
    font-size: var(--t-xs);
  }

  .bubble {
    align-self: flex-start;
    max-width: min(72ch, 78%);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    /* Colțurile aproape drepte ale portalului sunt potrivite pentru un formular
       instituțional; într-o conversație arătau ca niște celule de tabel. */
    border-radius: 14px;
    border-bottom-left-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  /* Replicile proprii erau roșu plin — adică sigiliul instituției pe jumătate
     din suprafața ecranului, într-un loc care e mobilier, nu acțiune. Rămâne
     aceeași familie de culoare, la intensitatea care distinge fără să domine. */
  .bubble--mine {
    align-self: flex-end;
    background: var(--red-tint);
    border-color: #f3d9d5;
    color: var(--ink);
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: var(--r-sm);
  }

  /* Cinci replici la rând de la același om se citesc ca un bloc, nu ca cinci
     cutii: continuarea pierde coada și se lipește de cea de dinainte. */
  .bubble--continuare {
