---
import Avatar from './Avatar.astro'
import type { Conversation, Message } from '../lib/chat'
import { formatTime, shortMonth, timeAgo } from '../lib/repo'

/**
 * Events are things the portal did — a decision, an invitation, a scheduled
 * consultation. They live in the thread because that is where someone will look
 * for them a month later, but they must never read as the other person typing:
 * full width, centred, marked, and never in the "mine" colour.
 */
const EVENT_LABELS: Record<string, string> = {
  request_approved: 'Cerere aprobată',
  request_rejected: 'Cerere respinsă',
  request_expired: 'Cerere expirată',
  request_withdrawn: 'Cerere retrasă',
  invitation_sent: 'Propunere de coordonare',
  invitation_accepted: 'Propunere acceptată',
  invitation_declined: 'Propunere refuzată',
  consultation_scheduled: 'Consultație programată',
  seats_granted: 'Locuri alocate',
}

const EVENT_TONE: Record<string, string> = {
  request_approved: 'is-bine',
  invitation_accepted: 'is-bine',
  request_rejected: 'is-rau',
  request_expired: 'is-rau',
  invitation_declined: 'is-rau',
}

export interface ChatFile {
  id: string
  original_name: string
  size_label: string
  created_at: string
  uploaded_by: string
}

interface Props {
  conversations: Conversation[]
  active: Conversation | null
  messages: Message[]
  /** Everything exchanged in the open thread, newest first. */
  files?: ChatFile[]
  userId: string
  base: string
  emptyText: string
  /** Renders a third column when the caller provides `slot="context"`. */
  hasContext?: boolean
}

const {
  conversations,
  active,
  messages,
  files = [],
  userId,
  base,
  emptyText,
  hasContext = false,
} = Astro.props

/** Messages are grouped by day, the way a messaging app does it. */
const days: { label: string; items: Message[] }[] = []
const today = new Date().toDateString()
const yesterday = new Date(Date.now() - 86400000).toDateString()

for (const m of messages) {
  const d = new Date(m.created_at)
  const key = d.toDateString()
  const label =
    key === today ? 'Astăzi' : key === yesterday ? 'Ieri' : `${d.getDate()} ${shortMonth(m.created_at)}`
  const last = days.at(-1)
  if (last?.label === label) last.items.push(m)
  else days.push({ label, items: [m] })
}
---

<div class:list={['chat', { 'chat--cu-context': hasContext }]} data-has-thread={active ? '' : undefined}>
  <aside class="chat__list" aria-label="Conversații">
    {
      conversations.length === 0 ? (
        <p class="chat__empty">{emptyText}</p>
      ) : (
        <ul>
          {conversations.map((c) => (
            <li>
              <a href={`${base}?conversatie=${c.id}`} class:list={['thread', { 'is-active': active?.id === c.id }]}>
                <Avatar name={c.peer_name} src={c.peer_avatar} size="md" />
                <span class="thread__body">
                  <span class="thread__top">
                    <strong>{c.peer_name}</strong>
                    <small>{c.last_message_at ? timeAgo(c.last_message_at) : ''}</small>
                  </span>
                  <span class="thread__preview">{c.last_message ?? 'Niciun mesaj încă'}</span>
                </span>
                {c.unread > 0 && <span class="thread__badge numeric">{c.unread}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </aside>

  <section class="chat__thread">
    {
      active ? (
        <>
          <header class="chat__header">
            <Avatar name={active.peer_name} src={active.peer_avatar} href={`/profil/${active.peer_id}`} />
            <span class="chat__peer">
              <strong>{active.peer_name}</strong>
              {active.peer_detail && <small class="muted">{active.peer_detail}</small>}
            </span>

            <button class="chat__fisiere-buton" type="button" id="comuta-fisiere" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M4 4h5l2 2h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
              </svg>
              Fișiere
              {files.length > 0 && <span class="chat__fisiere-contor numeric">{files.length}</span>}
            </button>
          </header>

          <div class="chat__messages" id="chat-messages">
            {messages.length === 0 && (
              <div class="empty">
                <p class="empty__title">Niciun mesaj încă</p>
                <p class="empty__text">
                  Scrie primul mesaj. Interlocutorul primește o notificare pe email dacă nu este în
                  portal.
                </p>
              </div>
            )}

            {days.map((day) => (
              <>
                <p class="chat__day"><span>{day.label}</span></p>
                {day.items.map((m) =>
                  m.kind === 'event' ? (
                    <article class:list={['eveniment', EVENT_TONE[m.event_type ?? ''] ?? '']}>
                      <span class="eveniment__eticheta">
                        {EVENT_LABELS[m.event_type ?? ''] ?? 'Actualizare'}
                      </span>
                      <p class="eveniment__corp">{m.body}</p>
                      <span class="eveniment__ora numeric">{formatTime(m.created_at)}</span>
                    </article>
                  ) : (
                  <article class:list={['bubble', { 'bubble--mine': m.sender_id === userId }]}>
                    <p class="bubble__body">{m.body}</p>
                    {m.file_id && (
                      <a class="bubble__file" href={`/fisiere/${m.file_id}`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                        </svg>
                        {m.file_name}
                      </a>
                    )}
                    <span class="bubble__time numeric">{formatTime(m.created_at)}</span>
                  </article>
                  ),
                )}
              </>
            ))}
          </div>

          {/* Toate fișierele firului, în ordine cronologică. Stă peste conversație
              ca un sertar, ca să nu fure lățime când nu e nevoie de el. */}
          <aside class="fisiere-drawer" id="fisiere-drawer" hidden>
            <div class="fisiere-drawer__cap">
              <strong>Fișiere din conversație</strong>
              <button class="btn btn--ghost btn--sm" type="button" id="inchide-fisiere" aria-label="Închide">✕</button>
            </div>
            {files.length === 0 ? (
              <p class="fisiere-drawer__gol">
                Niciun fișier încă. Atașează unul cu agrafa de lângă câmpul de mesaj.
              </p>
            ) : (
              <ul class="fisiere-drawer__lista">
                {files.map((f) => (
                  <li>
                    <a class="fisier" href={`/fisiere/${f.id}`}>
                      <span class="fisier__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" />
                        </svg>
                      </span>
                      <span class="fisier__corp">
                        <strong>{f.original_name}</strong>
                        <small class="muted">
                          {[f.size_label, timeAgo(f.created_at)].filter(Boolean).join(' · ')}
                          {f.uploaded_by === userId ? ' · trimis de tine' : ''}
                        </small>
                      </span>
                      <svg class="fisier__descarca" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                        <path d="M12 3v12M7 12l5 5 5-5M4 21h16" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </aside>

          <form class="chat__compose" method="POST" action="/api/mesaje" enctype="multipart/form-data">
            <input type="hidden" name="conversation_id" value={active.id} />
            <input type="hidden" name="redirect" value={`${base}?conversatie=${active.id}`} />

            <label class="attach" title="Atașează un fișier">
              <input type="file" name="file" hidden />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              <span class="visually-hidden">Atașează un fișier</span>
            </label>

            <div class="chat__camp">
              {/* Fișierul ales se vede înainte de trimitere: altfel nu ai cum să
                  știi că s-a atașat, nici cum să te răzgândești. */}
              <div class="atasament" id="atasament" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" />
                </svg>
                <span class="atasament__corp">
                  <strong id="atasament-nume"></strong>
                  <small class="muted" id="atasament-marime"></small>
                </span>
                <button class="atasament__scoate" type="button" id="scoate-atasament" aria-label="Elimină fișierul">✕</button>
              </div>

              <textarea class="chat__input" name="body" rows="1" placeholder="Scrie un mesaj…" aria-label="Mesaj"></textarea>
            </div>

            <button class="btn btn--primary" type="submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
              </svg>
              <span class="chat__send-label">Trimite</span>
            </button>
          </form>
        </>
      ) : (
        <div class="empty" style="margin:auto">
          <p class="empty__title">Alege o conversație</p>
          <p class="empty__text">{emptyText}</p>
        </div>
      )
    }
  </section>

  {hasContext && <aside class="chat__context"><slot name="context" /></aside>}
</div>

<script>
  // Start at the latest message; this is a starting position, not a transition.
  const scroller = document.getElementById('chat-messages')
  scroller?.scrollTo({ top: scroller.scrollHeight })

  const input = document.querySelector<HTMLTextAreaElement>('.chat__input')

  // Enter sends, Shift+Enter breaks the line.
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      input.form?.requestSubmit()
    }
  })

  input?.addEventListener('input', () => {
    input.style.height = 'auto'
    input.style.height = Math.min(input.scrollHeight, 160) + 'px'
  })

  /* --- atașamentul, vizibil înainte de trimitere ------------------------- */

  const file = document.querySelector<HTMLInputElement>('input[type="file"]')
  const chip = document.getElementById('atasament')
  const chipNume = document.getElementById('atasament-nume')
  const chipMarime = document.getElementById('atasament-marime')
  const scoate = document.getElementById('scoate-atasament')

  const marime = (bytes: number) =>
    bytes < 1024
      ? `${bytes} B`
      : bytes < 1024 * 1024
        ? `${Math.round(bytes / 1024)} KB`
        : `${(bytes / (1024 * 1024)).toFixed(1)} MB`

  const MAX = 15 * 1024 * 1024

  function aratăAtașament() {
    const f = file?.files?.[0]
    if (!f) {
      if (chip) chip.hidden = true
      return
    }
    if (f.size > MAX) {
      window.notifica?.(`„${f.name}" depășește 15 MB și nu poate fi atașat.`, 'error')
      if (file) file.value = ''
      if (chip) chip.hidden = true
      return
    }
    if (chipNume) chipNume.textContent = f.name
    if (chipMarime) chipMarime.textContent = marime(f.size)
    if (chip) chip.hidden = false
  }

  file?.addEventListener('change', aratăAtașament)

  scoate?.addEventListener('click', () => {
    if (file) file.value = ''
    if (chip) chip.hidden = true
    input?.focus()
  })

  // Un mesaj poate fi doar un fișier, dar nu poate fi gol de tot.
  input?.form?.addEventListener('submit', (e) => {
    const areText = (input.value ?? '').trim().length > 0
    const areFisier = Boolean(file?.files?.length)
    if (!areText && !areFisier) {
      e.preventDefault()
      window.notifica?.('Scrie un mesaj sau atașează un fișier.', 'error')
      return
    }
    // Trimiterea poate dura cât urcă fișierul; butonul trebuie să arate asta.
    const buton = input.form?.querySelector<HTMLButtonElement>('button[type="submit"]')
    if (buton) buton.dataset.loading = ''
  })

  /* --- sertarul cu fișiere ------------------------------------------------ */

  const drawer = document.getElementById('fisiere-drawer')
  const comuta = document.getElementById('comuta-fisiere')

  const setDrawer = (deschis: boolean) => {
    if (drawer) drawer.hidden = !deschis
    comuta?.setAttribute('aria-expanded', String(deschis))
  }

  comuta?.addEventListener('click', () => setDrawer(drawer?.hidden ?? true))
  document.getElementById('inchide-fisiere')?.addEventListener('click', () => setDrawer(false))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) setDrawer(false)
  })
</script>

<style>
  .chat {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    /* Fills whatever the page gives it. The old `calc(100vh - 210px)` guessed
       at the chrome above and overflowed the professor layout. */
    height: 100%;
    min-height: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .chat__list {
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }
  .chat__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chat__empty {
    padding: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .thread {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--fast) var(--ease);
  }
  .thread:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .thread.is-active {
    background: var(--red-tint);
  }

  .thread__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .thread__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .thread__top strong {
    font-size: var(--t-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .thread__top small {
    font-size: 11px;
    color: var(--ink-muted);
    flex: none;
  }

  .thread__preview {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thread__badge {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    flex: none;
  }

  .chat--cu-context {
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr) minmax(260px, 320px);
  }

  .chat__context {
    border-left: 1px solid var(--border);
    overflow-y: auto;
    background: var(--surface);
    min-width: 0;
  }

  .chat__thread {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    /* Fără această linie, minimul automat al unui element flex este dat de
       conținut: firul crește peste celula lui de grilă, lista de mesaje nu mai
       derulează niciodată, iar `.chat { overflow: hidden }` taie zona de scris
       sub marginea de jos. Pe telefon nu se vedea, pentru că regula de mai jos
       îi dă o înălțime explicită. */
    min-height: 0;
    background: var(--bg);
  }

  .chat__header {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .chat__peer {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .chat__peer strong {
    font-size: var(--t-sm);
  }
  .chat__peer small {
    font-size: var(--t-xs);
  }

  .chat__messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .chat__day {
    align-self: center;
    margin-block: var(--s-3);
  }
  .chat__day span {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-sunken);
    color: var(--ink-muted);
    font-size: var(--t-xs);
  }

  .bubble {
    align-self: flex-start;
    max-width: min(72ch, 78%);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    border-bottom-left-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  /* Own messages carry the institutional red — the "me" state, not decoration. */
  .bubble--mine {
    align-self: flex-end;
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    border-bottom-left-radius: var(--r-lg);
    border-bottom-right-radius: var(--r-sm);
  }

  .bubble__body {
    font-size: var(--t-sm);
    white-space: pre-wrap;
    text-wrap: pretty;
  }

  .bubble__time {
    align-self: flex-end;
    font-size: 11px;
    color: var(--ink-muted);
  }
  .bubble--mine .bubble__time {
    color: rgba(255, 255, 255, 0.75);
  }

  .bubble__file {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    background: var(--surface-sunken);
    color: var(--ink);
    text-decoration: none;
  }
  .bubble__file svg {
    width: 14px;
    height: 14px;
  }
  .bubble--mine .bubble__file {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  /* Un eveniment nu are „autor” în același sens: se așază pe toată lățimea,
     centrat, cu un chenar întrerupt — nu poate fi confundat cu o replică. */
  .eveniment {
    align-self: center;
    width: min(100%, 62ch);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    margin-block: var(--s-2);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
    text-align: center;
  }

  .eveniment__eticheta {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .eveniment__corp {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    white-space: pre-wrap;
    text-wrap: pretty;
  }

  .eveniment__ora {
    font-size: 11px;
    color: var(--ink-muted);
  }

  .eveniment.is-bine {
    border-color: var(--ok);
  }
  .eveniment.is-bine .eveniment__eticheta {
    color: var(--ok);
  }

  .eveniment.is-rau {
    border-color: var(--danger);
  }
  .eveniment.is-rau .eveniment__eticheta {
    color: var(--danger);
  }

  .chat__fisiere-buton {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
    min-height: 30px;
    padding: 0 var(--s-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .chat__fisiere-buton:hover,
  .chat__fisiere-buton[aria-expanded='true'] {
    border-color: var(--ink-muted);
    color: var(--ink);
  }
  .chat__fisiere-buton svg {
    width: 15px;
    height: 15px;
  }
  .chat__fisiere-contor {
    padding: 0 5px;
    border-radius: 999px;
    background: var(--surface-sunken);
    font-size: 11px;
  }

  /* Sertarul acoperă conversația în loc să o îngusteze: e o consultare scurtă,
     nu o a treia coloană permanentă. */
  .fisiere-drawer {
    position: absolute;
    inset: 56px 0 0 auto;
    width: min(340px, 100%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-raised);
    overflow: hidden;
  }

  .fisiere-drawer__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }

  .fisiere-drawer__gol {
    padding: var(--s-4);
    font-size: var(--t-xs);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .fisiere-drawer__lista {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fisier {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--ink);
  }
  .fisier:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .fisier__icon {
    display: grid;
    place-items: center;
