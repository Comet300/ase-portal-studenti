---
import Avatar from './Avatar.astro'
import type { Conversation, Message } from '../lib/chat'
import { lockNotice } from '../lib/chat-lock'
import { formatTime, monthLabel, shortMonth, timeAgo } from '../lib/repo'
import { prezenta } from '../lib/presence'
import { ACCEPT } from '../lib/files'

/**
 * Events are things the portal did — a decision, an invitation, a scheduled
 * consultation. They live in the thread because that is where someone will look
 * for them a month later, but they must never read as the other person typing:
 * full width, centred, marked, and never in the "mine" colour.
 */
const EVENT_LABELS: Record<string, string> = {
  request_approved: 'Cerere aprobată',
  request_rejected: 'Cerere respinsă',
  request_expired: 'Cerere expirată',
  request_withdrawn: 'Cerere retrasă',
  invitation_sent: 'Propunere de coordonare',
  invitation_accepted: 'Propunere acceptată',
  invitation_declined: 'Propunere refuzată',
  consultation_scheduled: 'Consultație programată',
  consultation_cancelled: 'Consultație anulată',
  /* The end of a supervision that went well. Entering the grade turns the
     thread read-only from one second to the next, and until the vocabulary of
     migration 0016 there was no way to write down why. */
  coordination_ended: 'Coordonare încheiată',
  /* „Locuri alocate” was taken out: nothing ever writes it. Seats are granted
     between the director and the coordinator, while the portal's threads are
     (student, coordinator) — the event would have nowhere to exist. The notice
     stays on email and on the seats screen. */
}

const EVENT_TONE: Record<string, string> = {
  request_approved: 'is-bine',
  invitation_accepted: 'is-bine',
  request_rejected: 'is-rau',
  request_expired: 'is-rau',
  invitation_declined: 'is-rau',
  consultation_cancelled: 'is-rau',
}

export interface ChatFile {
  id: string
  original_name: string
  size_label: string
  created_at: string
  uploaded_by: string
}

interface Props {
  conversations: Conversation[]
  active: Conversation | null
  messages: Message[]
  /** Everything exchanged in the open thread, newest first. */
  files?: ChatFile[]
  userId: string
  base: string
  emptyText: string
  /** How many messages are left before the ones fetched. Zero hides the button. */
  olderCount?: number
  /** The window asked for right now; the button doubles it. */
  pageSize?: number
  /** Renders a third column when the caller provides `slot="context"`. */
  hasContext?: boolean
}

const {
  conversations,
  active,
  messages,
  files = [],
  userId,
  base,
  emptyText,
  olderCount = 0,
  pageSize = 40,
  hasContext = false,
} = Astro.props

/**
 * The composer, or the reason there is no composer.
 *
 * A thread whose pairing has ended kept a textarea, a paperclip and a „Trimite”
 * that all worked right up to the server, which refused the message with a
 * notice nobody ever saw. What the student got was: the text they had typed
 * disappearing, and no explanation anywhere.
 *
 * The composer is not disabled — a greyed-out box invites people to keep
 * trying. It is replaced by the record of what closed it, in the vocabulary the
 * thread already uses for everything the portal did (PRODUCT.md: the portal's
 * own actions are not messages).
 */
const lock = active
  ? lockNotice(active.lock_reason, {
      name: active.peer_name,
      forStudent: active.student_id === userId,
    })
  : null

/**
 * The files, by month.
 *
 * Nine months of supervision gather twenty files, and the drawer strung them all
 * out in one row: „capitolul 2” appeared three times, with three dates, and
 * there was no telling which one was the spring one without reading every line.
 * The month is the division the rhythm of the thesis already has.
 */
const filesByMonth = [
  ...files
    .reduce((byMonth, f) => {
      const monthKey = f.created_at.slice(0, 7)
      byMonth.set(monthKey, [...(byMonth.get(monthKey) ?? []), f])
      return byMonth
    }, new Map<string, typeof files>())
    .entries(),
].sort(([a], [b]) => (a < b ? 1 : -1))

/** Messages are grouped by day, the way a messaging app does it. */
type GroupedMessage = Message & { continuare: boolean; lastInGroup: boolean }

const days: { label: string; items: GroupedMessage[] }[] = []
const today = new Date().toDateString()
const yesterday = new Date(Date.now() - 86400000).toDateString()

const GROUP_GAP_MS = 5 * 60 * 1000

for (const [i, m] of messages.entries()) {
  const d = new Date(m.created_at)
  const key = d.toDateString()
  const label =
    key === today ? 'Astăzi' : key === yesterday ? 'Ieri' : `${d.getDate()} ${shortMonth(m.created_at)}`

  /* Five replies in a row from the same person were five identical boxes, each
   * with its own time. They are tied into one block: only the last one carries
   * the time, and the ones in the middle lose the tail and the border. */
  const previous = messages[i - 1]
  const next = messages[i + 1]
  const sameGroup = (a: Message | undefined, b: Message) =>
    !!a &&
    a.kind === 'text' &&
    b.kind === 'text' &&
    a.sender_id === b.sender_id &&
    new Date(a.created_at).toDateString() === new Date(b.created_at).toDateString() &&
    Math.abs(new Date(b.created_at).getTime() - new Date(a.created_at).getTime()) < GROUP_GAP_MS

  const item: GroupedMessage = {
    ...m,
    continuare: m.kind === 'text' && sameGroup(previous, m),
    lastInGroup: m.kind !== 'text' || !sameGroup(m, next ?? m) || !next,
  }

  const last = days.at(-1)
  if (last?.label === label) last.items.push(item)
  else days.push({ label, items: [item] })
}

/** The types the browser can safely show right inside the thread. */
const PREVIEWABLE_TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif']

const STARTER_MESSAGES = [
  'Bună ziua! Mă bucur că lucrăm împreună.',
  'Am o întrebare despre structura lucrării.',
  'Am atașat prima versiune a capitolului.',
]
---

<!-- `data-total` is the reference for the poll: how many messages the thread had
     at load, not how many were rendered. Ever since the thread is paginated the
     two no longer coincide, and the pill would announce „260 de mesaje noi” on
     opening an old conversation. -->
<div
  class:list={['chat', { 'chat--cu-context': hasContext }]}
  data-has-thread={active ? '' : undefined}
  data-total={active ? String(messages.length + olderCount) : undefined}
>
  <aside class="chat__list" aria-label="Conversații">
    {
      conversations.length === 0 ? (
        <p class="chat__empty">{emptyText}</p>
      ) : (
        <ul>
          {conversations.map((c) => (
            <li>
              <a href={`${base}?conversatie=${c.id}`} class:list={['thread', { 'is-active': active?.id === c.id }]}>
                <Avatar name={c.peer_name} src={c.peer_avatar} size="md" />
                <span class="thread__body">
                  <span class="thread__top">
                    <strong>{c.peer_name}</strong>
                    <small>{c.last_message_at ? timeAgo(c.last_message_at) : ''}</small>
                  </span>
                  {/* Which of these five can still be written in, before
                      opening any of them. Written out, not drawn: a grey tint
                      on the row would be a state carried by colour alone. */}
                  <span class="thread__preview">
                    {!c.is_active && <span class="thread__inchis">Doar citire · </span>}
                    {c.last_message ?? 'Niciun mesaj încă'}
                  </span>
                </span>
                {c.unread > 0 && <span class="thread__badge numeric">{c.unread}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </aside>

  <section class="chat__thread">
    {/* The target for files dragged over the thread. It sits over the whole
        thread, not over one corner: in a long conversation, a small area is
        impossible to hit. */}
    <div class="chat__drop" aria-hidden="true">
      <span>Lasă fișierul aici ca să îl atașezi</span>
    </div>

    {
      active ? (
        <>
          <header class="chat__header">
            {/* On a phone the conversation list is hidden so that the thread
                fits, and there was no way back to it other than the browser's
                own button: the thread looked like the whole page. */}
            <a class="chat__inapoi" href={base} aria-label="Toate conversațiile">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </a>
            <Avatar name={active.peer_name} src={active.peer_avatar} href={`/profil/${active.peer_id}`} />
            <span class="chat__peer">
              <strong>{active.peer_name}</strong>
              {/* A student sends a chapter and has no way of knowing whether
                  the coordinator is in the portal right now: either they write
                  „ați văzut?” on top, or they wait two days for nothing. It is
                  written coarsely, in three steps — somebody else's exact
                  minute-by-minute would be surveillance, not help. */}
              <small class="muted" id="prezenta-peer" data-prezenta>
                {prezenta(active.peer_seen) ?? active.peer_detail ?? ''}
              </small>
            </span>

            {/* The thesis context — title, milestones, coordinator — is the
                third column only above 1200px. Below that width it was simply
                `display:none`, so on a tablet and on a phone there was no way
                to it at all: exactly where the thread needs it most, being the
                only thing on the screen. It becomes a drawer, like the files. */}
            {hasContext && (
              <button class="chat__fisiere-buton chat__context-buton" type="button" id="comuta-context" aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                Lucrarea
              </button>
            )}

            <button class="chat__fisiere-buton" type="button" id="comuta-fisiere" aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M4 4h5l2 2h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
              </svg>
              Fișiere
              {files.length > 0 && <span class="chat__fisiere-contor numeric">{files.length}</span>}
            </button>
          </header>

          <div class="chat__messages" id="chat-messages">
            {/* What is left before this point.
                The thread was fetched whole: nine months of supervision rendered
                three hundred bubbles so that the last five could be read. The
                button doubles the window and anchors to the message that used to
                be first, so that the place in the reading is not lost on
                reload. */}
            {olderCount > 0 && (
              <a
                class="chat__mai-vechi"
                href={`${base}?conversatie=${active.id}&mesaje=${pageSize * 2}#mesaj-${messages[0]?.id ?? ''}`}
              >
                Arată mesajele mai vechi
                <span class="muted">
                  ({olderCount} {olderCount === 1 ? 'mesaj' : 'mesaje'})
                </span>
              </a>
            )}

            {messages.length === 0 && !lock && (
              /* An empty thread asks for a beginning, not an explanation —
                 unless it can no longer be written in, in which case „Scrie
                 primul mesaj” and three ready-made openers above a composer
                 that is not there would be an invitation to nothing. */
              <div class="chat__inceput">
                <p class="empty__title">Scrie primul mesaj</p>
                <p class="empty__text">
                  {active?.peer_name.split(' ').slice(-1)[0]} primește o notificare pe email dacă nu
                  este în portal.
                </p>
                <div class="chat__sugestii">
                  {STARTER_MESSAGES.map((text) => (
                    <button class="chat__sugestie" type="button" data-inceput={text}>
                      {text}
                    </button>
                  ))}
                </div>
              </div>
            )}

            {days.map((day) => (
              <>
                <p class="chat__day"><span>{day.label}</span></p>
                {day.items.map((m) =>
                  m.kind === 'event' ? (
                    <article class:list={['eveniment', EVENT_TONE[m.event_type ?? ''] ?? '']}>
                      <span class="eveniment__eticheta">
                        {EVENT_LABELS[m.event_type ?? ''] ?? 'Actualizare'}
                      </span>
                      <p class="eveniment__corp">{m.body}</p>
                      <time class="eveniment__ora numeric" datetime={m.created_at}>
                        {formatTime(m.created_at)}
                      </time>
                    </article>
                  ) : (
                  <article
                    class:list={[
                      'bubble',
                      {
                        'bubble--mine': m.sender_id === userId,
                        'bubble--continuare': m.continuare,
                      },
                    ]}
                    id={m.id === messages.at(-1)?.id ? 'ultim-mesaj' : `mesaj-${m.id}`}
                  >
                    {/* Rows written before this change still carry the old
                        filler text; it has no business inside a bubble. */}
                    {m.body && m.body !== '(fișier atașat)' && <p class="bubble__body">{m.body}</p>}

                    {/* A message can carry several files: a chapter arrives with
                        the questionnaire and with the data file. Images are
                        shown, the rest are named. */}
                    {(m.files ?? []).map((f) =>
                      PREVIEWABLE_TYPES.includes(f.mime ?? '') ? (
                        /* An image named through its file is an image you do
                           not see. It is shown; a click opens it whole. */
                        <a class="bubble__imagine" href={`/fisiere/${f.id}?inline=1`} target="_blank" rel="noopener">
                          <img src={`/fisiere/${f.id}?inline=1`} alt={f.name ?? 'Imagine atașată'} loading="lazy" />
                        </a>
                      ) : (
                        <a class="bubble__file" href={`/fisiere/${f.id}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                          </svg>
                          {f.name}
                        </a>
                      ),
                    )}

                    {m.lastInGroup && (
                      <span class="bubble__time numeric">
                        <time datetime={m.created_at} title={formatTime(m.created_at)}>
                          {formatTime(m.created_at)}
                        </time>
                        {/* The read state was already in the database and
                            nobody ever saw it. One tick: sent. Two: read. */}
                        {m.sender_id === userId && (
                          <span class="bubble__stare" title={m.read_at ? `Văzut ${formatTime(m.read_at)}` : 'Trimis'}>
                            {m.read_at ? '✓✓' : '✓'}
                          </span>
                        )}
                      </span>
                    )}
                  </article>
                  ),
                )}
              </>
            ))}
          </div>

          {/* When the conversation is scrolled up, the new message lands below
              the edge with no sign at all. The pill says something happened down
              there. */}
          <button class="chat__noi" type="button" id="mesaje-noi" hidden>
            Mesaje mai noi ↓
          </button>

          {/* Something arrived while the thread was open. The page does not
              change under your hand — you press it if you want to see. */}
          <button class="chat__noi chat__noi--primite" type="button" id="mesaje-primite" hidden></button>

          {/* All of the thread's files, in chronological order. It sits over the
              conversation as a drawer, so that it does not steal width when it
              is not needed. */}
          <aside class="fisiere-drawer" id="fisiere-drawer" role="dialog" aria-modal="false" aria-label="Fișiere din conversație" hidden>
            <div class="fisiere-drawer__cap">
              <strong>Fișiere din conversație</strong>
              <button class="btn btn--ghost btn--sm" type="button" id="inchide-fisiere" aria-label="Închide">✕</button>
            </div>

            {files.length > 4 && (
              <div class="fisiere-drawer__cauta">
                <input
                  class="input"
                  type="search"
                  id="cauta-fisier"
                  placeholder="Caută după nume…"
                  aria-label="Caută un fișier"
                />
              </div>
            )}

            {files.length === 0 ? (
              <p class="fisiere-drawer__gol">
                Niciun fișier încă. Atașează unul cu agrafa de lângă câmpul de mesaj.
              </p>
            ) : (
              <ul class="fisiere-drawer__lista">
                <li class="fisiere-drawer__gol" id="fisiere-fara-rezultat" hidden>
                  Niciun fișier cu numele acesta.
                </li>
                {filesByMonth.map(([month, monthFiles]) => (
                  <li class="fisiere-drawer__grup" data-luna={month}>
                    <p class="fisiere-drawer__luna">
                      <span>{monthLabel(monthFiles[0].created_at)}</span>
                      <span class="muted numeric">
                        {monthFiles.length} {monthFiles.length === 1 ? 'fișier' : 'fișiere'}
                      </span>
                    </p>
                    <ul>
                      {monthFiles.map((f) => (
                        <li data-nume-fisier={f.original_name.toLowerCase()}>
                          <a class="fisier" href={`/fisiere/${f.id}`}>
                            <span class="fisier__icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" />
                              </svg>
                            </span>
                            <span class="fisier__corp">
                              <strong>{f.original_name}</strong>
                              <small class="muted">
                                {[f.size_label, timeAgo(f.created_at)].filter(Boolean).join(' · ')}
                                {f.uploaded_by === userId ? ' · trimis de tine' : ''}
                              </small>
                            </span>
                            <svg class="fisier__descarca" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                              <path d="M12 3v12M7 12l5 5 5-5M4 21h16" />
                            </svg>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            )}

            {/* Nine files meant nine clicks and nine „Salvează ca”, for every
                student, at every submission of a file. */}
            {files.length > 1 && (
              <div class="fisiere-drawer__jos">
                <a class="btn btn--secondary btn--sm" href={`/fisiere/conversatie/${active.id}.zip`}>
                  Descarcă toate ({files.length})
                </a>
              </div>
            )}

          </aside>

          {lock ? (
            /* Not a bubble and not a toast: the same record the thread uses for
               every decision, laid across the strip the composer used to
               occupy, so the bottom edge of the conversation is where it always
               was. */
            <div class:list={['eveniment', 'eveniment--blocaj', { 'is-rau': lock.tone === 'bad' }]}>
              <span class="eveniment__eticheta">{lock.label}</span>
              <p class="eveniment__corp">{lock.body}</p>
              {lock.action && (
                <a class="btn btn--secondary btn--sm" href={lock.action.href}>
                  {lock.action.text}
                </a>
              )}
            </div>
          ) : (
            <form class="chat__compose" method="POST" action="/api/mesaje" enctype="multipart/form-data">
              <input type="hidden" name="conversation_id" value={active.id} />
              <input type="hidden" name="redirect" value={`${base}?conversatie=${active.id}`} />

              {/* The button is a button, not a label: a label takes no keyboard
                  focus, so attaching a file was impossible without a mouse. The
                  field stays in the page, visually hidden but accessible. */}
              <input type="file" name="file" class="visually-hidden" id="camp-fisier" accept={ACCEPT} multiple />
              <button class="attach" type="button" id="alege-fisier">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                </svg>
                <span class="visually-hidden">Atașează fișiere</span>
              </button>

              <div class="chat__camp">
                {/* The chosen files are visible before sending: otherwise there is
                    no way to know what got attached, nor how to change your mind.
                    The bar underneath shows how much of the whole has gone up, and
                    the „✕” on the layer stops the upload.

                    The list is built from JavaScript, one row per file: a chapter
                    arrives with the questionnaire and with the data file, and
                    before this it meant three messages for a single thought. */}
                <div class="atasamente" id="atasamente" hidden>
                  {/* How many there are, how heavy they are, and — when they no
                      longer fit — that the row continues to the right. The fade
                      at the edge alone would be a state carried by colour. */}
                  <p class="atasamente__rezumat" id="atasamente-rezumat" aria-live="polite"></p>
                  <div class="atasamente__pista" id="atasamente-pista">
                    <ul class="atasamente__lista" id="atasamente-lista" aria-label="Fișiere atașate"></ul>
                  </div>
                  <span class="atasamente__bara" id="atasamente-bara"></span>
                </div>

                <textarea class="chat__input" name="body" rows="1" placeholder="Scrie un mesaj…" aria-label="Mesaj" data-autogrow></textarea>
              </div>

              <button class="btn btn--primary" type="submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
                <span class="chat__send-label">Trimite</span>
              </button>
            </form>
          )}
        </>
      ) : (
        <div class="empty" style="margin:auto">
          <p class="empty__title">Alege o conversație</p>
          <p class="empty__text">{emptyText}</p>
        </div>
      )
    }
  </section>

  {
    hasContext && (
      <aside class="chat__context" id="chat-context">
        {/* Closes the drawer; at a large width the button is not visible at
            all, because there the column is always open. */}
        <button class="chat__context-inchide" type="button" id="inchide-context" aria-label="Închide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
        <slot name="context" />
      </aside>
    )
  }
</div>

<script>
  import { start } from '../scripts/chat'

  start()
</script>

<style>
  .chat {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    /* Fills whatever the page gives it. The old `calc(100vh - 210px)` guessed
       at the chrome above and overflowed the professor layout. */
    height: 100%;
    min-height: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .chat__list {
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }
  .chat__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chat__empty {
    padding: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .thread {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background var(--fast) var(--ease);
  }
  .thread:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .thread.is-active {
    background: var(--red-tint);
  }

  .thread__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .thread__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .thread__top strong {
    font-size: var(--t-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .thread__top small {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    flex: none;
  }

  .thread__preview {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .thread__inchis {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .thread__badge {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
    flex: none;
  }

  .chat--cu-context {
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr) minmax(260px, 320px);
  }

  .chat__context {
    border-left: 1px solid var(--border);
    overflow-y: auto;
    background: var(--surface);
    min-width: 0;
  }

  .chat__thread {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    /* Without this line, the automatic minimum of a flex item is set by its
       content: the thread grows past its grid cell, the message list never
       scrolls again, and `.chat { overflow: hidden }` cuts the compose area off
       below the bottom edge. On a phone it did not show, because the rule
       further down gives it an explicit height. */
    min-height: 0;
    background: var(--bg);
  }

  .chat__header {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .chat__peer {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .chat__peer strong {
    font-size: var(--t-sm);
  }
  .chat__peer small {
    font-size: var(--t-xs);
  }

  .chat__messages {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .chat__day {
    align-self: center;
    margin-block: var(--s-3);
  }
  .chat__day span {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-sunken);
    color: var(--ink-muted);
    font-size: var(--t-xs);
  }

  /* The bubbles are written under `:global()`, and on purpose.
     -------------------------------------------------------------------------
     Astro compiles every selector in this block to `.bubble[data-astro-cid-…]`,
     an attribute it stamps on the elements *it* renders. The provisional bubble
     — the one standing in for the message while it is on its way to the server
     — is built by scripts/chat.ts, so it never carries that attribute: every
     rule below missed it, and what a person saw the moment they pressed
     „Trimite” was unstyled text on the page background.

     Writing the attribute from JavaScript would work today and break at the
     next build: the hash is derived from the file's content. The selectors stay
     anchored to `.chat__messages`, which is rendered here and does carry it, so
     the globals cannot leak past the thread. */

  .chat__messages :global(.bubble) {
    align-self: flex-start;
    max-width: min(72ch, 78%);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    /* The portal's almost square corners suit an institutional form; inside a
       conversation they looked like table cells. */
    border-radius: 14px;
    border-bottom-left-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  /* One's own replies were solid red — that is, the institution's seal over
     half the surface of the screen, in a place that is furniture, not action. It
     stays the same colour family, at the intensity that tells apart without
     dominating. */
  .chat__messages :global(.bubble--mine) {
    align-self: flex-end;
    background: var(--red-tint);
    border-color: #f3d9d5;
    color: var(--ink);
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: var(--r-sm);
  }

  /* Five replies in a row from the same person read as one block, not as five
     boxes: the continuation loses the tail and sticks to the one before it. */
  .chat__messages :global(.bubble--continuare) {
    margin-top: calc(var(--s-2) * -1 + 2px);
    border-top-left-radius: var(--r-sm);
  }
  .chat__messages :global(.bubble--mine.bubble--continuare) {
    border-top-left-radius: 14px;
    border-top-right-radius: var(--r-sm);
  }

  .chat__messages :global(.bubble__body) {
    font-size: var(--t-sm);
    white-space: pre-wrap;
    text-wrap: pretty;
  }

  .chat__messages :global(.bubble__time) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    align-self: flex-end;
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .chat__messages :global(.bubble__stare) {
    letter-spacing: -1px;
    color: var(--info);
  }

  /* A photo named through its file is a photo you do not see. */
  .chat__messages :global(.bubble__imagine) {
    display: block;
    max-width: 260px;
    border-radius: var(--r-md);
    overflow: hidden;
    line-height: 0;
  }
  .chat__messages :global(.bubble__imagine img) {
    width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: cover;
  }

  /* The provisional bubble, while the message is on its way to the server. */
  .chat__messages :global(.bubble.is-pending) {
    opacity: 0.6;
  }
  .chat__messages :global(.bubble.is-failed) {
    border-color: var(--danger);
    background: var(--danger-tint);
  }
  .chat__messages :global(.bubble__reia) {
    align-self: flex-end;
    margin-top: var(--s-1);
    border: 1px solid var(--danger);
    border-radius: var(--r-sm);
    background: none;
    padding: 2px var(--s-2);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--danger);
    cursor: pointer;
  }

  /* Only the last bubble enters with motion — with all of them animated, a long
     thread would shudder at every load. */
  .chat__messages > :global(.bubble:last-child) {
    animation: bula-noua var(--base) var(--ease-spring);
  }

  @keyframes bula-noua {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
  }

  .chat__messages :global(.bubble__file) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    background: var(--surface-sunken);
    color: var(--ink);
    text-decoration: none;
  }
  .chat__messages :global(.bubble__file svg) {
    width: 14px;
    height: 14px;
  }
  .chat__messages :global(.bubble--mine .bubble__file) {
    background: rgba(153, 0, 0, 0.07);
    color: var(--ink);
  }

  /* --- the target for files dragged over the thread ----------------------- */

  .chat__drop {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    border: 2px dashed var(--red);
    border-radius: var(--r-md);
    font-weight: 600;
    color: var(--red);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--fast) var(--ease);
  }

  .chat__thread[data-drop] .chat__drop {
    opacity: 1;
  }

  /* --- the „mesaje mai noi” pill ------------------------------------------- */

  /* A received message is news, not an order to scroll: it sits at the top,
     where new things arrive, and carries the informative colour. */
  .chat__noi--primite {
    top: 72px;
    bottom: auto;
    background: var(--info-tint);
    border-color: var(--info);
    color: var(--info);
  }

  .chat__noi {
    position: absolute;
    bottom: 84px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-raised);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
    animation: bula-noua var(--base) var(--ease);
  }

  /* --- the empty thread ---------------------------------------------------- */

  .chat__mai-vechi {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .chat__mai-vechi:hover {
    border-color: var(--ink-muted);
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .chat__inceput {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
    margin: auto;
    padding: var(--s-6) var(--s-5);
    text-align: center;
  }

  .chat__sugestii {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }

  /* Three conversation openers: an empty thread asks for a first sentence, not
     an explanation of how the email works. */
  .chat__sugestie {
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--t-xs);
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      background var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }
  .chat__sugestie:hover {
    background: var(--surface-sunken);
    border-color: var(--ink-muted);
    color: var(--ink);
  }

  /* An event has no „author” in the same sense: it lays itself across the full
     width, centred, with a dashed border — it cannot be taken for a reply. */
  .eveniment {
    align-self: center;
    width: min(100%, 62ch);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    margin-block: var(--s-2);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
    text-align: center;
  }

  .eveniment__eticheta {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .eveniment__corp {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    white-space: pre-wrap;
    text-wrap: pretty;
  }

  .eveniment__ora {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .eveniment.is-bine {
    border-color: var(--ok);
  }
  .eveniment.is-bine .eveniment__eticheta {
    color: var(--ok);
  }

  .eveniment.is-rau {
    border-color: var(--danger);
  }
  .eveniment.is-rau .eveniment__eticheta {
    color: var(--danger);
  }

  /* The record that closes the thread takes the place of the composer, so it
     takes its edges too: the same strip, the same line above it, the same
     surface. Dashed inside the conversation it reads as one more entry in the
     history; here it is the bottom of the screen, and a dashed frame floating
     over the whole width would read as a warning banner. */
  .eveniment--blocaj {
    align-self: stretch;
    width: auto;
    margin-block: 0;
    padding: var(--s-4);
    gap: var(--s-2);
    align-items: center;
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }
  .eveniment--blocaj.is-rau {
    border-top-color: var(--danger);
  }
  .eveniment--blocaj .eveniment__corp {
    max-width: 62ch;
  }

  .chat__fisiere-buton {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
    min-height: 30px;
    padding: 0 var(--s-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .chat__fisiere-buton:hover,
  .chat__fisiere-buton[aria-expanded='true'] {
    border-color: var(--ink-muted);
    color: var(--ink);
  }
  .chat__fisiere-buton svg {
    width: 15px;
    height: 15px;
  }
  .chat__fisiere-contor {
    padding: 0 5px;
    border-radius: 999px;
    background: var(--surface-sunken);
    font-size: var(--t-xs);
  }

  /* The drawer covers the conversation instead of narrowing it: it is a short
     consultation, not a permanent third column. */
  /* The drawer used to start at 56px — a hand-written measurement of the header,
     which stopped being true once the header got an avatar. It covers the thread
     from top to bottom and slides in from the edge. */
  .fisiere-drawer {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(340px, 100%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-overlay);
    overflow: hidden;
    animation: sertar-intra var(--base) var(--ease);
  }

  @keyframes sertar-intra {
    from {
      transform: translateX(100%);
    }
  }

  .fisiere-drawer__cauta {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
  }

  .fisiere-drawer__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-sm);
  }

  .fisiere-drawer__gol {
    padding: var(--s-4);
    font-size: var(--t-xs);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .fisiere-drawer__lista {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fisiere-drawer__lista ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* The month heading: sticky, so that while scrolling a long list you know
     which month you are in, not only which names you are going past. */
  .fisiere-drawer__luna {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-1);
    background: var(--surface);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .fisiere-drawer__jos {
    padding: var(--s-3) var(--s-4);
    border-top: 1px solid var(--border);
  }

  .fisier {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    text-decoration: none;
    color: var(--ink);
  }
  .fisier:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .fisier__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-md);
    background: var(--surface-sunken);
    color: var(--ink-muted);
    flex: none;
  }
  .fisier__icon svg {
    width: 16px;
    height: 16px;
  }

  .fisier__corp {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .fisier__corp strong {
    font-size: var(--t-xs);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fisier__corp small {
    font-size: var(--t-xs);
  }

  .fisier__descarca {
    width: 15px;
    height: 15px;
    flex: none;
    color: var(--ink-muted);
    opacity: 0;
    transition: opacity var(--fast) var(--ease);
  }
  .fisier:hover .fisier__descarca {
    opacity: 1;
  }

  .chat__camp {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  /* The strip of chosen files.
     -------------------------------------------------------------------------
     Two things were wrong with it, and they compounded.

     Every `.atasament…` rule here used to be dead. Astro scopes them to
     `[data-astro-cid-…]`, the chips are built by scripts/chat.ts and never
     carried it, so `svg { width: 15px }` never applied — and an `<svg>` with a
     viewBox, no dimensions and no CSS falls back to the replaced-element
     default of 300×150px. That giant glyph was the „huge thumbnail”, and it was
     identical for a .docx and for a photo.

     The row also wrapped. Ten files (the client's cap) at 150px tall came to
     five rows and some 700px of composer, inside a `.chat` that hides its
     overflow: the message list was squeezed towards nothing and „Trimite” went
     under the bottom edge. It is now one row that scrolls in its own box —
     never the page — with a fixed height whatever the file types are. */
  .atasamente {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-bottom: 3px;
  }

  .atasamente__rezumat {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .atasamente__pista {
    position: relative;
  }

  /* That the row continues past the edge. The fade is the quiet half of the
     signal; the loud half is the word in `.atasamente__rezumat`, because a
     gradient is a state carried by colour alone. */
  .atasamente__pista::before,
  .atasamente__pista::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: var(--s-5);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--fast) var(--ease);
  }
  .atasamente__pista::before {
    left: 0;
    background: linear-gradient(to right, var(--surface), transparent);
  }
  .atasamente__pista::after {
    right: 0;
    background: linear-gradient(to left, var(--surface), transparent);
  }
  .atasamente__pista[data-overflow-start]::before,
  .atasamente__pista[data-overflow-end]::after {
    opacity: 1;
  }

  .atasamente__lista {
    list-style: none;
    margin: 0;
    /* The padding is the room the focus ring needs. The container clips, and
       the ring is drawn 2px outside the „✕” — without it, the first and the
       last chip lose the only sign of where the keyboard is. */
    padding: var(--s-1);
    display: flex;
    flex-wrap: nowrap;
    gap: var(--s-2);
    overflow-x: auto;
    /* The strip scrolls, the thread behind it does not: flicking to the end of
       the files used to carry on into the conversation. */
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--s-1);
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
    /* As on `.table-wrap`: without it the lateral scroll of the strip becomes
       the lateral scroll of the document. */
    contain: paint;
  }
  .atasamente__lista::-webkit-scrollbar {
    height: 6px;
  }
  .atasamente__lista::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 999px;
  }

  .atasamente__bara {
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    width: 0;
    background: var(--red);
    transition: width 120ms linear;
  }

  /* The chips themselves are built in scripts/chat.ts, so their rules are
     written global — see the note above the bubbles for why the scope
     attribute is not written from JavaScript. They stay anchored under
     `.atasamente__lista`, which is rendered here. */
  .atasamente__lista :global(.atasament) {
    position: relative;
    /* Fixed, not fluid: the row is a rhythm you can flick through, and the
       snap has something to land on. */
    flex: 0 0 13rem;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    /* One height for a photo, a .docx and a .zip alike — the strip must not
       change height when the next file happens to be an image. */
    height: 3rem;
    padding-left: var(--s-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface-sunken);
    overflow: hidden;
  }

  /* The box has the size; the image only fills it. An `<img>` left to its own
     dimensions is exactly how a 4000px photo took over the composer. */
  .atasamente__lista :global(.atasament__vizual) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink-muted);
    overflow: hidden;
  }
  .atasamente__lista :global(.atasament__vizual img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .atasamente__lista :global(.atasament__vizual svg) {
    width: 16px;
    height: 16px;
  }

  .atasamente__lista :global(.atasament__corp) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }
  .atasamente__lista :global(.atasament__corp strong) {
    font-size: var(--t-xs);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .atasamente__lista :global(.atasament__corp small) {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  /* The glyph is small, the target is not: removing a file by mistake is
     cheaper than not being able to remove it at all on a phone. */
  .atasamente__lista :global(.atasament__scoate) {
    display: grid;
    place-items: center;
    width: var(--tap);
    align-self: stretch;
    flex: none;
    border: 0;
    background: none;
