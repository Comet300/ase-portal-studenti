---
import { recentEvents, unreadEvents } from '../lib/chat'
import { timeAgo } from '../lib/repo'

/**
 * What happened while you were away.
 *
 * Email was the only channel through which the portal announced anything.
 * Whoever did not check their inbox — or had it full — never found out that a
 * request had been approved, that a proposal had arrived or that a consultation
 * had been scheduled, unless they happened to open the right screen.
 *
 * The events already exist, written into the conversation threads by every
 * decision. Here they are only gathered in one place.
 */

interface Props {
  /** Where each row leads: the conversation thread, from the role's point of view. */
  messagesBase: string
}

const { messagesBase } = Astro.props
const u = Astro.locals.user!

const [events, necitite] = await Promise.all([recentEvents(u.id), unreadEvents(u.id)])

const EVENT_LABELS: Record<string, string> = {
  request_approved: 'Cerere aprobată',
  request_rejected: 'Cerere respinsă',
  request_expired: 'Cerere expirată',
  request_withdrawn: 'Cerere retrasă',
  invitation_sent: 'Propunere de coordonare',
  invitation_accepted: 'Propunere acceptată',
  invitation_declined: 'Propunere refuzată',
  consultation_scheduled: 'Consultație programată',
  consultation_cancelled: 'Consultație anulată',
  thesis_uploaded: 'Lucrare încărcată',
}

/**
 * Where a notification leads.
 *
 * All of them led into the conversation thread, because that is all an event
 * knew about itself. But „Cerere aprobată” means a decision with a written
 * reason, and that one is read in „Cererile mele”, not in the chat;
 * „Consultație programată” means a slot in the schedule.
 *
 * The subject is kept as a kind and an id, not as a URL, precisely because the
 * answer depends on who is reading: the same slot is on two different screens
 * for the student and for the coordinator. When it is not known, the thread
 * remains — it holds the event anyway, written into it at the moment of the
 * decision.
 */
const isStudent = u.role === 'student'

function destination(e: { subject_kind: string | null; subject_id: string | null; conversation_id: string }) {
  const threadHref = `${messagesBase}?conversatie=${e.conversation_id}`
  switch (e.subject_kind) {
    case 'request':
      return isStudent
        ? `/lucrarea-mea${e.subject_id ? `#cerere-${e.subject_id}` : ''}`
        : `/profesor/studenti?sectiune=cereri${e.subject_id ? `#cerere-${e.subject_id}` : ''}`
    /* No anchor: proposals are shown only while they are open, at the top of
       the page. An accepted or declined one no longer has a row, and a fragment
       pointing at it would be a link that leads nowhere. */
    case 'invitation':
      return isStudent ? '/lucrarea-mea' : '/profesor/studenti?sectiune=invitatii'
    case 'slot':
      return isStudent ? '/consultatii' : '/profesor/consultatii'
    /* Fișierul predat: studentul îl vede pe ecranul lucrării lui, coordonatorul
       în rândul studentului din lista de coordonați. Aceeași subiect, două
       adrese — de asta se păstrează felul, nu un URL. */
    case 'file':
      return isStudent ? '/lucrarea-mea#lucrare' : '/profesor/studenti?sectiune=studenti'
    default:
      return threadHref
  }
}
---

<details class="clopotel">
  <summary aria-label={necitite > 0 ? `Notificări — ${necitite} necitite` : 'Notificări'}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" />
    </svg>
    {necitite > 0 && <span class="clopotel__punct numeric">{necitite > 9 ? '9+' : necitite}</span>}
  </summary>

  <div class="clopotel__panou">
    <p class="clopotel__titlu">Notificări</p>

    {
      events.length === 0 ? (
        <p class="clopotel__gol">
          Nimic nou. Aici ajung deciziile, propunerile și consultațiile programate.
        </p>
      ) : (
        <ul class="clopotel__lista">
          {events.map((e) => (
            <li>
              <a
                class:list={['notificare', { 'is-unread': !e.read_at }]}
                href={destination(e)}
              >
                <span class="notificare__eticheta">
                  {EVENT_LABELS[e.event_type ?? ''] ?? 'Actualizare'}
                </span>
                <span class="notificare__corp">{e.body}</span>
                <span class="notificare__jos">
                  {e.peer_name} · <time datetime={e.created_at} data-relativ>{timeAgo(e.created_at)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</details>

<style>
  .clopotel {
    position: relative;
    flex: none;
  }

  .clopotel summary {
    display: grid;
    place-items: center;
    position: relative;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--r-md);
    color: var(--ink-soft);
    cursor: pointer;
    list-style: none;
    transition: background var(--fast) var(--ease);
  }
  .clopotel summary::-webkit-details-marker {
    display: none;
  }
  .clopotel summary:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .clopotel summary svg {
    width: 19px;
    height: 19px;
  }

  /* The dot carries the number: „ai ceva” and „ai patru lucruri” call for different reactions. */
  .clopotel__punct {
    position: absolute;
    top: 6px;
    right: 6px;
    min-width: 18px;
    height: 18px;
    padding: 1px 5px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 700;
    line-height: 1;
  }

  .clopotel__panou {
    position: absolute;
    top: calc(100% + var(--s-2));
    right: 0;
    z-index: var(--z-drawer);
    width: min(360px, calc(100vw - var(--s-5) * 2));
    max-height: 60vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-overlay);
    animation: clopotel-intra var(--base) var(--ease);
  }

  @keyframes clopotel-intra {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .clopotel__titlu {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .clopotel__gol {
    padding: var(--s-5) var(--s-4);
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .clopotel__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notificare {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--fast) var(--ease);
  }
  .notificare:hover {
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .clopotel__lista li:last-child .notificare {
    border-bottom: 0;
  }

  /* Unread is a mark on the edge, not a wash of red across the row. */
  .notificare.is-unread {
    box-shadow: inset 3px 0 0 var(--info);
  }

  .notificare__eticheta {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--ink-soft);
  }

  .notificare__corp {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notificare__jos {
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
</style>
