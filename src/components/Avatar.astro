---
import { initials } from '../lib/auth'

interface Props {
  name: string
  src?: string | null
  /** 28 · 34 · 44 · 72 px — the four sizes the portal actually uses. */
  size?: 'xs' | 'sm' | 'md' | 'lg'
  href?: string
  class?: string
}

const { name, src, size = 'sm', href, class: extra } = Astro.props

/**
 * A picture when there is one, initials when there is not.
 *
 * Most people will never upload a photo, so the fallback is the normal case and
 * has to look deliberate rather than broken: the same circle, the same border,
 * the initials set in the interface face.
 */
const Tag = href ? 'a' : 'span'

/**
 * A tint of its own for every name.
 *
 * A list of thirty students was a column of identical circles, with nothing for
 * the eye to catch on. The colour comes from the name, so it is stable across
 * pages and across sessions, and it stays within the institution's register:
 * muted tones, not the palette of a chat application.
 */
const TINTS = [
  { background: '#eceef3', text: '#3c4a63' },
  { background: '#eff1ea', text: '#4a5537' },
  { background: '#f4ece8', text: '#6b463a' },
  { background: '#eaeff1', text: '#37535c' },
  { background: '#f1ecf1', text: '#5a3f58' },
  { background: '#f2efe6', text: '#5f5230' },
]

let sum = 0
for (const ch of name) sum = (sum + ch.codePointAt(0)!) % 4096
const tint = TINTS[sum % TINTS.length]
---

<Tag
  class:list={['avatar', `avatar--${size}`, extra]}
  href={href}
  title={href ? name : undefined}
  data-photo={src ? '' : undefined}
  style={src ? undefined : `--fundal:${tint.background};--text:${tint.text}`}
>
  {
    src ? (
      <img src={`/avatare/${src}`} alt="" loading="lazy" decoding="async" />
    ) : (
      <span aria-hidden="true">{initials(name)}</span>
    )
  }
</Tag>

<style>
  .avatar {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--fundal, var(--surface-sunken));
    border: 1px solid var(--border);
    color: var(--text, var(--ink-soft));
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    flex: none;
    overflow: hidden;
  }

  a.avatar:hover {
    border-color: var(--ink-muted);
    color: var(--ink);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar--xs {
    width: 28px;
    height: 28px;
    font-size: var(--t-xs);
  }
  .avatar--sm {
    width: 34px;
    height: 34px;
    font-size: var(--t-xs);
  }
  .avatar--md {
    width: 44px;
    height: 44px;
    font-size: var(--t-sm);
  }
  .avatar--lg {
    width: 72px;
    height: 72px;
    font-size: var(--t-lg);
    border-color: var(--border-strong);
  }
</style>
