---
/**
 * A bar of sections, as links.
 *
 * Four screens each had their own bar, with four style variants and a single
 * one that marked the current page for a screen reader. Links, not buttons:
 * a section is an address someone can send to a colleague, and it works
 * without JavaScript.
 */
interface Tab {
  key: string
  text: string
  href: string
  /** The number to the right of the label; hidden when zero, so it adds no noise. */
  count?: number | null
}

interface Props {
  taburi: Tab[]
  activ: string
  eticheta: string
}

const { taburi, activ, eticheta } = Astro.props
---

<nav class="taburi" aria-label={eticheta}>
  {
    taburi.map((t) => (
      <a
        href={t.href}
        class:list={['tab', { 'is-activ': activ === t.key }]}
        aria-current={activ === t.key ? 'page' : undefined}
      >
        {t.text}
        {t.count != null && t.count > 0 && <span class="tab__contor numeric">{t.count}</span>}
      </a>
    ))
  }
</nav>

<style>
  .taburi {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    border-bottom: 1px solid var(--border);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab.is-activ {
    color: var(--red);
    font-weight: 600;
    border-bottom-color: var(--red);
  }

  .tab__contor {
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--surface-sunken);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .tab.is-activ .tab__contor {
    background: var(--red-tint);
    color: var(--red);
  }
</style>
