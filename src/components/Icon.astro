---
/**
 * The portal's icon set.
 *
 * They were written inline, with `stroke-width` between 1.6 and 2 and sizes
 * between 14 and 19px, each one chosen separately — so two neighbouring icons
 * did not carry the same weight. Here they are a single set, with a single
 * weight, at three sizes that line up with the text scale.
 *
 * Every one is `aria-hidden`: an icon next to a label has nothing to announce,
 * and one standing on its own takes its name from the control containing it.
 */
interface Props {
  name: keyof typeof ICON_PATHS
  /** sm 14px · md 16px · lg 19px — aligned with --t-xs / --t-sm / --t-md. */
  size?: 'sm' | 'md' | 'lg'
  class?: string
}

const ICON_PATHS = {
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  users:
    'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  chat:
    'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z',
  list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  chart: 'M18 20V10M12 20V4M6 20v-6',
  archive: 'M21 8v13H3V8M1 3h22v5H1zM10 12h4',
  calendar:
    'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  refresh: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15',
  acasa: 'M3 12l9-9 9 9M5 10v10h14V10',
  iesire: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9',
  jos: 'M6 9l6 6 6-6',
  inapoi: 'M19 12H5M12 19l-7-7 7-7',
  inainte: 'M5 12h14M13 6l6 6-6 6',
  clopotel: 'M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0',
  agrafa:
    'M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48',
  fisier: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6',
  dosar: 'M4 4h5l2 2h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z',
  descarca: 'M12 3v12M7 12l5 5 5-5M4 21h16',
  trimite: 'M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z',
  meniu: 'M3 6h18M3 12h18M3 18h18',
} as const

const { name, size = 'md', class: extra } = Astro.props
---

<svg
  class:list={['icon', `icon--${size}`, extra]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={ICON_PATHS[name]} />
</svg>

<style>
  .icon {
    flex: none;
  }
  .icon--sm {
    width: 14px;
    height: 14px;
  }
  .icon--md {
    width: 16px;
    height: 16px;
  }
  .icon--lg {
    width: 19px;
    height: 19px;
  }
</style>
