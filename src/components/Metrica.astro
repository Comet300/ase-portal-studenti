---
/**
 * A figure with its name.
 *
 * The same box was written by hand on five screens, with five variants of
 * spacing and three ways of marking the alert state. When something about it
 * changes — and it did change, twice in this audit — it has to be changed in a
 * single place.
 */
interface Props {
  value: string | number
  label: string
  /** One line under the label: the context that makes the figure useful. */
  note?: string
  /** Marks the figure as the one that asks for attention. */
  alerta?: boolean
  /** When it is given, the whole box becomes a link. */
  href?: string
}

const { value, label, note, alerta = false, href } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag class:list={['metrica', { 'metrica--alerta': alerta, 'metrica--link': href }]} href={href}>
  <span class="metrica__valoare numeric">{value}</span>
  <span class="metrica__eticheta">{label}</span>
  {note && <span class="metrica__nota">{note}</span>}
</Tag>

<style>
  .metrica {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-4) var(--s-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
  }

  /* The elevation marks what responds to touch. */
  .metrica--link {
    transition:
      box-shadow var(--fast) var(--ease),
      transform 90ms var(--ease-in);
  }
  .metrica--link:hover {
    box-shadow: var(--shadow-raised);
    color: inherit;
  }
  .metrica--link:active {
    transform: scale(0.99);
  }

  /* The alert colours the figure, not the whole box: a card red all over shouts
     louder than a number deserves. Amber, not red — every figure marked this way
     („fără cerere depusă”, „locuri epuizate”) asks for attention, none of them is
     an error. */
  .metrica--alerta .metrica__valoare {
    color: var(--warn);
  }

  .metrica__valoare {
    font-family: var(--serif);
    font-size: var(--t-2xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .metrica__eticheta {
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }

  .metrica__nota {
    font-size: var(--t-xs);
    color: var(--ink-muted);
    text-wrap: pretty;
  }
</style>
